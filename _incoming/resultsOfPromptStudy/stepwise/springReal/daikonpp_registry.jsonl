{"id":"5c6a7173-608d-4ac6-9272-85a4d6691a6b","expr":"desc != null && desc.length() > 0","rationale":"The descriptor string desc should be non-null and non-empty as it represents a type descriptor.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariableAnnotation(int,TypePath,Label[],Label[],int[],String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:25.328773039Z"}
{"id":"cb949d85-5e09-44e5-a9b6-db57809ad5bd","expr":"start != null && end != null","rationale":"Both start and end Label arrays must be non-null for the annotation.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariableAnnotation(int,TypePath,Label[],Label[],int[],String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:25.328773039Z"}
