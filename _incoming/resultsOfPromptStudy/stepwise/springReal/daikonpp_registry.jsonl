{"id":"38bd039d-5625-4732-a248-4b3a9650e979","expr":"name == null || descriptor == null || (name != null && descriptor != null)","rationale":"this invariant is consistent with the condition in method implementation","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassWriter#visitOuterClass(String,String,String):void","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:47.653374321Z"}
{"id":"2290d144-5a73-4f6b-b78a-4d76a34857f4","expr":"owner != null","rationale":"the method is dealing with an outer class, so owner should be non-null","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassWriter#visitOuterClass(String,String,String):void","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:47.653374321Z"}
{"id":"85062c7a-3518-41d0-8801-b886d18e0e39","expr":"descriptor != null","rationale":"The descriptor string must be non-null to create an annotation.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassWriter#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:48.056826967Z"}
{"id":"83f0feee-1fc7-47c0-b6a1-bf75a70bbfe0","expr":"descriptor.length() > 0","rationale":"The descriptor string likely describes an annotation's type, so it should be non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassWriter#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:48.056826967Z"}
{"id":"cc5b56a0-f029-4afd-9102-ec5385c65f86","expr":"visible == true || visible == false","rationale":"visible is a boolean parameter, must be true or false.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassWriter#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:48.056826967Z"}
