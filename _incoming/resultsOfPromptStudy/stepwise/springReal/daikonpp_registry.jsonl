{"id":"973f4e1d-89de-4e03-82d6-89007bc55a6d","expr":"data == null || !data.contains(\"?>\")","rationale":"The data string should not include the string '?>' as it prematurely ends the processing instruction.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeProcessingInstruction(String,String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T00:37:10.276550008Z"}
