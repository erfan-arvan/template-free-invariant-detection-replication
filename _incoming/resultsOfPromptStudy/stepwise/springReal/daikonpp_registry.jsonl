{"id":"25bd4894-f9fd-4557-8e93-724d9d990080","expr":"className != null && !className.isEmpty()","rationale":"The method requires className to be non-null and it makes sense it is non-empty to represent a class name.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertClassNameToResourcePath(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:05.838648308Z"}
{"id":"cbe80908-7d5e-49cb-bc5e-c7e597b36e57","expr":"!className.contains(\"/\")","rationale":"Class names in Java typically do not contain the '/' character.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertClassNameToResourcePath(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:05.838648308Z"}
{"id":"b1c306a8-0664-4b33-b562-db0d1aac73ba","expr":"className.contains(\".\")","rationale":"Typical fully qualified Java class names contain at least one '.' character.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertClassNameToResourcePath(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:05.838648308Z"}
{"id":"1763109d-5466-489e-874a-2b068558f34e","expr":"className.equals(className.trim())","rationale":"Class names are generally expected not to have whitespace padding.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertClassNameToResourcePath(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:05.838648308Z"}
{"id":"f02d8779-8958-4a60-b543-6a75c2d77f0c","expr":"type != null","rationale":"Method asserts type is not null at entry","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:06.494495959Z"}
{"id":"1eecc254-cbb6-44ab-b7c7-e9028deca988","expr":"value == null || value.getClass() != null","rationale":"If 'value' is not null, then 'value.getClass()' is defined and not null","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:06.494495959Z"}
{"id":"ab7dc878-505c-4e5e-8ba0-264918f75c04","expr":"!type.isPrimitive() || value != null","rationale":"According to method logic, if 'value' is null then 'type' is not primitive","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:06.494495959Z"}
{"id":"3a8d1de5-adca-4190-a148-9c1eb7733b1d","expr":"value == null || (type.isAssignableFrom(value.getClass()))","rationale":"The method calls isAssignable(type, value.getClass()) if value is not null; thus at this point, if value is non-null, then type may be assignable from value.getClass()","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:06.494495959Z"}
{"id":"67d9a1d8-4100-4913-8bce-c479670ae8ea","expr":"type.isPrimitive() == false || value != null","rationale":"Reflecting similar nullability constraint for 'type.isPrimitive' and 'value'","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:06.494495959Z"}
{"id":"3faa1afa-ad6f-459d-b659-1ffd9cac5667","expr":"resourceName != null && !resourceName.isEmpty() && !resourceName.startsWith(\"/\") || resourceName.startsWith(\"/\")","rationale":"At method entry, resourceName is non-null as checked by Assert, and it may or may not start with '/'.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#addResourcePathToPackagePath(Class<?>,String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:07.705375289Z"}
{"id":"8a9d4eb2-2b49-466e-a992-919e764c6847","expr":"clazz != null","rationale":"The parameter clazz should be non-null for correct operation of the method.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#addResourcePathToPackagePath(Class<?>,String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:07.705375289Z"}
{"id":"ad35da4f-8386-4602-9dc5-1f7ddc8c9ccf","expr":"resourceName.length() > 0","rationale":"Since resourceName must not be null and make sense as a resource path, it should be non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#addResourcePathToPackagePath(Class<?>,String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:07.705375289Z"}
{"id":"a617a1c7-1656-4e7b-9e33-aeb6ec450dcc","expr":"resourceName.startsWith(\"/\") == false || resourceName.startsWith(\"/\")","rationale":"This is a trivial invariant capturing that resourceName either starts with '/' or not.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#addResourcePathToPackagePath(Class<?>,String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:07.705375289Z"}
{"id":"a6f61358-1376-4309-99eb-ffde8b4dc55b","expr":"result.contains(resourceName)","rationale":"Result always includes resourceName appended to classPackageAsResourcePath(clazz) (with or without path separator).","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#addResourcePathToPackagePath(Class<?>,String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:07.978493385Z"}
{"id":"ef33c85c-68cf-43f6-9330-489112ddbdec","expr":"classes.getName() != null","rationale":"A Class object always has a non-null name.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#classNamesToString(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:08.213373462Z"}
{"id":"d0d22569-2e75-42f5-a310-71fefd94b21d","expr":"!classes.isPrimitive()","rationale":"Typically, classes represent reference types, not primitives.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#classNamesToString(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:08.213373462Z"}
{"id":"874da32a-47ca-4c90-a237-9c37022968a6","expr":"classes.getModifiers() >= 0","rationale":"Modifiers returned by getModifiers() are non-negative integers.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#classNamesToString(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:08.213373462Z"}
{"id":"088cbee4-d60d-4602-8dd9-323ae574c706","expr":"result != null && !result.contains(\".\") == (clazz == null || clazz.getName().lastIndexOf('.') == -1)","rationale":"If clazz is null or its name contains no package separator, result is empty (no dot translated to slashes).","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:08.543602876Z"}
{"id":"2aac4370-95d0-4dc6-84f8-3e875431dc5d","expr":"clazz == null || clazz.getName().startsWith(result.replace('/', '.') + \".\")","rationale":"If clazz is not null, result corresponds to its package name with separators replaced; so clazz.getName() starts with packageName + dot.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:08.543602876Z"}
{"id":"cbd447c9-0893-4d86-a1e2-fb3648b516af","expr":"result.indexOf('.') == -1","rationale":"Result string does not contain '.' because it replaces dots by slashes.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:08.543602876Z"}
{"id":"727de6a8-8798-4e34-8500-1a8e8dc2cdeb","expr":"result.indexOf('/') == -1 == (clazz == null || clazz.getName().lastIndexOf('.') == -1)","rationale":"If clazz is null or no package separator, then result is empty (so no '/').","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:08.543602876Z"}
{"id":"a60ad397-96ed-4842-a0fe-458a50e2afdb","expr":"result.equals(\"\") == (clazz == null || clazz.getName().lastIndexOf('.') == -1)","rationale":"Result is empty if and only if clazz is null or its name has no package separator.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:08.543602876Z"}
{"id":"255bdc7b-4baa-4873-a5fe-c338e46e8fcc","expr":"result != null && !result.isEmpty() || classes.length == 0","rationale":"The returned string representation is non-empty if classes is not empty","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classNamesToString(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:09.502025638Z"}
{"id":"2113a915-e648-4ede-91cc-b8de58552b8e","expr":"!result.contains(\"null\")","rationale":"Since classes should contain non-null Class objects, result does not contain \"null\"","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classNamesToString(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:09.502025638Z"}
{"id":"88ce6964-ebd1-4729-8691-c54cb358adaa","expr":"clazz == null || clazz.getName() != null","rationale":"The name of clazz must be non-null if clazz is non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:10.314506404Z"}
{"id":"e4675085-9a09-4e3e-8ccd-30524acaf54f","expr":"clazz == null || !clazz.getName().isEmpty()","rationale":"Class name is a non-empty string for any non-null clazz.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:10.314506404Z"}
{"id":"886b6d59-e030-45cc-b17b-aeaac16b5f81","expr":"clazz == null || clazz.getName().lastIndexOf('.') >= -1","rationale":"The lastIndexOf call always returns at least -1.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:10.314506404Z"}
{"id":"d45db26a-fd18-4c3c-ad62-210dc64c7899","expr":"clazz == null || clazz.getName().indexOf('/') == -1","rationale":"Class names use dots, not slashes.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:10.314506404Z"}
