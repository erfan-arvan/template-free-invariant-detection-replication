{"id":"6c48f5bf-cbbe-456b-972d-4e5ec43318d2","expr":"name != null && !name.isEmpty()","rationale":"Ensures the method name is a valid non-null, non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:45.588896911Z"}
