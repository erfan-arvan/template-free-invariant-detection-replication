{"id":"56afe6bf-c7bd-4d17-b52e-aac063a7d2b5","expr":"!name.endsWith(\"[]\") || name.length() > 2","rationale":"If name ends with array suffix, it logically must be longer than that suffix.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#forName(String,ClassLoader):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:48.613220195Z"}
