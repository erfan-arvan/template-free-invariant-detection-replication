{"id":"b8c9216e-13c6-4731-b3fb-ee0f5411780b","expr":"jarUrl.getFile().indexOf(\"*/\") >= -1","rationale":"The file component may contain the WAR_URL_SEPARATOR substring which the method uses to distinguish WAR files.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#extractArchiveURL(URL):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-11T00:34:19.524970071Z"}
{"id":"5522bc5f-ea0c-4cf9-a537-b6c9fb5e7883","expr":"jarUrl.getFile().indexOf(\"!\") > 0","rationale":"Jar URLs normally contain a '!' character to separate the archive file path and the internal entry path.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#extractArchiveURL(URL):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-11T00:34:19.524970071Z"}
{"id":"3daac01d-2f0f-499f-ac62-1c02863d65fa","expr":"root != null && relativePath != null && !relativePath.contains(\"#\")","rationale":"Method replaces # in relativePath with %23; at entry, relativePath typically does not contain # to avoid ambiguity.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toRelativeURL(URL,String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-11T00:34:19.651934492Z"}
{"id":"0d737c66-b2a1-4c67-8220-0529358283bf","expr":"root.toString().contains(\"//\")","rationale":"At entry, the root URL string should have the standard URL structure including '//' indicating host part.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toRelativeURL(URL,String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-11T00:34:19.651934492Z"}
{"id":"19d882c7-ea3d-4981-bc93-657510e968e3","expr":"relativePath.length() >= 0","rationale":"relativePath is a String and thus length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toRelativeURL(URL,String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-11T00:34:19.651934492Z"}
{"id":"7cd82569-943b-4acd-8d4d-f2b88ace2c14","expr":"root.toString().startsWith(root.getProtocol() + \":\")","rationale":"The string representation of root must start with the protocol and colon.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toRelativeURL(URL,String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-11T00:34:19.651934492Z"}
{"id":"b240a9cf-28e7-4fd7-89c7-e0ed63cedfff","expr":"root.getProtocol() != null && !root.getProtocol().isEmpty()","rationale":"A valid URL root should have a non-null, non-empty protocol.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toRelativeURL(URL,String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-11T00:34:19.651934492Z"}
{"id":"b2e23f32-2721-45a9-95d2-f63c95eccc16","expr":"result.toURI().isAbsolute() == root.toURI().isAbsolute()","rationale":"The resulting URL has the same absolute/relative status as the root URL, since it's constructed relative to root.","kind":"METHOD_EXIT","element":"org.springframework.util.ResourceUtils#toRelativeURL(URL,String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-11T00:34:20.823493407Z"}
{"id":"db459bd3-1c26-425b-a2d8-99ae4c8cccbe","expr":"result.toString().startsWith(root.toString().substring(0, root.toString().lastIndexOf('/') + 1))","rationale":"Since the new URL is constructed relative to root, its string representation starts with the root URL base path portion.","kind":"METHOD_EXIT","element":"org.springframework.util.ResourceUtils#toRelativeURL(URL,String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-11T00:34:20.823493407Z"}
{"id":"a61269bd-c0ac-4db9-a0a8-4c1eaa24149a","expr":"result.getProtocol().equals(root.getProtocol())","rationale":"The method creates a new URL relative to root, so the protocol is inherited from root.","kind":"METHOD_EXIT","element":"org.springframework.util.ResourceUtils#toRelativeURL(URL,String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-11T00:34:20.823493407Z"}
{"id":"b059799e-145f-4872-a8ad-a4e5438786bc","expr":"messageDigest != null && messageDigest.getAlgorithm() != null && !messageDigest.getAlgorithm().isEmpty()","rationale":"After updating the messageDigest, it should still have a valid algorithm.","kind":"METHOD_EXIT","element":"org.springframework.util.UpdateMessageDigestInputStream#updateMessageDigest(MessageDigest):void","file":"org/springframework/util/UpdateMessageDigestInputStream.java","createdAt":"2026-09-11T00:34:21.603894155Z"}
{"id":"c08990fd-c11c-4f49-a028-24b9632b608d","expr":"messageDigest.getDigestLength() > 0","rationale":"The digest length of the messageDigest should be positive after update.","kind":"METHOD_EXIT","element":"org.springframework.util.UpdateMessageDigestInputStream#updateMessageDigest(MessageDigest):void","file":"org/springframework/util/UpdateMessageDigestInputStream.java","createdAt":"2026-09-11T00:34:21.603894155Z"}
{"id":"c2d45751-2bae-4c3f-8950-df10f9f2d66e","expr":"len >= 0","rationale":"len should represent a non-negative int count of bytes to read.","kind":"METHOD_EXIT","element":"org.springframework.util.UpdateMessageDigestInputStream#updateMessageDigest(MessageDigest,int):void","file":"org/springframework/util/UpdateMessageDigestInputStream.java","createdAt":"2026-09-11T00:34:21.620268076Z"}
{"id":"fc8cf6ae-a829-48c7-9f70-dd081ecc59f2","expr":"messageDigest != null","rationale":"messageDigest must be non-null to safely update it.","kind":"METHOD_EXIT","element":"org.springframework.util.UpdateMessageDigestInputStream#updateMessageDigest(MessageDigest,int):void","file":"org/springframework/util/UpdateMessageDigestInputStream.java","createdAt":"2026-09-11T00:34:21.620268076Z"}
{"id":"fdd4efd1-ab81-48c9-bedb-87d1632d97d7","expr":"messageDigest != null && len >= 0","rationale":"Method expects a non-null MessageDigest and non-negative length","kind":"METHOD_ENTRY","element":"org.springframework.util.UpdateMessageDigestInputStream#updateMessageDigest(MessageDigest,int):void","file":"org/springframework/util/UpdateMessageDigestInputStream.java","createdAt":"2026-09-11T00:34:21.691140011Z"}
{"id":"487ac60e-10b6-4d19-9d89-e7993660dedf","expr":"len == 0 || len > 0","rationale":"Ensuring len is a non-negative integer as per parameter type and likely usage","kind":"METHOD_ENTRY","element":"org.springframework.util.UpdateMessageDigestInputStream#updateMessageDigest(MessageDigest,int):void","file":"org/springframework/util/UpdateMessageDigestInputStream.java","createdAt":"2026-09-11T00:34:21.691140011Z"}
{"id":"603e786b-6361-47b7-aee4-dd4f8d68dbbb","expr":"len >= 0","rationale":"Length parameter cannot be negative as per usual input constraints for reading data","kind":"METHOD_ENTRY","element":"org.springframework.util.UpdateMessageDigestInputStream#updateMessageDigest(MessageDigest,int):void","file":"org/springframework/util/UpdateMessageDigestInputStream.java","createdAt":"2026-09-11T00:34:21.691140011Z"}
{"id":"2b7d273d-49ba-4196-a1fe-1f896aed1569","expr":"messageDigest.getAlgorithm() != null","rationale":"MessageDigest should have an associated algorithm string not null","kind":"METHOD_ENTRY","element":"org.springframework.util.UpdateMessageDigestInputStream#updateMessageDigest(MessageDigest,int):void","file":"org/springframework/util/UpdateMessageDigestInputStream.java","createdAt":"2026-09-11T00:34:21.691140011Z"}
{"id":"5ae0ca4d-d897-45c1-bb07-78335e548e1d","expr":"!(len < 0)","rationale":"len parameter must be non-negative as part of input validation","kind":"METHOD_ENTRY","element":"org.springframework.util.UpdateMessageDigestInputStream#updateMessageDigest(MessageDigest,int):void","file":"org/springframework/util/UpdateMessageDigestInputStream.java","createdAt":"2026-09-11T00:34:21.691140011Z"}
{"id":"7bf8363a-155e-478f-a9a4-a54627344d42","expr":"(pattern == null || str == null) == !result","rationale":"If either pattern or str is null, the method returns false, so result is false only if one of them is null.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatchIgnoreCase(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:23.134969265Z"}
{"id":"8ed3789a-f593-4820-bc36-10949db2fe0f","expr":"pattern != null && str != null || !result || (pattern != null && str != null)","rationale":"If result is true, both pattern and str must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatchIgnoreCase(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:23.134969265Z"}
{"id":"de4a5a93-ff30-4643-a7b8-0c5c2e90bc6d","expr":"pattern != null || str == null || !pattern.isEmpty() || !str.isEmpty()","rationale":"Since method returns false if either parameter is null, at method entry either both could be non-null or one could be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatchIgnoreCase(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:24.240634907Z"}
{"id":"70341697-2460-4b3c-9dc2-637ea7e90835","expr":"(pattern == null) == (str == null)","rationale":"Though method returns false if either is null, this expresses the relationship that if pattern is null, str tends to also be null or vice versa.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatchIgnoreCase(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:24.240634907Z"}
{"id":"7bbe6075-5aaf-4dfc-acae-68e131a7aa90","expr":"pattern == null || pattern.length() >= 0","rationale":"Length of pattern if non-null is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatchIgnoreCase(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:24.240634907Z"}
{"id":"766797ac-d15c-4025-af68-90d03f201152","expr":"str == null || str.length() >= 0","rationale":"Length of str if non-null is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatchIgnoreCase(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:24.240634907Z"}
{"id":"492bd2e0-0735-43dd-aa0a-0256788a1f22","expr":"pattern == null || str == null || !pattern.equalsIgnoreCase(str) || !pattern.contains(\"*\")","rationale":"At method entry, if both strings non-null, pattern may not equal str ignoring case or may not contain '*', capturing possible matches.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatchIgnoreCase(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:24.240634907Z"}
{"id":"71c89a19-ff90-4cb1-8cb0-b4458fb6fdf9","expr":"pattern == null || pattern.length() >= 0","rationale":"pattern must have length property >= 0 if not null","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:24.243385711Z"}
{"id":"2e3be989-9089-422f-80ea-d9285864e615","expr":"str == null || str.length() >= 0","rationale":"str must have length property >= 0 if not null","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:24.243385711Z"}
{"id":"3dc36001-14be-4b74-9f53-c49a0ad15066","expr":"pattern != null && str != null && index >= 0 && index <= str.length()","rationale":"To safely call substring and startsWith methods, pattern and str must be non-null and index must be in valid range [0..str.length()]","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#checkStartsWith(String,String,int,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:24.884254956Z"}
{"id":"8f62f439-7176-467e-80d0-d96cccae90c1","expr":"ignoreCase || pattern.startsWith(str.substring(0, index))","rationale":"If ignoreCase false implies prefix matching by default case","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#checkStartsWith(String,String,int,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:24.884254956Z"}
{"id":"5f11e41a-a6ab-4a66-b94d-8b76add5c2f9","expr":"pattern != null && str != null ? true : true","rationale":"At method entry, both can be null but code returns false if any null; so pattern and str can be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:25.222122078Z"}
{"id":"28c9ede6-0967-4ed3-8563-47f96fc26f28","expr":"ignoreCase == true || ignoreCase == false","rationale":"ignoreCase is a boolean parameter, so it's either true or false.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:25.222122078Z"}
{"id":"6f029d69-b43b-414a-aff6-b5aecb0ee0d2","expr":"pattern == null || str == null || pattern.indexOf('*') >= -1","rationale":"The method uses pattern.indexOf('*'); at entry pattern can be null, otherwise indexOf returns >= -1.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:25.222122078Z"}
{"id":"67274dc4-67b2-4dca-9870-6581c90988f4","expr":"pattern == null || str == null || (pattern.indexOf('*') >= -1 && pattern.indexOf('*') < pattern.length())","rationale":"indexOf returns -1 or an index within the string length.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:25.222122078Z"}
{"id":"860d292a-cf34-4603-b0b6-2ed08e8aa730","expr":"pattern == null || str == null || (ignoreCase && (pattern.equalsIgnoreCase(str) || !pattern.equalsIgnoreCase(str)))","rationale":"At method entry, pattern and str may be equal ignoring case if ignoreCase true.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:25.222122078Z"}
{"id":"f862d3cb-9196-4f9f-a7f3-cd6c00ce60b6","expr":"!result || (pattern.indexOf('*') == -1 ? (ignoreCase ? pattern.equalsIgnoreCase(str) : pattern.equals(str)) : true)","rationale":"If the pattern contains no '*', then result matches equality of pattern and str with respect to ignoreCase.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:25.252356363Z"}
{"id":"f5069cd0-4065-4022-aaaf-06625fc1f532","expr":"result == (pattern.length() == 1 && pattern.charAt(0) == '*') || (pattern.length() == 1 && pattern.charAt(0) == '*' ? true : true)","rationale":"If pattern is exactly '*', the method returns true.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:25.252356363Z"}
{"id":"2f8609a0-27d9-4754-8847-196bab6e3353","expr":"!result || str.length() >= pattern.indexOf('*')","rationale":"If result is true and pattern has '*', str length must be at least position of first '*' to satisfy matching.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:25.252356363Z"}
{"id":"f5b3a3d4-fc17-4e09-9063-b46aa125ad1e","expr":"(pattern == null) == false || result == false","rationale":"The contract states if pattern is null, method returns false; so (pattern == null) implies result == false.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:26.027366381Z"}
{"id":"b73f73a0-4b23-40af-b65a-12c198a431fb","expr":"(str == null) == false || result == false","rationale":"The contract states if str is null, method returns false; so (str == null) implies result == false.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:26.027366381Z"}
{"id":"ab3a5869-e7dc-4ec7-acdf-3c9034866b0f","expr":"pattern != null && str != null || result == false","rationale":"If either pattern or str is null, result is false, so if result is true then both must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:26.027366381Z"}
{"id":"ce342a0e-5b5c-4196-8c79-615cff83ca65","expr":"result == true || (pattern == null || str == null)","rationale":"The result being true implies neither parameter is null due to the method contract.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:26.027366381Z"}
{"id":"f7310c9a-674c-4f84-9ae9-a429bdb8b60e","expr":"result == false || (pattern != null && str != null)","rationale":"Whenever result is true, it must be that pattern and str are non-null based on method contract.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:26.027366381Z"}
{"id":"7f67eb35-32bd-42fe-b1b1-8353888ece27","expr":"result == true || result == false","rationale":"result is a boolean, thus must be true or false.","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#checkStartsWith(String,String,int,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:26.080423033Z"}
{"id":"f0cd4300-b92a-426d-acbe-e16fbb06e6b1","expr":"startIndex >= 0 || str == null || otherStr == null","rationale":"Generally, startIndex is expected to be non-negative since it represents an index in str. Null checks prevent evaluation errors.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#indexOf(String,String,int,boolean):int","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.236044272Z"}
{"id":"9c28ce38-608a-4ac1-934d-743e238f0b8e","expr":"startIndex <= str.length() || str == null","rationale":"startIndex should be within the bounds of str length for valid indexOf operation.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#indexOf(String,String,int,boolean):int","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.236044272Z"}
{"id":"92423bd9-61bb-43bd-b1ec-f4d9ae8c91cb","expr":"otherStr.length() <= str.length() || str == null || otherStr == null","rationale":"It makes no sense to find a substring longer than the containing string.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#indexOf(String,String,int,boolean):int","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.236044272Z"}
{"id":"f85f1d5c-4a3a-45f0-8639-19740ac278af","expr":"str != null && otherStr != null || startIndex >= 0","rationale":"startIndex is meaningful only when str and otherStr are non-null strings.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#indexOf(String,String,int,boolean):int","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.236044272Z"}
{"id":"c2a40234-419b-429c-b38b-b7e7d3137f12","expr":"ignoreCase == true || ignoreCase == false","rationale":"This is a tautology but captures the boolean domain of ignoreCase","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#indexOf(String,String,int,boolean):int","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.236044272Z"}
{"id":"c9cbee52-684f-4e9c-97dc-ae52aa6fe4bf","expr":"patterns == null || patterns.length >= 0","rationale":"Patterns array is either null or non-null with a non-negative length.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String @Nullable [],String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.651804137Z"}
{"id":"538fc3b9-3607-4bf1-9639-19a942de0867","expr":"str == null || str.length() >= 0","rationale":"If str is not null, its length is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String @Nullable [],String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.651804137Z"}
{"id":"66d5ed45-8c67-4698-8fd3-08e6945d35a2","expr":"patterns == null || (patterns.length == 0 || patterns.length > 0)","rationale":"patterns.length will be either zero or greater than zero when patterns is not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String @Nullable [],String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.651804137Z"}
{"id":"d9f9c42d-6e76-4f06-88fa-758503c5daff","expr":"patterns != null || str == null || patterns == null","rationale":"No direct relation between patterns non-null and str nullness at method entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String @Nullable [],String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.651804137Z"}
{"id":"663d7ff6-6653-4055-9493-a48ad482392d","expr":"patterns == null || (!patterns.equals(null))","rationale":"patterns not equal to null if patterns is not null; tautological but valid","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String @Nullable [],String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.651804137Z"}
{"id":"8a6b97f6-7a20-42eb-bdb4-566ef312333e","expr":"patterns == null || patterns.length >= 0","rationale":"patterns is either null or a String array with length >= 0.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatchIgnoreCase(String @Nullable [],String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.823174375Z"}
{"id":"b57a50d2-41e9-4482-b880-d6e4daf870a0","expr":"patterns == null || (patterns.length == 0 || patterns.length > 0)","rationale":"patterns is either null or has a length that is zero or positive.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#simpleMatchIgnoreCase(String @Nullable [],String):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T00:34:27.823174375Z"}
