{"id":"ee87be89-ab67-4fd2-b917-f9c9a88f1e46","expr":"name.length() > 0","rationale":"Non-empty string invariant on name parameter","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#endEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:25.600642037Z"}
