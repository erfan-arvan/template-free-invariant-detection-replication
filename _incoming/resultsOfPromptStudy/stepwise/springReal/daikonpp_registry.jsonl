{"id":"76845a2e-9eb0-4b65-b588-d4b90f67741d","expr":"clazz.getName().equals(classLoader.getClass().getName()) == false","rationale":"The class's name is different from the name of the class loader's class.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:54.631954343Z"}
{"id":"89b7a7fe-c3e2-466d-88db-23042e503d9c","expr":"clazz.getName().contains(\".\")","rationale":"Class names usually have dot separators for package names.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:54.631954343Z"}
{"id":"86128e1e-2916-42c9-bb1b-efaee4ae74ff","expr":"!(classLoader != null && clazz.getClassLoader() == classLoader) || result","rationale":"If clazz.getClassLoader() equals classLoader (and classLoader not null), then result must be true.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isVisible(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:54.766544693Z"}
{"id":"eb1db3b3-2afa-49cd-829b-62d817f07faf","expr":"name == null || name.length() <= 7 || result == null","rationale":"If name is null or longer than 7, result must be null because the method only resolves primitive class names for short strings.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.126669612Z"}
{"id":"d8457b5f-427e-49b7-8b5b-9fc4514d11a3","expr":"result == null || name != null","rationale":"The result class can only be non-null if the input name is non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.126669612Z"}
{"id":"014a878f-8755-4890-8079-60be23311c15","expr":"name != null && name.length() <= 7 || result == null","rationale":"Either name is null or empty or long, or else result is null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.126669612Z"}
{"id":"4c12d41e-3aee-450a-b758-8b42b24725fc","expr":"result == null || result.isPrimitive()","rationale":"If result is non-null, it must correspond to a primitive class.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.126669612Z"}
{"id":"1ec94398-52d4-440e-8885-daf9fce5eb09","expr":"name == null || name.length() <= 7","rationale":"The method only uses the name if it is null or length no more than 7.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.526562959Z"}
{"id":"5d8ba7c8-f8f4-44e8-a124-009bde666718","expr":"result == (clazz != null && classLoader != null && clazz.equals(classLoader.loadClass(clazz.getName())))","rationale":"The return value is true exactly when clazz is loadable by classLoader and loads to the same class.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.529134786Z"}
{"id":"fc0728b1-c22b-4a56-96db-b4a550d3a257","expr":"!result || (clazz != null && classLoader != null)","rationale":"If the method returns true, then clazz and classLoader are non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.529134786Z"}
{"id":"51cd95ad-31e4-4f66-88fe-825b82588b0e","expr":"result == (clazz != null && classLoader != null && clazz.getName() != null)","rationale":"For the method to load the class successfully (and return true), clazz and classLoader must be non-null, and clazz.getName() must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.529134786Z"}
{"id":"0437e4d1-79e4-40f7-bb4a-da53371e1379","expr":"!result || clazz.getName().equals(clazz.getName())","rationale":"If result is true, the class name is equal to itself (trivially true, but expresses expected usage of getName).","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.529134786Z"}
{"id":"d1779762-19ea-48db-8a88-526767bb4af2","expr":"result == false || (clazz.getName().equals(clazz.getName()))","rationale":"The loadable condition implies clazz.getName() is consistent.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.529134786Z"}
{"id":"21f5239d-4a19-4872-bcc8-bcfa1a43a82e","expr":"clazz.isPrimitive() == false","rationale":"Primitive wrappers map keys correspond to wrapper classes, which are not primitive themselves.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.963021055Z"}
{"id":"37505656-c895-43b6-ab79-57beb472ebcd","expr":"!clazz.isPrimitive()","rationale":"Class wrappers are not primitive, so clazz.isPrimitive() is false.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:55.963021055Z"}
{"id":"1b81b9da-eecb-458c-b9ff-89fa642c9ce3","expr":"clazz != null && clazz.isArray() == (clazz.getComponentType() != null)","rationale":"If clazz is an array, its component type is not null and vice versa.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapperArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:57.988376901Z"}
{"id":"fd5bef5b-38e4-4672-a5f7-22819610cd75","expr":"clazz.isArray() == (clazz.getName().startsWith(\"[\") )","rationale":"Array classes start with '[' in their name.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapperArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:57.988376901Z"}
{"id":"33d0d10b-52cb-4a3f-90fa-a6b03b77309d","expr":"clazz.isArray() || !clazz.isArray()","rationale":"Avoid tautologies.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapperArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:57.988376901Z"}
{"id":"b2d8c55e-8ba6-4215-b268-0208b5e117ef","expr":"clazz != null","rationale":"Method asserts that clazz must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveOrWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.110116664Z"}
{"id":"552d89c0-804d-4489-8d77-5aaf17d9aae4","expr":"clazz.isPrimitive() == false || clazz != null","rationale":"Safe to check isPrimitive only if clazz is not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveOrWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.110116664Z"}
{"id":"a685f36a-a3c1-441b-8ff9-cc5be97bd929","expr":"!clazz.isPrimitive() || clazz != null","rationale":"Ensures that isPrimitive call is only evaluated if clazz is not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveOrWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.110116664Z"}
{"id":"d3db3831-e26c-47b3-b654-240e58f80a97","expr":"clazz.isPrimitive() || !clazz.isPrimitive()","rationale":"Represents tautology, but indicates logical domain of isPrimitive.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveOrWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.110116664Z"}
{"id":"43792d3f-89f6-4241-ac21-7880c9248360","expr":"clazz != null && clazz.isArray() == clazz.getComponentType() != null && clazz.getComponentType().isPrimitive() == false || clazz.isArray() == true && clazz.getComponentType().isPrimitive() == true","rationale":"The method asserts clazz is non-null, then uses clazz.isArray() and clazz.componentType().isPrimitive(). Thus, if clazz.isArray() is true, componentType() is non-null, and componentType().isPrimitive() can be called.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.775517935Z"}
