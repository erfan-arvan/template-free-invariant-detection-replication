{"id":"cc81d369-ad2b-4794-ac7b-cb824cc681ab","expr":"maxStack >= 0","rationale":"maxStack as maximum stack size should be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMaxs(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:14.553039157Z"}
{"id":"cdcaff22-4eda-4b2a-b8b4-c98eb0c4974a","expr":"maxLocals >= 0","rationale":"maxLocals as local variable count should be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMaxs(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:14.553039157Z"}
