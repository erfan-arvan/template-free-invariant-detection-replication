{"id":"b4167afa-b9c3-41eb-aabd-1542c1c256b3","expr":"signature == null || !signature.isEmpty()","rationale":"Signature should either be null or a meaningful non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:45.588896911Z"}
