{"id":"3d63fa6d-d003-43de-9b14-c59e12300e0f","expr":"result != null","rationale":"The method returns a non-null AnnotationVisitor reference.","kind":"METHOD_EXIT","element":"org.springframework.asm.ClassWriter#visitTypeAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:49.021410582Z"}
