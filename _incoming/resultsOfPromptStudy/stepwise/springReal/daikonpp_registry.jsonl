{"id":"ccf46963-06f5-4b85-8a7f-e662db87a798","expr":"visible == true || visible == false","rationale":"visible is a boolean with no other possible values.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:53.985438452Z"}
{"id":"ad3adaa4-7f57-46a8-b3a9-dec122f98c77","expr":"desc.length() > 0","rationale":"Descriptor strings should not be empty for annotations.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:53.985438452Z"}
{"id":"5ca6c70f-1293-441d-ae65-6b943aef74f1","expr":"result != null","rationale":"'result' is expected to be a valid AnnotationVisitor (non-null).","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitParameterAnnotation(int,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:54.343707470Z"}
{"id":"1bfa545b-fd01-42ba-823e-23f860bff302","expr":"(result == null) == false","rationale":"Explicit check confirming 'result' is not null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitParameterAnnotation(int,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:54.343707470Z"}
{"id":"1271d6c9-ce79-4649-9280-d0adc03c2bcd","expr":"attr != null && attr.getName() != null && !attr.getName().isEmpty()","rationale":"The visitAttribute method likely requires a valid attribute name.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:54.570935044Z"}
{"id":"1d2dc930-7d3b-499b-b085-1826f5423278","expr":"parameter >= 0","rationale":"In Java, parameter indices are typically non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitParameterAnnotation(int,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:54.830780325Z"}
{"id":"cea9c50d-d348-467f-a1ac-d84dc2c7fb7b","expr":"desc != null","rationale":"The annotation descriptor is expected to be a valid non-null string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitParameterAnnotation(int,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:54.830780325Z"}
{"id":"62460b36-3be4-4b4b-a873-0f25ce59a233","expr":"visible == true || visible == false","rationale":"visible is always boolean, so it can be true or false.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitParameterAnnotation(int,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:54.830780325Z"}
{"id":"f01a5779-e561-4f1b-a00a-1b70c832e744","expr":"attr != null && attr.getName() != null && !attr.getName().isEmpty()","rationale":"attr should be a valid attribute with a non-empty name because it is passed to both mv1 and mv2 visitAttribute methods which likely require a proper attribute.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:55.082546169Z"}
{"id":"33473cea-e636-49f9-abc0-01bd51b6dd26","expr":"opcode >= 0 && opcode <= 255","rationale":"The opcode parameter typically represents JVM instruction opcodes, which are between 0 and 255 inclusive.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitInsn(int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:56.373305484Z"}
{"id":"14e41638-60fa-46df-b86e-ede47879492e","expr":"opcode != 0","rationale":"Opcode 0 generally does not represent a valid JVM instruction, so it is unlikely at method exit.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitInsn(int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:56.373305484Z"}
{"id":"799db36c-4b9b-455d-a109-b058d7d58ecc","expr":"opcode >= 0 && opcode <= 255","rationale":"This limits the opcode to the valid byte range for JVM instructions.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitIntInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:56.622474834Z"}
{"id":"7aa30814-e8af-4d33-9c77-b3b3bc444887","expr":"operand >= -32768 && operand <= 32767","rationale":"operand should be within the signed short range used for int instructions.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitIntInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:56.622474834Z"}
{"id":"0318e41c-a20d-4f0b-9463-dceb12c4f279","expr":"opcode >= 0 && opcode <= 255","rationale":"The opcode is an opcode byte value, so it must be within the range of unsigned byte values.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitIntInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:56.923777314Z"}
{"id":"ff8e6544-5080-456b-9ded-887a865afcf2","expr":"operand >= -32768 && operand <= 32767","rationale":"Operand for IntInsn is typically a signed short value.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitIntInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:56.923777314Z"}
{"id":"d8335054-cd0f-40f8-97b8-7a27224e834a","expr":"opcode != 0","rationale":"Ensures the opcode is not zero, assuming zero is invalid opcode.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitIntInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:56.923777314Z"}
{"id":"8765cbc6-360a-4bb1-9bbb-6bd5cca153aa","expr":"opcode >= 0 && opcode <= 255","rationale":"opcode should be within valid range of Java bytecode instructions","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitInsn(int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:57.255471126Z"}
{"id":"2991d555-2793-4053-a78f-32f2af3e2e11","expr":"opcode != -1","rationale":"opcode should be a valid bytecode opcode, not a sentinel value","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitInsn(int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:57.255471126Z"}
{"id":"e700bd03-44ef-4e08-9a82-af5f67edace3","expr":"opcode == (opcode & 0xFF)","rationale":"opcode fits within a byte, representing the bytecode instruction","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitInsn(int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:57.255471126Z"}
{"id":"49d0e98d-4a94-45b4-a5d9-9fb3c043b876","expr":"(opcode & ~0xFF) == 0","rationale":"opcode is confined to the byte range","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitInsn(int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:57.255471126Z"}
{"id":"9f2c8788-522c-401e-85c4-04b75df3b69b","expr":"opcode >= 0 && opcode <= 255","rationale":"Opcode values usually range from 0 to 255 as they represent bytecodes.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitVarInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:57.938632161Z"}
{"id":"b29c7209-422c-4e63-9c72-3746133d3fd5","expr":"var >= 0","rationale":"The local variable index 'var' must be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitVarInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:57.938632161Z"}
{"id":"cf5ef138-a669-4a28-ac5a-58b0c667c828","expr":"opcode >= 0 && opcode <= 255","rationale":"opcode is usually a JVM bytecode opcode which fits in an unsigned byte range.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitVarInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:58.239200675Z"}
{"id":"b5df5571-41cf-4ec8-8640-62dd69b831ea","expr":"var >= 0","rationale":"Local variable indices in bytecode are non-negative integers.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitVarInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:58.239200675Z"}
{"id":"d6e402de-aae2-48f9-a9ee-139dc9a61f65","expr":"var <= 65535","rationale":"JVM uses 16-bit unsigned indices for local variables.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitVarInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:58.239200675Z"}
{"id":"05ab805b-34b8-4250-a64c-f96c58e13746","expr":"opcode >= 0","rationale":"opcode represents a bytecode instruction code, which is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTypeInsn(int,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:59.268835754Z"}
{"id":"ec338d5b-63ab-4caf-9e56-45d1419b34ad","expr":"opcode != 176","rationale":"opcode is expected to be a type instruction opcode, e.g. NEW, CHECKCAST; it should not be the opcode for RETURN (176).","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTypeInsn(int,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:59.268835754Z"}
{"id":"b59711e2-a553-4a6d-b4f3-9f4abe76917b","expr":"opcode >= 187 && opcode <= 193","rationale":"Ensures opcode is one of the expected JVM type instruction opcodes.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTypeInsn(int,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:59.633101166Z"}
{"id":"9a490039-d4cd-439c-9e54-0c8a58704c33","expr":"desc != null","rationale":"desc must be non-null because it is forwarded to other visitors.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTypeInsn(int,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:59.633101166Z"}
{"id":"544319e0-b83a-4270-a2de-7983df5e9840","expr":"owner != null && !owner.isEmpty()","rationale":"Typically, 'owner' representing the class/internal name is not null and not empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:00.599085334Z"}
{"id":"e2a30bde-a05b-4ff8-9f45-faeb9c4cf518","expr":"name != null && !name.isEmpty()","rationale":"Field name should be non-null and non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:00.599085334Z"}
{"id":"efee40c3-f81e-4212-9b36-bede5cc09288","expr":"desc != null && !desc.isEmpty()","rationale":"Descriptor string should be non-null and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:00.599085334Z"}
{"id":"9005a7ea-5df9-4c89-97ca-ac574c4dc6f7","expr":"opcode >= 178 && opcode <= 181","rationale":"The opcode for visitFieldInsn corresponds to a field instruction opcode within range 178 to 181.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:00.599085334Z"}
{"id":"59f129a5-8021-4a59-bc41-293d2e2c2a53","expr":"!owner.contains(\" \") && !name.contains(\" \") && !desc.contains(\" \")","rationale":"owner, name, and desc should not contain spaces for valid field names and descriptors.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:00.599085334Z"}
{"id":"fb25d486-dece-478b-8d9a-801844441301","expr":"owner != null && !owner.isEmpty()","rationale":"owner usually represents a class name, which should be a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:01.124874973Z"}
{"id":"caf19844-bdfc-4562-b8ab-7e8cd948c082","expr":"name != null && !name.isEmpty()","rationale":"Method name should be a valid non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:01.124874973Z"}
{"id":"d06a8d36-b40a-4d81-b899-9eaa4f547e08","expr":"desc != null && !desc.isEmpty()","rationale":"Method descriptor should not be null or empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:01.124874973Z"}
{"id":"a5bb69d8-5430-4c02-ba55-4d9d60dc6213","expr":"opcode >= 0","rationale":"opcode is expected to be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:01.124874973Z"}
{"id":"d50fd48d-a016-4acd-a328-e0c9a016d77c","expr":"(opcode >= 0 && opcode <= 255)","rationale":"opcode likely represents an opcode value bounded by byte range.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:01.124874973Z"}
{"id":"621e7e60-7e03-4892-8ca1-b6aed8922e70","expr":"label != null","rationale":"The label parameter is expected to be non-null as it is used to indicate a jump target.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitJumpInsn(int,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:02.158417511Z"}
{"id":"fddfe0f2-a7b9-47e6-99fa-94a984d7f0f9","expr":"owner != null && !owner.isEmpty()","rationale":"The 'owner' string denotes the class or interface name where the field is declared, expected to be a valid non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:02.231633434Z"}
{"id":"6f13cc6b-2811-47c1-9c45-08d897c4ac98","expr":"name != null && !name.isEmpty()","rationale":"The 'name' represents the field name, which should be a valid, non-empty identifier string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:02.231633434Z"}
{"id":"8237612e-d4c2-44cd-b836-f591a1e94ed0","expr":"desc != null && desc.startsWith(\"[\") == false","rationale":"The descriptor should be a valid JVM field descriptor string and is often non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:02.231633434Z"}
{"id":"911a7cfb-0be4-4cc6-8bcf-d51c0c73b8be","expr":"opcode >= 178 && opcode <= 181","rationale":"VisitFieldInsn is called for field-related opcodes defined in the JVM spec (178 to 181).","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:02.231633434Z"}
{"id":"42dde33c-d0bc-455c-a068-b3ccef32abc5","expr":"owner != null && !owner.isEmpty() && name != null && !name.isEmpty() && desc != null && !desc.isEmpty() && (opcode >= 0)","rationale":"The method passes opcode, owner, name, desc to another method, suggesting they are non-null and meaningful strings with opcode >= 0.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:02.563567490Z"}
{"id":"bfdea896-9bc6-42f8-bef5-8d07098d71a2","expr":"owner.indexOf('/') >= 0","rationale":"In JVM bytecode, the owner usually represents an internal name with slashes, so it likely contains '/'. ","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:02.563567490Z"}
{"id":"9723bdc7-db4b-4d7f-a350-5cb2d9351381","expr":"desc.startsWith(\"(\") && desc.endsWith(\")\")","rationale":"Standard JVM method descriptors start with '(' followed by argument types and end with ')' before the return type.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:02.563567490Z"}
{"id":"3e1c63ea-08c2-4765-9b14-9b0c01f91133","expr":"desc.length() > 2","rationale":"A valid method descriptor has minimum length to encode return type in JVM format.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:02.563567490Z"}
{"id":"ae13309d-20a6-4976-bb6a-bb6c37dc1776","expr":"owner != null && !owner.isEmpty() && owner.indexOf('/') >= 0","rationale":"In JVM bytecode, the owner parameter usually denotes a class name in internal form, which includes '/' characters.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:03.445213802Z"}
{"id":"72bccc64-df1f-4124-b722-4bc9781abdc7","expr":"name != null && !name.isEmpty()","rationale":"A method name passed to visitMethodInsn must be a valid non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:03.445213802Z"}
{"id":"f0e45e19-90ad-4045-95b1-fddcbd65575c","expr":"desc != null && desc.startsWith(\"(\") && desc.endsWith(\")\")","rationale":"A method descriptor in JVM bytecode specifies argument types enclosed in parentheses.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:03.445213802Z"}
{"id":"cf359a2e-ab73-41b8-b99b-4353471cc344","expr":"!itf || (owner != null && owner.indexOf('/') >= 0)","rationale":"The itf parameter is true if the owner is an interface; thus owner should be a valid internal class name.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:03.445213802Z"}
{"id":"74138db7-e4cf-46b8-baad-9f3ddf43e92f","expr":"label != null","rationale":"Since label is passed to mv1.visitJumpInsn and mv2.visitJumpInsn, it must be non-null to avoid NullPointerException.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitJumpInsn(int,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:03.628683342Z"}
{"id":"61555455-4373-42ff-95be-1521e539aa26","expr":"opcode >= 0","rationale":"Opcodes are generally non-negative values representing instruction codes.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitJumpInsn(int,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:03.628683342Z"}
{"id":"61119357-f1d1-4c5b-b27a-1489763eb9fd","expr":"var >= 0","rationale":"In bytecode instructions, variable indices are non-negative integers, so var is typically >= 0.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitIincInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:05.237358691Z"}
{"id":"0888afab-b804-4773-bc28-685c2506802e","expr":"increment != 0","rationale":"To actually perform an increment operation, 'increment' is generally expected to be non-zero.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitIincInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:05.237358691Z"}
{"id":"9496fd64-f9ff-4447-9931-d533fcf518d1","expr":"cst != null || cst == null","rationale":"At method entry, cst can be any Object including null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLdcInsn(Object):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:05.352176837Z"}
{"id":"320cfc9f-2ea4-4ee5-aa6f-34f7ad7271f5","expr":"owner != null && name != null && desc != null && (itf || !itf)","rationale":"Parameters owner, name, desc are used in method calls, indicating they are likely non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:05.668335062Z"}
{"id":"6b54cec1-f1cb-4a24-a166-c3d38a521ead","expr":"opcode >= 0","rationale":"Opcode is an opcode parameter, which is non-negative integer.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:05.668335062Z"}
{"id":"8e03b9b0-57a7-4bc8-b6f4-1faac243eabb","expr":"desc.startsWith(\"(\")","rationale":"The desc string is a method descriptor, which typically starts with '('.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:05.668335062Z"}
{"id":"4dc7b424-0bca-41f4-8451-b1300af13f82","expr":"name.length() > 0","rationale":"Method name should be a non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:05.668335062Z"}
{"id":"59d70c87-56c6-4f85-87b2-a0af4d9246f1","expr":"cst != null || cst == null","rationale":"cst can be any object including null, no restriction known","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLdcInsn(Object):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:06.454414261Z"}
{"id":"4eb0799a-6015-4e98-8d6b-512a79bdbcee","expr":"cst == null || cst != null","rationale":"cst may be null or non-null, no constraint","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLdcInsn(Object):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:06.454414261Z"}
{"id":"f4b9c695-a777-42fc-a8f8-8762652229dd","expr":"increment != 0 || increment == 0","rationale":"increment can be any integer; trivial.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitIincInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:07.088896159Z"}
{"id":"c5d11eac-3bc7-4151-919e-851251cd5bf5","expr":"var >= 0 || var < 0","rationale":"var can be any integer; trivial.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitIincInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:07.088896159Z"}
{"id":"0c43399b-e259-4199-8d83-349b192d7615","expr":"min <= max && labels != null && labels.length == (max - min + 1)","rationale":"In a table switch instruction, labels correspond to each integer between min and max inclusive.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:07.345660712Z"}
{"id":"7bd89102-f583-4060-858a-b98c43f7ac11","expr":"dflt != null","rationale":"The default label is the fallback target if the value is out of the min-max range.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:07.345660712Z"}
{"id":"9413b815-d4bc-4852-9cf7-19aaeb717cc0","expr":"labels != null && labels.length == (max - min + 1)","rationale":"The labels array length matches the range size.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:07.611670945Z"}
{"id":"3c961b64-ff44-48e5-bfd8-d7cd0d4c6250","expr":"max >= min","rationale":"The max value is greater or equal to min, defining a valid range.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:07.611670945Z"}
{"id":"c5420925-9882-470a-90c1-7b00e1f36ea4","expr":"dflt != null","rationale":"The default label for the switch is non-null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:07.611670945Z"}
{"id":"067b16df-ce91-44c8-9fca-4a2364217be1","expr":"keys != null && labels != null && keys.length == labels.length + 1","rationale":"The method visitLookupSwitchInsn expects keys and labels arrays where keys.length == labels.length.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:09.231863994Z"}
{"id":"fa8528c5-c897-4c42-9c5a-dfde790ca1ec","expr":"dflt != null","rationale":"The default label should not be null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:09.231863994Z"}
{"id":"29c7dc9f-d529-4d64-92d1-22dde40530ba","expr":"keys.length == labels.length","rationale":"Typically number of keys equals number of labels.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:09.231863994Z"}
{"id":"640aaf17-2562-4d91-a301-60c9c93e4c6b","expr":"keys.length >= 0","rationale":"Keys array length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:09.231863994Z"}
{"id":"0333dc24-c7ff-4bb6-a519-6818c29c5ebe","expr":"labels.length >= 0","rationale":"Labels array length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:09.231863994Z"}
{"id":"1041db45-d9f9-4c63-a4f5-6a8aa5aa44eb","expr":"keys != null && labels != null && labels.length == keys.length + 1","rationale":"In a lookup switch, the labels array length should be one more than keys array length to account for the default label.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:09.534546821Z"}
{"id":"9f9fc467-8f1e-4438-ac64-0577f64ee852","expr":"dflt != null","rationale":"The default label in a lookup switch case must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:09.534546821Z"}
{"id":"2a3fb130-f7e1-4cfa-a6aa-0eb2849f940c","expr":"dims >= 0","rationale":"Number of dimensions cannot be negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:09.584302151Z"}
