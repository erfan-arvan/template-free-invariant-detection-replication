{"id":"65bd1786-4970-4637-b630-87d622c6e421","expr":"data != null","rationale":"No modifications to data are made; assume it was passed as is.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#processingInstructionInternal(String,String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:21.247031610Z"}
