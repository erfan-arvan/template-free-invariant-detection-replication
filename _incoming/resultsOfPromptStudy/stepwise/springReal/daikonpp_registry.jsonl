{"id":"3e43586d-e724-4b65-a135-4969847126f3","expr":"name != null && !name.isEmpty()","rationale":"Local variable names should be valid non-empty strings.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:14.171016862Z"}
{"id":"98f6a7aa-c725-4a6c-8e5b-b5e140634dbe","expr":"desc != null && !desc.isEmpty()","rationale":"Descriptor string must be non-null and non-empty to represent a valid type.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:14.171016862Z"}
{"id":"549a62b2-f838-4d24-a0df-68e22a09b958","expr":"start != null && end != null","rationale":"Start and end labels must be non-null to indicate variable lifetime range.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:14.171016862Z"}
{"id":"4daa7980-7739-4e8d-b012-c49c32c8c1ba","expr":"index >= 0","rationale":"Index should be zero or positive as it indicates a local variable slot.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:14.171016862Z"}
{"id":"273e13b0-948f-4929-951b-d7899938940f","expr":"(signature == null || signature.isEmpty()) || signature.length() > 0","rationale":"Signature is optional and if present must be a valid string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:14.171016862Z"}
{"id":"8855ace5-ef5d-43ed-9eba-99241869c546","expr":"line > 0","rationale":"Line number represents source code line, which is positive in typical cases.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLineNumber(int,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:14.216050135Z"}
