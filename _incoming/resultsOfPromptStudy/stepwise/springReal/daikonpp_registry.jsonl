{"id":"95e7dc1a-71a8-4b1a-94e1-778532d8d11c","expr":"target != null && !target.isEmpty()","rationale":"The 'target' string should be non-null and non-empty as it is used to create a processing instruction.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeProcessingInstruction(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T00:37:09.544765708Z"}
{"id":"cd4c8b57-4ec7-446f-8927-97f002be1ad6","expr":"target != null && !target.isEmpty()","rationale":"The target parameter for a processing instruction should be a valid non-empty string to comply with XML standards.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeProcessingInstruction(String,String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T00:37:10.276550008Z"}
