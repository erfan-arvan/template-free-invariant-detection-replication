{"id":"fc3dae57-53e9-41e3-b08b-17a310d8a7c6","expr":"index >= 0","rationale":"Index parameter is likely used as an attribute position, so it should be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractXMLStreamReader#getAttributePrefix(int):String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-11T00:37:27.714715027Z"}
