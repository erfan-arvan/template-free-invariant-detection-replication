{"id":"af8d15a7-841e-4978-bcc5-8bf24940d9f4","expr":"oldValue >= Character.MIN_VALUE && oldValue <= Character.MAX_VALUE","rationale":"oldValue is a char, its value is always within char range bounds.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#readChar(Object,String,char):char","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:53.941450902Z"}
