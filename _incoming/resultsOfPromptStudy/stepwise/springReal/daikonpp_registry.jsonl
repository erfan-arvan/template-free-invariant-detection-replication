{"id":"2c4bbfaa-510e-4471-ac5c-8848800f3f27","expr":"obj != null || obj == null","rationale":"No constraints on obj nullity, can be any object or null","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeFloat(Object,String,float,float):float","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:49.959037864Z"}
