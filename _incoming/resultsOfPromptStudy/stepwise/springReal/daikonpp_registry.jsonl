{"id":"e0ad23f8-6aa8-4da0-94bb-6eb568cbf83e","expr":"target.indexOf(' ') == -1","rationale":"Ensures the 'target' string contains no spaces as the XML target token must not include whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeProcessingInstruction(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T00:37:08.703867115Z"}
