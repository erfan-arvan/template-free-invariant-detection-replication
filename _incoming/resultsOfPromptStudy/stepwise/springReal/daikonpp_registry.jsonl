{"id":"21cf76e7-f78c-41d6-9246-82fd9fb51125","expr":"!result || ifc.isInterface()","rationale":"If result is true, ifc must be an interface.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isJavaLanguageInterface(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:20.182891020Z"}
{"id":"7aae9009-e163-4946-8b6d-2691e5bc1ad2","expr":"clazz.isMemberClass() == (clazz.getEnclosingClass() != null)","rationale":"Member classes have a non-null enclosing class.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isStaticClass(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:20.250691104Z"}
