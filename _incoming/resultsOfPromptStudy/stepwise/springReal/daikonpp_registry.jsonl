{"id":"98a79c8d-412c-4b9c-a875-91d5c63859f6","expr":"result == (className != null && className.length() > 0)","rationale":"Result depends on className validity.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPresent(String,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:50.997288161Z"}
{"id":"b07b7d38-2002-411a-8918-b6d95cb3e726","expr":"className != null && !className.isEmpty()","rationale":"The method is intended to check presence of a class given by className, so className should be non-null and not empty at method entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPresent(String,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:51.065672378Z"}
{"id":"f10877d0-d2c8-4b68-87c2-7b3b6a764001","expr":"className != null && className.indexOf(' ') == -1","rationale":"Class names should not contain spaces, so this invariant checks for absence of whitespace character.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPresent(String,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:51.065672378Z"}
