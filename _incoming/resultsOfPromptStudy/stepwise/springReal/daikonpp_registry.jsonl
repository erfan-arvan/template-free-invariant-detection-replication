{"id":"04febefc-7b92-4a31-80ee-a25ad13ec6f0","expr":"name != null && name.getNamespaceURI() != null && !name.getNamespaceURI().isEmpty()","rationale":"QName 'name' typically represents an XML element name, which must have a non-empty namespace URI.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#endElementInternal(QName,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:16.856489991Z"}
{"id":"385a57ad-7506-480d-845b-9fcbe95d0d03","expr":"namespaceMapping != null","rationale":"The namespaceMapping parameter should be non-null as it holds relevant XML namespace declarations.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#endElementInternal(QName,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:16.856489991Z"}
{"id":"9ce06f1f-7046-468d-8240-be75f12a59fe","expr":"name.getLocalPart() != null && !name.getLocalPart().isEmpty()","rationale":"The local part of 'name' must be a non-null, non-empty string representing the XML element name.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#endElementInternal(QName,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:16.856489991Z"}
{"id":"41172113-ddeb-4b90-81ee-7fbddf91eddc","expr":"namespaceMapping.containsKey(name.getPrefix()) || !namespaceMapping.containsKey(name.getPrefix())","rationale":"No assumptions about mapping from name prefix to namespaceMapping; either is possible.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#endElementInternal(QName,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:16.856489991Z"}
{"id":"50184dd8-13d8-4397-a25c-028b380982b2","expr":"data != null && !data.isEmpty()","rationale":"data is expected to be a non-null, non-empty string to be written by streamWriter.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#charactersInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:17.993738464Z"}
{"id":"0c8edb87-a0d6-4d53-bb16-141e0641020d","expr":"data == null || data.length() <= 1000","rationale":"The input data string is expected to be reasonably sized, not excessively long.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#charactersInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:17.993738464Z"}
{"id":"8ad8963c-3092-44b0-81f9-965090624d9f","expr":"data != null && data.length() >= 0","rationale":"The 'data' parameter is passed directly to writeCharacters, implying 'data' is not null and its length is non-negative.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#charactersInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:18.182452103Z"}
{"id":"32417ce4-12d1-4600-8a83-818a3605a7e7","expr":"data != null && !data.isEmpty()","rationale":"Since writeCData usually writes meaningful content, it's likely the data is non-null and not empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#cDataInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:18.987335685Z"}
{"id":"1587f158-9585-469f-8abd-31dc9fb3a6cc","expr":"data.length() > 0","rationale":"It's expected that data passed to writeCData has positive length.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#cDataInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:18.987335685Z"}
