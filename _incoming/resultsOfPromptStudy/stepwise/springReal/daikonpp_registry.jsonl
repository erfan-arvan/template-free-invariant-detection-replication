{"id":"5cdbb298-c1c6-43b7-b2b2-cf357ccb35de","expr":"line != null && line.startsWith(\"--\") && line.endsWith(\">\")","rationale":"The XML end comment likely involves lines starting with '--' and ending with '>'.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XmlValidationModeDetector#endComment(String):int","file":"org/springframework/util/xml/XmlValidationModeDetector.java","createdAt":"2026-09-11T00:36:20.900359058Z"}
{"id":"277851b9-8d62-4dd9-a2ee-0bff180d8ebc","expr":"line != null && !line.isEmpty()","rationale":"The method likely expects a non-empty line to process comments.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XmlValidationModeDetector#endComment(String):int","file":"org/springframework/util/xml/XmlValidationModeDetector.java","createdAt":"2026-09-11T00:36:20.900359058Z"}
