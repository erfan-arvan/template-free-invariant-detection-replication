{"id":"3fcf3f94-8d2a-4349-8472-9e7d28c22c72","expr":"className != null && !className.isEmpty()","rationale":"Typically, resolveClassName is called with a non-null, non-empty className to find the class.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolveClassName(String,ClassLoader):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:49.921540262Z"}
{"id":"40261f16-c326-40bc-a4b0-accc24cb521c","expr":"classLoader == null || classLoader.getParent() != null || classLoader.getParent() == null","rationale":"classLoader may or may not have a parent ClassLoader.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolveClassName(String,ClassLoader):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:49.921540262Z"}
{"id":"e3a13a65-715a-4746-90cf-67d64bfce737","expr":"className.indexOf(' ') == -1","rationale":"A valid className typically does not contain spaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolveClassName(String,ClassLoader):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:49.921540262Z"}
{"id":"b0421cf0-bc59-4839-85e7-b574a98da975","expr":"className.contains(\".\") || className.indexOf('$') >= 0","rationale":"The className string usually contains package separator '.' or inner class separator '$'.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolveClassName(String,ClassLoader):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:49.921540262Z"}
{"id":"3b8b31e9-4b30-4a1b-be0f-16a083821caf","expr":"result != null && result.getName().equals(className)","rationale":"The returned Class<?> corresponds to the class specified by className, so its name equals className.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolveClassName(String,ClassLoader):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:50.094966129Z"}
{"id":"b53dca1d-678f-45c7-89e1-bd29f316b671","expr":"classLoader == null || classLoader.getParent() != null || result == false","rationale":"ClassLoader null or parenting affects class loading; failure affects result.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPresent(String,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:50.997288161Z"}
