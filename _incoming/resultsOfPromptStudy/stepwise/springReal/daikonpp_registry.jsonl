{"id":"6dd623ac-5ce6-4540-9275-624c2831b7b8","expr":"name != null && !name.isEmpty()","rationale":"name is likely a non-empty string representing a field name.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeObject(Object,String,Object,Object):Object","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:51.858725761Z"}
{"id":"e534bef2-eeb3-427a-9f50-5807e1938948","expr":"oldValue == null || !oldValue.equals(newValue)","rationale":"oldValue and newValue are either both null or different objects.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeObject(Object,String,Object,Object):Object","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:51.858725761Z"}
{"id":"d7ea03e2-0f3b-47e7-b01c-1306e080f75d","expr":"obj != null","rationale":"obj parameter is not null at method entry.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeObject(Object,String,Object,Object):Object","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:51.858725761Z"}
{"id":"84233890-fba4-495b-8115-d15249810976","expr":"obj != null || name != null || true","rationale":"obj and name are method parameters, they can be independently null or non-null. No constraint forces them both to be null simultaneously.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeLong(Object,String,long,long):long","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:52.031886244Z"}
{"id":"c4954fa1-bd61-4ed5-8934-f31532e30360","expr":"name != null || obj != null || true","rationale":"Since name is a parameter, it can be null or non-null, no constraint implies a relation with obj.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeLong(Object,String,long,long):long","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:52.031886244Z"}
{"id":"898358ff-3ef8-4e1f-916c-8a23d70dbb6e","expr":"oldValue != newValue || true","rationale":"oldValue and newValue are separate long parameters; there is no imposed relation before execution.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeLong(Object,String,long,long):long","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:52.031886244Z"}
{"id":"34963e99-724b-42bc-afea-1b6dae0d24fe","expr":"result == newValue","rationale":"Result must always equal newValue since method returns newValue.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeDouble(Object,String,double,double):double","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:52.166651519Z"}
