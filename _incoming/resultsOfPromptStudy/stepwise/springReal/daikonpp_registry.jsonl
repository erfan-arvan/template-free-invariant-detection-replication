{"id":"c33a2d0c-bccb-4a95-8f1b-30b0d2ded756","expr":"name.getNamespaceURI() != null","rationale":"Namespace URI used in writeStartElement, assumed non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#startElementInternal(QName,Attributes,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:15.900180536Z"}
{"id":"8e6864ae-fc9c-4d23-a08c-de2e8a0390ec","expr":"attributes.getLength() >= 0","rationale":"Attributes length should be zero or positive.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#startElementInternal(QName,Attributes,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:15.900180536Z"}
{"id":"1cf9e587-8fa7-457b-85ed-157271ff8169","expr":"name != null && name.getPrefix() != null && name.getLocalPart() != null && name.getNamespaceURI() != null","rationale":"The method calls methods on name without null checks, so name and its components must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#startElementInternal(QName,Attributes,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:16.017359418Z"}
