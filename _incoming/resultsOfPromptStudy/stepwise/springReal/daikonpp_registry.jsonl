{"id":"0e8a23ee-287c-4e9c-99b5-39a6fe533c3f","expr":"str == null || str.length() >= 0","rationale":"String length is always non-negative if str is not null","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleString(String):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:00.342990861Z"}
{"id":"9ffaba62-c1e2-40e6-a586-aeea8dc62c44","expr":"str == null || str.isEmpty() || !str.isEmpty()","rationale":"str can be empty or non-empty string or null","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleString(String):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:00.342990861Z"}
{"id":"1cc4c245-2573-4b1e-89b2-af9a57892dc6","expr":"str == null || str.contains(\"\\\"\") == false","rationale":"no guarantee about content of str","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleString(String):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:00.342990861Z"}
{"id":"7b49352e-0e4f-4159-818a-3ad1d305147a","expr":"result != null && !result.isEmpty()","rationale":"The method returns a styled representation of the class; typically non-null and non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleClass(Class<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:01.956016133Z"}
{"id":"983d45bf-619a-47b5-8224-5866ed6b7e91","expr":"result.equals(clazz.getName()) || result.equals(clazz.getSimpleName()) || result.equals(clazz.getCanonicalName())","rationale":"The result of styling the class is often one of the class standard names.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleClass(Class<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:01.956016133Z"}
{"id":"6001f662-a1f9-4066-bb8c-ea8a526178c8","expr":"result.length() <= clazz.getName().length()","rationale":"The styled string length is less than or equal to the full class name length.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleClass(Class<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:01.956016133Z"}
{"id":"84537766-0a93-416e-a234-8d4d0ff6a282","expr":"clazz.isPrimitive() == false || (clazz.isPrimitive() && clazz.getName().length() > 0)","rationale":"Primitive classes have valid names, so their name length is greater than zero.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleClass(Class<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:02.071345173Z"}
{"id":"9f999260-9b41-4bad-a73d-d11997782602","expr":"clazz.getSimpleName() != null && clazz.getSimpleName().length() >= 0","rationale":"This invariant captures the expected valid returned strings from getSimpleName.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleClass(Class<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:02.071345173Z"}
{"id":"8379c3bc-9976-4da7-a240-bba2c51e6089","expr":"clazz.getCanonicalName() == null || clazz.getCanonicalName().length() > 0","rationale":"Some classes (like local or anonymous) have null canonical names but when defined, it's a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleClass(Class<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:02.071345173Z"}
{"id":"87351e4c-2e4b-4c4b-870d-ce36b9635fd6","expr":"clazz.getPackage() == null || clazz.getPackage().getName().length() > 0","rationale":"Packages have non-empty names when defined.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleClass(Class<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:02.071345173Z"}
{"id":"e1754214-9e9c-4e6a-9767-cfea887e2a9d","expr":"method != null && method.getName() != null && !method.getName().isEmpty()","rationale":"method.getName() is expected to be a valid method name string.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleMethod(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:02.469170775Z"}
{"id":"5df01b89-4d24-447f-9521-beb5ba0db65f","expr":"method.getParameterCount() >= 0","rationale":"getParameterCount() returns the count of parameters, which cannot be negative.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleMethod(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:02.469170775Z"}
{"id":"2d082e78-03be-4383-8c73-30c86f260b3b","expr":"method.getReturnType() != null","rationale":"getReturnType() should always return a Class object.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleMethod(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:02.469170775Z"}
{"id":"979a7cb4-58e7-439b-91cf-fbb31b6e63d8","expr":"method.getDeclaringClass() != null","rationale":"Declaring class of a method cannot be null.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleMethod(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:02.469170775Z"}
{"id":"3ec17da7-01f1-426c-b97a-218721f32b36","expr":"method.getModifiers() >= 0","rationale":"Modifiers flags are non-negative integers.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleMethod(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:02.469170775Z"}
{"id":"f6360142-b122-477a-9dc1-575f568dd357","expr":"result != null && !result.isEmpty() && result.length() > 0","rationale":"The method returns a styled string representation of the Method, so the result is expected to be a non-null, non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleMethod(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:03.261708100Z"}
{"id":"aa167b1d-551e-4dba-b989-9ee16efb59c4","expr":"result.startsWith(method.getName())","rationale":"Usually the styled string of a method begins with the method's name, so result starts with method.getName().","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleMethod(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:03.261708100Z"}
{"id":"5638b874-6b58-4c9c-bd84-59df0c2cd8e4","expr":"result.contains(\",\") || map.size() <= 1","rationale":"If the map has zero or one entry, no commas are in the result string; if multiple, commas separate entries.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleMap(Map<K, V>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:04.768369552Z"}
{"id":"f2cabad8-69e1-4248-859b-d813c4938237","expr":"collection != null && !collection.contains(null)","rationale":"The method iterates over the collection's elements to style them, so the collection must not be null and is expected not to contain null elements for correct operation.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleCollection(Collection<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:05.011016121Z"}
{"id":"0897634b-264c-4510-8397-ef9434b8b9e7","expr":"collection.size() >= 0","rationale":"The collection has a non-negative size.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleCollection(Collection<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:05.011016121Z"}
{"id":"87403960-096f-4b19-9d49-607abb25ee8f","expr":"collection.isEmpty() == (collection.size() == 0)","rationale":"isEmpty() is true if and only if size() is zero.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleCollection(Collection<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:05.011016121Z"}
{"id":"efa76c1b-d28e-444c-bb20-14b844cd208b","expr":"collection.iterator().hasNext() == !collection.isEmpty()","rationale":"The iterator's hasNext() method reflects if the collection is empty or not.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleCollection(Collection<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:05.011016121Z"}
{"id":"84769425-001f-487d-8c17-ece0ebb0a9b6","expr":"result.startsWith(\"[\") && result.endsWith(\"]\")","rationale":"The method uses StringJoiner initialized with prefix '[' and suffix ']', so the result string must start and end with these characters.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleCollection(Collection<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:06.930075374Z"}
{"id":"57777eb3-881a-47e1-9e09-92fa8743de83","expr":"result.contains(\", \") || collection.isEmpty()","rationale":"If the collection size is more than one, the result string contains the delimiter \", \"; if empty, the result string doesn't contain delimiter.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleCollection(Collection<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:06.930075374Z"}
{"id":"e05cc904-fe55-4fdd-beab-6a0739de96a1","expr":"result.length() >= 2","rationale":"The returned string must be at least \"[]\" which has length 2.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleCollection(Collection<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:06.930075374Z"}
{"id":"4276c7a2-5488-4f96-b04b-176b695e76bc","expr":"collection.isEmpty() == (\"[]\".equals(result))","rationale":"The result is exactly \"[]\" if and only if the collection is empty.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleCollection(Collection<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:06.930075374Z"}
{"id":"906d09bc-4e11-4f1f-9e49-f8e42f6c6eec","expr":"!collection.isEmpty() || result.equals(\"[]\")","rationale":"The result string is \"[]\" only when the collection is empty.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleCollection(Collection<?>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:06.930075374Z"}
{"id":"adc11ac3-21c5-476e-ad80-26532370b67f","expr":"map.size() >= 0","rationale":"Map size is always non-negative as per Map interface contract.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleMap(Map<K, V>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:06.989895139Z"}
{"id":"06b0e436-fb4a-463b-a0aa-49b975cf94a3","expr":"!map.entrySet().contains(null)","rationale":"Each entry in the map entry set is expected to be a valid Map.Entry, never null.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleMap(Map<K, V>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:06.989895139Z"}
{"id":"45031ef4-1eca-402e-b76f-2331b5f186d4","expr":"map.entrySet().size() == map.size()","rationale":"The number of entries in the map is the same as the size of the map.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleMap(Map<K, V>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:06.989895139Z"}
{"id":"5e4e5179-c0db-4837-b07c-fd84e3997d77","expr":"map.keySet().size() == map.size()","rationale":"The set of keys has size equal to the map size, indicating consistency.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleMap(Map<K, V>):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:06.989895139Z"}
{"id":"97445db6-a964-4df7-a7d1-a545aa709106","expr":"array.length >= 0","rationale":"Array length is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleArray(Object[]):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:07.872887621Z"}
{"id":"e3e74fda-ea86-4eac-8c1c-42b4d1940481","expr":"array.getClass().isArray()","rationale":"The parameter 'array' is always an array class instance.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleArray(Object[]):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:07.872887621Z"}
{"id":"30d11d90-db81-4f0f-a960-be022a9b227d","expr":"array.length == (array != null ? array.length : 0)","rationale":"Length property aligns with array length or zero if null.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleArray(Object[]):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:07.872887621Z"}
{"id":"408a519d-f218-4eb0-b6ce-490a95b29d34","expr":"result.startsWith(\"[\")","rationale":"The method initializes the StringJoiner with prefix '[' so the result must start with '['.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleArray(Object[]):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:08.910905787Z"}
{"id":"6102f00f-75b9-4c6a-83ec-62b5a93c977b","expr":"result.endsWith(\"]\")","rationale":"The method initializes the StringJoiner with suffix ']' so the result must end with ']'.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleArray(Object[]):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:08.910905787Z"}
{"id":"f32338d5-6886-4e08-b1ac-947c7d30be64","expr":"result.length() >= 2","rationale":"Even for an empty array, the result would contain at least the opening and closing brackets \"[]\".","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleArray(Object[]):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:08.910905787Z"}
{"id":"8657d9dc-ed45-4499-a31b-63767bf6ea97","expr":"(array.length == 0) == (result.equals(\"[]\"))","rationale":"For an empty input array, the styleArray method returns \"[]\"; for non-empty arrays it produces a longer string.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleArray(Object[]):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:08.910905787Z"}
{"id":"a0568d39-ffbb-4cc5-b99f-af4b08b46117","expr":"result != null","rationale":"The method always returns a formatted string, so result is never null.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#toSimpleMethodSignature(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:09.304830113Z"}
{"id":"04881ef5-2baf-4e07-8eb2-a1e8832cdcdf","expr":"result.startsWith(method.getName() + \"(\")","rationale":"The result string is formatted with the method name followed by an opening parenthesis.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#toSimpleMethodSignature(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:09.304830113Z"}
{"id":"51c55740-b27b-4c62-a47f-bc964ecab206","expr":"result.endsWith(\")\")","rationale":"The result string ends with a closing parenthesis according to the format string.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#toSimpleMethodSignature(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:09.304830113Z"}
{"id":"c6f63d03-139b-4c31-9d89-5bc10735b24e","expr":"result.contains(method.getName())","rationale":"The method name is explicitly formatted into the result string, so result contains method name.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#toSimpleMethodSignature(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:09.304830113Z"}
{"id":"67043d77-bd75-4696-b611-88b0a6c49ac4","expr":"!result.contains(\"[\") && !result.contains(\"]\")","rationale":"The parameter list is composed of simple class names separated by commas, so no square brackets appear in result.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#toSimpleMethodSignature(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:09.304830113Z"}
{"id":"8a15b941-e4e0-4b57-ae4b-670442b522ef","expr":"method != null && method.getName() != null && !method.getName().isEmpty()","rationale":"The method and its name must be non-null and non-empty since they are used to create the signature string.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#toSimpleMethodSignature(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:09.991319103Z"}
{"id":"72b3e2af-f6ad-4a4a-8612-ef9a82de9af8","expr":"method.getParameterTypes() != null","rationale":"The array of parameter types returned by getParameterTypes() is non-null according to Method API.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#toSimpleMethodSignature(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T00:52:09.991319103Z"}
{"id":"8392c081-cbc9-430b-a770-20381a544f99","expr":"out != null","rationale":"The OutputStream parameter out is usually expected to be non-null for this method to operate correctly.","kind":"METHOD_ENTRY","element":"org.springframework.core.SortedProperties#store(OutputStream,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:10.879197392Z"}
{"id":"51416212-a18a-4f7d-83f4-40be25df27a2","expr":"comments == null || comments.isEmpty() || comments.trim().length() == 0","rationale":"comments may be empty or trimmed empty string when non-null, because some usages pass empty notification.","kind":"METHOD_ENTRY","element":"org.springframework.core.SortedProperties#store(OutputStream,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:10.879197392Z"}
{"id":"0a5f4c1a-06e5-4230-bc32-913b963e5831","expr":"comments == null || !comments.startsWith(\"#\")","rationale":"Comments are not expected to start with '#' as that is treated as a comment line in store method.","kind":"METHOD_ENTRY","element":"org.springframework.core.SortedProperties#store(OutputStream,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:10.879197392Z"}
{"id":"6931eaae-7570-43bf-954c-48db0ca2b417","expr":"out != null","rationale":"The output stream out must be non-null at method exit to perform output operations.","kind":"METHOD_EXIT","element":"org.springframework.core.SortedProperties#store(OutputStream,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:11.056574044Z"}
{"id":"f1074955-8272-401c-aa4e-979540f134d6","expr":"writer != null","rationale":"writer must be non-null to write output.","kind":"METHOD_ENTRY","element":"org.springframework.core.SortedProperties#store(Writer,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:11.812339327Z"}
{"id":"bf9fbec2-a588-4c6d-9ad7-f2a6a24ee8b2","expr":"comments == null || comments.length() >= 0","rationale":"comments is either null or a non-null string.","kind":"METHOD_ENTRY","element":"org.springframework.core.SortedProperties#store(Writer,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:11.812339327Z"}
{"id":"c3c40525-c1f2-4066-a442-a50eb29b1ebf","expr":"comments == null || comments.trim().length() == comments.length()","rationale":"if comments is not null, it usually doesn't start or end with whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.core.SortedProperties#store(Writer,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:11.812339327Z"}
{"id":"0d98599c-00c5-49a8-9368-05a344505310","expr":"out != null","rationale":"The OutputStream 'out' should be non-null at method exit because it is used to store the XML.","kind":"METHOD_EXIT","element":"org.springframework.core.SortedProperties#storeToXML(OutputStream,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:12.610765583Z"}
{"id":"bd15c4c0-8879-442c-9832-90aef5b2cce8","expr":"out != null","rationale":"The OutputStream parameter 'out' is expected to be non-null to successfully perform XML output.","kind":"METHOD_ENTRY","element":"org.springframework.core.SortedProperties#storeToXML(OutputStream,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:12.926357112Z"}
{"id":"2a943f0d-1219-4ea6-a6c5-496de5461b27","expr":"comments == null || comments.length() >= 0","rationale":"If comments is not null, its length is non-negative, a trivial but useful invariant.","kind":"METHOD_ENTRY","element":"org.springframework.core.SortedProperties#storeToXML(OutputStream,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:12.926357112Z"}
{"id":"fcb5269e-e007-41b2-ae51-6be6f99a4ffa","expr":"writer != null && comments != null || writer != null && comments == null","rationale":"writer is the stream written to, must be non-null as method executed without exception.","kind":"METHOD_EXIT","element":"org.springframework.core.SortedProperties#store(Writer,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:13.403069256Z"}
{"id":"5e5ad4c5-c93c-4e91-9c50-e1fc1388dddd","expr":"writer.toString().contains(comments) || comments == null","rationale":"If comments is provided, it should be included in the written contents.","kind":"METHOD_EXIT","element":"org.springframework.core.SortedProperties#store(Writer,String):void","file":"org/springframework/core/SortedProperties.java","createdAt":"2026-09-11T00:52:13.403069256Z"}
