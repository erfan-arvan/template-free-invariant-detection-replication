{"id":"5fbab589-7860-4ce5-b893-df0d52d40f44","expr":"typePath != null","rationale":"typePath is expected to be a valid TypePath object and not null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.FieldVisitorTee#visitTypeAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/FieldVisitorTee.java","createdAt":"2026-09-11T01:28:29.453453918Z"}
{"id":"1d28568c-106b-4d12-940d-4bc18b675e56","expr":"typeRef >= 0","rationale":"typeRef must be non-negative as it is an integer encoding a type reference.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.FieldVisitorTee#visitTypeAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/FieldVisitorTee.java","createdAt":"2026-09-11T01:28:29.453453918Z"}
{"id":"1070771a-0815-41a9-8c12-eef551daa41d","expr":"visible == true || visible == false","rationale":"No constraints needed on visible; it must be boolean.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.FieldVisitorTee#visitTypeAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/FieldVisitorTee.java","createdAt":"2026-09-11T01:28:29.453453918Z"}
{"id":"3a8a201d-5f3b-4d4b-9818-0fbab18b90ce","expr":"result != null","rationale":"The method always returns a non-null AnnotationVisitor instance created by AnnotationVisitorTee.getInstance.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.FieldVisitorTee#visitTypeAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/FieldVisitorTee.java","createdAt":"2026-09-11T01:28:31.033514960Z"}
{"id":"cf6b50c5-c737-4b9d-aae4-662bbaba198b","expr":"target.getClass().getInterfaces().length >= 0","rationale":"The target's class always has an array of interfaces; the length is always >= 0.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassTransformerTee#setTarget(ClassVisitor):void","file":"org/springframework/cglib/transform/ClassTransformerTee.java","createdAt":"2026-09-11T01:28:31.210372133Z"}
{"id":"9824e764-9f89-4c11-9fea-0eae683e857b","expr":"target != null && target.getClass() != null && target.getClass().getName() != null","rationale":"Target is expected to be a valid ClassVisitor instance after setTarget.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassTransformerTee#setTarget(ClassVisitor):void","file":"org/springframework/cglib/transform/ClassTransformerTee.java","createdAt":"2026-09-11T01:28:31.544678529Z"}
{"id":"0d974893-d4e9-4a1e-bdbe-7ef3357edb16","expr":"target.hashCode() >= 0","rationale":"Hashcode typically non-negative, assuming standard implementation.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassTransformerTee#setTarget(ClassVisitor):void","file":"org/springframework/cglib/transform/ClassTransformerTee.java","createdAt":"2026-09-11T01:28:31.544678529Z"}
{"id":"b5ba1625-f14b-4d84-a8cd-d84f7ea8fbc6","expr":"target.toString() != null","rationale":"The toString method of target should return a non-null String.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassTransformerTee#setTarget(ClassVisitor):void","file":"org/springframework/cglib/transform/ClassTransformerTee.java","createdAt":"2026-09-11T01:28:31.544678529Z"}
{"id":"09da83cf-66a9-4a52-845e-6545a8d357bb","expr":"!target.equals(null)","rationale":"target is a non-null object, so target.equals(null) should be false.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassTransformerTee#setTarget(ClassVisitor):void","file":"org/springframework/cglib/transform/ClassTransformerTee.java","createdAt":"2026-09-11T01:28:31.544678529Z"}
{"id":"e5154312-f3aa-4e17-a51b-1edcfd799c0f","expr":"target != null && target.getClass().getName() != null","rationale":"Target is expected to be a non-null ClassVisitor at method exit, indicating setTarget was called successfully.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#setTarget(ClassVisitor):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:32.223842767Z"}
{"id":"df164713-a915-451b-8246-00827bf8964c","expr":"target.getClass() != null","rationale":"Every object has a non-null class","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#setTarget(ClassVisitor):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:32.318448844Z"}
{"id":"884b1549-3c56-41e5-acf2-0a943954ea48","expr":"target.getClass().isInstance(target)","rationale":"Ensures type validity at this point","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#setTarget(ClassVisitor):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:32.318448844Z"}
{"id":"ccdad817-c1c4-4f3f-aa95-a23d2e16c5c9","expr":"target.hashCode() >= 0","rationale":"Non-negative hash code is a common property for identification","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#setTarget(ClassVisitor):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:32.318448844Z"}
{"id":"e706bcb3-65ad-4edf-abdb-e06e7c78dba0","expr":"name != null && !name.isEmpty()","rationale":"Name represents a class name and is expected to be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:34.767278920Z"}
{"id":"d216fd00-1711-41bd-abbd-afc4943d214a","expr":"interfaces != null","rationale":"The interfaces array is expected to be non-null at this program point.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:34.767278920Z"}
{"id":"bf065d66-9789-47ef-8981-481632dd4a44","expr":"signature == null || signature.length() > 0","rationale":"Signature being null or containing a signature string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:34.767278920Z"}
{"id":"025c0eae-e1ad-4ad1-b7e3-48a5b403898a","expr":"(superName == null || (!superName.equals(name)))","rationale":"The superclass name, if present, is different from the class name.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:34.767278920Z"}
{"id":"acf39f78-4094-40ac-b282-171f03f927c3","expr":"version >= 0","rationale":"The version number should be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:34.767278920Z"}
{"id":"f3d0bf8a-955d-4af4-9f6f-ed19d2357791","expr":"name != null && !name.isEmpty()","rationale":"The 'name' parameter likely represents a class name and thus is expected to be non-null and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.141282201Z"}
{"id":"4dbdc1cb-a576-4dcb-823c-2d29cb9c3411","expr":"interfaces != null","rationale":"The 'interfaces' argument should be non-null as it's passed directly to the visitor method.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.141282201Z"}
{"id":"5a75f7f2-4eac-4706-b027-079f3eecc766","expr":"signature == null || signature.length() > 0","rationale":"'signature' can be null or a non-empty string, reflecting typical usage when a generic signature is present or absent.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.141282201Z"}
{"id":"09005660-c7cb-419d-a81a-cbbbf6c07f19","expr":"version > 0","rationale":"ASM version constants are positive integers, so the version must be greater than zero.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.141282201Z"}
{"id":"e7a6da5a-2aa5-49c2-9ee7-4a04d25e95a8","expr":"(superName == null) || (!superName.isEmpty())","rationale":"The 'superName' is either null or a valid class name string, thus not empty if present.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.141282201Z"}
{"id":"4e368a48-261a-49b6-b091-acf197e91763","expr":"(source == null) == (debug == null)","rationale":"Since source and debug are passed directly together to the same method, they tend to be null or non-null simultaneously.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.655961149Z"}
{"id":"d65d738f-84a3-472e-bfba-784aee09bade","expr":"source == null || !source.isEmpty()","rationale":"At method exit, source if not null, is likely not empty since it represents a source string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.655961149Z"}
{"id":"6ebe383f-3cb9-40e1-84d6-eb22827e992f","expr":"debug == null || !debug.isEmpty()","rationale":"At method exit, debug if not null, is likely not empty as it represents debug info.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.655961149Z"}
{"id":"6af990bd-35e4-4718-8299-3e8fedd4b11a","expr":"source == null || source.length() >= 0","rationale":"If source is not null, its length is always non-negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.655961149Z"}
{"id":"d5d04982-d5b1-4217-8fb4-4820080fb6be","expr":"debug == null || debug.length() >= 0","rationale":"If debug is not null, its length is always non-negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.655961149Z"}
{"id":"cc8aaf77-a0bf-4fad-b168-4da6202f5fdb","expr":"source == null || source.length() >= 0","rationale":"If source is non-null, it is a String and its length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.672151052Z"}
{"id":"436840e5-5458-4017-a543-d7ba2892f4d5","expr":"debug == null || debug.length() >= 0","rationale":"If debug is non-null, it is a String and its length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.672151052Z"}
{"id":"7acd360d-0dfb-47c4-a99d-654a23c2c7ed","expr":"(source == null) || (debug == null) || !source.equals(debug)","rationale":"Typically, source and debug strings are different inputs, so if both are non-null they are not always equal.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.672151052Z"}
{"id":"647b8d44-9861-48a2-9a41-55c682018c3a","expr":"source == null || source.contains(\".\") || !source.isEmpty()","rationale":"Source may be a Java class or file name, often including dots (package separators).","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.672151052Z"}
{"id":"6a01b977-fde5-4697-a595-0c8b350b0ae0","expr":"(source == null) || (debug != null && debug.length() >= source.length())","rationale":"If both source and debug are non-null, debug string might be longer or equal in length to source for debugging info.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:35.672151052Z"}
{"id":"c484066f-4d6e-4b85-a8fa-4316822a581c","expr":"desc != null && !desc.isEmpty()","rationale":"Annotation descriptor strings are usually meaningful and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:37.799252906Z"}
{"id":"d245e8d5-e3c8-4f61-b65f-79737536c9de","expr":"visible == true || visible == false","rationale":"The visible parameter is a boolean and can only be true or false.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:37.799252906Z"}
{"id":"6363529f-8b57-4ae5-bc67-5ad9c740ce7a","expr":"desc.contains(\"/\")","rationale":"Descriptors usually contain '/' to denote the package path of the annotation.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:37.799252906Z"}
{"id":"6f97230d-7de1-4cc2-a30d-0a740ccd3f60","expr":"owner != null && name != null && desc != null && !owner.isEmpty() && !name.isEmpty() && !desc.isEmpty()","rationale":"The call target.visitOuterClass(owner, name, desc) suggests that owner, name, and desc are likely non-null and non-empty strings, as these represent class and method descriptors typically non-null when referring to bytecode elements.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:38.952510107Z"}
{"id":"d5edd78e-d868-45b1-b01c-b7d495ae7887","expr":"owner.length() > 0","rationale":"owner represents an internal class name, which is conventionally a non-empty string at method exit.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:38.952510107Z"}
{"id":"e1d91307-75f2-4ff6-9c5b-60e14cdcca2e","expr":"desc.startsWith(\"(\") && desc.contains(\")\")","rationale":"Method descriptors typically follow the JVM descriptor format, starting with '(' and containing ')' to separate parameters and return types.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:38.952510107Z"}
{"id":"c4e74d28-d5cc-4d20-a5af-406c554d6f40","expr":"attr != null && attr.getClass() != null && attr.getName() != null && !attr.getName().isEmpty()","rationale":"attr is expected to be a valid Attribute object with a non-null, non-empty name attribute before the method executes.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:38.953630813Z"}
{"id":"7a83267b-badf-4bbf-98c4-245dfa109a52","expr":"desc != null || result == null","rationale":"Indicates that if desc is null then result is also null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:39.929819282Z"}
{"id":"15404778-9829-4ab7-9628-e6748b25bb87","expr":"result != null","rationale":"The method contract likely guarantees a non-null AnnotationVisitor returned.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:39.929819282Z"}
{"id":"7c6e437c-fb17-4566-adaf-b5669fccfe9e","expr":"owner != null && !owner.isEmpty() && name != null && desc != null && !desc.isEmpty() && !name.isEmpty() && desc.length() > 0","rationale":"At method entry, these strings usually represent meaningful identifiers and descriptors in class manipulation libraries like cglib, thus non-null and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:40.040684253Z"}
{"id":"34635b96-a49b-44dd-9ea9-1a2b5b1b3753","expr":"owner.indexOf('/') >= 0","rationale":"owner string typically contains '/' characters as internal name representation of classes (e.g., 'java/lang/String').","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:40.040684253Z"}
{"id":"61b8519e-5ee6-4a55-844e-a19ddc9ccae3","expr":"name.indexOf('/') == -1","rationale":"The method name should not include '/' characters; they are usually in owner names.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:40.040684253Z"}
{"id":"2c88a019-6e37-4875-a1c6-87c3a566443f","expr":"desc.startsWith(\"(\") && desc.endsWith(\")\")","rationale":"The 'desc' string adheres to typical JVM method descriptor syntax enclosed in parentheses.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:40.040684253Z"}
{"id":"22e31619-d43e-4359-9f35-06c8e7df9256","expr":"name != null && !name.isEmpty() && innerName != null && !innerName.isEmpty() && (outerName == null || !outerName.isEmpty())","rationale":"The 'name' and 'innerName' parameters identify classes and should be non-null and non-empty; 'outerName' can be null or a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:41.648228866Z"}
{"id":"cfca7912-3699-403b-b4f6-9cac9bdf644f","expr":"!name.equals(innerName)","rationale":"Since 'name' is usually the full name and 'innerName' is the identifier of the inner class itself, they should not be equal.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:41.648228866Z"}
{"id":"926add83-bd4f-48a1-9e4f-d4fc515bc26f","expr":"access >= 0","rationale":"Access flags are expected to be non-negative integers representing access modifiers.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:41.648228866Z"}
{"id":"8b0cbb9a-043a-4c9d-b1e4-009a3c421c12","expr":"attr != null && attr.getName() != null && !attr.getName().isEmpty()","rationale":"The attribute's name is expected to be meaningful and non-empty after the method call.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:42.349404701Z"}
{"id":"123a2f68-9465-460a-828f-ac66aedb258a","expr":"attr != null && (attr.getLength() >= 0)","rationale":"Attributes typically have a non-negative length in bytecode manipulation contexts.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:42.349404701Z"}
{"id":"4acdd97b-b36f-4106-919b-d5f83f0e395e","expr":"attr != null","rationale":"attr parameter is passed to target.visitAttribute(attr) and should remain non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:42.349404701Z"}
{"id":"06ec2c51-9ab2-4321-bb18-c061e4a7413e","expr":"name != null && !name.isEmpty()","rationale":"Class name is typically non-null and non-empty when processing inner classes.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:42.633663245Z"}
{"id":"b8d18c9a-ca61-4e60-b0a7-8b0612d0c524","expr":"innerName != null && !innerName.isEmpty()","rationale":"The inner class name should be a valid, non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T01:28:42.633663245Z"}
