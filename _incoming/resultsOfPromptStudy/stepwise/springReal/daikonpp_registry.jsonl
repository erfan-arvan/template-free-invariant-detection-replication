{"id":"e3c68bcf-6f17-4b04-a549-b9dde937e12c","expr":"clazz1 != null && clazz2 != null || clazz1 == null || clazz2 == null","rationale":"At method entry, either one or both classes can be null or non-null independently.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#determineCommonAncestor(Class<?>,Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:19.867254052Z"}
{"id":"09692b0f-90d1-48e0-aca3-6a811a8bd9d0","expr":"clazz1 != null || clazz2 != null","rationale":"The method works with null and non-null parameters.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#determineCommonAncestor(Class<?>,Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:19.867254052Z"}
