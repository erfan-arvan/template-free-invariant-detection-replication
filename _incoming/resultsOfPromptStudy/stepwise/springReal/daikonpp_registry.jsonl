{"id":"776b61c9-d691-44a8-8449-f8f22a0f246a","expr":"name != null && !name.isEmpty()","rationale":"Parameter names are generally non-null and non-empty strings to meaningfully identify parameters.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitParameter(String,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:16.517695082Z"}
