{"id":"57f7e31b-d079-44af-9a48-e523aaee3b1b","expr":"file == null || !file.isEmpty()","rationale":"If 'file' is non-null, it is not empty due to UTF-8 encoding requirement.","kind":"METHOD_EXIT","element":"org.springframework.asm.ClassWriter#visitSource(String,String):void","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:45.957575815Z"}
