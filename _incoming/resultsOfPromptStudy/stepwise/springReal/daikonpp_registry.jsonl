{"id":"d835f53a-e1e7-411b-ba09-b4757d9595a0","expr":"m != null && m.getName() != null && m.getReturnType() != null && m.getParameterTypes() != null && m.getExceptionTypes() != null && m.getReturnType().getName() != null && m.getName().length() > 0","rationale":"Non-null and valid method metadata is implied for the delegate method lookup.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AddDelegateTransformer#addDelegate(Method):void","file":"org/springframework/cglib/transform/impl/AddDelegateTransformer.java","createdAt":"2026-09-11T01:27:44.084892654Z"}
