{"id":"5c9eba1f-4e03-4d31-96e3-1f7743bc7fe8","expr":"value != null || result == !type.isPrimitive()","rationale":"If value is null, then result must be the negation of type.isPrimitive().","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:03.718803360Z"}
{"id":"bdf713e6-f4b4-456b-9c69-9b841e80e067","expr":"resourcePath != null && result != null && result.equals(resourcePath.replace('/', '.'))","rationale":"Result is the resourcePath with all '/' replaced by '.'.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:04.571977882Z"}
{"id":"2fe49b91-0ed0-4944-9f88-745e4263b2ce","expr":"!result.contains(\"/\")","rationale":"The result string does not contain '/' character.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:04.571977882Z"}
{"id":"e3100097-7b20-499a-b505-1e157d290e59","expr":"result.contains(\".\") == resourcePath.contains(\"/\")","rationale":"Presence of '.' in result matches presence of '/' in resourcePath.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:04.571977882Z"}
{"id":"7a615a59-5687-499b-b443-77afb8912276","expr":"result.length() == resourcePath.length()","rationale":"Result has same length as resourcePath.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:04.571977882Z"}
{"id":"8254b66d-cd0c-4fd8-9204-5f915a630327","expr":"resourcePath != null","rationale":"The method explicitly asserts that resourcePath must not be null upon entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:04.598200290Z"}
{"id":"ce6e94c0-0d8e-4cc8-b9c8-8f1deb9d2416","expr":"resourcePath.length() >= 0","rationale":"The length of a string is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:04.598200290Z"}
{"id":"aa7870d8-db2e-40ff-bd34-ba96db77a745","expr":"!resourcePath.contains(\" \") || resourcePath.contains(\".\")","rationale":"A resource path for classes typically includes dot separators, not spaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:04.598200290Z"}
{"id":"a6a3d0d4-dc2b-4143-882c-a6af760be0f5","expr":"resourcePath.indexOf('/') >= -1","rationale":"Call to indexOf on resourcePath is safe and returns -1 or a valid index.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:04.598200290Z"}
{"id":"14b3d760-26cc-4060-9647-adc2dd84c319","expr":"resourcePath.startsWith(\"/\") == false","rationale":"Resource paths representing class names do not start with slash.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:04.598200290Z"}
{"id":"56212b26-12d2-4868-a224-ead932ceb1d4","expr":"!result || lhsType.isAssignableFrom(rhsType)","rationale":"The first if condition in the method guarantees that if result is true, lhsType.isAssignableFrom(rhsType) is true.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isAssignable(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:04.621217586Z"}
