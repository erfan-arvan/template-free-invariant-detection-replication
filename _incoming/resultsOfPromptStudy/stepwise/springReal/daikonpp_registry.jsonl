{"id":"e91ba5d6-7412-4a49-abf4-878d74ec346d","expr":"clazz != null","rationale":"The parameter clazz should be non-null since it is mandatory for visibility checking.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isVisible(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:52.187295617Z"}
{"id":"35747e11-ffd0-4ff1-a7de-6ebc7792c3bc","expr":"classLoader == null || classLoader.getParent() != null","rationale":"If classLoader is not null, it usually has a parent class loader or is itself the bootstrap loader.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isVisible(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:52.187295617Z"}
{"id":"76d50b2d-eae4-49bc-af66-7b41529ced86","expr":"classLoader == null || clazz.getClassLoader() == null || clazz.getClassLoader() != classLoader || clazz.getClassLoader() == classLoader","rationale":"The class loader of clazz may or may not be the same as the provided classLoader if it is not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isVisible(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:52.187295617Z"}
{"id":"0f39dcc6-1605-497d-8646-e66148c5f1df","expr":"clazz.getClassLoader() == null || classLoader == null || clazz.getClassLoader() != classLoader","rationale":"Implements the logic that if clazz.getClassLoader() == classLoader then isVisible would return true early.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isVisible(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:52.187295617Z"}
{"id":"e1c5f10d-4e0e-4c81-9dbf-ec10dab9a66b","expr":"result == true || result == false","rationale":"Result is a boolean indicating if clazz is cache safe with respect to classLoader.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isCacheSafe(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:53.456882221Z"}
{"id":"683921c1-9385-4c36-b29e-46011bc6190d","expr":"(classLoader == null) == !result || clazz.getClassLoader() == null || clazz.getClassLoader() == classLoader","rationale":"If classLoader is null, result is false except if clazz's classLoader is also null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isCacheSafe(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:53.456882221Z"}
{"id":"545c2aa1-dbdf-4eee-8f4a-0737e40d1523","expr":"!result || (classLoader != null && clazz.getClassLoader() != null)","rationale":"If result is true, classLoader and clazz's classLoader are non-null or equivalent.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isCacheSafe(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:53.456882221Z"}
{"id":"15758492-b73d-4213-974d-20970b4637d6","expr":"clazz != null && classLoader != null && clazz.getName() != null && !clazz.getName().isEmpty()","rationale":"The method uses clazz.getName() and classLoader.loadClass(clazz.getName()) which require non-null and non-empty class name.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:54.631954343Z"}
{"id":"c67f27ff-3286-4c8f-8284-e688c5b675c0","expr":"clazz.getClassLoader() != null || classLoader != null","rationale":"Since the method loads the class using classLoader, at least one class loader is expected to be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:54.631954343Z"}
