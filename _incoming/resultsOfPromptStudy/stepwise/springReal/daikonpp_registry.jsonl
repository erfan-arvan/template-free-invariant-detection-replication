{"id":"9179f580-cf77-4459-bee1-836714eda42c","expr":"name != null && !name.isEmpty()","rationale":"The method uses 'name' to create property names and method signatures, implying 'name' should be not null and not empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AccessFieldTransformer#declare_field(int,String,Type,Object):void","file":"org/springframework/cglib/transform/impl/AccessFieldTransformer.java","createdAt":"2026-09-11T01:27:46.262248478Z"}
{"id":"31a57da6-8daf-40d8-80ea-8abb87d19263","expr":"type != null","rationale":"The 'type' parameter is used to define method signatures, so it must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AccessFieldTransformer#declare_field(int,String,Type,Object):void","file":"org/springframework/cglib/transform/impl/AccessFieldTransformer.java","createdAt":"2026-09-11T01:27:46.262248478Z"}
