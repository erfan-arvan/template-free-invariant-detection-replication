{"id":"152d1dee-4491-43d6-9fbd-d8d2a0cfa0fb","expr":"!result == (newValue == false)","rationale":"This is logically equivalent to result == newValue.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeBoolean(Object,String,boolean,boolean):boolean","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:50.073670641Z"}
{"id":"a148f3aa-a20c-4119-a422-1bf765dcec5c","expr":"obj != null || obj == null","rationale":"obj can be any Object reference, including null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeDouble(Object,String,double,double):double","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-11T01:27:51.471881431Z"}
