{"id":"a60aa164-8cf0-431e-879a-181097afb2f9","expr":"result.getName().equals(name) || name.endsWith(\"[]\") && result.isArray()","rationale":"If 'name' ends with '[]', the returned class must be an array type; otherwise, the class name matches 'name'.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#forName(String,ClassLoader):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:48.911124086Z"}
