{"id":"2a1d5ffa-ba57-485e-ad1f-9a112addda4f","expr":"locator == null || locator.getLineNumber() >= -1","rationale":"Line number is either unknown (-1) or a non-negative integer.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#setDocumentLocator(Locator):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-11T00:37:24.761118251Z"}
