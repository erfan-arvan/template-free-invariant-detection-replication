{"id":"d217fcb5-07b0-43bc-9cf1-5782365beff3","expr":"clazz.componentType() == null || clazz.componentType().isPrimitive() == true || clazz.componentType().isPrimitive() == false","rationale":"componentType().isPrimitive() returns a boolean only when componentType() is non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.775517935Z"}
{"id":"14ae3fd5-8f3a-4325-9931-4021a9aab637","expr":"clazz != null","rationale":"Method asserts clazz non-null, so it's invariant at method entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.775517935Z"}
{"id":"2c355252-1087-4bfa-9713-21e139ada516","expr":"(result == clazz.isArray() && clazz.componentType().isPrimitive()) || !clazz.isArray() || !clazz.componentType().isPrimitive()","rationale":"The method returns true if and only if clazz represents an array whose component type is primitive.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.810981044Z"}
{"id":"5280e6ea-58cf-4cb3-abc5-29672bd290ad","expr":"!result || clazz.isArray()","rationale":"If the method returns true then clazz is an array; if false, nothing is implied.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.810981044Z"}
{"id":"a59787da-56bb-474c-ada3-14bb82ec3c18","expr":"!result || clazz.componentType().isPrimitive()","rationale":"When the result is true, the component type of the array class is primitive.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.810981044Z"}
{"id":"61479015-e6f6-4ed8-a940-9c3b9dd5bec9","expr":"result == (clazz.isArray() && clazz.componentType() != null && clazz.componentType().isPrimitive())","rationale":"The method returns true exactly when clazz is an array whose componentType is not null and primitive.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:58.810981044Z"}
{"id":"87a0282c-ff25-4fa3-b690-1552ee57383c","expr":"clazz != null","rationale":"Method asserts clazz is not null at entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:59.978544627Z"}
{"id":"bc5b35ad-da1b-48a2-976d-b4284a52bbac","expr":"clazz.isPrimitive() == clazz.isPrimitive()","rationale":"Ensures method call is valid, though tautological.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:42:59.978544627Z"}
{"id":"68e9bf99-fe95-4141-acf3-cb8cadb3194c","expr":"result != null","rationale":"The method either returns a wrapper class or the original clazz, both non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:00.353556017Z"}
{"id":"6dd4223b-97a6-402c-9d63-fd60c9cd67bc","expr":"clazz.isPrimitive() == (result != clazz)","rationale":"The result is a wrapper class if clazz is primitive and not void, else it is clazz.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:00.353556017Z"}
{"id":"21463aa2-e7b3-4128-8018-8e91abdfb4b6","expr":"!clazz.isPrimitive() || result != clazz","rationale":"The method returns a wrapper class for primitive types except void.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:00.353556017Z"}
{"id":"77bef9ed-dc54-4212-a3e5-eb8803d3fd12","expr":"type == null || type != null","rationale":"The parameter 'type' can be null or non-null as there is no restriction preventing null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isVoidType(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:00.527057196Z"}
{"id":"d8d120e7-e36d-45ab-a70b-6568e74bec92","expr":"(type == null) == !result","rationale":"Because the method returns false if type is null, this invariant captures that relationship.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isVoidType(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:01.210481733Z"}
{"id":"6f604583-6dcc-48dd-83c6-c83732a8b27e","expr":"!result || type != null","rationale":"The method never returns true if type is null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isVoidType(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:01.210481733Z"}
{"id":"ec68376d-b24d-4935-82f1-72bb2542d70d","expr":"type != null","rationale":"The method body uses type in several isAssignableFrom calls and equality comparisons, so type must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isSimpleValueType(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:01.588286719Z"}
{"id":"41a0f984-35f5-417f-b755-2cf6813eb05c","expr":"lhsType != null && rhsType != null","rationale":"Ensures non-null types as implied by input checks.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignable(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T00:43:03.077680044Z"}
