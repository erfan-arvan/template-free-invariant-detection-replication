{"id":"065c2d21-8829-4a9b-bb83-4e2c26c7e774","expr":"m.getParameterTypes() != null","rationale":"Necessary condition for delegate method retrieval call.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AddDelegateTransformer#addDelegate(Method):void","file":"org/springframework/cglib/transform/impl/AddDelegateTransformer.java","createdAt":"2026-09-11T01:27:44.084892654Z"}
