{"id":"8788f619-2f61-4101-b8ed-bfd2111cc574","expr":"result != null","rationale":"The method always returns a non-null AnnotationVisitor instance.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariableAnnotation(int,TypePath,Label[],Label[],int[],String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:29:26.422021658Z"}
