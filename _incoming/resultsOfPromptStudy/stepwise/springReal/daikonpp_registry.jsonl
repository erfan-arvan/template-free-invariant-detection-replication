{"id":"d45a3334-d571-4e1c-9117-35f8fd9daa37","expr":"(stack == null) || (stack.length >= nStack)","rationale":"If the stack array is provided, its length must be at least nStack.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:51.971161321Z"}
{"id":"3d6f60a9-3506-421e-bc8b-ad494785c26a","expr":"nLocal == (local != null ? local.length : 0)","rationale":"Length of the local array should match nLocal if local is not null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:51.988272594Z"}
{"id":"6e60d535-9280-4db8-a832-464de2ebc187","expr":"nStack == (stack != null ? stack.length : 0)","rationale":"Length of the stack array should match nStack if stack is not null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:51.988272594Z"}
{"id":"f66cfb08-e091-4f0d-b728-eed03ed8f2dc","expr":"type >= 0 && type <= 3","rationale":"ASM frame types are usually between 0 and 3 inclusive.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:51.988272594Z"}
{"id":"dfc5f802-74fa-46c9-a8ed-77730dc59ebb","expr":"(local == null && nLocal == 0) || (local != null && nLocal <= local.length)","rationale":"nLocal must not exceed local array length or be non-zero if local is null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:51.988272594Z"}
{"id":"b6aff85c-fe7b-49ab-9647-d1d6f8a8af2c","expr":"(stack == null && nStack == 0) || (stack != null && nStack <= stack.length)","rationale":"nStack must not exceed stack array length or be non-zero if stack is null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:51.988272594Z"}
{"id":"049e3a27-cba5-4568-9e9c-a08dd8525bff","expr":"result != null","rationale":"The method always returns an instance from AnnotationVisitorTee.getInstance, which is presumably non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T01:28:53.534488172Z"}
