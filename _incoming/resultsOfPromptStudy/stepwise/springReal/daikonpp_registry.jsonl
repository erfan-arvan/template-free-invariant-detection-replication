{"id":"38f26703-f81d-4a0a-8c90-736b470d96c2","expr":"typePath == null || typePath.getLength() >= 0","rationale":"If typePath is not null, its length is expected to be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassWriter#visitTypeAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:47.413233669Z"}
{"id":"b6b64919-268f-4eb4-ae2e-b4accaf09fcb","expr":"visible == true || visible == false","rationale":"Boolean visible is always true or false; included for completeness since visible is a primitive boolean.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassWriter#visitTypeAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:47.413233669Z"}
{"id":"92b73ac3-2966-480b-97fd-09d07dea1881","expr":"typePath == null || typePath.getLength() <= 255","rationale":"The length of a TypePath is limited by JVM spec to a maximum of 255 steps.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassWriter#visitTypeAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:47.413233669Z"}
{"id":"b8c0ae4a-9878-4ad0-b985-20870b49b9fb","expr":"owner != null || name == null || descriptor == null","rationale":"owner being null implies no valid outer class, so name and descriptor are not both non-null","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassWriter#visitOuterClass(String,String,String):void","file":"org/springframework/asm/ClassWriter.java","createdAt":"2026-09-11T01:53:47.653374321Z"}
