{"id":"32d90d60-8eb5-4bc0-a073-622ac24a7ad3","expr":"methodsToFilter.getClass().isArray() && methodsToFilter != null","rationale":"methodsToFilter is a non-null array of Predicate","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.024037796Z"}
{"id":"2cd8028e-f8a9-4811-a43b-bd786a57faa3","expr":"result != null","rationale":"The method always returns an unmodifiable list, never null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.023668328Z"}
{"id":"67acfd3b-95ee-405c-be53-98eecacee892","expr":"!result.contains(null)","rationale":"The list result contains Method instances, and null methods are not added.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.023668328Z"}
{"id":"a869e5c6-4ce4-4fc2-af36-6c68e22b8c75","expr":"result != null","rationale":"The method returns a List<Method>, so result is expected to be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.028059491Z"}
{"id":"87eab712-6d08-4c5e-86de-4567f21c86cc","expr":"!result.contains(null)","rationale":"The list of methods returned should not contain null elements.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.028059491Z"}
{"id":"95e0da9a-b9b6-468d-95c7-f065043c5cd6","expr":"methodsToFilter == null || methodsToFilter.test(result.get(0)) || result.isEmpty()","rationale":"If a predicate filter is provided, all returned methods satisfy it; if result is non-empty, then the filter accepts at least the first method.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.028059491Z"}
{"id":"ab2c13a9-64de-46a6-a44a-c576c8f81750","expr":"declaringClass.isAnnotation() == false","rationale":"The declaringClass is expected to be a Class object not representing an annotation type to collect declared methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.024154627Z"}
{"id":"2abdf830-47ca-4696-a9d6-c5aa8ad37ac0","expr":"declaringClass.isInterface() == false","rationale":"The declaringClass is usually a concrete class, not an interface, to retrieve declared methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.024154627Z"}
{"id":"1c14d156-d55f-4738-a026-f85b64f0d9ae","expr":"declaringClass.getMethods() != null","rationale":"declaringClass.getMethods() returns an array of Methods that is always non-null even if empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.024154627Z"}
{"id":"7e1f77bf-8011-491f-a143-0560f923f562","expr":"methodsToFilter.length >= 0","rationale":"Varargs arrays are always initialized with length zero or greater.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.024154627Z"}
{"id":"6fc69b78-c8ed-4dce-8555-07f3036fa0cb","expr":"declaringClass.getMethods().length >= 0","rationale":"The declaringClass is a Class<?> and getMethods returns an array of Method, so length is non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.029602895Z"}
{"id":"6521b01a-4149-4ccf-80ee-8a709e44350a","expr":"methodsToFilter.length >= 0","rationale":"methodsToFilter is an array and its length is always non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.029602895Z"}
{"id":"d65384e6-0204-4989-906c-40b8416d1041","expr":"declaringClass.getDeclaredMethods().length >= 0","rationale":"The declaringClass.getDeclaredMethods() array length is non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.029602895Z"}
{"id":"39b48832-f65c-44a5-98ee-f7484e1e8bad","expr":"type != null && methodName != null && !methodName.isEmpty()","rationale":"The method is likely to require non-null and non-empty methodName and non-null type to find a method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.033003527Z"}
{"id":"033e920b-83ae-473b-ac10-ef5ad18fdc24","expr":"methodName.equals(methodName.trim())","rationale":"Method names likely do not have leading or trailing whitespace.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.033003527Z"}
{"id":"06d46391-33d2-4552-b554-eb78a40ca372","expr":"type.isInterface() || type.isPrimitive() || type.isArray() || type.isAnnotation() || type.isEnum() || type.isSynthetic() || !type.isSynthetic()","rationale":"Type can be interface, primitive, array, annotation, enum, or synthetic.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.033003527Z"}
{"id":"cedff599-8728-49e6-9358-273aaa9b8755","expr":"type.getName() != null","rationale":"Class#getName() never returns null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.033003527Z"}
{"id":"68cd7685-dc0f-4602-bc75-3cd6d6db0d20","expr":"methodName.length() > 0","rationale":"methodName is non-empty string required to look-up a method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.033003527Z"}
{"id":"d0253ab3-2939-4265-8333-a7d2e21a3139","expr":"result != null","rationale":"The result List<Method> should never be null as it is returned by the getMethods call.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.033642785Z"}
{"id":"b1969461-1123-4f14-8b16-1de145045a91","expr":"result == null || result.getName().equals(methodName)","rationale":"The returned Method, if not null, should have the name equal to methodName parameter.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.033973419Z"}
{"id":"c02eabbe-1b9b-4e61-a2a7-7efaadd9ae5d","expr":"result == null || result.getDeclaringClass().equals(type)","rationale":"The returned Method must be declared by the parameter type if not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.033973419Z"}
{"id":"74ff134d-791f-4ef8-98bd-da5f8cf412f8","expr":"result == null || methodName.equals(result.getName())","rationale":"The found method's name must be equal to the methodName parameter if result is not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.034335092Z"}
{"id":"cea7258f-f1e9-4a24-a44f-9972396a7fee","expr":"result == null || type.isAssignableFrom(result.getDeclaringClass())","rationale":"Ensures the method found is declared by or inherited from the type class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.034335092Z"}
{"id":"d5f23f5c-03ad-4eed-982e-c8538618dc01","expr":"result == null || result.getParameterTypes().length == 0","rationale":"Since the findMethod invocation uses EMPTY_CLASS_ARRAY, the found method likely has zero parameter types.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.034335092Z"}
{"id":"de56a349-0a75-405e-852a-599d8b9e08c4","expr":"object != null && methodName != null && methodName.length() > 0 && methodParameters != null","rationale":"Non-null assumptions on object, methodName, and methodParameters to ensure method invocation can proceed.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.038447117Z"}
{"id":"b201d7d2-cd7a-4d56-b3f8-0641b778fb57","expr":"object.getClass() != null","rationale":"object.getClass() is non-null because object is non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.038447117Z"}
{"id":"04926129-084a-4356-907b-00692b475284","expr":"methodParameters.getClass().isArray()","rationale":"methodParameters is an array by Java varargs property.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.038447117Z"}
{"id":"304adf21-a116-4bd2-9c07-db3191b77c28","expr":"object != null && methodName != null && methodParameters.length >= 0","rationale":"methodParameters length cannot be negative; object and methodName must be non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.038447117Z"}
{"id":"0fb24670-a536-435f-a124-2c3c28961bff","expr":"overrider != null && overridden != null","rationale":"Since the method returns false if either overrider or overridden is null, it is a meaningful invariant that both are non-null before executing main logic.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.039210719Z"}
{"id":"77c69802-f01b-48d3-b01d-27c3af82c043","expr":"!Objects.equals(overrider, overridden)","rationale":"The method returns false if the two Method objects are equal, so they must be distinct at this program point.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.039210719Z"}
{"id":"440b5015-2a4c-43ba-86dd-a70f08c76753","expr":"overridden.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"The method returns false if overridden's class is not assignable from overrider's class; hence this relation holds.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.039210719Z"}
{"id":"34bcab5e-dae2-416b-97d4-a3756d743327","expr":"type != null || methodName == null || methodName.isEmpty() == false","rationale":"If type is not null and methodName is not empty, the method tries to find the method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.034458815Z"}
{"id":"aa8e78ee-5700-4d63-bda8-150a9b89c83a","expr":"methodName != null && !methodName.isEmpty() || type == null","rationale":"The method first checks that type is not null and methodName is not empty to call getDeclaredMethod.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.034458815Z"}
{"id":"9a309aa1-9982-4e0e-887c-5bb4562f828a","expr":"parameterTypes != null","rationale":"parameterTypes is a variadic parameter, always non-null even if empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.034458815Z"}
{"id":"dddac94c-8291-42be-b85c-26f54c7ac543","expr":"methodName == null || methodName.length() > 0","rationale":"methodName is either null or non-empty string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.034458815Z"}
{"id":"fb7785d3-ff07-4d59-b36d-69c6fb360107","expr":"overrider != null","rationale":"The method expects a non-null Method object to operate on.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.043183632Z"}
{"id":"43303192-e9f5-489b-b59f-a515dce217cb","expr":"(type == null || (methodName != null && !methodName.isEmpty()))","rationale":"This invariant reflects the main if condition that must be true to attempt method lookup.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.034458815Z"}
{"id":"da3e88ea-ef57-40d6-86ae-b949183b84c6","expr":"result == null || overrider.getName().equals(result.getName())","rationale":"The method findNearestOverriddenMethod returns the closest overridden method of overrider, so their names should match if result is not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.043647307Z"}
{"id":"702c5155-3fd9-4b89-906f-d1bd62c6b4cf","expr":"result == null || result.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"Since result is the overridden method, its declaring class is a superclass or interface of overrider's class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.043647307Z"}
{"id":"b654232b-a7fb-45db-90a1-5d5577c70b98","expr":"result == null || !result.equals(overrider)","rationale":"findNearestOverriddenMethod returns a method different from overrider if any overridden method exists.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.043647307Z"}
{"id":"d54c762e-a934-4a52-a7c7-edb241547600","expr":"result == null || result.getClass().isAssignableFrom(object.getClass()) == false","rationale":"result may be null or any type; no direct type relation with object is guaranteed.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.043797250Z"}
{"id":"33fc80e3-f96b-422f-a64e-4b9ced8a55ec","expr":"result == null || !result.equals(object)","rationale":"Generally, result is not equal to object unless the invoked method returns the same instance; so it's reasonable to suggest that result is either null or not equal to object.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.043797250Z"}
{"id":"3e49b769-c675-44d2-a697-1269acd5b231","expr":"overrider != null && declaringClass != null && declaringClass.isAssignableFrom(overrider.getDeclaringClass())","rationale":"The declaringClass should be related by assignability to the overrider's declaring class, as overriding implies inheritance or interface implementation.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.044780718Z"}
{"id":"4892249b-e14a-41fa-9124-d6858472c210","expr":"overrider.getDeclaringClass().isAssignableFrom(declaringClass) == false","rationale":"overrider.getDeclaringClass() should not be a superclass of declaringClass as overriding implies subclassing.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.044780718Z"}
{"id":"92e74394-f8c5-462f-9a85-86c4a99eaf21","expr":"overrider.getParameterCount() >= 0","rationale":"The number of parameters on the overrider method must be non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.044780718Z"}
{"id":"f5c37a0a-77d9-4eb6-b75c-a0a8ee09c3d5","expr":"!overrider.isSynthetic()","rationale":"It is likely the overrider is a non-synthetic method when considering overridden methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.044780718Z"}
{"id":"b6a26b07-ef67-48d0-9248-3859f1297010","expr":"method != null && method.getName() != null","rationale":"The method parameter and its name are expected to be non-null to extract the field name.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.048909104Z"}
{"id":"99810c6c-c8a9-4b49-b38a-80464800651f","expr":"!method.getName().isEmpty()","rationale":"Method name must be non-empty to pass through the method logic.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.048909104Z"}
{"id":"fcbb3233-d69e-4586-8ff4-acaecd860c70","expr":"overrider.getDeclaringClass() != null","rationale":"Every Method object has a non-null declaring class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.043183632Z"}
{"id":"77216302-be22-47c2-b356-f7da91cc7ee5","expr":"overrider.getName() != null","rationale":"Method name is always non-null in a Method object.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.043183632Z"}
{"id":"fb869236-ce7e-40a8-bec7-833cb46994b8","expr":"overrider.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"Declaring class is always assignable from itself.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.043183632Z"}
{"id":"6d884aec-c76b-41d6-9442-a5cffd29fd36","expr":"overrider.getParameterCount() >= 0","rationale":"Parameter count is always zero or positive for any Method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T23:30:57.043183632Z"}
