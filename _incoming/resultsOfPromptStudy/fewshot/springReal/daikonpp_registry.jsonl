{"id":"1ba639d8-e3e4-4ea9-8af9-88f0c1e38ad9","expr":"(local == null) || (local.length >= nLocal)","rationale":"The local array should have enough entries for the given count of local variables","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:38:00.562808070Z"}
