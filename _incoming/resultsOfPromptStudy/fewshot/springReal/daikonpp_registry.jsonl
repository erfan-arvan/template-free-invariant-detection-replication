{"id":"3eb9337d-e0ce-4069-a334-53c36ad6a14b","expr":"clazz == null || clazz.getName().length() > 0","rationale":"The class name cannot be empty if clazz is not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.483631261Z"}
