{"id":"e6ebabf1-12d4-4891-9e4d-6f21a4dea397","expr":"clazz.getName() != null","rationale":"Every Class object should have a non-null name.","kind":"METHOD_ENTRY","element":"org.springframework.objenesis.SpringObjenesis#getInstantiatorOf(Class<T>):ObjectInstantiator<T>","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-08T06:38:05.651302515Z"}
{"id":"4c160427-b156-4fd9-aeec-9505b9f41c6e","expr":"clazz != null","rationale":"The method expects a valid Class object to create an instantiator for.","kind":"METHOD_ENTRY","element":"org.springframework.objenesis.SpringObjenesis#newInstantiatorOf(Class<T>):ObjectInstantiator<T>","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-08T06:38:05.652400612Z"}
{"id":"4265821d-f7a1-42ae-92e8-5223543988cd","expr":"clazz.isPrimitive() == false","rationale":"Primitive types normally don't have instantiators.","kind":"METHOD_ENTRY","element":"org.springframework.objenesis.SpringObjenesis#newInstantiatorOf(Class<T>):ObjectInstantiator<T>","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-08T06:38:05.652400612Z"}
{"id":"cb020e95-b331-4d39-b8cd-bec2bbb7e7a2","expr":"clazz.getModifiers() >= 0","rationale":"Class modifiers are bitfields and hence non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.objenesis.SpringObjenesis#newInstantiatorOf(Class<T>):ObjectInstantiator<T>","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-08T06:38:05.652400612Z"}
