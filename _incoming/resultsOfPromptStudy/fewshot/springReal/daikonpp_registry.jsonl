{"id":"2e87f775-73e0-4ab3-b724-cb1f3e95b082","expr":"(result == -1) == (line.indexOf(token) == -1)","rationale":"return value encodes token presence with -1 or a position","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XmlValidationModeDetector#commentToken(String,String,boolean):int","file":"org/springframework/util/xml/XmlValidationModeDetector.java","createdAt":"2026-09-08T06:37:50.805325431Z"}
