{"id":"981eb3bd-93ac-4536-a6fe-86a8c325e65f","expr":"result.getClass() == clazz || clazz.isAssignableFrom(result.getClass())","rationale":"The instantiated result should be either exactly clazz or a subclass of clazz.","kind":"METHOD_EXIT","element":"org.springframework.objenesis.SpringObjenesis#newInstance(Class<T>):T","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-08T06:38:05.650782285Z"}
