{"id":"3c6ce45e-5db7-419e-922d-c2d28e012244","expr":"data != null","rationale":"The data parameter should not be null to create a valid XML comment.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeComment(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:37:51.083248768Z"}
