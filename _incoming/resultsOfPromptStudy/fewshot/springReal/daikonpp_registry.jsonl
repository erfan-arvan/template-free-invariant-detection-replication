{"id":"70bd63eb-b2e3-42e2-b2ed-48c1ce9d01df","expr":"!result || className.contains(\"$$\")","rationale":"If result is true, className must contain the CGLIB separator.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isCglibProxyClassName(String):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.676785517Z"}
