{"id":"bb298de0-edf4-4b1d-9d18-7b0c17822fb9","expr":"!clazz.isPrimitive()","rationale":"Primitive classes do not implement interfaces, so clazz usually represents a reference type.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getAllInterfacesForClassAsSet(Class<?>,ClassLoader):Set<Class<?>>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.606827870Z"}
