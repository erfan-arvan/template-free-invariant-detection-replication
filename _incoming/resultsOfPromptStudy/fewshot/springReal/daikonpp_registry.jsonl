{"id":"c79c2d54-a67e-49c3-802e-91aa28a03be1","expr":"con != null","rationale":"The method operates on the URLConnection instance, so it must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#useCachesIfNecessary(URLConnection):void","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-08T06:37:48.550824715Z"}
{"id":"e323ad8c-9998-48ec-b879-934a36177c09","expr":"messageDigest != null","rationale":"The method calls messageDigest.update(byte), so messageDigest cannot be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.UpdateMessageDigestInputStream#updateMessageDigest(MessageDigest):void","file":"org/springframework/util/UpdateMessageDigestInputStream.java","createdAt":"2026-09-08T06:37:48.551057313Z"}
