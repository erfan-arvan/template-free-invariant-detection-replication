{"id":"0fe0a1fe-cec2-4ae9-945f-6ca91d28a09f","expr":"target != null && !target.isEmpty() || target == null || target.isEmpty()","rationale":"target is expected to be a non-empty processing instruction target string or possibly empty but still processed","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.303595668Z"}
{"id":"cbe66807-5ad8-421a-a079-0fb276fb20ad","expr":"data != null && data.length() >= 0","rationale":"data is a string and length is non-negative if data is non-null","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.303595668Z"}
{"id":"bb144aaa-8de4-4bbf-aaa6-4dadd3cc1792","expr":"qName != null","rationale":"startElement is usually called with qName being non-null as it's the qualified XML name.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.306224618Z"}
{"id":"b0160bcc-32c0-4a2e-b15b-a0aeab9603d1","expr":"(uri == null) || qName.startsWith(uri)","rationale":"If the namespace URI is present, qName often starts with it or incorporates it.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.306224618Z"}
{"id":"322ef035-597f-4e08-9e9b-91a9240add0b","expr":"localName != null","rationale":"Local name in XML parsing is required and typically non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.306224618Z"}
{"id":"d2de9e58-aab6-454b-b26c-efb02e901bce","expr":"atts != null","rationale":"Attributes parameter is likely always non-null to represent attribute list.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.306224618Z"}
{"id":"71554684-364c-4a1c-9972-e4cee2284935","expr":"atts.getLength() >= 0","rationale":"Attributes length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.306224618Z"}
{"id":"56e22bb6-f72a-43be-87e3-f72215e3df34","expr":"name != null && name.length() > 0","rationale":"The skippedEntity method is only meaningful if name is non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.307685608Z"}
{"id":"7296e72a-17a2-4a94-9996-90dc3d1822b8","expr":"name == null || name.indexOf(' ') == -1","rationale":"XML entity names do not contain whitespace characters.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.307685608Z"}
{"id":"39d40030-eda0-4a02-a70f-23c9af31c93a","expr":"name != null","rationale":"The 'name' parameter is used unconditionally to build the DOCTYPE string, so it must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.308203844Z"}
{"id":"60c98323-14e6-484f-9f1d-4bc1be3ea287","expr":"systemId != null","rationale":"In the method, systemId is appended without null guards, so it's expected to be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.308203844Z"}
{"id":"48dc7d9f-0be9-4230-89cd-6e8cc3265dc5","expr":"(publicId == null) || (publicId.length() > 0)","rationale":"If publicId is provided, it is used meaningfully, so if not null, it is presumably non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.308203844Z"}
{"id":"836d0065-83ab-4886-ac7c-d86af49859ff","expr":"name.length() > 0","rationale":"As 'name' is used in constructing DOCTYPE, it should have a positive length.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.308203844Z"}
{"id":"cc9778c8-6d39-4e88-8e28-47dda77c49a4","expr":"systemId.length() > 0","rationale":"The systemId string is appended directly; presumably it's non-empty for a valid DOCTYPE.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.308203844Z"}
{"id":"78aebc67-7cd4-434d-8959-a4c76240dde0","expr":"uri != null","rationale":"The uri parameter representing the namespace URI should not be null after method processing.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.299051143Z"}
{"id":"e7aaf71e-6e0f-46fe-b313-5a174dc6c56e","expr":"localName != null && !localName.isEmpty()","rationale":"The localName parameter should be non-null and non-empty as it identifies the element's local name.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.299051143Z"}
{"id":"3d28fa7c-db1b-41e9-85ab-54ff8b3a0ed5","expr":"atts != null","rationale":"The atts parameter should be a valid Attributes object, not null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.299051143Z"}
{"id":"c99d8c35-e3f8-4670-a3b0-f5f43040b0ab","expr":"atts.getLength() >= 0","rationale":"The atts object represents the attributes of the element and getLength returns the count, which should not be negative.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.299051143Z"}
{"id":"23692b2c-70d7-43d6-9bf9-2543bb7709fe","expr":"start <= ch.length","rationale":"Ensuring start index is within char array bounds.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.295458850Z"}
{"id":"eacee253-81f2-4851-9b73-7c91b42f6619","expr":"length <= ch.length","rationale":"Logical bound check for length relative to the char array size.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.295458850Z"}
{"id":"5d38427b-8231-4b52-8f7b-f6fc6eb5187e","expr":"start + length >= 0","rationale":"Ensures the parameters to String constructor are non-negative and valid.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.295458850Z"}
{"id":"fbbdcf46-c3ef-4d8c-b372-22cbcc2a1e4b","expr":"ch != null  &&  start >= 0  &&  length >= 0  &&  start + length <= ch.length","rationale":"The constructor new String(char[] value, int offset, int count) requires that offset and count specify a valid range within the array.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.322412935Z"}
{"id":"3edb35e0-c0d8-48ae-88e8-cac0238fa3cc","expr":"length >= 0","rationale":"Length describes how many characters from ch starting at start are used. Negative length would be invalid.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.322412935Z"}
{"id":"4f44a6c4-af57-47db-a3f0-5c7b6af5ede4","expr":"start >= 0","rationale":"Java array indexing requires start index to be at least 0.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.322412935Z"}
{"id":"5b745271-f995-4cb0-a8e3-fd84ab145b2d","expr":"start <= ch.length","rationale":"Start index must be within or at most equal to ch length to avoid IndexOutOfBounds.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.322412935Z"}
{"id":"8e9ca9c6-9a14-4c4b-88ec-5f9a8c9196af","expr":"name != null","rationale":"The method logically expects 'name' parameter to identify the entity starting.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.323416214Z"}
{"id":"e65c7765-f576-4159-8e69-35283b222120","expr":"name.length() > 0","rationale":"Entity names should generally be non-empty strings.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.323416214Z"}
{"id":"6b696596-3096-467c-a219-fc5d4f2cf97e","expr":"name.trim().length() == name.length()","rationale":"Leading or trailing spaces in name are generally disallowed or unintended.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.323416214Z"}
{"id":"7047ef15-d836-45f9-ad1f-41372b374aca","expr":"name != null","rationale":"The 'name' parameter should be non-null after the method starts processing an entity.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.327376560Z"}
{"id":"a6850135-cd1a-4e78-98f2-edbaf9af7566","expr":"name != null","rationale":"The method uses 'name' in a method call 'skippedEntityInternal(name)', so nullness is relevant.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.304243548Z"}
{"id":"2c06deb2-8d9f-433e-a232-0c8f337d7f9a","expr":"name.length() > 0","rationale":"Entity names in XML are usually non-empty strings.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.304243548Z"}
{"id":"d9e233fd-bd91-42a2-91fe-3141c7575b3d","expr":"name != null && name.length() > 0","rationale":"Based on the method appending name to the DOCTYPE, name must be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.310992144Z"}
{"id":"cc9e509c-d672-4a6d-ad21-26dd9330667a","expr":"(publicId != null) || (systemId != null && systemId.length() > 0)","rationale":"SystemId is appended either after 'PUBLIC' if publicId is present or after 'SYSTEM' otherwise, implying systemId is always non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.310992144Z"}
{"id":"ef1a94d5-aa45-4d1c-9f1f-8c26daeac5f5","expr":"systemId != null && systemId.length() > 0","rationale":"The method appends systemId in both branches implying systemId must be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.310992144Z"}
{"id":"fb5dfea4-6ef3-43c4-9be7-2d6a8be37a73","expr":"publicId == null || (publicId.length() > 0)","rationale":"The code appends 'PUBLIC \"' + publicId + '\" \"', so if publicId is not null, it likely is non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.310992144Z"}
{"id":"8a6c35c4-25fd-453a-b3d1-e97c0ddaf6ae","expr":"!(publicId != null && systemId == null)","rationale":"When publicId is non-null, systemId must also be non-null to produce a well-formed DOCTYPE declaration.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.310992144Z"}
{"id":"1788a85b-0a62-4c9c-9b97-770bcc70b6fd","expr":"!name.contains(\" \")","rationale":"XML entity names typically are tokens without whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.304243548Z"}
{"id":"eddeb692-203d-4a95-9089-0fddee39984a","expr":"qName != null","rationale":"Parameter qName should be non-null to access its methods.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#isNamespaceDeclaration(QName):boolean","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.335128645Z"}
{"id":"f8da1275-cb59-4bd7-8202-97ddd48feab7","expr":"qName.getPrefix() != null","rationale":"Prefix string should be non-null to allow empty check.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#isNamespaceDeclaration(QName):boolean","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.335128645Z"}
{"id":"4d55f04e-337b-4af0-b99f-25ee81fc209e","expr":"qName.getLocalPart() != null","rationale":"LocalPart string should be non-null to allow equality check.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#isNamespaceDeclaration(QName):boolean","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.335128645Z"}
{"id":"8cfb8ae7-5b19-4afe-a5dd-02728d68c164","expr":"qName.getLocalPart().length() >= 0","rationale":"Strings returned by getLocalPart have non-negative length.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#isNamespaceDeclaration(QName):boolean","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.335128645Z"}
{"id":"3675e55d-a551-4c50-bb39-f9bb938d50ad","expr":"result != null","rationale":"The method returns a new QName object constructed from inputs, so result is never null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.335841256Z"}
{"id":"ca2351da-4ba6-48f1-923d-7881a8b78ef0","expr":"qualifiedName.indexOf(':') == -1 || result.getLocalPart().equals(qualifiedName.substring(qualifiedName.indexOf(':') + 1))","rationale":"When qualifiedName contains ':', the local part in result is the substring after ':'.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.335841256Z"}
{"id":"fbf1d2d6-7b68-4889-bd78-f7d4d02d74c8","expr":"qualifiedName.indexOf(':') == -1 || result.getPrefix().equals(qualifiedName.substring(0, qualifiedName.indexOf(':')))","rationale":"When qualifiedName contains ':', the prefix in result is the substring before ':'.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.335841256Z"}
{"id":"ff93ab85-156c-4dfc-947c-3bfbca5708f1","expr":"result.getNamespaceURI() == namespaceUri","rationale":"The QName is constructed using the given namespaceUri, so result.getNamespaceURI() equals namespaceUri.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.335841256Z"}
{"id":"9d45bc13-84a5-4525-8b86-d9dead3f3367","expr":"qualifiedName.indexOf(':') == -1 || (!result.getLocalPart().contains(\":\") && !result.getPrefix().contains(\":\"))","rationale":"Local part and prefix are substrings split by ':', so they will not contain ':' themselves.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.335841256Z"}
{"id":"c1be2919-c23c-4c07-9478-dc776fb49193","expr":"!result || (qName.getPrefix().isEmpty() || !qName.getLocalPart().isEmpty())","rationale":"If the QName is declared as a namespace, then prefix is empty or localPart not empty holds.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#isNamespaceDeclaration(QName):boolean","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.338127500Z"}
{"id":"bc83a220-bbd3-4e43-b160-d33679cd34cb","expr":"!result || (qName.getLocalPart() != null && qName.getPrefix() != null)","rationale":"If result is true, both qName fields must be non-null to safely evaluate their equality to \"xmlns\".","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#isNamespaceDeclaration(QName):boolean","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.338127500Z"}
{"id":"8fbda03d-c2a9-4ea4-9983-465231a61695","expr":"result != null","rationale":"The method returns a map from the last element of a non-empty list, which is expected to be non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#currentNamespaceMapping():Map<String, String>","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.339887414Z"}
{"id":"1413f8ff-93f1-4dac-ab26-ae64ae3f836b","expr":"ch != null","rationale":"Creating a new String with the given char array requires that the array is non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.345829941Z"}
{"id":"f2b79ea6-02f8-4c7e-9ce0-0f8f33f91149","expr":"start >= 0","rationale":"The start index for substring extraction must be within valid array bounds, starting from zero.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.345829941Z"}
{"id":"a50b227d-ff91-4f1c-9123-f6c94ace8dbc","expr":"length >= 0","rationale":"Length passed to String constructor must be non-negative to avoid exceptions.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.345829941Z"}
{"id":"b131180c-4ca6-4d3e-90db-49c344e6985e","expr":"start + length <= ch.length","rationale":"The substring defined by start and length must fit entirely within the bounds of the char array.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.345829941Z"}
{"id":"47856708-25e7-444f-91c6-6d2a502734f1","expr":"contentHandler == null || contentHandler.getClass().getMethods().length > 0","rationale":"If contentHandler is not null, it should be a real content handler with methods defined (heuristic)","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractXMLReader#setContentHandler(ContentHandler):void","file":"org/springframework/util/xml/AbstractXMLReader.java","createdAt":"2026-09-08T06:37:51.347257600Z"}
{"id":"352c3a3f-827d-4e44-8ad4-920ad18d8bc1","expr":"qualifiedName != null","rationale":"The method accesses qualifiedName and calls methods on it, so it must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.348336611Z"}
{"id":"927e0cb3-76c3-4e7d-ad8e-7e31a6c4eecf","expr":"qualifiedName.indexOf(':') >= -1","rationale":"The indexOf method returns -1 or higher for any string.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.348336611Z"}
{"id":"2a9a187d-dd17-4770-bb07-77d3d6a8e8f2","expr":"(qualifiedName.indexOf(':') == -1) || (qualifiedName.indexOf(':') < qualifiedName.length() - 1)","rationale":"If ':' exists, the substring after ':' (localPart) should be valid and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.348336611Z"}
{"id":"690868b7-b3bc-42a6-b03d-452731bb7e05","expr":"namespaceUri == null || namespaceUri.length() >= 0","rationale":"namespaceUri can be null or any string length.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.348336611Z"}
{"id":"000847e1-0222-4063-92c6-377e55709305","expr":"qualifiedName.length() >= 0","rationale":"String length is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.348336611Z"}
{"id":"93e2582d-3180-4195-88a9-fe406a665075","expr":"contentHandler == null || contentHandler.getClass() != null","rationale":"If contentHandler is not null, it must have a non-null class object.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractXMLReader#setContentHandler(ContentHandler):void","file":"org/springframework/util/xml/AbstractXMLReader.java","createdAt":"2026-09-08T06:37:51.349653971Z"}
{"id":"645a0d31-759a-4a6e-b696-f19a652246dd","expr":"result == null || result.getClass() != null","rationale":"If result is not null, it must be a valid instance of ContentHandler (which must have a class).","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractXMLReader#getContentHandler():ContentHandler","file":"org/springframework/util/xml/AbstractXMLReader.java","createdAt":"2026-09-08T06:37:51.352541908Z"}
{"id":"b9cc2c1e-a357-4d96-a65e-3ea54d05fcb6","expr":"name != null","rationale":"The name parameter represents the entity name to end; it is expected to be non-null to identify the entity.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.362058364Z"}
{"id":"700d1092-8dec-46a7-86a5-512c7a025c5f","expr":"name.length() > 0","rationale":"An entity name having length greater than zero makes sense semantically for XML entity naming.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.362058364Z"}
{"id":"dbde3204-7f99-4db3-a432-4e8037137608","expr":"!name.contains(\" \")","rationale":"Entity names in XML do not generally contain whitespace characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.362058364Z"}
{"id":"234a2a7b-5ebf-492d-be36-c782aca2bf75","expr":"name.equals(name.trim())","rationale":"It is expected that entity names are trimmed and do not have excess whitespace around.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.362058364Z"}
{"id":"fe228820-3599-4e99-8bb0-9ac457141870","expr":"result == false","rationale":"The method returns false when the input name starts with 'http://xml.org/sax/features/'.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractXMLReader#getFeature(String):boolean","file":"org/springframework/util/xml/AbstractXMLReader.java","createdAt":"2026-09-08T06:37:51.363933885Z"}
