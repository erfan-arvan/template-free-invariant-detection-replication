{"id":"5302e405-5010-4adc-9176-5c9f8af4478d","expr":"start + len <= text.length","rationale":"'start + len' must not exceed 'text.length' to avoid StringIndexOutOfBoundsException.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeCharacters(char[],int,int):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:37:51.091572109Z"}
