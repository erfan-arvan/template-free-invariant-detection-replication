{"id":"49107bd2-1e39-4de7-9008-bdb005e04efa","expr":"location.indexOf(' ') >= -1","rationale":"indexOf returns -1 if space not found, otherwise a non-negative index.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toURI(String):URI","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-08T06:37:48.539846607Z"}
