{"id":"cfd6c631-9cf1-4d90-b3e5-779c29023479","expr":"attribute.isCodeAttribute() == true || attribute.isCodeAttribute() == false","rationale":"isCodeAttribute must return a boolean value indicating attribute type.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitAttribute(Attribute):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.592748423Z"}
{"id":"a882c39a-0187-40f7-a63f-9c81298d4ead","expr":"attribute != null","rationale":"Method uses attribute.isCodeAttribute(), so attribute must not be null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitAttribute(Attribute):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.593794182Z"}
{"id":"b9ca9bd3-c70e-408c-8554-df97fc43833e","expr":"attribute.nextAttribute != attribute","rationale":"Typically, the next attribute should not be self to avoid cycles.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitAttribute(Attribute):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.593794182Z"}
{"id":"1bd152d1-a066-489e-9e7a-948101e5099e","expr":"numLocal >= 0","rationale":"Number of local variables cannot be negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.609697332Z"}
{"id":"976baaff-8e36-484b-8b2d-4e6868de7b50","expr":"numStack >= 0","rationale":"Number of stack items cannot be negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.609697332Z"}
{"id":"bdd49dbf-e5dc-426d-90a6-89ffb10d9f96","expr":"(local == null && numLocal == 0) || (local != null && local.length >= numLocal)","rationale":"If local array exists, it must have length at least numLocal; if null, then numLocal must be zero.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.609697332Z"}
{"id":"6d771a26-ea03-4f74-b0be-3ec2c542f9d0","expr":"(stack == null && numStack == 0) || (stack != null && stack.length >= numStack)","rationale":"If stack array exists, it must have length at least numStack; if null, then numStack must be zero.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.609697332Z"}
{"id":"80624552-0f11-447a-b294-49bcdad9d7bf","expr":"type == 0 || type == 1 || type == 2 || type == 3 || type == 4 || type == 5","rationale":"The frame type must be one of the predefined constants (e.g., Opcodes.F_NEW, F_FULL, etc.).","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.609697332Z"}
{"id":"48b7b0dd-4c6e-48c8-bb9b-5c4616af584a","expr":"opcode >= 0","rationale":"Opcodes in ASM are typically non-negative integers corresponding to opcode values.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInsn(int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.621035108Z"}
{"id":"e6495eb0-bc86-4581-a9ad-acbf4bcbfe8f","expr":"opcode < 256","rationale":"ASM opcodes fit within a byte, so they must be less than 256.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInsn(int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.621035108Z"}
{"id":"673e99e4-0d85-49d8-92d8-d13c01e07f6a","expr":"opcode >= 0 && opcode <= 255","rationale":"Opcode values are expected within the unsigned byte range, consistent with standard JVM opcode ranges.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitInsn(int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.630987264Z"}
{"id":"1f911e50-1140-480f-8cc5-bc78df668d92","expr":"operand >= -32768 && operand <= 65535","rationale":"Operand is likely constrained to fit in 16-bit range for these instructions.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitIntInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.648686466Z"}
{"id":"922981ae-900f-4c8c-911b-cdec48abb079","expr":"opcode >= 0","rationale":"Opcode values represent instruction codes, typically non-negative.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitVarInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.650080661Z"}
{"id":"6c1b1b0a-f7dc-4f60-9064-584ff5b7bb04","expr":"varIndex >= 0","rationale":"Variable indexes in bytecode are always zero or positive.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitVarInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.650080661Z"}
{"id":"41ac5f18-b695-48fd-8cf4-eb5f505bc633","expr":"varIndex >= 0","rationale":"Local variable indices are non-negative indices.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitVarInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.650140994Z"}
{"id":"c36b1a6f-7ec3-4e5a-93b6-40053d30e85e","expr":"opcode >= 0","rationale":"Opcode should be non-negative as valid instruction codes.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitVarInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.650140994Z"}
{"id":"899a22a5-b1ee-4a96-9ef9-c762b1d393df","expr":"varIndex < 256 || varIndex >= 256","rationale":"Either varIndex is below 256 or at least 256 to choose encoding path.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitVarInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.650140994Z"}
{"id":"3637444a-97be-4f55-918e-3a6c043821fb","expr":"type != null","rationale":"The type parameter is used by symbolTable.addConstantClass(type), which requires type to be non-null","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTypeInsn(int,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.668487274Z"}
{"id":"06e50362-de6f-4092-8bf7-1dea0f8b3cdc","expr":"opcode >= 0","rationale":"Opcodes represent instruction codes and are usually non-negative integers","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTypeInsn(int,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.668487274Z"}
{"id":"2d697cc0-1b7e-4a61-ac9e-08a2a778d2e5","expr":"opcode <= 255","rationale":"Java bytecodes opcodes are defined as 1-byte unsigned values, so their values are between 0 and 255 inclusive","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTypeInsn(int,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.668487274Z"}
{"id":"e840191e-6e41-4477-9083-5bf73d40ab57","expr":"!type.isEmpty()","rationale":"The type string represents a class name and should not be empty","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTypeInsn(int,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.668487274Z"}
{"id":"c9e93cab-6b45-4ed7-af82-987534240c7c","expr":"opcode >= 0 && opcode <= 255","rationale":"The opcode parameter corresponds to JVM opcode values which are typically in the range 0 to 255.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTypeInsn(int,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.674809767Z"}
{"id":"d896017f-bfc2-4f34-ab72-1632ab542345","expr":"type != null && !type.isEmpty()","rationale":"The type argument, representing a class/type descriptor, should be a valid non-null non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTypeInsn(int,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.674809767Z"}
{"id":"b5c09a2a-1e91-47d2-bc78-9087c435dbf0","expr":"!type.contains(\" \")","rationale":"The internal name provided by 'type' is expected to be a valid descriptor without spaces.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTypeInsn(int,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.674809767Z"}
{"id":"e34dc4a4-1613-4b92-a52d-b68f04c2ad96","expr":"owner != null","rationale":"The internal name of the class owning the field should be a valid (non-null) string.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitFieldInsn(int,String,String,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.677126119Z"}
{"id":"5648f766-1fb0-44f8-9816-4c0ca6b2ab1e","expr":"name != null","rationale":"The name of the field should be non-null as a valid identifier.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitFieldInsn(int,String,String,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.677126119Z"}
{"id":"c7cb85c8-3964-4016-9cb4-af90c5df8b1f","expr":"descriptor != null","rationale":"The field descriptor is mandatory and must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitFieldInsn(int,String,String,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.677126119Z"}
{"id":"6d0ea9a9-3d10-4b74-9b77-8e7729f89fb9","expr":"opcode >= 0 && opcode <= 255","rationale":"Opcodes in the JVM bytecode are in the range 0 to 255 (byte values).","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitFieldInsn(int,String,String,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.677126119Z"}
{"id":"a8784254-258b-4b2d-8a33-b0062f29c4ca","expr":"(opcode == 178 || opcode == 179 || opcode == 180 || opcode == 181)","rationale":"The method deals with field instructions, so opcode must be one of the four related opcodes.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitFieldInsn(int,String,String,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.677126119Z"}
{"id":"836565f4-3740-492e-ba31-4af02caa97af","expr":"opcode == 178 || opcode == 179 || opcode == 180 || opcode == 181","rationale":"The opcode corresponds to one of the GETSTATIC, PUTSTATIC, GETFIELD, or PUTFIELD instructions.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitFieldInsn(int,String,String,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.703534116Z"}
{"id":"bc2e6213-c5a7-4c32-97bf-6bca47312247","expr":"owner != null && name != null && descriptor != null","rationale":"The method requires non-null owner, name, and descriptor strings to add fieldref symbol.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitFieldInsn(int,String,String,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.703534116Z"}
{"id":"157ce83d-1af5-4472-a9de-95ee93dc2446","expr":"(opcode == 178 || opcode == 179) || (opcode == 180 || opcode == 181)","rationale":"The opcode partitions into static (GETSTATIC, PUTSTATIC) and instance (GETFIELD, PUTFIELD) field instructions.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitFieldInsn(int,String,String,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.703534116Z"}
{"id":"c9ffa7b4-c0d3-4ccb-beb2-ddb819c4a2b4","expr":"owner != null","rationale":"The owner parameter is the internal name of the method's owner class and must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.704155095Z"}
{"id":"40baf46f-7694-40d6-a7e6-7db06dae2560","expr":"name != null","rationale":"The method name identifies the method and should always be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.704155095Z"}
{"id":"9b4e83b2-fb0a-4ef2-926a-444ea522e27f","expr":"descriptor != null","rationale":"The method descriptor describes the types of arguments and return value and hence must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.704155095Z"}
{"id":"44339867-1601-427d-a1a0-95b5041759bd","expr":"opcode >= 0","rationale":"The opcode parameter represents a JVM bytecode instruction and is expected to be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.704155095Z"}
{"id":"ebb6df42-6be1-49c9-a6d6-20448023d893","expr":"(opcode == 185) == isInterface","rationale":"If the opcode indicates an interface method invocation, the isInterface boolean should be true, otherwise false.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.704809928Z"}
{"id":"566b906f-af18-401d-b8db-226ef9f0d6c5","expr":"owner != null","rationale":"The owner of the method invoked should be a valid class name string and should not be null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.704809928Z"}
{"id":"aaff464e-0ed6-401f-a229-f8a4f539be8c","expr":"name != null && name.length() > 0","rationale":"The method name must be a valid non-empty string to represent the invoked method.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.704809928Z"}
{"id":"9ac9fadf-acbd-4e57-bbc7-1d889b8a7612","expr":"descriptor != null && descriptor.length() > 0","rationale":"Method descriptor is expected to be valid non-empty string describing the method signature.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.704809928Z"}
{"id":"ca61047c-f0aa-46cb-a2f6-a562b7688794","expr":"opcode != 0","rationale":"Opcode should be a valid JVM instruction opcode and is unlikely to be zero at this point in the code.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.704809928Z"}
{"id":"80d7e544-0d8f-41d6-87b8-1f21e7ce738b","expr":"opcode >= 0","rationale":"Opcode values are generally non-negative integers representing bytecode instructions","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitJumpInsn(int,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.725788604Z"}
{"id":"9da813be-6015-4bb8-af57-f221c80e4f36","expr":"label != null","rationale":"The label parameter should never be null as it represents the label to be visited.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitLabel(Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.733786140Z"}
{"id":"1a51dc1e-ff73-4b28-b0f7-12b937e05211","expr":"label.flags >= 0","rationale":"Flags usually represent bit flags, so negative values don't make sense.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitLabel(Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.733786140Z"}
{"id":"dab767cc-9c58-45ac-bdc4-836afbb8dbed","expr":"label.bytecodeOffset >= 0","rationale":"Labels represent a position in bytecode, which is never negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitLabel(Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.733786140Z"}
{"id":"3d7a80e7-0304-4c63-9840-7d6cc86f9361","expr":"label.frame == null || label.frame.owner == label","rationale":"From the context, label.frame is either null or has owner field pointing to label; this maintains frame ownership consistency.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitLabel(Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.733786140Z"}
{"id":"8025f6d9-8962-4247-ae8f-b9d5e8960883","expr":"name != null","rationale":"The name of the method or dynamic call must be non-null for the invoke dynamic instruction to be valid.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.737229213Z"}
{"id":"a7a97473-abc5-45bc-af5f-750757c681f1","expr":"descriptor != null","rationale":"Because the method descriptor is fundamental to the bytecode instruction, it should not be null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.737229213Z"}
{"id":"782fd5ab-64f2-46e1-bd8c-50d3ebed19a9","expr":"bootstrapMethodHandle != null","rationale":"This handle is necessary to create the constant invoke dynamic symbol.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.737229213Z"}
{"id":"f561b355-bb63-4b02-ae3e-ee8bd39b9d2f","expr":"bootstrapMethodArguments == null || bootstrapMethodArguments.length >= 0","rationale":"Array length properties are always non-negative but this confirms non-null or empty args are possible.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.737229213Z"}
{"id":"7721d3fb-c266-4f51-99e2-9b4349d0585f","expr":"name != null","rationale":"The name parameter should represent a method or field name and thus must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.737399303Z"}
{"id":"2ae4bd14-9585-4bd7-b9f9-4395a4c842a2","expr":"descriptor != null","rationale":"The descriptor defines the method type descriptor and must always be present.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.737399303Z"}
{"id":"73a7f527-8b55-41d3-ad5f-d04f82ef482b","expr":"bootstrapMethodHandle != null","rationale":"The bootstrap method handle is essential for resolving the invoke dynamic call site.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.737399303Z"}
{"id":"d4f53a41-2f11-45d0-818b-ac27bf6c866b","expr":"bootstrapMethodArguments == null || bootstrapMethodArguments.getClass().isArray()","rationale":"Bootstrap method arguments represent varargs and are modeled as Object, so they must be an array type or null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.737399303Z"}
{"id":"e8027a6f-9216-4572-be28-aa9e66858f67","expr":"label != null","rationale":"The label parameter must be non-null because label.flags and label.put are accessed without null checks.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitJumpInsn(int,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.746707658Z"}
{"id":"c0023e7e-3a36-4ae8-86c4-95bc7a7b33a6","expr":"label.flags >= 0","rationale":"Label flags are used in bitwise operations which are typically non-negative flags.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitJumpInsn(int,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.746707658Z"}
{"id":"84438a26-4843-45e6-ae88-72ce6d6c7845","expr":"opcode >= 0 && opcode <= 255","rationale":"In JVM bytecode, opcodes are between 0 and 255 inclusive.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitJumpInsn(int,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.746707658Z"}
{"id":"15ede3fe-cfd9-4acc-b1b3-60580e458e42","expr":"label != null","rationale":"Label must be non-null at method exit.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLabel(Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.760116843Z"}
{"id":"37d62c24-2fc9-4b49-8480-f555eaba9f18","expr":"label.frame == null || label.frame.owner == label","rationale":"The frame owner is updated to label or label.frame can be null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLabel(Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.760116843Z"}
{"id":"8d2c801e-8717-4c06-a169-224472f57906","expr":"label.bytecodeOffset >= 0","rationale":"Basic blocks and labels alignment imply non-negative bytecode offset.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLabel(Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.760116843Z"}
{"id":"64ff49d2-b450-4b31-ad9b-625c2b341070","expr":"value != null || value == null","rationale":"value parameter may be null or non-null based on user input or caller context.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLdcInsn(Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.761182098Z"}
{"id":"30297b26-3628-4ace-879f-621ec36ec04e","expr":"value == null || value.getClass() != null","rationale":"If value is non-null, calling getClass() is safe and returns non-null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLdcInsn(Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.761182098Z"}
{"id":"dc749b4f-f77a-489a-aff7-281051b76c18","expr":"value == null || value.toString().length() >= 0","rationale":"Ensures that for non-null value, calling toString and length is safe and well-defined.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLdcInsn(Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.761182098Z"}
{"id":"42aa3aa4-1068-479f-9501-46a79f500185","expr":"value != null","rationale":"The value passed to visitLdcInsn is typically a constant to be added; expecting non-null is common though null may be allowed.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitLdcInsn(Object):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.783196123Z"}
{"id":"35901bfb-652d-4e8e-8647-18ae6aa0a40d","expr":"varIndex >= 0","rationale":"Local variable indexes in bytecode are non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.789503938Z"}
{"id":"0935a744-47d2-43bf-976d-9fdfbff6c425","expr":"increment <= 127","rationale":"Increment values fit in a signed byte range for the non-wide case.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.789503938Z"}
{"id":"07b9d787-aead-49c9-80b2-ef26396d9dfa","expr":"increment >= -128","rationale":"Increment values fit in a signed byte range for the non-wide case.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.789503938Z"}
{"id":"b25572e2-b86a-4f17-9ba7-7a82154b4d91","expr":"(varIndex > 255) || (increment > 127) || (increment < -128)","rationale":"The method uses the WIDE instruction if any of these conditions is true.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.789503938Z"}
{"id":"dbf18fef-497b-4624-b780-9adc4324e415","expr":"varIndex <= 65535","rationale":"VarIndex when wide encoded must fit in a short according to standard JVM constraints.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.789503938Z"}
{"id":"2d983d10-e549-4360-9fa2-358d8a0795a3","expr":"(varIndex >= 0)","rationale":"Local variable index should be non-negative as it refers to a variable slot in the frame.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.801893294Z"}
{"id":"089742a4-eb04-4019-879f-3a610a99e5a5","expr":"(increment >= -128 && increment <= 127) || (varIndex > 255)","rationale":"If varIndex > 255 or increment is out of the range [-128, 127], the WIDE instruction is used.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.801893294Z"}
{"id":"e4a623be-83f6-43ee-bd3c-a3d5d6eda5a3","expr":"varIndex < 256 || increment < -128 || increment > 127","rationale":"If varIndex is below or equal 255 and increment fits in signed byte, WIDE not used.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.801893294Z"}
{"id":"db88f9d4-cf43-4bba-a590-75e7890e3c81","expr":"increment >= -128 && increment <= 127","rationale":"Increment value for IINC must fit in signed byte if WIDE prefix is not used.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.801893294Z"}
{"id":"44c9c703-6dcb-4028-8bc3-638f8c294c9d","expr":"varIndex + 1 >= 1","rationale":"maxLocals is updated if current varIndex + 1 is greater than existing maxLocals, thus varIndex + 1 >= 1.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.801893294Z"}
{"id":"a8024a47-14db-47ab-8497-0665ae1007da","expr":"min <= max","rationale":"In a tableswitch instruction, the min bytecode value is always less than or equal to max to define a valid switch case range.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.802882225Z"}
{"id":"6794f264-b819-43aa-b519-f2d4e9f9bdcc","expr":"labels != null","rationale":"The labels parameter cannot be null because the method iterates over labels to put them to the code.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.802882225Z"}
{"id":"dea89225-d244-4143-934b-6a48b03ea8ca","expr":"labels.length == max - min + 1","rationale":"The label array should contain exactly one Label entry per possible switch value between min and max.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.802882225Z"}
{"id":"7cac07e2-a332-4afe-a319-17d3ab2f1f3b","expr":"dflt != null","rationale":"The default label is used for all keys not covered by the range and labels, so it must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.802882225Z"}
{"id":"012311a7-ccd3-4d14-b519-7365e800ee18","expr":"labels != null","rationale":"The labels array is documented as a varargs parameter and used in a loop and method calls, so it cannot be null here.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.803222977Z"}
{"id":"44f45ff4-5642-45fb-905c-7ffe4714f199","expr":"labels.length == max - min + 1","rationale":"A table switch requires a label for each value from min to max inclusive, so labels length equals max-min+1.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.803222977Z"}
{"id":"17fb7d77-96b1-492b-a121-488dc062141e","expr":"min <= max","rationale":"A table switch instruction requires a valid range with min <= max to be meaningful.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.803222977Z"}
{"id":"a07a8aa4-8ca8-40e1-ad48-0496f0e3adb9","expr":"dflt != null","rationale":"Since dflt.put() is called, dflt cannot be null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.803222977Z"}
{"id":"db579c2c-984d-4291-ac08-916de1aad372","expr":"labels.length >= 0","rationale":"Though trivial, this asserts labels array length is not negative.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.803222977Z"}
{"id":"94deb0f0-9899-4520-a6c6-50366e7f69c6","expr":"dflt != null","rationale":"A lookup switch instruction must have a valid default label.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.810584797Z"}
{"id":"9b300221-1018-490c-9262-414345ec1a36","expr":"keys != null && labels != null","rationale":"The keys and labels arrays are essential for the lookup switch and cannot be null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.810584797Z"}
{"id":"c7680b54-ff95-46d3-8326-3e1e8387925e","expr":"keys.length == labels.length","rationale":"Each key has a corresponding label, so the lengths must match.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.810584797Z"}
{"id":"6da81aef-ad19-443b-9c87-fd7ccd2b2341","expr":"labels.length >= 0","rationale":"Array length can't be negative; labels.length must be >= 0.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.810584797Z"}
{"id":"38a1a417-e240-442f-bb31-6f093c1c2370","expr":"keys != null && labels != null","rationale":"The keys and labels arrays are required and assumed non-null to support iteration and processing.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.824954540Z"}
{"id":"c0e6a737-97da-4042-8405-307cf701f742","expr":"keys.length == labels.length","rationale":"The keys and labels arrays represent a mapping from keys to labels; they must be of equal length.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.824954540Z"}
{"id":"d86d96bc-29e6-4406-a204-c5c565874f90","expr":"dflt != null","rationale":"The default label is needed for the switch instruction and should not be null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.824954540Z"}
{"id":"1c127f51-002a-4e1e-9d79-ce46a69199a1","expr":"labels.length >= 0","rationale":"Array lengths are non-negative by definition.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.824954540Z"}
{"id":"4bc56ba7-9856-426e-a106-9ff18bcf1fe0","expr":"keys.length >= 0","rationale":"Array lengths are non-negative by definition.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.824954540Z"}
{"id":"b9d04b27-8b64-4e1a-acfe-8c609326b3a7","expr":"dflt != null","rationale":"The default label must be provided and is used immediately.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitSwitchInsn(Label,Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.826655332Z"}
{"id":"ffe1629f-e408-41e0-a431-642972077257","expr":"labels != null","rationale":"The labels array must be provided to add successors.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitSwitchInsn(Label,Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.826655332Z"}
{"id":"dedcbed1-28bd-472b-b51c-18d805da1237","expr":"labels.length >= 0","rationale":"Labels is an array, so length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitSwitchInsn(Label,Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.826655332Z"}
{"id":"6bd77bf3-3542-4482-bdc2-7d3cfef20b9a","expr":"dflt.getCanonicalInstance() != null","rationale":"The method calls getCanonicalInstance on dflt and expects it non-null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitSwitchInsn(Label,Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.826655332Z"}
{"id":"8d17f902-afba-4e5e-a70c-0d91eca31f7f","expr":"dflt != null","rationale":"The default label is always used as a successor and its flag is set, so it must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitSwitchInsn(Label,Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.840338223Z"}
{"id":"8d6d465f-c210-4248-9898-d291b8f3e1a6","expr":"labels != null && labels.length > 0","rationale":"Labels array is iterated over to add successors and set flags, so it must be non-null with at least one element.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitSwitchInsn(Label,Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.840338223Z"}
{"id":"49fd5198-3e94-471d-befc-ece44dbfa484","expr":"dflt.getCanonicalInstance() != null","rationale":"A canonical instance is accessed and flags updated, so must not be null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitSwitchInsn(Label,Label[]):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.840338223Z"}
{"id":"a5ac1e82-2e00-4e2b-93c5-b6545b3b99e2","expr":"descriptor != null","rationale":"The descriptor string must be non-null as it is used to add a constant class.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.846843530Z"}
{"id":"63215f03-915a-43cb-8e62-7ddbaf87d2ff","expr":"numDimensions >= 1","rationale":"The number of dimensions for a new multi-array must be at least one.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.846843530Z"}
{"id":"74bdd876-7d38-4667-b1d7-7ec9f4206ad0","expr":"!descriptor.isEmpty()","rationale":"The descriptor must not be an empty string for the method to function correctly.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.846843530Z"}
{"id":"99d175f9-f2ba-4572-b8b6-5951520505c3","expr":"descriptor != null","rationale":"The method uses descriptor to add a constant class symbol and does not check for null, so descriptor must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.858957527Z"}
{"id":"51477e06-d5d4-44e6-98ad-73662b6b562b","expr":"numDimensions > 0","rationale":"numDimensions represents the number of array dimensions and must be positive for the MULTIANEWARRAY instruction.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.858957527Z"}
{"id":"659426f2-4013-472c-80ab-669ba707b48e","expr":"numDimensions <= descriptor.length()","rationale":"The number of dimensions specified cannot exceed the length of the descriptor string representing the array type.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.858957527Z"}
{"id":"d3847423-6bf4-4175-ba19-7fe5a83a1301","expr":"descriptor.startsWith(\"[[\") || !descriptor.contains(\"[\")","rationale":"The descriptor should start with at least one or two '[' characters indicating array dimensions for a multi-dimensional array.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.858957527Z"}
{"id":"a8684d97-291b-43da-b9f8-39a81b151d02","expr":"result != null","rationale":"The method returns an AnnotationWriter created from AnnotationWriter.create, which never returns null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitInsnAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.859187830Z"}
{"id":"375e2c3c-aaec-419d-83e9-75dcd313a3c4","expr":"descriptor != null && !descriptor.isEmpty()","rationale":"Annotations have a valid non-empty descriptor string.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInsnAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.859721214Z"}
{"id":"95cc4b7e-4f39-4d59-90d4-8047545c8ad6","expr":"typeRef >= 0","rationale":"typeRef should be a non-negative integer as it encodes annotation type reference flags.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInsnAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.859721214Z"}
{"id":"f849556d-28d0-45fe-a0a6-fde75aca04b2","expr":"typePath == null || typePath.isEmpty() || typePath.getLength() >= 0","rationale":"TypePath if not null is either empty or has a non-negative length.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInsnAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.859721214Z"}
{"id":"0bb5f4bd-2a8c-469b-bcc7-0a10dfd6aa5f","expr":"visible == true || visible == false","rationale":"visible is a boolean and can only be true or false.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInsnAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.859721214Z"}
{"id":"f33cf86a-6db9-4383-a045-df4e78f7d94d","expr":"numDimensions <= 255","rationale":"numDimensions is stored as a byte, so it must be within 0 and 255 inclusive.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.858957527Z"}
{"id":"8d373704-ff01-434e-a6a3-734369abf940","expr":"start != null","rationale":"The start Label is used directly in creating a new Handler instance, so it must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.867344546Z"}
{"id":"fee7d80d-9057-4396-b44a-837a715f78d9","expr":"end != null","rationale":"The end Label is also passed to the Handler constructor, indicating it should be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.867344546Z"}
{"id":"7f944c79-6df0-46c4-81ab-451c58f202af","expr":"handler != null","rationale":"The handler Label is used directly in the Handler constructor and thus must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.867344546Z"}
{"id":"94396a19-f0cd-465d-b1a1-a3375e0c79f0","expr":"(start.position < end.position)","rationale":"In a try-catch block, the start label must precede the end label, so start.position < end.position should hold.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.867344546Z"}
{"id":"29f8923e-bcdf-4f54-ad1f-de3a3c7ea8df","expr":"(type != null) || (type == null)","rationale":"type may be null or not, no direct constraint but relevant to use symbolTable.addConstantClass when non-null","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.882121116Z"}
{"id":"4b1c3c37-06d4-4c30-980d-f5b1fafb9d2b","expr":"start != null","rationale":"start label must be non-null as it is passed to Handler constructor","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.882121116Z"}
{"id":"21eb8867-83b8-409b-856f-60aa13b98b36","expr":"end != null","rationale":"end label must be non-null as it is passed to Handler constructor","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.882121116Z"}
{"id":"2e148878-ea73-4510-bc52-1230d1710453","expr":"handler != null","rationale":"handler label must be non-null as it is passed to Handler constructor","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.882121116Z"}
{"id":"858a56c4-9465-48fa-b34d-09959ef318b6","expr":"descriptor != null","rationale":"The descriptor string representing the annotation type should not be null for creating an annotation.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTryCatchAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:38:02.883298673Z"}
