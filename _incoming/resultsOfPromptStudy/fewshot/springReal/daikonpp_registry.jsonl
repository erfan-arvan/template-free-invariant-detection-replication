{"id":"17931a80-f44d-485f-a8b1-cd80c4e50e3d","expr":"local != null && nLocal <= local.length","rationale":"The nLocal count cannot be greater than the available slots in the local array.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:38:00.562252654Z"}
{"id":"693939b6-1bec-493e-934e-3a102e9b6691","expr":"attr != null","rationale":"Since attr is passed directly to mv1.visitAttribute and mv2.visitAttribute without null checks, attr should not be null","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:38:00.567332788Z"}
