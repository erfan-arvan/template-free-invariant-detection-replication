{"id":"0ab46228-1127-43f1-897f-c0b6ad7ec1c4","expr":"desc != null","rationale":"desc should be a non-null descriptor string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitInsnAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:38:00.604377041Z"}
