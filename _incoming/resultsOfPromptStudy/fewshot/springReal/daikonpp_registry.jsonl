{"id":"7ae163ce-5393-4aa5-a72e-397488c613e6","expr":"namespace.getPrefix() != null","rationale":"Namespace prefix should be defined and non-null for proper XML serialization.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#doWriteNamespace(Namespace):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:37:51.055784913Z"}
{"id":"4893634c-4e08-4aa8-81df-cb0eabc70032","expr":"namespaceURI == null || !namespaceURI.contains(\"␀\")","rationale":"XML namespace URIs do not include null characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:37:51.048781448Z"}
{"id":"ffabdb1f-43d7-4bd2-8668-720d6a4e64b9","expr":"namespaceURI == null || !namespaceURI.contains(\" \")","rationale":"XML namespace URIs conventionally do not contain spaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:37:51.048781448Z"}
{"id":"7c7e2ca2-d3e4-47e5-abfd-4854193dcafe","expr":"namespaceURI == null || namespaceURI.equals(namespaceURI.trim())","rationale":"Namespace URIs usually do not have leading or trailing whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:37:51.048781448Z"}
