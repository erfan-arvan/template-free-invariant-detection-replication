{"id":"e554e081-b8c2-406d-8a3f-c1be99ec8295","expr":"namespaceURI == null || namespaceURI.indexOf(':') == -1","rationale":"Namespace URIs are usually URIs without embedded ':' except in some cases; this captures that they typically don't contain colon","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:37:51.050626952Z"}
