{"id":"9e33a1f3-011a-442a-98f8-7fec98a957fa","expr":"method.getDeclaringClass().isAssignableFrom(method.getDeclaringClass())","rationale":"The declaring class of the method is always assignable from itself.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.795546975Z"}
{"id":"57f360bf-9401-4335-a957-886111a5f04e","expr":"result != null","rationale":"The method returns a non-null qualified name string.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.811501041Z"}
{"id":"521bbb85-fede-4b4d-9fd5-35fdc9dc2329","expr":"result.contains(method.getName())","rationale":"The qualified name must include the method name.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.811501041Z"}
{"id":"e122f799-3a31-482a-920a-6a239473803e","expr":"!result.isEmpty()","rationale":"A qualified method name cannot be empty.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.811501041Z"}
{"id":"ec9b4b2b-105d-42cb-97d1-719dae815d26","expr":"result.startsWith(method.getDeclaringClass().getName())","rationale":"A qualified method name includes the declaring class name as a prefix.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.811501041Z"}
{"id":"b4b5065a-1138-403f-93b6-2dab57d76b45","expr":"result.startsWith((clazz != null ? clazz : method.getDeclaringClass()).getName())","rationale":"The returned qualified method name always starts with the class name corresponding to clazz if not null, else method.getDeclaringClass()","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method,Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.817561341Z"}
{"id":"849a59a1-ca1a-43a8-8279-45cbf63cd1a6","expr":"result.endsWith(method.getName())","rationale":"The qualified method name always ends with the simple name of the method","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method,Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.817561341Z"}
{"id":"6bc69b0e-b740-4ecf-b88d-7de7b5c53876","expr":"result.contains(\".\")","rationale":"The returned string concatenates class name, a dot, and method name, so it must have a dot","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method,Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.817561341Z"}
{"id":"1df15a6f-cb4b-4da0-8098-5e10d5275886","expr":"clazz != null","rationale":"A non-null class is required to determine if it has a constructor.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasConstructor(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.818567034Z"}
{"id":"caaafc63-627f-4417-aa29-f20a9dc7649e","expr":"paramTypes != null","rationale":"Non-nullity of paramTypes ensures the method can safely check constructors with given parameter signature.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasConstructor(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.818567034Z"}
{"id":"ac51c0c4-fbb3-441b-bab0-95c468f544ae","expr":"paramTypes.getClass().isArray()","rationale":"Ensures paramTypes can be treated as the varargs Class parameter.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasConstructor(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.818567034Z"}
{"id":"83af639c-a909-4ab8-8173-9380d771017d","expr":"clazz.isInterface() == false","rationale":"Indicates that clazz is not an interface, relevant as interfaces do not have constructors.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasConstructor(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.818567034Z"}
{"id":"72804bce-fc95-479d-8055-73079f34caaf","expr":"clazz.getClassLoader() != null","rationale":"Having a class loader is typical for classes that can have constructors.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasConstructor(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.818567034Z"}
{"id":"f54721fd-a26c-4f8f-84b2-478d1daaedf4","expr":"clazz != null && paramTypes != null || !result","rationale":"The method returns true only if a constructor with the given parameter types is available, which requires clazz and paramTypes not to be null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#hasConstructor(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.823817760Z"}
{"id":"abce5dd7-4493-4db0-b424-786005d37c51","expr":"clazz != null","rationale":"The method asserts that 'clazz' is not null at the start.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getConstructorIfAvailable(Class<T>,Class<?>):Constructor<T>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.824965711Z"}
{"id":"f408915c-cd83-4cb4-b2b7-73f69ac21c90","expr":"paramTypes != null","rationale":"The varargs array 'paramTypes' is never null when called in Java varargs context.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getConstructorIfAvailable(Class<T>,Class<?>):Constructor<T>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.824965711Z"}
{"id":"8fc50e99-38df-416c-a89e-d7a51e9fab66","expr":"paramTypes.getClass().isArray()","rationale":"The paramTypes parameter is declared as an array of Class objects.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getConstructorIfAvailable(Class<T>,Class<?>):Constructor<T>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.824965711Z"}
{"id":"c8c803c7-a97a-4ba9-bf41-7ff6d445e589","expr":"clazz != null","rationale":"The method requires clazz to be non-null, hence this invariant ensures the input parameter is valid.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedName(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.825486922Z"}
{"id":"ac2a4d9c-faaf-4966-abae-0ed54e599e14","expr":"clazz.getName().length() > 0","rationale":"The class name must be a valid non-empty string since the Class object must represent a valid class.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedName(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.825486922Z"}
{"id":"1052b11a-6aa0-4d88-a3f2-c5ce30a76ec2","expr":"clazz.getTypeName().equals(clazz.getName())","rationale":"In Java, getTypeName() and getName() typically return the fully qualified name of the class including package.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedName(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.825486922Z"}
{"id":"57d533f4-09f2-4ce2-bfd2-9c2a388f3dea","expr":"!clazz.isPrimitive() || clazz.getTypeName().length() > 0","rationale":"Primitives have type names like int, boolean, which are non-empty strings.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedName(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.825486922Z"}
{"id":"a93a2d83-4750-4966-8eb7-2e233b14aa14","expr":"clazz.isArray() == clazz.getTypeName().startsWith(\"[\")","rationale":"The class is an array if and only if its type name starts with '['.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedName(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.825486922Z"}
{"id":"f009909c-0937-4d6a-88b4-03cb6f4fead7","expr":"result != null","rationale":"The method returns an empty string if no package is found, thus result is never null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getPackageName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.837674417Z"}
{"id":"5b5838de-ccbe-433f-a0f3-1f90b2d2b3b7","expr":"result.isEmpty() || fqClassName.startsWith(result + \".\")","rationale":"When there is a package, result is the substring up to the last dot, so fqClassName should start with package plus dot.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getPackageName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.837674417Z"}
{"id":"b130e403-84ee-461b-a2ae-bee67cc94225","expr":"result.equals(\"\") || result.indexOf('.') >= 0","rationale":"If there is a package name, it must contain at least one dot, since it is extracted as substring before last dot.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getPackageName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.837674417Z"}
{"id":"80743384-20f8-4584-b1f0-d958a89acf02","expr":"result.length() < fqClassName.length()","rationale":"If package is non-empty, it is a prefix, so shorter; if empty, length is 0 which is less than class name length.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getPackageName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.837674417Z"}
{"id":"5714d0d7-cf57-48c2-93f2-5b6d3098f1f6","expr":"!result.isEmpty() || fqClassName.indexOf('.') == -1","rationale":"If result is empty, no dot was found in fqClassName, otherwise lastIndexOf('.') would be >=0.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getPackageName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.837674417Z"}
{"id":"e7132995-147b-45e1-9729-9febad73d34d","expr":"clazz != null","rationale":"The method asserts clazz must not be null at entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,Method):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.853697593Z"}
{"id":"c3210dd8-06a5-494e-9772-0e9258eb8462","expr":"method != null","rationale":"The method asserts method must not be null at entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,Method):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.853697593Z"}
{"id":"33171686-77c8-49b6-8312-f7346263a195","expr":"method.getDeclaringClass() != null","rationale":"A Method object always has a non-null declaring class.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,Method):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.853697593Z"}
{"id":"c8023926-131d-4527-9923-d350f53c914b","expr":"method.getName() != null","rationale":"Method name is always non-null in Java reflection.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,Method):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.853697593Z"}
