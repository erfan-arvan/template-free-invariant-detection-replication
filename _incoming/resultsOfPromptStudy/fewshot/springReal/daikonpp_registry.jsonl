{"id":"28ed02de-c4ec-43e2-abeb-c3d94a2c6d85","expr":"!dtd.contains(\"<?\")","rationale":"Processing instructions are a separate XML construct and unlikely part of a DTD content string.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxEventHandler#dtdInternal(String):void","file":"org/springframework/util/xml/StaxEventHandler.java","createdAt":"2026-09-08T06:37:50.689973522Z"}
