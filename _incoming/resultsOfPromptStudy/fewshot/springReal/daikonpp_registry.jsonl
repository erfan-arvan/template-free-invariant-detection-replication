{"id":"3bc4115a-d380-4d11-b4df-be00ce89ecf3","expr":"clazz.isInstance(result)","rationale":"The returned object should be an instance of the class clazz.","kind":"METHOD_EXIT","element":"org.springframework.objenesis.SpringObjenesis#newInstance(Class<T>):T","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-08T06:38:05.650782285Z"}
