{"id":"2417c745-584a-49dd-afe1-1f616c15d57c","expr":"opcode <= 255","rationale":"Opcode fits in a byte as opcodes in ASM range from 0 to 255.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitInsn(int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:38:05.412758746Z"}
{"id":"6c1481cb-546a-4f6d-8d93-5f2a9e551f44","expr":"numLocal >= 0 && numLocal <= (local == null ? 0 : local.length)","rationale":"numLocal cannot be negative and must not exceed local array length.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:38:05.412745381Z"}
