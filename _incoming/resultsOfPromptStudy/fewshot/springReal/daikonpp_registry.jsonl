{"id":"e350c7bc-6521-4ebc-9af8-f8ab492c7c76","expr":"uri != null || (localName != null && qName != null)","rationale":"Either uri is provided, or both localName and qName are provided, to identify the element.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.290131791Z"}
{"id":"07188f29-5840-4dd4-9df0-84bf8714b2e6","expr":"(qName == null) || qName.length() > 0","rationale":"If qName is provided, it is not empty, representing a qualified XML name.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.290131791Z"}
{"id":"7b366f98-1692-4966-8efc-7f248892df35","expr":"(localName == null) || localName.length() >= 0","rationale":"localName is a string representing the local part of the element name.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.290131791Z"}
{"id":"db805f95-8234-4ea5-a163-efe21054ad48","expr":"uri == null || uri.length() >= 0","rationale":"uri is a namespace URI string, can be null or non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.290131791Z"}
