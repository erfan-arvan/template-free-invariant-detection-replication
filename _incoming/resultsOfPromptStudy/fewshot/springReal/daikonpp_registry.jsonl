{"id":"e9242d90-c709-459b-91f5-7fe141864b95","expr":"local == null || local.length >= numLocal","rationale":"Local array length must cover the declared number of local variables.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:38:05.412745381Z"}
{"id":"2d06cbfa-d0b1-4046-a4b7-bee2eb779332","expr":"stack == null || stack.length >= numStack","rationale":"Stack array length must cover the declared stack elements.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:38:05.412745381Z"}
{"id":"b3755a3d-9380-4dff-bb92-04d2476e913c","expr":"opcode >= 0","rationale":"Opcodes generally correspond to a set of predefined instruction constants which are non-negative.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitInsn(int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:38:05.413058090Z"}
{"id":"617fc8f0-1fad-45d7-ae1c-3f4d37148e22","expr":"opcode <= 255","rationale":"Opcodes in JVM bytecode are usually defined as single byte values.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitInsn(int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:38:05.413058090Z"}
