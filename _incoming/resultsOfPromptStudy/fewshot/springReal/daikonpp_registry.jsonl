{"id":"3e8f3585-fe75-4cee-a4ef-7717f94bd1f0","expr":"clazz != null","rationale":"The method expects a non-null Class object to operate on.","kind":"METHOD_ENTRY","element":"org.springframework.objenesis.SpringObjenesis#getInstantiatorOf(Class<T>):ObjectInstantiator<T>","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-08T06:38:05.651302515Z"}
{"id":"21e18962-2e7f-45b5-badf-d81fef9cdb70","expr":"clazz.isInterface() == false","rationale":"Instantiators generally operate on concrete classes, not interfaces.","kind":"METHOD_ENTRY","element":"org.springframework.objenesis.SpringObjenesis#getInstantiatorOf(Class<T>):ObjectInstantiator<T>","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-08T06:38:05.651302515Z"}
