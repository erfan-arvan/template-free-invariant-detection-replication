{"id":"bd91cb7c-d2e8-4d1b-8f2e-a160218625f1","expr":"visible == true || visible == false","rationale":"visible is a boolean flag indicating the visibility of the annotation.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-08T06:38:00.550710424Z"}
