{"id":"e268091f-5770-4a34-8849-d910b5eb8878","expr":"location != null","rationale":"The location parameter must be non-null to avoid NullPointerException when calling StringUtils.cleanPath.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toURL(String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-08T06:37:48.537399931Z"}
{"id":"24ec6308-0c6e-4b7a-9d30-0dc2e85d6cdf","expr":"!location.isEmpty()","rationale":"The method will attempt to construct a URI from the location and then convert to URL, empty string would be invalid.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toURL(String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-08T06:37:48.537399931Z"}
{"id":"07f36d17-2fa1-4061-b7e0-ef05407523f8","expr":"location.indexOf('\\0') == -1","rationale":"Null characters are illegal in URLs and likely cause exceptions or malformed URLs.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toURL(String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-08T06:37:48.537399931Z"}
{"id":"26f7666c-5b53-46d9-b514-37ef69d4d982","expr":"location.indexOf(' ') == -1","rationale":"Spaces in a URL string are typically not valid and can lead to failures in URI or URL construction.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toURL(String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-08T06:37:48.537399931Z"}
{"id":"df3eecfe-d4ed-40a8-8f9b-b34b1aea9423","expr":"location.indexOf(':') > 0","rationale":"The presence of ':' indicates that location may include a scheme component as expected in URLs and URIs.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toURL(String):URL","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-08T06:37:48.537399931Z"}
