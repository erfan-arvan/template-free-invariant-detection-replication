{"id":"9662045d-84c2-4fcd-b08d-0ece9e6c492d","expr":"key.length() > 0","rationale":"Keys usually are non-empty strings representing property names.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-08T06:37:58.961668576Z"}
