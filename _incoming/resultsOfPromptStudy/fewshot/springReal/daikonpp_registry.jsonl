{"id":"b72624e7-48d3-47ea-ab2c-8361b16a7799","expr":"result != null","rationale":"The method returns the instantiator created by the strategy, which should not be null on successful execution.","kind":"METHOD_EXIT","element":"org.springframework.objenesis.SpringObjenesis#newInstantiatorOf(Class<T>):ObjectInstantiator<T>","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-08T06:38:05.653348396Z"}
