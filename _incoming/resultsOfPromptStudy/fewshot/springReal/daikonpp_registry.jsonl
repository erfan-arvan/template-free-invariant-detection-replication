{"id":"1fc16190-6814-4d10-80f6-3b406ff5baef","expr":"name != null","rationale":"Method's name parameter should not be null as it identifies the method signature.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-08T06:38:01.899841079Z"}
{"id":"b9b7d29c-cb74-4500-bd4f-2cd5614b0011","expr":"superName == null || !superName.isEmpty()","rationale":"If superName is non-null, it typically is a non-empty class name string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-08T06:38:01.899841079Z"}
{"id":"4f3e0974-5fee-4c9d-b959-68ca8d7b33b2","expr":"interfaces != null","rationale":"Interfaces array parameter is expected to be non-null to enumerate implemented interfaces, possibly empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-08T06:38:01.899841079Z"}
{"id":"6ce5808b-699c-4ff1-900d-35a44e8b8c92","expr":"version >= 0","rationale":"Version is expected to be a non-negative integer representing class file version.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-08T06:38:01.899841079Z"}
{"id":"c9e79f07-609a-4e87-923b-14fbceb771ea","expr":"(signature == null) || (signature.startsWith(\"<\") && signature.endsWith(\">\"))","rationale":"Signature is either null or a generic signature enclosed in angle brackets.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-08T06:38:01.899841079Z"}
{"id":"637bcaaf-926f-4b9b-bbda-2cbbfa575041","expr":"name != null","rationale":"name is required to create a Signature object without NullPointerException","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-08T06:38:01.897715898Z"}
