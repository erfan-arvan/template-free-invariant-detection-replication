{"id":"8f22a111-fb28-41ab-aeea-ecc0ebde2c0d","expr":"methodName != null","rationale":"Method requires methodName to be non-null to proceed.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethodIfAvailable(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.884131801Z"}
{"id":"329b8a0e-9ec6-49f1-96ac-0b996ee7d90d","expr":"paramTypes == null || paramTypes.getClass().isArray()","rationale":"Parameter paramTypes is declared as an array or null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethodIfAvailable(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.884131801Z"}
{"id":"87e0cb16-c28e-462c-969a-e459740d4b51","expr":"methodName.length() > 0","rationale":"Methods generally require non-empty method names.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethodIfAvailable(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.884131801Z"}
{"id":"a305f42a-f7f8-4527-86c6-a480b967e205","expr":"(! (paramTypes != null)) || paramTypes.length >= 0","rationale":"If paramTypes is non-null, its length is zero or positive.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethodIfAvailable(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.884131801Z"}
{"id":"4806736e-7db5-4ba7-ad8e-9e2e32e328e9","expr":"clazz != null","rationale":"The method asserts that clazz is not null, so it must hold at method entry","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethodCountForName(Class<?>,String):int","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.887748059Z"}
{"id":"61fb2548-9987-44b3-93ca-6d756614ebf7","expr":"methodName != null","rationale":"The method asserts that methodName is not null, so it must hold at method entry","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethodCountForName(Class<?>,String):int","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.887748059Z"}
