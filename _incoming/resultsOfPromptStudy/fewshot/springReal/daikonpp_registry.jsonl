{"id":"dfb3fbb1-82ab-4795-b654-63adfde8cd4a","expr":"data.indexOf('>') == -1 || data.indexOf('<') == -1","rationale":"Comment data usually should not include angle brackets, avoiding malformed XML.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeComment(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:37:51.083248768Z"}
