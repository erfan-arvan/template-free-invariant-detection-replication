{"id":"16d2c6e2-e04a-42d8-aafa-3d75ac660b2c","expr":"key != null","rationale":"The key parameter must be non-null to retrieve a property.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getRequiredProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-08T06:37:58.967447907Z"}
{"id":"9c8b4d71-d952-43f9-b373-bf5c6722a9b1","expr":"!key.isEmpty()","rationale":"A non-empty string key is expected for meaningful property retrieval.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getRequiredProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-08T06:37:58.967447907Z"}
{"id":"77ed6f10-47bc-4a07-9605-c67315c6b988","expr":"key.trim().length() > 0","rationale":"The key should contain non-whitespace characters.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getRequiredProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-08T06:37:58.967447907Z"}
