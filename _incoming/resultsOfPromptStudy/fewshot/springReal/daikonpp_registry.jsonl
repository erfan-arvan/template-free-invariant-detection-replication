{"id":"8284bdc9-c9b4-4852-9ef7-28d3db8e620e","expr":"result != null","rationale":"The returned AnnotationVisitor result from visitParameterAnnotation should never be null","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitParameterAnnotation(int,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:38:00.562979072Z"}
{"id":"24b9ed17-858f-4edd-848e-349f35d071e3","expr":"nStack >= 0","rationale":"nStack represents the number of stack elements, which cannot be negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:38:00.562252654Z"}
{"id":"f1f72373-b772-471f-933d-6071e9e32de9","expr":"local != null || nLocal == 0","rationale":"If there are zero local variables, local may be null; otherwise, it should not be null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:38:00.562252654Z"}
