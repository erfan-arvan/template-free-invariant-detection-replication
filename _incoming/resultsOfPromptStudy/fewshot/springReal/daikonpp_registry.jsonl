{"id":"bcfd6ad6-5854-4ea7-9965-785b3045a291","expr":"namespace != null && namespace.getPrefix() != null && namespace.getNamespaceURI() != null && !namespace.getPrefix().isEmpty() && !namespace.getNamespaceURI().isEmpty()","rationale":"Namespace object is expected to provide a valid prefix and URI.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#doWriteNamespace(Namespace):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:37:51.073250024Z"}
