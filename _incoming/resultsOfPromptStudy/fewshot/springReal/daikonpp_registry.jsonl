{"id":"efebb355-35e0-4c4c-9f5e-989ee7d3c844","expr":"!target.contains(\"<?\")","rationale":"The target string should not contain '<?' which denotes start of XML processing instruction.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxEventHandler#processingInstructionInternal(String,String):void","file":"org/springframework/util/xml/StaxEventHandler.java","createdAt":"2026-09-08T06:37:50.690291961Z"}
