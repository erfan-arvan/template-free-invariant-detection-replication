{"id":"bd66b07a-8bae-41d6-8ce9-7464bef26341","expr":"value.length() >= 0","rationale":"String length is always >= 0.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#resolveNestedPlaceholders(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-08T06:37:58.974278426Z"}
{"id":"6bcdedb8-4768-4ea4-8407-53825ac01cea","expr":"value.trim().length() <= value.length()","rationale":"Trimming removes whitespace, never adds characters.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#resolveNestedPlaceholders(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-08T06:37:58.974278426Z"}
{"id":"05f3b34c-0398-4185-91af-f1b74767ffea","expr":"result != null","rationale":"The method returns either the input value or the result of other resolving methods, which presumably do not return null.","kind":"METHOD_EXIT","element":"org.springframework.core.env.AbstractPropertyResolver#resolveNestedPlaceholders(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-08T06:37:58.975186546Z"}
