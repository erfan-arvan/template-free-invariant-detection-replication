{"id":"bcd3892d-e42d-494d-b46f-87de0f1b0cf5","expr":"!prefix.isEmpty() || prefix.equals(\"\")","rationale":"prefix might be empty string or non-empty but should be valid","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.283307142Z"}
{"id":"027a5fc0-348c-48cd-abbf-e62c2da0ca06","expr":"!uri.isEmpty() || uri.equals(\"\")","rationale":"uri might be empty string or non-empty but should be valid","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:37:51.283307142Z"}
