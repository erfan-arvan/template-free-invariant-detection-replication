{"id":"c6f8d9ee-cbfa-45ca-bc10-8a766eb08f7f","expr":"clazz != null","rationale":"Methods can only be searched if the clazz parameter is not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,String,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.857546149Z"}
{"id":"1d6319ee-0362-45e7-a1f0-101bd79b56ef","expr":"methodName != null","rationale":"A method must have a non-null methodName for meaningful search.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,String,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.857546149Z"}
{"id":"d725fe9f-f814-47fe-8629-2dbcc2d8854a","expr":"paramTypes != null","rationale":"ParamTypes may be empty, but the varargs array itself should not be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,String,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.857546149Z"}
{"id":"c55c1161-a0c0-4382-944a-0b8b68102a5f","expr":"(methodName.length() > 0) || (paramTypes.length >= 0)","rationale":"Method name should be non-empty or the paramTypes length is measured.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,String,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.857546149Z"}
{"id":"f4b18fd4-887b-476c-b39e-fc05c5f8f1fd","expr":"clazz.isInterface() || !clazz.isPrimitive()","rationale":"Typically, methods searched for are not primitives or are interface types.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,String,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.857546149Z"}
{"id":"076a5273-b920-434a-b2ee-08f36e55dce5","expr":"result == null || result.getParameterCount() == paramTypes.length","rationale":"If a constructor is found, its parameter count must match the provided parameter types length.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getConstructorIfAvailable(Class<T>,Class<?>):Constructor<T>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.860414950Z"}
{"id":"26d07d27-a9c3-4fd7-9a4d-a418f26a139b","expr":"result == null || result.getDeclaringClass().isAssignableFrom(clazz)","rationale":"The constructor (if present) is declared in the class or a superclass of clazz.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getConstructorIfAvailable(Class<T>,Class<?>):Constructor<T>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.860414950Z"}
{"id":"c6abb579-a6c1-4b10-bc77-91aecb9a7b95","expr":"result == null || result.getDeclaringClass() == clazz","rationale":"Constructors returned correspond exactly to the 'clazz' class.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getConstructorIfAvailable(Class<T>,Class<?>):Constructor<T>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.860414950Z"}
{"id":"ffc5375f-504c-43ce-a863-c58af7cdbfc2","expr":"clazz != null","rationale":"The method asserts clazz must not be null at entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethod(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.861392550Z"}
{"id":"437b9410-dbb5-4796-ae36-964e69cb59e2","expr":"methodName != null","rationale":"The method asserts methodName must not be null at entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethod(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.861392550Z"}
{"id":"c77e9064-e8da-41ef-89ee-a6cb08b26d35","expr":"clazz.isAssignableFrom(clazz)","rationale":"Demonstrates usage of valid clazz instance, but not a useful invariant; included for demonstration.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethod(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.861392550Z"}
{"id":"a9522f20-4842-4434-b557-972c8774f53b","expr":"method != null","rationale":"The method parameter is asserted non-null at the beginning.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method,Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.870723928Z"}
{"id":"44a3f71d-5158-447f-b51d-7bd6d7b76cf3","expr":"(clazz == null) || clazz.isAssignableFrom(method.getDeclaringClass())","rationale":"If clazz is not null, then it's a class context possibly related to method's declaring class.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method,Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.870723928Z"}
{"id":"1b2ffe8b-fd9c-4590-aa80-493daf8c1d55","expr":"method.getName() != null","rationale":"Method name is always non-null as per Java Reflection API.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method,Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.870723928Z"}
{"id":"a279491f-7c56-4835-8c95-e45ea7ed0dc2","expr":"method.getDeclaringClass() != null","rationale":"Every method has a declaring class (Java reflection guarantees this).","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method,Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.870723928Z"}
{"id":"14183230-48a8-49fb-9c6d-a5f25be36703","expr":"((clazz != null) ? clazz : method.getDeclaringClass()).getName() != null","rationale":"The class name used in the returned string is always non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method,Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.870723928Z"}
{"id":"b50f74e0-4d6b-45fe-89c2-1572bfee29b9","expr":"paramTypes != null || result == null || result.getName().equals(methodName)","rationale":"When paramTypes is null and a method is returned, it must have the matching methodName.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getMethodIfAvailable(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.883831455Z"}
