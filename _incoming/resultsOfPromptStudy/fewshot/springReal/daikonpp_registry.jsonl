{"id":"52c64c33-79dd-4dbf-9205-5e7a8663cd9a","expr":"instance != null","rationale":"The method asserts that instance is not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getUserClass(Object):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.678609611Z"}
{"id":"f47dad30-edc3-4d0f-ac79-041e47957334","expr":"instance.getClass() != null","rationale":"Every non-null object has a non-null class returned by getClass().","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getUserClass(Object):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:37:53.678609611Z"}
