{"id":"e1c7c9e0-b135-4cec-8027-ee45d01212d5","expr":"name != null","rationale":"Typically, 'name' parameter should not be null when visit is called.","kind":"METHOD_EXIT","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-08T06:38:01.897614958Z"}
{"id":"520171d0-c1f0-4b4e-aa42-77405eb22906","expr":"superName == null || !superName.equals(name)","rationale":"The superName should not be the same as the name to avoid recursive or incorrect inheritance loops.","kind":"METHOD_EXIT","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-08T06:38:01.897614958Z"}
{"id":"f17b8877-1b9a-43bf-aff7-7e4529fa3771","expr":"interfaces != null","rationale":"The interfaces array should be non-null even if empty.","kind":"METHOD_EXIT","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-08T06:38:01.897614958Z"}
{"id":"fe00614b-ce44-49f8-960d-a75de01ee866","expr":"access >= 0","rationale":"Access flags are usually non-negative integers representing modifiers.","kind":"METHOD_EXIT","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-08T06:38:01.897614958Z"}
