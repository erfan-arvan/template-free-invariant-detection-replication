{"id":"853f5490-65fa-46ec-8e9e-58fcf2c0d408","expr":"destIdx >= 0 && destIdx + srcSize <= destChars.length","rationale":"The method checks for buffer bounds ensuring destIdx and srcSize fit within destChars array length.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.Utf8Utils#decodeUtf8(byte[],int,int,char[],int):int","file":"org/apache/dubbo/common/utils/Utf8Utils.java","createdAt":"2026-09-11T02:17:00.803491809Z"}
