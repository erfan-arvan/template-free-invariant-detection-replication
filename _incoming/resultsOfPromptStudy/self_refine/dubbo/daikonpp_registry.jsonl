{"id":"2a88acd5-23ff-4e53-882d-f42f38cb12a4","expr":"className.contains(\".\") || className.contains(\"$\")","rationale":"className usually contains either '.' or '$' characters in Java class naming.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass0(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.220712954Z"}
{"id":"b7c73c4c-0f00-4b25-839a-58e5441e32dc","expr":"classLoader != null || className != null","rationale":"Either the ClassLoader or className is usually expected to be non-null to attempt class loading.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.220778118Z"}
{"id":"65fb816d-6164-48dd-9617-6a77ae3ba7d2","expr":"result != null","rationale":"The method returns a Class<?> instance or throws an exception if the class cannot be loaded, so result should never be null at method exit.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass0(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.220938040Z"}
{"id":"c8c1d0e3-0a58-4e2f-9796-d7d2ce609e5b","expr":"result.getName().equals(className)","rationale":"The resulting Class's name matches the requested className string on method exit.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass0(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.220938040Z"}
{"id":"71eaa363-e223-4a74-8ac8-efce74afd990","expr":"className != null && !className.isEmpty()","rationale":"The className string is expected to be non-null and not empty to proceed with class loading.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.220930926Z"}
{"id":"158d8a8d-3ce9-4f25-ad11-8a82489375bc","expr":"result != null && result.getName().equals(className)","rationale":"If the method returns successfully, the result class's name should equal the requested className.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.221442913Z"}
{"id":"cc744ff4-62e4-48ab-b37c-b28704db926f","expr":"className != null","rationale":"The className parameter must be provided to specify which class to load.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.220778118Z"}
{"id":"0c66a7ae-23d4-42c7-8216-26abe65f231d","expr":"className.length() > 0","rationale":"An empty string is not a valid class name and the method expects a meaningful class name.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.220778118Z"}
{"id":"34bbcfae-06e3-4da1-a833-45bf7d96915c","expr":"className != null && (result == null || className.equals(result.getName()))","rationale":"The returned class (if any) matches the requested class name.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.221442913Z"}
{"id":"628b8491-2750-4f9e-a843-1f46fb4982a5","expr":"(classLoader == null) || (result != null && result.getClassLoader() == classLoader)","rationale":"Whenever classLoader is provided, the result class is loaded by that classLoader.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.221442913Z"}
{"id":"af156d48-030e-4407-80c2-d129830cf0e0","expr":"!className.isEmpty() && result != null","rationale":"The method returns a non-null class only for non-empty className strings.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.221442913Z"}
{"id":"9f50167d-1f49-4ecd-9456-f041703cd1f4","expr":"classLoader != null || classLoader == null","rationale":"No restriction on classLoader being null or not, both states are possible.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.220930926Z"}
{"id":"38fff112-56a7-4cce-aa86-f7308492a04e","expr":"classLoader == null || classLoader.getClass() != null","rationale":"If classLoader is non-null, it must be a valid ClassLoader instance.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.220930926Z"}
{"id":"00abec98-39c2-48bc-9f31-5553b13edf4e","expr":"result != null","rationale":"The method returns a singleton or cached instance, so result should always be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#getInstance():DefaultSerializeClassChecker","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.223640052Z"}
{"id":"98459432-5ac5-4193-b797-810dc5c9f4d8","expr":"logger != null || msg == null","rationale":"If logger is null, the method returns before checking msg or calling trace.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.225019607Z"}
{"id":"d293b8ce-c0b1-4d8c-8bb7-d2ad5e6c9695","expr":"!logger.isTraceEnabled() || msg != null","rationale":"If the logger is trace-enabled, msg should be non-null at this point.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.225019607Z"}
{"id":"1dfead20-f378-401f-b1e9-9c5102ca6028","expr":"logger.isTraceEnabled() || msg == null","rationale":"If trace is disabled, msg may be null safely.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.225019607Z"}
{"id":"067cbae8-2fa6-41e1-a3a8-ef6cf975f059","expr":"logger.isTraceEnabled() == (msg != null) || !logger.isTraceEnabled()","rationale":"msg non-null implies trace is enabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.225019607Z"}
{"id":"80135c17-f7f6-40c2-875b-95d5b4aadc3f","expr":"logger != null || msg == null","rationale":"If logger is null, msg can be any value; if logger is not null, we can check logger.isTraceEnabled().","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.225349781Z"}
{"id":"893bc536-d52e-4d3b-b5a0-17a8d7910c54","expr":"logger == null || logger.isTraceEnabled() || !logger.isTraceEnabled()","rationale":"Invariant needed to show logger is not null implies isTraceEnabled evaluation is possible.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.225349781Z"}
{"id":"30db7604-a225-4f2b-8aaf-1cbaf7a61961","expr":"logger == null || (logger.isTraceEnabled() == (logger.isTraceEnabled() && true))","rationale":"Invariant stating that logger.isTraceEnabled is consistently boolean.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.225349781Z"}
{"id":"94dec7b9-30b6-4ca5-a460-e8bb71048c87","expr":"logger == null || (msg == null || true)","rationale":"No specific relationship between logger and msg nullness at method entry except logger null short-circuit.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.225349781Z"}
{"id":"fa0518fc-ab58-4436-8376-23089d042535","expr":"logger == null || (logger.isTraceEnabled() == logger.isTraceEnabled())","rationale":"Method call consistency for logger.isTraceEnabled; invariant always true, but reflects stability of method calls.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.225349781Z"}
{"id":"fe27bec1-e408-481d-bb5c-5978d718073d","expr":"result == true || result == false","rationale":"The returned value result is a boolean, so it is either true or false.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#isCheckSerializable():boolean","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-09-11T02:17:04.226994437Z"}
{"id":"278b133b-35e5-48bd-b55e-8819b77a640b","expr":"logger != null && (!logger.isTraceEnabled() || throwable == null)","rationale":"If logger is not null and trace is enabled, then trace(throwable) is called; if trace is disabled, throwable may remain unchanged.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227378312Z"}
{"id":"7cec6926-885f-48e4-91da-ba1869eeaf1b","expr":"logger == null || logger.isTraceEnabled()","rationale":"If logger is non-null, then either trace is enabled or method returns early; thus logger is null or isTraceEnabled is true.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227378312Z"}
{"id":"b2d35172-9176-4eb9-a6ec-2c8d78b7c943","expr":"logger != null","rationale":"At method exit, logger is not null because early return if null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227378312Z"}
{"id":"d3293ed4-1ade-4968-980c-fe44240aac61","expr":"logger != null && logger.isTraceEnabled() == true || logger == null || !logger.isTraceEnabled()","rationale":"This captures the relationship that the method checks logger for null and trace enabled status.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227000348Z"}
{"id":"c7b2134e-9025-4595-8f72-fbfdb4f6c6a1","expr":"logger != null || throwable != null || true","rationale":"Non-informative but valid invariant to include all variables.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227000348Z"}
{"id":"ae9a7565-4585-4be5-bbb7-92b7d519686e","expr":"!logger.isTraceEnabled() || (logger.isTraceEnabled() && throwable != null)","rationale":"If trace is not enabled, no trace call with throwable occurs; if enabled, throwable is passed to trace.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227378312Z"}
{"id":"d12659fb-0bef-44d6-b875-deef25026277","expr":"logger != null || !logger.isTraceEnabled()","rationale":"logger being null implies the method returns early, so isTraceEnabled() won't be called.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227553332Z"}
{"id":"8af1e1a2-a0eb-46bb-853a-6b064638333d","expr":"logger != null && logger.isTraceEnabled() == true","rationale":"If the method exits normally, then either logger is null or trace is enabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227411525Z"}
{"id":"941faed2-af96-4d11-80a6-905056b228f8","expr":"(logger == null) || logger.isTraceEnabled()","rationale":"Precondition for trace call is logger non-null and trace enabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227411525Z"}
{"id":"9b39e332-2818-4a25-a388-d11667664861","expr":"(!logger.isTraceEnabled()) || (logger.isTraceEnabled() && logger != null)","rationale":"isTraceEnabled() is invoked only if logger is not null, guaranteeing safe usage.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227553332Z"}
{"id":"0c1e6d0e-c230-41ad-a303-d7d405328c3f","expr":"(msg == null) || (msg != null)","rationale":"No restriction on msg nullness before method invocation.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227553332Z"}
{"id":"f527c6d3-e3f3-4870-93dc-552a1a1c3f70","expr":"(e == null) || (e != null)","rationale":"No restriction on exception parameter nullness before method invocation.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227553332Z"}
{"id":"56cc8d6b-0780-42a4-b846-85494dfba375","expr":"logger == null || logger.isTraceEnabled() == false || logger.isTraceEnabled() == true","rationale":"Expresses logger state logical completeness with the method entry check.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227000348Z"}
{"id":"126507e2-2df7-4045-af91-f259721f191d","expr":"!(logger == null && logger.isTraceEnabled())","rationale":"logger cannot be null while isTraceEnabled() is true since method returns if logger is null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227553332Z"}
{"id":"73f8651b-fc99-433e-a6c8-f5577e576a1d","expr":"(logger == null) || (msg != null || e != null)","rationale":"No enforced relation between msg and e, but both can be null if logger is non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227411525Z"}
{"id":"70aaa0bc-5479-495b-b4fb-45a0bd7f31fa","expr":"logger == null || logger.isTraceEnabled()","rationale":"Trace call happens only if logger is enabled and non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227411525Z"}
{"id":"95708285-6325-4a25-a151-b21ef488c37c","expr":"logger == null || (logger.isTraceEnabled() && true)","rationale":"If logger is non-null, method only calls trace if isTraceEnabled is true.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.227411525Z"}
{"id":"d5163b99-647b-4e9b-9e60-dc28fc998e3a","expr":"logger != null && logger.isDebugEnabled() == true","rationale":"At method entry, if logger is non-null, then logger.isDebugEnabled() can be either true or false, but if debug will do any operation, isDebugEnabled must be true.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.228356319Z"}
{"id":"b43845bd-89a4-4d63-ade6-7a68a8b21004","expr":"logger != null || msg != null","rationale":"Either the logger is null or the message may be present or absent; this reflects normal parameter combinations.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.228356319Z"}
{"id":"ea5f77f0-88a7-4180-a87a-fadd0f47834d","expr":"logger != null || (msg == null || msg.length() >= 0)","rationale":"String msg length is always >= 0 when msg is non-null; if logger is null, the method returns and no debug called.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.228356319Z"}
{"id":"912723bd-d710-493c-9d42-231db08e0aa8","expr":"logger != null && logger.isDebugEnabled() == true && msg != null","rationale":"If logger is non-null and debug is enabled, then logger.debug(msg) was called, so msg may be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.228995746Z"}
{"id":"a30fd513-dadc-48f3-84cd-87cfecb7ca10","expr":"logger == null || logger.isDebugEnabled() == false","rationale":"If logger is null, method returns early; if debug not enabled, logger.debug(msg) is not called.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.228995746Z"}
{"id":"0b755401-dccf-4dcc-882e-30f130f35237","expr":"! (logger != null && logger.isDebugEnabled()) || msg != null","rationale":"If debug is enabled, msg is likely non-null when passed.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.228995746Z"}
{"id":"7d09820b-d324-478b-8349-a48458c3ce3c","expr":"logger == null || logger != null","rationale":"Basic nullness states of logger.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.228995746Z"}
{"id":"afe7e84c-4e65-442b-8381-40ae87cc6c83","expr":"logger != null && logger.isDebugEnabled() == true","rationale":"Meaningful condition under which the debug method will invoke logger.debug(e)","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.229701229Z"}
{"id":"ee82da37-8535-4d56-b0e6-9ddf0bba35b1","expr":"logger.isDebugEnabled() == (logger != null && logger.isDebugEnabled())","rationale":"Relates nullness of logger and call to isDebugEnabled() method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.229701229Z"}
{"id":"8b8b9a54-c456-44e5-8439-bd116c5d62a2","expr":"logger != null","rationale":"Logger must not be null to execute further code.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.229701229Z"}
{"id":"c01de3f0-e9b9-4ebb-b5f5-db822f887994","expr":"logger != null && logger.isDebugEnabled() == false || logger.isDebugEnabled() == true","rationale":"At the method exit, either debug logging was disabled or enabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.230578105Z"}
{"id":"3c77e5aa-93a2-4744-bdac-4b424726801d","expr":"logger != null && (!logger.isDebugEnabled() || logger.isDebugEnabled())","rationale":"Indicates the condition controlling whether logger.debug(e) executes.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.230578105Z"}
{"id":"1a2f6284-8c74-4f09-a63f-64259d8568d2","expr":"logger != null","rationale":"Method returns immediately if logger is null, so at exit if code continues, logger is not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.230578105Z"}
{"id":"49071cb9-e9db-4014-a536-bd22707e4304","expr":"logger != null || true","rationale":"logger may be null, and if so, method returns early.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.231689774Z"}
{"id":"3b4e3147-b261-4a98-b9e7-e3836aa3603a","expr":"(logger != null) && (logger.isDebugEnabled() == true) || (logger != null && logger.isDebugEnabled() == false)","rationale":"The isDebugEnabled method returns a boolean.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.231689774Z"}
{"id":"577193cf-cd9b-4cc7-950e-8daba4052a39","expr":"logger.isDebugEnabled() == true || logger.isDebugEnabled() == false","rationale":"logger.isDebugEnabled() must be boolean true or false.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.231689774Z"}
{"id":"b672e0de-96ee-4432-9e31-41e2ebb61864","expr":"logger != null || (msg == null && e == null)","rationale":"If logger is null, the method returns early without using msg or e.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.232306378Z"}
{"id":"25f8b79c-85be-4ef6-9f8e-7f61181417c8","expr":"!logger.isDebugEnabled() || (msg != null || e != null)","rationale":"If debug is enabled, at least one argument msg or e is passed.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.232306378Z"}
{"id":"e4e09646-ef76-4b20-a8bb-b21f8e2abbe0","expr":"logger != null && !logger.isInfoEnabled() || msg != null","rationale":"If logging at info level occurred, the msg passed to logger.info is likely non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233005879Z"}
{"id":"fe2feea8-6a9c-43fd-8712-c5c1f1001c7e","expr":"logger == null || logger.isInfoEnabled() || msg == null","rationale":"If logger is not null and info is not enabled, msg may be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233005879Z"}
{"id":"10a649b1-b9e6-40f3-9171-970432d55587","expr":"logger != null || msg != null","rationale":"If logger is null, msg is irrelevant; if logger is non-null msg may be anything.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233005879Z"}
{"id":"5c57bdfc-40f7-4979-b5b3-1e8bfec1244d","expr":"logger != null && (!logger.isInfoEnabled() || msg != null)","rationale":"When logger exists and info is enabled, msg is passed; else msg could be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233005879Z"}
{"id":"b5cab671-7818-4d34-aae8-22de6c247ff9","expr":"logger != null && !logger.isInfoEnabled() || e != null","rationale":"If info is being logged, the Throwable e is likely non-null or info logging is disabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233416325Z"}
{"id":"eaa9496e-593d-404d-8d5b-ec5fead9ae8f","expr":"logger == null || logger.isInfoEnabled() || e == null","rationale":"If logger exists but info logging is not enabled, e can be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233416325Z"}
{"id":"dd8476e5-d4c0-46d4-a369-5f792a1d400d","expr":"logger != null","rationale":"The logger is non-null at return point as method returns early if null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233416325Z"}
{"id":"13987afb-560b-4365-9940-9a3f40caf73f","expr":"!logger.isInfoEnabled() || (e != null)","rationale":"If info logging is enabled, the Throwable e passed to logger.info must not be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233416325Z"}
{"id":"7be0d287-0f3c-4aa5-b25c-a4445a1f8289","expr":"logger != null || msg == null","rationale":"If logger is null, the method returns immediately and no logging occurs, so msg may be null or not.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233999937Z"}
{"id":"7fece013-4e7f-49a4-bc8f-615be78e2eef","expr":"logger == null || logger.isInfoEnabled() == true || logger.isInfoEnabled() == false","rationale":"If logger is non-null, isInfoEnabled is a boolean method; must be true or false.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233999937Z"}
{"id":"2cb5dd95-b463-43bb-9205-60918f972fd9","expr":"logger != null","rationale":"Non-null logger is required for the logging operation; method returns early if null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233999937Z"}
{"id":"99535bcf-4b9a-4666-88f7-e2185e67d122","expr":"(logger != null && msg != null) || e == null || e != null","rationale":"This expresses that either logger and msg are both non-null or e is null or non-null (always true, included for completeness).","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.233999937Z"}
{"id":"e321543a-e735-46e3-97ca-0069f4856eb3","expr":"logger != null || (msg == null && e == null)","rationale":"If logger is null, the method returns early; thus the state here implies logger != null or else the method already returned.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.234492647Z"}
{"id":"1fa57593-9891-4ad1-b3a0-87a5a879925a","expr":"!logger.isInfoEnabled() || (msg != null || e != null)","rationale":"If info logging is enabled, the logger.info is called with msg and e, suggesting at least one might not be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.234492647Z"}
{"id":"cecd861e-1678-4daa-9fac-51af913360de","expr":"logger.isInfoEnabled() || (msg == null && e == null)","rationale":"If info logging is disabled, logger.info is not called, so it's consistent if msg and e are null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.234492647Z"}
{"id":"74e50b4c-4f03-4307-8495-d168e435fc0e","expr":"(msg != null) || (e != null) || !logger.isInfoEnabled()","rationale":"To have logging done, either msg or e is not null when info is enabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.234492647Z"}
{"id":"76b4fc96-319a-491a-aee3-55bcf0bc5af8","expr":"(logger.isInfoEnabled() && (msg != null || e != null)) || !logger.isInfoEnabled()","rationale":"Info should occur only if info logging is enabled and a msg or e is provided.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.234492647Z"}
{"id":"b1192989-6bfe-4ca5-afce-cf010d2cb982","expr":"logger != null || true","rationale":"The method returns immediately if logger is null, so at method entry logger may be null or not.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.235515218Z"}
{"id":"ec65055e-0f54-4ee2-b4a6-ee5410a667ea","expr":"(logger != null) && (!logger.isWarnEnabled() || (logger.isWarnEnabled() && true))","rationale":"If logger is not null, isWarnEnabled() may be true or false.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.235515218Z"}
{"id":"9fccfa6d-6321-4fa4-b921-b1e44f8fe1f8","expr":"logger != null && (logger.isWarnEnabled() || !logger.isWarnEnabled())","rationale":"At method entry, if logger is not null, isWarnEnabled() may be true or false.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.235515218Z"}
{"id":"c4c1e8e6-8cf1-4490-8842-a47cbca5a4da","expr":"logger != null || msg == null","rationale":"logger may be null or not, msg can be anything.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.236149376Z"}
{"id":"3375dc2d-5ae9-430d-b962-3948afbaed60","expr":"logger != null && logger.isInfoEnabled() == true","rationale":"The method proceeds to log info only if logger is not null and info level is enabled.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.235648991Z"}
{"id":"df1b5c1c-0918-4d01-8f99-779ee30e3e76","expr":"logger != null","rationale":"The method checks for null logger and returns early, so logger must be non-null here.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.235648991Z"}
{"id":"af2c9ebb-2ec0-469e-9488-e958e268a0f0","expr":"logger == null || logger.isInfoEnabled() || !logger.isInfoEnabled()","rationale":"This is a tautological expression involving logger conditions, so it is not included.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.236149376Z"}
{"id":"841c4b93-54bf-4330-b37a-b371731557d5","expr":"logger != null","rationale":"Non-null logger is required for the method to proceed.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.236149376Z"}
{"id":"89b45788-ae2c-4d2e-82d0-c816364faa77","expr":"logger != null && logger.isWarnEnabled() == (msg != null || e != null)","rationale":"Warn is called if and only if logger is not null and warning is enabled; thus, typically either msg or e is provided.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.236151580Z"}
{"id":"cfea8a49-cb56-465b-8519-41dd69ae6810","expr":"logger == null || logger.isWarnEnabled() == (logger != null && logger.isWarnEnabled())","rationale":"Method returns immediately if logger is null; warn called only if logger.isWarnEnabled() is true.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.236151580Z"}
{"id":"5c97a27a-318c-45de-b125-fc23f986b786","expr":"logger != null || msg == null","rationale":"If logger is null, method returns early, so msg use does not proceed.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.236151580Z"}
{"id":"664d6236-02d4-4d48-b4e5-8350f1e24a3b","expr":"logger == null || !logger.isWarnEnabled() || (msg != null || e != null)","rationale":"If logger is present and warn is enabled, then msg or e should be available to warn with.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.236151580Z"}
{"id":"abdbab3b-9a3f-4452-a870-2a2ba694463b","expr":"(logger == null) || logger.isInfoEnabled() == false","rationale":"The negation of the condition to log info: either logger is null or info isn't enabled.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.235648991Z"}
{"id":"0a880d58-488c-40f5-88e3-d97c474cd382","expr":"logger != null && (!logger.isWarnEnabled() || msg == null || !msg.isEmpty())","rationale":"If the logger is not null and warn is enabled, logically warning with the message happened or the message is non-empty to justify the call.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.237213636Z"}
{"id":"f1cf1050-685e-4231-be14-1887da201ca9","expr":"logger != null && (!logger.isWarnEnabled() || msg != null)","rationale":"If warn logging is enabled, the message is likely non-null when about to log.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.237213636Z"}
{"id":"ac4ae65d-9324-4a3c-b075-8d4e464473b8","expr":"logger != null","rationale":"The logger is guaranteed to be not null at method exit due to the early return.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.237213636Z"}
{"id":"186d7522-ab29-41ad-aab5-0c3b3fd7d4fe","expr":"logger != null && logger.isWarnEnabled() == true","rationale":"Logger is not null and warn level is enabled or disabled based on logger.isWarnEnabled().","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.236871370Z"}
{"id":"ca665634-9d8f-4d07-9a66-1e7c4de346a7","expr":"logger != null && (msg == null || msg.length() >= 0)","rationale":"msg is either null or a valid string; no constraint that requires msg to be non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.236871370Z"}
{"id":"35750a46-283b-492f-8700-575b56a9ddb4","expr":"logger != null","rationale":"The method returns early if logger is null, so at method entry logger can be null or non-null but method mainly handles non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.236871370Z"}
{"id":"39544ffe-1c29-40ef-b41d-b7600a0e443b","expr":"logger.isInfoEnabled() == (logger != null && e != null || e == null)","rationale":"infoEnabled status depends only on logger, unrelated to e's nullness, so this expression is false but present for completeness.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.235648991Z"}
{"id":"57788db7-23c1-42ac-aae5-af7e53c04b8b","expr":"logger != null && (!logger.isWarnEnabled() || e != null)","rationale":"The method calls logger.warn(e) only if logger is not null and warning is enabled, and e is the Throwable to warn with.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.238462595Z"}
{"id":"640c7b16-3a97-4d5d-b89d-f808efc5a5cd","expr":"logger != null && (!logger.isWarnEnabled() || logger.isWarnEnabled())","rationale":"After the method execution, logger remains non-null and its warnEnabled state is defined.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.238462595Z"}
{"id":"fd87e41d-cae4-43d1-b5ec-f331348cd80e","expr":"logger == null || logger.isWarnEnabled()","rationale":"The method returns immediately if logger is null, otherwise it checks isWarnEnabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.238462595Z"}
{"id":"acf94964-9f25-440f-ac98-3db0d5f8b9e2","expr":"!logger.isWarnEnabled() || e != null","rationale":"When warning logging is enabled, the Throwable e should be valid to issue a warning.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.238462595Z"}
{"id":"6f4f0a57-9bdd-498f-9d7a-a8eb5fc0cb8a","expr":"logger != null && e != null && logger.isErrorEnabled() == false","rationale":"Ensures error is logged only if error logging is enabled.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.239134423Z"}
{"id":"ff140113-f89c-4b19-8239-71d1d0ee3bfe","expr":"logger == null || logger.isErrorEnabled() == true","rationale":"Either logger is null or error logging is enabled.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.239134423Z"}
{"id":"f07d9806-8ec4-4e71-9312-dc7378485759","expr":"logger != null && e != null","rationale":"Both logger and the Throwable e can be non-null at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.239134423Z"}
{"id":"e444a028-5501-4d6d-8c8d-c72821033bad","expr":"logger != null && logger.isErrorEnabled() == true","rationale":"Before method exit, if an error was logged, then logger is not null and logger.isErrorEnabled() is true.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.240284966Z"}
{"id":"151a68bf-24cb-435a-bd68-0be6a3cbc1d3","expr":"logger != null","rationale":"Logger is guaranteed not to be null when exiting the method.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.240284966Z"}
{"id":"b92592ca-cd09-4a57-bd6d-eccf394cac4b","expr":"pojoClazz != null && pojoClazz.isPrimitive() == false","rationale":"Since protobuf classes are user-defined messages, the input class should not be a primitive type.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ProtobufUtils#isProtobufClass(Class<?>):boolean","file":"org/apache/dubbo/common/utils/ProtobufUtils.java","createdAt":"2026-09-11T02:17:04.240590062Z"}
{"id":"fa5f2536-7908-41e9-aa49-13e8ed903c7a","expr":"pojoClazz != null && pojoClazz.isInterface() == false","rationale":"Protobuf classes are concrete classes, so pojoClazz should not be an interface.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ProtobufUtils#isProtobufClass(Class<?>):boolean","file":"org/apache/dubbo/common/utils/ProtobufUtils.java","createdAt":"2026-09-11T02:17:04.240590062Z"}
{"id":"62026ee5-a172-4414-a835-2f6e98896053","expr":"pojoClazz != null && pojoClazz.getPackage() != null","rationale":"The class should be associated with some package, so getPackage() should be non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ProtobufUtils#isProtobufClass(Class<?>):boolean","file":"org/apache/dubbo/common/utils/ProtobufUtils.java","createdAt":"2026-09-11T02:17:04.240590062Z"}
{"id":"4b0d91d1-9757-4ade-b5ac-001dd8d5c6f2","expr":"pojoClazz != null && pojoClazz.getSimpleName() != null && pojoClazz.getSimpleName().length() > 0","rationale":"A protobuf class should have a non-empty simple name.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ProtobufUtils#isProtobufClass(Class<?>):boolean","file":"org/apache/dubbo/common/utils/ProtobufUtils.java","createdAt":"2026-09-11T02:17:04.240590062Z"}
{"id":"4b0b2a1f-e3f7-4feb-8637-20de52f8509f","expr":"logger != null && !logger.isErrorEnabled() || logger != null && msg != null && logger.isErrorEnabled() && logger.isErrorEnabled() == true","rationale":"If the logger is not null and error is enabled, the error method on logger is called with msg. This indicates that when error is enabled, msg is expected to be non-null or used.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.241045412Z"}
{"id":"99c00c0e-dfc5-4d6a-bb2a-7e30dee47802","expr":"logger != null || e == null","rationale":"At method entry, logger might be null, but e can be any Throwable or null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-11T02:17:04.237880836Z"}
