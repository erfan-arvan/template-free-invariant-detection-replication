{"id":"d2210616-3b58-4e42-94f6-20c8f11c1166","expr":"(byte1 & 0xFF) <= 255","rationale":"byte1 as byte is from -128 to 127, but when cast to char it is interpreted as unsigned 0-255.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.Utf8Utils#handleOneByteSafe(byte,char[],int):void","file":"org/apache/dubbo/common/utils/Utf8Utils.java","createdAt":"2026-09-11T02:17:00.809673152Z"}
