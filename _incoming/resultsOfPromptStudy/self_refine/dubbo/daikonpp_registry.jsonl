{"id":"8f24d9c1-8e7b-45d0-94fd-ca03a65fa9e2","expr":"declaringClass.isInterface() == overrider.getDeclaringClass().isInterface()","rationale":"Ensures the interface vs class nature matches for overrider and declaringClass.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.196823016Z"}
{"id":"81420b16-003a-4cc8-bc3f-190ad83ee35c","expr":"overrider.getParameterCount() == overrider.getParameterTypes().length","rationale":"Confirms internal consistency of overrider method's parameters.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.196823016Z"}
{"id":"a788c138-b13c-43ba-a0ee-fe23825ca6cc","expr":"overrider.isAccessible() || overrider.canAccess(null)","rationale":"Ensures the overrider Method object is generally accessible.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.196823016Z"}
{"id":"6c70e4d2-2186-47f2-a555-22f79d15aded","expr":"type != null || methodName == null || methodName.isEmpty() || parameterTypes != null","rationale":"This captures that the method call is only attempted if type is non-null and methodName is not empty, so if type is null then methodName is null or empty, or parameterTypes not null for safe method call.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.197806093Z"}
{"id":"0286c447-6e96-4484-8e97-0c40bc6fb4fc","expr":"methodName != null && !methodName.isEmpty() || type == null","rationale":"Before calling getDeclaredMethod, type must be non-null and methodName must be not empty, so either methodName is not empty or type is null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.197806093Z"}
{"id":"9c9f1215-4c2f-4a80-bf6d-d769e4004f96","expr":"parameterTypes != null","rationale":"parameterTypes is a varargs var and is never null at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.197806093Z"}
{"id":"a75b403e-ebe0-401e-9eff-1c7c05133afe","expr":"type == null || (methodName != null && !methodName.isEmpty())","rationale":"The method calls getDeclaredMethod only when type is non-null and methodName is not empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.197806093Z"}
{"id":"4a829dd1-a74c-4af7-ba54-7924ad1c78e1","expr":"result != null && (result.isEmpty() || Character.isLowerCase(result.charAt(0)))","rationale":"The method returns either an empty string or a string whose first character is lowercase.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.201333314Z"}
{"id":"47c6f3e3-0e9b-4ed7-a7b9-ea7475eb644a","expr":"result != null","rationale":"result is never null on return.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.201333314Z"}
{"id":"caa5a8b1-f3f9-4c48-99b0-090433b84045","expr":"result == null || declaringClass.isAssignableFrom(result.getDeclaringClass())","rationale":"The method returns either null or a method overridden in a subclass of declaringClass.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.202160396Z"}
{"id":"3441c7b9-fe2c-40ea-8f6a-b353d2792547","expr":"result == null || overrider != null","rationale":"When result is not null, the overrider method should be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.202160396Z"}
{"id":"e2e56baf-a842-422d-b8f4-c8ccc3e33312","expr":"method != null || targetObj == null","rationale":"If method is null, targetObj might not be relevant for invocation.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.202174783Z"}
{"id":"c820f3ab-8674-4dda-84fc-e51e4808e955","expr":"method == null || method.getDeclaringClass() != null","rationale":"If method is not null, its declaring class should not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.202174783Z"}
{"id":"ece8e32a-f04e-462a-871d-97e26172f71e","expr":"method == null || method.isAccessible() || true","rationale":"If method is not null, it is either accessible or has accessibility overridden.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.202174783Z"}
{"id":"b53830af-a136-4e87-a498-ebf849771620","expr":"method != null || true","rationale":"Method might be null or not, no specific constraint.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.202174783Z"}
{"id":"da023818-db27-48e5-9b77-353830727dde","expr":"result == null || result.getName().equals(overrider.getName())","rationale":"The returned method, if any, must have the same name as the overrider method.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.202160396Z"}
{"id":"e19bbfeb-cd54-408f-81b5-29870bc4abc2","expr":"! (result != null && !overrider.getDeclaringClass().isAssignableFrom(result.getDeclaringClass()))","rationale":"If result is not null, result's declaring class must be assignable from overrider's declaring class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.202160396Z"}
{"id":"be27257e-4b39-466f-8227-b2839b85c1f8","expr":"!result || !Objects.equals(overrider, overridden)","rationale":"If the result is true it guarantees that the methods are not equal.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.204758001Z"}
{"id":"dd8b39cc-f593-466c-85d3-883339dd9673","expr":"!result || overridden.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"If the result is true the declaring class of overrider must be assignable from that of overridden.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.204758001Z"}
{"id":"e4caf9e4-698f-411a-ab9a-e07aecca2aeb","expr":"!method.getName().isEmpty()","rationale":"Non-empty method names expected at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.208929669Z"}
{"id":"84509fd6-2d8d-4354-99e4-1dbe0ac29811","expr":"method == null || method.getParameterCount() == 0","rationale":"The method invoked is expected to have zero parameters because no arguments are passed in invoke() call.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.211150584Z"}
{"id":"253db1ac-700e-4e1d-b35d-3c2f7ff1d2e9","expr":"method != null && method.getDeclaringClass() != null && method.getDeclaringClass().getName() != null","rationale":"The method's declaring class and its name must be non-null for toShortString to work.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212010137Z"}
{"id":"c63d30ac-b9f9-4d36-8e4f-3c8984dc0569","expr":"method.getParameterTypes() != null","rationale":"The method's parameter types array is never null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212010137Z"}
{"id":"e09cfb36-0278-4572-b600-1f5b17711cf0","expr":"method.getName() != null","rationale":"The method name is non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212010137Z"}
{"id":"86ca0cf1-98a0-4ea1-a9b6-e660ba1f9da1","expr":"method.getParameterTypes().length >= 0","rationale":"The length of the parameter types array is zero or more.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212010137Z"}
{"id":"2b4cce08-6cf7-4444-93fb-2d5058df8dad","expr":"method.getDeclaringClass().isAssignableFrom(method.getDeclaringClass())","rationale":"The declaring class is assignable from itself, a trivial property used for sanity.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212010137Z"}
{"id":"b1a4dfc0-deeb-44eb-8d66-2855cbfd6929","expr":"(method == null) == (result == -1)","rationale":"If method is null, the method returns -1 as per the implementation.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212686534Z"}
{"id":"f2395952-a75d-482b-b8bd-922085b3fde2","expr":"result == -1 || result >= 0","rationale":"The method returns -1 on error or the result of a long cast, which should be non-negative as method.invoke likely returns a boxed Number or similar.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212686534Z"}
{"id":"da03e943-f4eb-4c23-bfdd-8d77aebef21c","expr":"method != null || result == -1","rationale":"When method is null, the method returns -1, so !method implies result == -1.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212686534Z"}
{"id":"a70b53f3-e87a-4528-922f-1e577f71798d","expr":"result != -1 || (method == null || method != null)","rationale":"If the result is -1, it's either a null method or an exception caught.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212686534Z"}
{"id":"820f3ca0-32ff-421d-bb0a-ce10c85aa7fd","expr":"(method == null) == (Double.isNaN(result))","rationale":"If method is null, the method returns Double.NaN, so result is NaN.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212170269Z"}
{"id":"7e026a9e-b551-425f-acb1-314cf789250a","expr":"result.startsWith(method.getDeclaringClass().getName())","rationale":"The resulting string starts with the fully qualified name of the method's declaring class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.213234639Z"}
{"id":"dfe4dbca-663a-4366-940e-7353087d9da9","expr":"result.contains(method.getName())","rationale":"The method name appears in the result as part of the returned string.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.213234639Z"}
{"id":"8454f0d7-c77a-4c0f-a210-c9099848e988","expr":"result.endsWith(\")\")","rationale":"The returned string ends with a closing parenthesis as per the method implementation.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.213234639Z"}
{"id":"982a7ad5-a3bf-47be-b8a6-3d21873a2416","expr":"!result.contains(\"(\") || result.indexOf('(') > 0","rationale":"The opening parenthesis, if present, appears after the class name and method name.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.213234639Z"}
{"id":"326c4000-8440-465f-8868-479f8163f333","expr":"result.length() >= method.getDeclaringClass().getName().length() + method.getName().length() + 2","rationale":"The length of the result string must be at least the sum of declaring class name length, method name length, and two parentheses characters.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.213234639Z"}
{"id":"f888bf0c-742e-4cdf-bfab-58c84ef9e3c9","expr":"array == null || array.length >= 0","rationale":"The array can be null or have zero or more elements, length is always >=0 if not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-11T02:17:02.213317696Z"}
{"id":"437ba4cb-0952-4f29-ab5d-165b47f8ebde","expr":"array == null || array.length != -1","rationale":"If array is not null, its length must not be -1.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-11T02:17:02.213317696Z"}
{"id":"5fff870b-cc0e-493e-b9f0-3aca34159a42","expr":"(method != null) || Double.isNaN(result)","rationale":"Either method is not null or result is NaN.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.212170269Z"}
{"id":"9674a54c-e6de-4ab6-8743-3d0afddbbed4","expr":"array == null || array.length == 0 || array.length > 0","rationale":"If array is not null, it must have length zero or a positive length.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-11T02:17:02.213317696Z"}
{"id":"fc8372b4-23b8-4576-938b-72fce9908933","expr":"md != null && (md.getMethod() != null || md.getMethodName() != null)","rationale":"If the method in MethodDescriptor is null, methodName should be available to build the string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(MethodDescriptor):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.213877093Z"}
{"id":"b11b06c7-0e4b-459a-b905-29e0e91f3f8e","expr":"md.getMethod() == null || md.getMethod().getParameterCount() == md.getParameterClasses().length","rationale":"If method exists, its parameter count must match parameter classes count in MethodDescriptor.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(MethodDescriptor):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.213877093Z"}
{"id":"566352d7-e746-4314-b2a6-4c754d24ea14","expr":"md.getMethodName() != null","rationale":"Method name string is appended when method is null; must be non-null to avoid NullPointerException.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(MethodDescriptor):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.213877093Z"}
{"id":"4e42ff0a-077e-4e67-9390-403edb7df35d","expr":"md.getParameterClasses() != null","rationale":"Accessing length on parameterClasses requires it not to be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(MethodDescriptor):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.213877093Z"}
{"id":"bb72af29-2ef5-4f7e-ae6a-2359d4efad7a","expr":"md.getMethod() != null || (md.getParameterClasses() != null && md.getMethodName() != null)","rationale":"To build the short string, either method or methodName and parameter classes must be valid.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(MethodDescriptor):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T02:17:02.213877093Z"}
{"id":"d36af49f-14af-4c40-acbe-db3c406c7c27","expr":"array == null || array.length >= 0","rationale":"If array is not null, its length must be zero or more.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isNotEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-11T02:17:02.214692563Z"}
{"id":"e67d3228-ca81-458f-aa60-b7f436844272","expr":"array != null || array == null","rationale":"Array can be either null or non-null, capturing the binary possibility.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isNotEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-11T02:17:02.214692563Z"}
{"id":"32f9de24-1778-4fb9-a705-d2e6fa7744fa","expr":"array == null || array.length != 0","rationale":"Reflects the non-empty condition when array is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isNotEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-11T02:17:02.214692563Z"}
{"id":"780e1baf-f641-40af-8fa7-6973b02aa656","expr":"array == null || array.length > 0 || array.length == 0","rationale":"Partition of lengths covering all possibilities when array is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isNotEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-11T02:17:02.214692563Z"}
{"id":"ee3eef98-eea2-49f0-b1b0-4045cec6bc82","expr":"result == (array == null || array.length == 0)","rationale":"result is true exactly when array is either null or has zero length according to the method implementation.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ArrayUtils#isEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-11T02:17:02.213684509Z"}
