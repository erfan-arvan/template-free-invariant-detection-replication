{"id":"d0af39f8-cbfb-4ea6-a4ef-f54ff990ec3d","expr":"clazz != null && paramType != null && clazz.isAssignableFrom(clazz)","rationale":"A Class object is always assignable from itself, reflecting a fundamental property of classes.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.439472202Z"}
{"id":"5af21322-bac6-41da-8224-ec2e9b4d6331","expr":"paramType != null && (paramType.isInterface() || !paramType.isPrimitive())","rationale":"In this context, paramType is likely a class or interface type used for constructor parameter matching.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.439472202Z"}
{"id":"9aea6efe-1a48-46bc-9d99-c74e11fe3c99","expr":"clazz != null && paramType != null","rationale":"The method assumes these parameters are non-null to proceed without NullPointerExceptions.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.439472202Z"}
{"id":"77064c25-a109-4f6f-8db0-9ee66e9e10e0","expr":"clazz.isAssignableFrom(clazz)","rationale":"This basic property holds for any Class object at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.439472202Z"}
{"id":"54b29115-c397-427a-9f36-086b4293f3e7","expr":"clazz != null","rationale":"Method requires clazz to be non-null to find its constructors.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.439472202Z"}
{"id":"0300ba59-3311-49fe-acb2-e287a8171ad6","expr":"m.getReturnType().isPrimitive() == (result != null)","rationale":"result is non-null iff the return type is primitive.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Method):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.457362637Z"}
{"id":"5fbc4d1d-ae67-48f5-94b2-92935ddbfad4","expr":"!m.getReturnType().isPrimitive() || result.getClass().isAssignableFrom(m.getReturnType())","rationale":"If return type is primitive then result is non-null and assignable from return type.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Method):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.457362637Z"}
{"id":"4e72d533-6e6a-4dc8-86ca-1ef07df7ddd4","expr":"!m.getReturnType().isPrimitive() || !result.getClass().isPrimitive()","rationale":"If primitive return type, result's class is not primitive.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Method):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.457362637Z"}
{"id":"e7f5203e-4764-4fec-9b15-d4b889ede24d","expr":"level >= 0","rationale":"The level parameter represents the recursion depth and is never negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.457665780Z"}
{"id":"01f92db7-5162-4523-90c0-90cbf74f6974","expr":"emptyInstances != null","rationale":"emptyInstances must be non-null to allow caching empty objects.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.457665780Z"}
{"id":"02da5534-1fcc-40e0-bf15-549dcf88d2ff","expr":"(returnType == null) == (level <= 2) || (returnType != null)","rationale":"If level > 2 then null is returned, ensures relationship with returnType nullity.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.457665780Z"}
{"id":"9f7d54e3-7cd2-43d7-8a7d-bc8c86db3959","expr":"(returnType != null) && (level <= 2)","rationale":"At the method entry, returnType is not null and level is within bounds for further processing.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.457665780Z"}
{"id":"184dce10-1253-43e7-b211-e8fed7d3454a","expr":"(result == null) == (!m.getReturnType().isPrimitive())","rationale":"result is null exactly when return type is not primitive.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Method):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.457362637Z"}
{"id":"da18eac6-3995-42bb-b667-87f83fcb0369","expr":"(classType == null) || (classType.isPrimitive() && result != null)","rationale":"When classType is primitive, result is the default primitive value, which should not be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.460688019Z"}
{"id":"8de0c089-4c58-4129-9662-152aa89fcffe","expr":"(classType == null) || (!classType.isPrimitive() && result == null)","rationale":"When classType is not primitive, the method returns null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.460688019Z"}
{"id":"ce6e2172-2309-4fc2-8118-45a610950c56","expr":"(result == null) || (classType != null && classType.isPrimitive())","rationale":"If result is not null, classType must be primitive.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.460688019Z"}
{"id":"2fbaf1ac-08f3-4ace-8aca-476f446467ca","expr":"!(classType != null && classType.isPrimitive()) || (result != null)","rationale":"If classType is primitive, the result cannot be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.460688019Z"}
{"id":"cfd2f1a4-2b02-471f-9b45-0037a992d2e7","expr":"(result == null) || (result != null)","rationale":"Result is either null or not null, included for completeness.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.460688019Z"}
{"id":"69ce3fba-c03d-4166-8952-b324fbf81d47","expr":"m != null && m.getReturnType() != null","rationale":"Method and its return type must be non-null to safely proceed.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Method):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.462952577Z"}
{"id":"5082eb3b-042a-4257-8d0e-3386b20f10fb","expr":"m != null && m.getReturnType() != null && (m.getReturnType().isPrimitive() || !m.getReturnType().isPrimitive())","rationale":"All return types are either primitive or non-primitive, but excluded as tautological.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Method):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.462952577Z"}
{"id":"62380566-2525-41cf-8ee9-23211acd6271","expr":"classType != null || classType == null","rationale":"classType can be null or non-null at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.465788774Z"}
{"id":"97949597-07cd-4311-9392-08001eebe988","expr":"classType == null || classType.isPrimitive() == classType.isPrimitive()","rationale":"Logical consistency of null and isPrimitive check.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.465788774Z"}
{"id":"bd51146a-71e6-4904-a51e-0ae05447224c","expr":"classType != null && classType.isPrimitive() || !(classType != null && classType.isPrimitive())","rationale":"classType is either a primitive type or not.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.465788774Z"}
{"id":"3ba53d2d-917d-4566-8546-3e87e394ceee","expr":"(level > 2) == (result == null)","rationale":"If level is above 2, the method returns null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.478817976Z"}
{"id":"b7b920bf-b58e-41fb-b52f-bf8031cc2cbe","expr":"returnType == null || result == null || returnType.isInstance(result)","rationale":"If returnType is not null and result is not null, then result is an instance of returnType.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.478817976Z"}
{"id":"4a076623-44f1-46de-b09c-a0afa0c15cb2","expr":"(returnType.isArray()) == (result != null && result.getClass().isArray())","rationale":"If returnType is array, result is a non-null array instance.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.478817976Z"}
{"id":"626928eb-6804-4834-9e3d-0823192227a1","expr":"method == null || method.getName() == null || method.getName().length() > 3","rationale":"Name length must be greater than 3 for it to be a bean property write method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isBeanPropertyWriteMethod(Method):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.500404975Z"}
{"id":"7e378503-d967-40b8-a286-d65161994764","expr":"method == null || method.getParameterTypes().length == 1","rationale":"Bean property write methods have exactly one parameter.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isBeanPropertyWriteMethod(Method):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.500404975Z"}
{"id":"7e71b840-76b6-472b-bacf-e6b0d1d7487d","expr":"result == (method != null)","rationale":"If method is null, result must be false.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#isBeanPropertyWriteMethod(Method):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.501044994Z"}
{"id":"201294a9-61fd-41b8-a9f8-979e4d906ea1","expr":"!result || method.getParameterTypes().length == 1","rationale":"If result is true, method must have exactly one parameter.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#isBeanPropertyWriteMethod(Method):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.501044994Z"}
{"id":"8201fac9-9b7d-4c0a-9bd6-43202e4bbc06","expr":"!result || method.getParameterTypes().length == 0","rationale":"A bean property read method has zero parameters.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#isBeanPropertyReadMethod(Method):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.512762288Z"}
{"id":"508913f3-0b69-49a6-8857-76102521eb08","expr":"result == null || (result.length() == method.getName().length() - 3)","rationale":"The result is either null (if not a bean write method) or a property name derived from method name.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getPropertyNameFromBeanWriteMethod(Method):String","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.516663257Z"}
{"id":"f43413c9-8abf-4e7c-80bb-bdc69472f105","expr":"result == null || Character.isLowerCase(result.charAt(0))","rationale":"When result is non-null, it starts with a lowercase character.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getPropertyNameFromBeanWriteMethod(Method):String","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.516663257Z"}
{"id":"24b1acde-f0d7-485b-a3a4-49f5fcfe92af","expr":"!field.isSynthetic() || !result","rationale":"Synthetic fields always cause result to be false; hence if result is true, field is non-synthetic.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#isPublicInstanceField(Field):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.536977521Z"}
{"id":"11add846-d5b9-45d5-8d77-f2a21e170296","expr":"result != null","rationale":"The method initializes and returns a new HashMap, so result is never null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getBeanPropertyFields(Class):Map<String, Field>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.540409113Z"}
{"id":"4a88e43a-e9d4-4143-a576-2b9a673f1b4e","expr":"!result.containsKey(null)","rationale":"Field.getName() never returns null, so no null keys in result.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getBeanPropertyFields(Class):Map<String, Field>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.540409113Z"}
{"id":"698eec9f-b261-46ba-8fd6-b71908c64e41","expr":"(result == null) || (!result.isEmpty())","rationale":"Result is null or a non-empty property name derived from the method name.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getPropertyNameFromBeanReadMethod(Method):String","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.546425318Z"}
{"id":"3bfd912d-8216-4646-9501-54f4cf8fd170","expr":"field != null && field.getModifiers() >= 0","rationale":"The field must not be null and its modifiers are a non-negative integer.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isPublicInstanceField(Field):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.548230327Z"}
{"id":"73961c04-9385-4473-8532-6546814d33b4","expr":"!field.isSynthetic() || field != null","rationale":"If field is non-null then it can non-synthetically be either synthetic or not.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isPublicInstanceField(Field):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.548230327Z"}
{"id":"bb3d11ed-cf83-4eed-b2e2-ab640ac1705f","expr":"result != null","rationale":"The result is a Map initialized inside the method, so it should never be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getBeanPropertyReadMethods(Class):Map<String, Method>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.556661454Z"}
{"id":"d6165750-07f9-4248-909d-9bf44da7dc38","expr":"(cl != null) == (cl.getName() != null)","rationale":"If cl is non-null, then its name string should also be non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getBeanPropertyReadMethods(Class):Map<String, Method>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.565484330Z"}
{"id":"bb38dd69-7b38-4d08-9aa3-5ddbd9dff84f","expr":"cl.isInterface() == false || cl.getSuperclass() == null","rationale":"If cl is an interface, its superclass should be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getBeanPropertyReadMethods(Class):Map<String, Method>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.565484330Z"}
{"id":"dcd519e7-ac05-4dbd-b018-79ab050c58da","expr":"cl.getDeclaredMethods().length >= 0","rationale":"The class's declared methods array length must be non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getBeanPropertyReadMethods(Class):Map<String, Method>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.565484330Z"}
{"id":"604a3340-0d6a-471f-89a6-119b36a1276a","expr":"cl.getSuperclass() == null || cl.getSuperclass().isAssignableFrom(cl)","rationale":"The superclass is assignable from the class if not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getBeanPropertyReadMethods(Class):Map<String, Method>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.565484330Z"}
{"id":"7f0ebd0c-ea91-4f6a-832f-dbda7e80a8ef","expr":"method != null && method.getReturnType() != null && method.getGenericReturnType() != null","rationale":"The Method parameter is expected to be non-null and have a return type and generic return type according to the method contract.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getReturnTypes(Method):Type[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.577034779Z"}
{"id":"b8963a22-ea96-4a8b-bb89-0e8fc1ea4501","expr":"method != null","rationale":"The method parameter must not be null at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getReturnTypes(Method):Type[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.577034779Z"}
{"id":"a8410bdd-220f-42a8-b5d8-f5839ee16d42","expr":"result != null","rationale":"The return statement constructs and returns a new Type[] array, so result cannot be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getReturnTypes(Method):Type[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.580574957Z"}
{"id":"d8a6cff4-ef60-4727-aac3-c075f813de93","expr":"result.length == 2","rationale":"The method returns an array of exactly two elements: returnType and genericReturnType.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getReturnTypes(Method):Type[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.580574957Z"}
{"id":"c1b1db93-a0e3-4162-90fa-1b9708cccbc3","expr":"result != null && (result.isEmpty() || sourceClass != null)","rationale":"If result is empty or not, sourceClass is valid since it's a method parameter; this allows safe evaluation.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findParameterizedTypes(Class<?>):Set<ParameterizedType>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.588659589Z"}
{"id":"d770c6de-6c6f-40e7-87cb-c5efcc7fa8e9","expr":"result != null","rationale":"The returned Set is never null as per method implementation (unmodifiableSet of a Set).","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findParameterizedTypes(Class<?>):Set<ParameterizedType>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.588659589Z"}
{"id":"52a5a8f0-bc0e-45d8-be7e-f14e1b24e3d8","expr":"(result.isEmpty() || sourceClass.getGenericInterfaces().length > 0 || sourceClass.getGenericSuperclass() != null)","rationale":"If result is not empty, then the sourceClass has at least some generic interfaces or superclass.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findParameterizedTypes(Class<?>):Set<ParameterizedType>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.588659589Z"}
{"id":"a77030eb-1da1-439a-a805-28c77ac79313","expr":"bean != null && methodName != null && !methodName.isEmpty() && bean.getClass().getMethods().length > 0","rationale":"At method entry, bean and methodName are expected to be non-null and methodName non-empty; bean's class should have methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getProperty(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.604744073Z"}
{"id":"8b462b6f-5885-4c10-b068-4d4e4e88ac4e","expr":"bean.getClass().getName() != null","rationale":"bean.getClass().getName() returns a non-null class name.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getProperty(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.604744073Z"}
{"id":"2fe4f520-5cdd-4c7a-9487-84f8b910fec8","expr":"methodName.length() > 0","rationale":"methodName is a non-null, likely non-empty string to find a matching method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getProperty(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.604744073Z"}
{"id":"22ee8a9d-e795-45cd-bff9-3b3c5459d495","expr":"bean != null && methodName != null","rationale":"Typically at method entry, parameters are expected to be non-null for correct operation.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getProperty(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.604744073Z"}
{"id":"bad6dd40-c27d-4fe9-80b3-4064c80acb94","expr":"methodName.equals(methodName)","rationale":"Excluded trivial tautologies according to instructions.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getProperty(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.604744073Z"}
{"id":"9349c560-8610-4c5f-bc5b-316e6ba7339e","expr":"result != null && (result.isEmpty() || result.contains(matchType) || matchType.isAssignableFrom(sourceClass))","rationale":"The result set contains classes assignable from matchType and related to sourceClass.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findHierarchicalTypes(Class<?>,Class<T>):Set<Class<T>>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.605594810Z"}
{"id":"2c95e366-fa64-4618-b184-d68469b59b2d","expr":"!result.isEmpty() || sourceClass == null","rationale":"If sourceClass is null, result must be empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findHierarchicalTypes(Class<?>,Class<T>):Set<Class<T>>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.605594810Z"}
{"id":"b6324d1e-b199-427c-a23c-329a3770288f","expr":"!result.isEmpty() || matchType.isAssignableFrom(sourceClass)","rationale":"matchType assignability to sourceClass implies non-empty result.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findHierarchicalTypes(Class<?>,Class<T>):Set<Class<T>>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.605594810Z"}
{"id":"3ae74ad1-75b5-4186-998e-efed10fc757e","expr":"sourceClass != null && sourceClass.isInterface() == false","rationale":"Since method is designed to find parameterized types in class hierarchy, sourceClass is expected to be a valid class, not an interface.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findParameterizedTypes(Class<?>):Set<ParameterizedType>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.606651265Z"}
{"id":"7057e204-b39e-4208-b6e1-0fb593df4483","expr":"sourceClass.getGenericInterfaces() != null","rationale":"The method getGenericInterfaces returns a non-null array.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findParameterizedTypes(Class<?>):Set<ParameterizedType>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.606651265Z"}
{"id":"9bd94541-db27-4922-b11d-e48ab59ad5e3","expr":"!(sourceClass.isPrimitive())","rationale":"Primitives do not have generics, so sourceClass is not primitive.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findParameterizedTypes(Class<?>):Set<ParameterizedType>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.606651265Z"}
{"id":"97177db0-a7d0-4245-966b-ef11af49cb08","expr":"sourceClass.getTypeParameters().length >= 0","rationale":"Type parameters array is always non-null but may be empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findParameterizedTypes(Class<?>):Set<ParameterizedType>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.606651265Z"}
{"id":"0e3c7bc0-5d07-4a10-afa4-f141aca07a5a","expr":"matchType.isAssignableFrom(sourceClass) || !sourceClass.isAssignableFrom(matchType)","rationale":"If matchType is not assignable from sourceClass, sourceClass must not be assignable from matchType for the add operation condition.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findHierarchicalTypes(Class<?>,Class<T>):Set<Class<T>>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.613693629Z"}
{"id":"ecade0d2-bbba-4ace-8666-a3141505b9bb","expr":"sourceClass.getSuperclass() == null || matchType.isAssignableFrom(sourceClass.getSuperclass()) || !matchType.isAssignableFrom(sourceClass)","rationale":"The method recurses on sourceClass.getSuperclass(), so for assignability checks, either the superclass is null or matchType assigns it or sourceClass.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findHierarchicalTypes(Class<?>,Class<T>):Set<Class<T>>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.613693629Z"}
{"id":"07fa8989-35f6-4d7b-b983-1fa3e46980ca","expr":"matchType != null","rationale":"matchType is dereferenced without null checks, so it must be non-null at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findHierarchicalTypes(Class<?>,Class<T>):Set<Class<T>>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.613693629Z"}
{"id":"723a1d3c-5e31-4313-86ef-13c95ada3488","expr":"!matchType.isInterface() || sourceClass.isInterface()","rationale":"If matchType is an interface, sourceClass could be either class or interface; if matchType is a class, sourceClass should not be an interface to be assignable.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findHierarchicalTypes(Class<?>,Class<T>):Set<Class<T>>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.613693629Z"}
{"id":"87b10732-1dfd-4ea1-80bf-984bf1b3635e","expr":"methodName != null && bean != null && result != null || result == null","rationale":"If bean and methodName are non-null then matching method invocation may produce non-null result or fallback to null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getProperty(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.616530638Z"}
{"id":"7db8bb2a-5ed0-4658-b5f4-00226663247d","expr":"(result == null) || bean.getClass().isAssignableFrom(result.getClass())","rationale":"The returned property value's class should be compatible with the bean's class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getProperty(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.616530638Z"}
{"id":"998b337a-82bc-4cef-95ce-9ddba7a8b8ac","expr":"(result == null) || true","rationale":"result can be null or any reference type; method may fail to find or invoke method.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getProperty(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.616530638Z"}
{"id":"6fdf1d72-a4cf-4ddc-909a-d7c1bafcbd48","expr":"beanClass != null && methodName != null && methodName.length() > 0","rationale":"The method intends to find a method with a given name in beanClass; methodName should be a non-empty string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#hasMethod(Class<?>,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.620303304Z"}
{"id":"f95521b0-ffa7-4985-aa7a-fb156cbdf0b6","expr":"beanClass.isInterface() || !beanClass.isPrimitive()","rationale":"Only classes or interfaces, not primitives, can have methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#hasMethod(Class<?>,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.620303304Z"}
{"id":"40305a57-bf4e-4bc5-91a5-5eb7c90fc98a","expr":"beanClass.getName() != null","rationale":"Class objects always have a name string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#hasMethod(Class<?>,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.620303304Z"}
{"id":"0b27002f-1b7f-4b90-ba75-c3554756a7bc","expr":"!methodName.isEmpty()","rationale":"An empty methodName makes no sense for method lookup.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#hasMethod(Class<?>,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.620303304Z"}
{"id":"bd8de9fb-1686-40bc-aee0-c0d01856bb7e","expr":"beanClass.getDeclaredMethods() != null","rationale":"Reflection API guarantees non-null arrays for declared methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#hasMethod(Class<?>,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.620303304Z"}
{"id":"fc40d7d9-2aa3-4198-a663-cf7e9506684c","expr":"(result == false) || (methodName.length() > 0)","rationale":"If the method is present, the methodName is likely non-empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#hasMethod(Class<?>,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.628346909Z"}
{"id":"4ab5f9f8-e723-4aa5-9214-4c3f6d9f92ee","expr":"(!result) || (methodName != null)","rationale":"If the method was found, methodName used for comparison must be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#hasMethod(Class<?>,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.628346909Z"}
{"id":"3de19a84-ed0c-4a2d-b101-b52d8744b373","expr":"result.length == values.length || (values == null && result.length == 0)","rationale":"The result array length matches the values length unless the input is empty or null, returning an empty array.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#resolveTypes(Object):Class[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.644362532Z"}
{"id":"308a2b15-e640-4919-ae95-9eedaa495f24","expr":"result != null","rationale":"The method always returns a non-null Class array.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#resolveTypes(Object):Class[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.644362532Z"}
{"id":"60dbc7db-bc3a-487f-81cd-8ef1e742b1ba","expr":"(values == null || values.length == 0) == (result.length == 0)","rationale":"If input is null or empty, result is empty array, else not.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#resolveTypes(Object):Class[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.644362532Z"}
{"id":"118b0bd6-3b8b-466a-b5d5-c6de32ecb5d6","expr":"clazz != null && clazz.getDeclaredConstructors().length > 0","rationale":"If the checkZeroArgConstructor method is to return true, the class must have at least one declared constructor.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#checkZeroArgConstructor(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.645440388Z"}
{"id":"32cab30c-ec1a-4125-ba1c-6f1be94a3847","expr":"clazz != null","rationale":"The method requires a non-null Class parameter.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#checkZeroArgConstructor(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.645440388Z"}
{"id":"71d21785-c916-401d-9300-72e965ec7568","expr":"!clazz.isPrimitive()","rationale":"The class must not be a primitive type for the zero-argument constructor concept to hold.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#checkZeroArgConstructor(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.645440388Z"}
{"id":"d4a35388-cae5-4139-a889-6ce181f3ee65","expr":"!clazz.isArray()","rationale":"The class must not be an array to have a zero-argument constructor.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#checkZeroArgConstructor(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.645440388Z"}
{"id":"462b22ae-fe94-41a8-adfa-d3a69d182a64","expr":"clazz.getEnclosingClass() == null || clazz.isMemberClass()","rationale":"Class should be either a top-level class or a member class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#checkZeroArgConstructor(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.645440388Z"}
{"id":"5549a5bc-6c2f-4f7a-a2b2-5e1b663d6268","expr":"clazz != null && !result || clazz.getDeclaredConstructor() != null && result == true","rationale":"The method returns true iff clazz has a zero-arg constructor, so if result is true, getDeclaredConstructor() call succeeds; if false, it throws NoSuchMethodException.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#checkZeroArgConstructor(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.648655782Z"}
{"id":"858f5973-7a8d-4074-b6b2-74ceab17e97a","expr":"clazz != null && result == (clazz.getDeclaredConstructor() != null)","rationale":"The result reflects the presence of a zero-argument constructor by the success of getDeclaredConstructor().","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#checkZeroArgConstructor(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.648655782Z"}
{"id":"c2bfdc6b-f603-44e4-91b3-c8eecf38d074","expr":"clazz != null && result == true || clazz == null || result == false","rationale":"If clazz is null, method would throw NullPointerException, but no explicit null check; mostly result reflects the existence of a zero-arg constructor.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#checkZeroArgConstructor(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.648655782Z"}
{"id":"af218019-adee-44c9-acb7-7de742349b1d","expr":"clazz != null","rationale":"The parameter clazz must not be null to safely call getName() in the method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isJdk(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.653001972Z"}
{"id":"24a7d073-b687-4bfb-b141-88bad154e8e3","expr":"clazz.getName() != null","rationale":"Class.getName() returns a non-null String, so this invariant holds.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isJdk(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.653001972Z"}
{"id":"dbda2f34-57d9-4bd7-bec7-3844580e81c1","expr":"clazz.getName().length() > 0","rationale":"Class.getName() is a non-empty valid binary name string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isJdk(Class):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.653001972Z"}
{"id":"818d5ee9-dc08-4af3-a5fa-07cf7e5cdb24","expr":"values == null || values.getClass().isArray() != false","rationale":"values is either null or an array of Object (varargs).","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#resolveTypes(Object):Class[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.670500658Z"}
{"id":"a39efbc3-5032-470a-a238-f3b01bbe20d6","expr":"values == null || values.length >= 0","rationale":"Length of the values array is non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#resolveTypes(Object):Class[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.670500658Z"}
{"id":"e2995cc6-90de-4bfa-986e-d7785d500b9c","expr":"method != null","rationale":"The method parameter must be non-null to be used.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#makeAccessible(Method):void","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.673448356Z"}
{"id":"8057322a-80d6-416b-93a2-c379882a10cb","expr":"method != null && method.isAccessible()","rationale":"The method is guaranteed to be accessible upon method exit either because it was initially accessible or set accessible by makeAccessible.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#makeAccessible(Method):void","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.680090994Z"}
{"id":"8e619bb6-cbd3-45ed-a804-85cb9e11e8c5","expr":"result != null","rationale":"The result set is always instantiated and returned, so it cannot be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getAllFieldNames(Class<?>):Set<String>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.697622251Z"}
{"id":"831c0208-34ae-44f7-a9e8-dc8027cc9fe8","expr":"!result.contains(null)","rationale":"Field.getName() never returns null, so the set contains no null elements.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getAllFieldNames(Class<?>):Set<String>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.697622251Z"}
{"id":"9a852bf5-ffd4-4999-bebe-94bd33ae1b66","expr":"result.size() >= type.getDeclaredFields().length","rationale":"The set contains at least all fields declared in the input class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getAllFieldNames(Class<?>):Set<String>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.697622251Z"}
{"id":"444d01a7-db6a-436b-832a-2febf9534f1a","expr":"obj != null","rationale":"The method throws an exception if obj is null, so obj != null always holds at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getFieldValue(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.703922532Z"}
{"id":"c699e724-49b8-47d1-bbd8-e6081fa7256d","expr":"fieldName != null","rationale":"Although not explicitly checked, fieldName being null would cause getDeclaredField to throw a NullPointerException, so it is expected to be non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getFieldValue(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.703922532Z"}
{"id":"9bd19902-8abb-4682-8594-dfd1523a4e17","expr":"fieldName.length() > 0","rationale":"ReflectUtils#getFieldValue usually expects a non-empty field name to retrieve a field.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getFieldValue(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.703922532Z"}
{"id":"af718b1f-e766-4ee3-9f99-58bc8ec83823","expr":"obj.getClass() != null","rationale":"obj.getClass() is never null for any non-null obj.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getFieldValue(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.703922532Z"}
{"id":"835bf817-2cad-4c5e-8567-7c3a82fd6a9e","expr":"!fieldName.isEmpty()","rationale":"An empty string usually is not a valid field name in Java reflection.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getFieldValue(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.703922532Z"}
{"id":"e3a55594-3bc8-46c2-bf52-eaed785cc4b2","expr":"obj != null && fieldName != null && result != null || (result == null)","rationale":"obj is never null due to check, fieldName must be non-null for getDeclaredField, result can be null if the field value is null","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getFieldValue(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.706298040Z"}
{"id":"4f3f32c4-5a4f-4739-a569-f28dead8f7d5","expr":"result == obj.getClass().getDeclaredField(fieldName).get(obj)","rationale":"result matches the value obtained from the field access on obj.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getFieldValue(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.706298040Z"}
{"id":"cfd0a826-7c4b-4efb-ae62-bbe173408586","expr":"cs == null || cs.length() >= 0","rationale":"If cs is not null, its length() must be non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.StringUtils#length(CharSequence):int","file":"org/apache/dubbo/common/utils/StringUtils.java","createdAt":"2026-09-10T20:13:49.707323437Z"}
{"id":"60f57bc5-c16a-40a6-a0a8-1f744fcab18b","expr":"!(cs == null && cs.length() > 0)","rationale":"If cs is null, it cannot have positive length.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.StringUtils#length(CharSequence):int","file":"org/apache/dubbo/common/utils/StringUtils.java","createdAt":"2026-09-10T20:13:49.707323437Z"}
