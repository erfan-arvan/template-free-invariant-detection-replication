{"id":"93b5ceb0-2042-4c4f-8578-fcab349899c0","expr":"(!logger.isInfoEnabled() || (msg != null))","rationale":"msg is not necessarily null when info enabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-10T20:13:50.750173194Z"}
