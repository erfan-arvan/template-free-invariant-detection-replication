{"id":"70edc0c3-d81a-4c99-ad27-1bc624513527","expr":"!name.contains(\"[\") || result.startsWith(\"[\")","rationale":"The output descriptor starts with '[' if input name contained arrays.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#name2desc(String):String","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.248634627Z"}
