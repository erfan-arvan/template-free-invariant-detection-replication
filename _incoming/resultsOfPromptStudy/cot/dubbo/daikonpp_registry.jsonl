{"id":"d99ba5ed-7419-4c50-b2b9-90776eb72b1f","expr":"name == null || !name.startsWith(\"[\")","rationale":"name represents a human-readable type name which usually doesn't start with '[' unless it is an array type descriptor.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#name2desc(String):String","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-10T20:13:49.255770357Z"}
