{"id":"28e2e909-00f1-455c-bcb8-056ded919bf3","expr":"declaringClass.getDeclaredMethods().length >= 0","rationale":"Java API guarantees non-negative array length","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.804836667Z"}
