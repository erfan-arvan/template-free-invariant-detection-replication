{"id":"e7e34f3e-3fb8-40e0-a258-ee8ea1d9aef8","expr":"(byte1 & 0xC0) == 0xE0","rationale":"UTF-8 4-byte sequence lead byte should start with bits 1110xxxx, i.e., (byte1 & 0xC0) == 0xE0.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DecodeUtil#handleFourBytesSafe(byte,byte,byte,byte,char[],int):void","file":"org/apache/dubbo/common/utils/Utf8Utils.java","createdAt":"2026-09-10T20:13:47.348890034Z"}
