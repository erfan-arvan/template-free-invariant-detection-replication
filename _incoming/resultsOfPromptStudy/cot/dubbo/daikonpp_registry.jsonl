{"id":"785fe0e6-81ac-4112-a53d-e699d17a2a5e","expr":"declaringClass != null && declaringClass.isInterface() == false","rationale":"declaringClass should be a concrete class, often not an interface.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.805518384Z"}
{"id":"d4091d8e-987d-4213-ace7-c2f4b7d301ee","expr":"methodsToFilter != null","rationale":"methodsToFilter array should not be null at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.805518384Z"}
{"id":"c699b5d1-4ab9-41a8-ad64-205bf4d75f48","expr":"(methodsToFilter.length == 0) || (methodsToFilter.length > 0)","rationale":"methodsToFilter array length should be non-negative (always true constraint on length)","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.805518384Z"}
{"id":"028c16a0-3408-4a12-951f-5f0b07dac526","expr":"method != null","rationale":"Since the method parameter is required to be checked for Deprecated annotation, it is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#isDeprecated(Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.809684114Z"}
{"id":"9a58e661-05d4-4e39-b738-bd9904f5d057","expr":"declaringClass != null && methodsToFilter != null && methodsToFilter.getClass().isArray() && methodsToFilter.length >= 0","rationale":"methodsToFilter is an array of Predicate<Method>, so it is non-null at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.810650269Z"}
{"id":"a84bd8d3-baec-46d0-ad0f-8181bbbbd645","expr":"!declaringClass.isPrimitive()","rationale":"Primitives do not have methods, so declaringClass should not be primitive.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.810650269Z"}
{"id":"270a6536-9937-42cb-89f7-a5ae63a4a9d8","expr":"declaringClass != null && methodsToFilter != null","rationale":"declaringClass and methodsToFilter are parameters and expected to be non-null when passed.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.810650269Z"}
{"id":"103b9af4-622a-4ca4-ba24-92ab7558ea3d","expr":"!declaringClass.isArray() || declaringClass.getComponentType() != null","rationale":"If declaringClass represents an array type, its component type must not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.810650269Z"}
{"id":"a4ab3cfc-9780-4eb1-9aac-07d36b0cd52a","expr":"result != null","rationale":"The method returns a List of Methods, so result should not be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.811701825Z"}
{"id":"ba567c13-45f8-471f-b9b1-c11b458091a1","expr":"!result.isEmpty() || declaringClass.getDeclaredMethods().length == 0","rationale":"If the declaringClass has no declared methods, then result should be empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.811701825Z"}
{"id":"40f5a040-acaa-460a-8e08-91b2d9ebd876","expr":"result != null","rationale":"The method returns a List of Methods, so the result should not be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.814275928Z"}
{"id":"422274ec-5ece-4360-87b3-821217da330b","expr":"!result.isEmpty() || declaringClass.getDeclaredMethods().length == 0","rationale":"If there are no declared methods, result may be empty; otherwise result should not be empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.814275928Z"}
{"id":"845c2aa9-1530-4ff7-9732-9a3c24bb5cde","expr":"type != null && methodName != null && !methodName.isEmpty() && type.isInterface() == false","rationale":"'type' and 'methodName' must be non-null and 'methodName' non-empty as preconditions for method finding.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.816022687Z"}
{"id":"c6cbb01e-a61b-4987-af4d-f6efc11ed732","expr":"type != null","rationale":"'type' must be non-null at the entry of findMethod(Class, String).","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.816022687Z"}
{"id":"6c2c75a9-0c56-40ab-9fd5-15c10272c939","expr":"methodName != null && methodName.length() > 0","rationale":"'methodName' must be a non-empty string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.816022687Z"}
{"id":"2bd48f06-c912-492a-85f6-8cb8669fba79","expr":"type.getMethods().length >= 0","rationale":"The methods array of a Class always has length zero or more.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.816022687Z"}
{"id":"1c0257d0-4383-47c7-86bb-9cc92139593e","expr":"result != null","rationale":"The method returns a List of Method, so the result should be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.816764539Z"}
{"id":"6f86b511-876b-4668-9b19-06cde2a3b82f","expr":"!result.isEmpty() || (result.isEmpty() && declaringClass != null)","rationale":"If no methods are found, the result can be empty, but declaringClass should be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.816764539Z"}
{"id":"0ee94e79-de27-434a-b738-bb58f9368c35","expr":"methodsToFilter == null || methodsToFilter.test(result.get(0)) || result.isEmpty()","rationale":"If methodsToFilter is provided, the first method in the result should satisfy it, or result can be empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.816764539Z"}
{"id":"41b150ad-109a-4570-b024-9ea10484b6d9","expr":"result != null","rationale":"The method returns a list of methods, so the result should never be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.821160312Z"}
{"id":"e4b598b3-ae63-4ede-82fa-67ba91041eac","expr":"!result.isEmpty() || !declaringClass.getDeclaredMethods().toString().isEmpty()","rationale":"If the declaring class has declared methods, the result should not be empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.821160312Z"}
{"id":"1f72db9c-8b77-47ca-9c08-4b0b378be625","expr":"result == null || result.getName().equals(methodName)","rationale":"Resulting method's name matches the requested methodName if not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.822008174Z"}
{"id":"e0004468-cb87-49b2-b354-da6c95468443","expr":"result == null || result.getDeclaringClass().equals(type)","rationale":"Resulting method is declared by the given type if result is not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.822008174Z"}
{"id":"976a4f4b-8895-4817-b706-383635219202","expr":"type == null || methodName == null || methodName.isEmpty() || result == null || (result.getDeclaringClass().equals(type) && result.getName().equals(methodName))","rationale":"Valid inputs and found method imply matching method name and declaring class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.822008174Z"}
{"id":"780691f4-b10c-47e1-91ca-f4df4ef026bf","expr":"result == null || result.getModifiers() >= 0","rationale":"Result method's modifiers field is a valid non-negative integer.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.822008174Z"}
{"id":"f6574173-d119-4932-b5a4-5bbc9b637ced","expr":"object.getClass().getMethods()!=null","rationale":"The class of object has a non-null methods array.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.825066291Z"}
{"id":"3ec0a16a-16a5-4c37-b526-80dfab07a2c0","expr":"!methodName.isEmpty()","rationale":"methodName is non-empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.825066291Z"}
{"id":"8231c5bb-9457-4c9a-9ed1-299d133eeb6e","expr":"methodParameters.length >= 0","rationale":"methodParameters array length is non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.825066291Z"}
{"id":"c7375fc0-07da-4783-8e77-dd892e1f6939","expr":"overrider != null && overridden != null","rationale":"The method returns false if either overrides or overridden is null, so at method entry both are expected to be non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.826826426Z"}
{"id":"f8d8f7c0-b4f1-4f3d-a188-a9034d91d747","expr":"!Objects.equals(overrider, overridden)","rationale":"The method returns false if overrider equals overridden.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.826826426Z"}
{"id":"3d34094f-9056-4ad7-97a9-7cbb8db828b7","expr":"overridden.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"The overrider's declaring class must inherit from the overridden's class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.826826426Z"}
{"id":"c6224f59-fb77-4019-b002-f13040d409a5","expr":"result != null || type.getDeclaredMethods().length == 0 || methodName == null || methodName.isEmpty()","rationale":"Ensures that if result is null, it's possibly due to no methods or invalid methodName.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.827492354Z"}
{"id":"8f92f88c-43c0-4606-a8dc-8a79aed360d6","expr":"result == null || result.getName().equals(methodName)","rationale":"The found method must have the requested name.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.827492354Z"}
{"id":"f9383a71-2efd-4542-9619-7820c0baa7f2","expr":"result == null || result.getDeclaringClass().equals(type) || type.isAssignableFrom(result.getDeclaringClass())","rationale":"Ensures that the method corresponds to type or its subclass.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.827492354Z"}
{"id":"2760a97b-aa39-4080-9373-90bebb6be86f","expr":"type != null || methodName == null || methodName.isEmpty() || parameterTypes == null || parameterTypes.length >= 0","rationale":"If type is null, then methodName might be null or empty; parameterTypes can be any array length.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.833858479Z"}
{"id":"bc380fbf-dbd6-46df-a41c-647d5ed69879","expr":"result == null || !result.equals(overrider)","rationale":"If there is an overridden method, it should be distinct from the overrider itself.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.833960893Z"}
{"id":"96e4ffe0-be0e-45d3-81f2-5f64310f7b8a","expr":"result == null || result.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"The result method is overridden by the overrider, so its declaring class must be a superclass or interface of that of the overrider.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.833960893Z"}
{"id":"5fa9c2ed-4597-4f17-95dd-af84d8f217ef","expr":"result == null || result.getName().equals(overrider.getName())","rationale":"Overriding methods share the same name.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.833960893Z"}
{"id":"7fc7ad61-1ed6-4501-af2a-6c4d0e6605d9","expr":"result == null || result.getReturnType().equals(overrider.getReturnType())","rationale":"Typically, overriding methods have matching return types.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.833960893Z"}
{"id":"1d220f3c-8f9f-4fb3-80e8-a78d5c85682f","expr":"overrider != null","rationale":"The overrider method parameter must be non-null to find overridden methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.834628173Z"}
{"id":"fcccb677-c10f-4bea-bbbe-682bd424267f","expr":"overrider.getDeclaringClass() != null","rationale":"The overrider method must have a declaring class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.834628173Z"}
{"id":"2ecd46a1-a86b-4973-be3f-7bbcb71bf137","expr":"overrider.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"A class is always assignable from itself.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.834628173Z"}
{"id":"694da369-6477-41eb-b48c-9d0199433080","expr":"overrider.getParameterCount() >= 0","rationale":"Parameter count must be zero or positive.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.834628173Z"}
{"id":"c230c018-3489-4424-90fe-e1aea08d2341","expr":"overrider.isBridge() == false || overrider.isSynthetic() == false","rationale":"Most methods are not both bridge and synthetic.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.834628173Z"}
{"id":"87122491-f2f5-466b-bde4-0ec09f7d5910","expr":"overrider != null && declaringClass != null && declaringClass.isAssignableFrom(overrider.getDeclaringClass()) == false","rationale":"The 'overrider' method is non-null and 'declaringClass' is non-null, and 'declaringClass' is not assignable from 'overrider's declaring class, consistent with override semantics.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.836267690Z"}
{"id":"47eddce4-0971-4987-9836-3b64674ad396","expr":"overrider.getDeclaringClass() != declaringClass","rationale":"The 'overrider' method's declaring class is different from 'declaringClass', so we may find methods in 'declaringClass' that are overridden by 'overrider'.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.836267690Z"}
{"id":"e2bf73fc-5dce-4f0d-b33a-dbe8a8ad52f7","expr":"declaringClass.isInterface() || !overrider.isSynthetic()","rationale":"Either declaringClass is an interface or the overrider method is not synthetic, as synthetic methods are less likely to participate in overriding.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.836267690Z"}
{"id":"6e34146d-9406-4ac2-9c12-8a30c78cf472","expr":"overrider.getParameterCount() >= 0","rationale":"The method 'overrider' has a non-negative parameter count.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.836267690Z"}
{"id":"db8cf9f8-e293-4fa7-b4d9-fbe7c7a27030","expr":"overrider.getName() != null && !overrider.getName().isEmpty()","rationale":"The overrider method has a valid method name.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.836267690Z"}
{"id":"b43046e8-f5f4-4ce4-a15c-570b5ce14151","expr":"result == null || true","rationale":"Result can be null or non-null depending on invoked method.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T20:13:48.837452028Z"}
