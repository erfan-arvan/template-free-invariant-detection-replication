{"id":"c2a6bf41-3544-4b07-b13c-00f7da7e47eb","expr":"m.getName() != null","rationale":"Method.getName() in Java standard always returns a non-null String.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getDesc(Method):String","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:49.816303779Z"}
