{"id":"97b87c1b-33f6-4648-81af-736bef1ee715","expr":"(result.isPrimitive() || result.isArray() || !result.isPrimitive())","rationale":"The result class can be a primitive type, an array type, or a normal class; this invariant reflects the possible types.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#name2class(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.000424104Z"}
{"id":"d1d1e02a-36f7-47c3-bf5c-330741bf8cc5","expr":"result != null","rationale":"The method always returns an array (possibly EMPTY_CLASS_ARRAY) thus result is not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#desc2classArray(ClassLoader,String):Class<?>[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.013951170Z"}
{"id":"2770b941-8459-497a-bdec-0fbfc8db1754","expr":"result.length == 0 || desc.length() > 0","rationale":"If desc is empty, method returns EMPTY_CLASS_ARRAY (length 0), otherwise the result is non-empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#desc2classArray(ClassLoader,String):Class<?>[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.013951170Z"}
{"id":"0b76f771-c70e-4951-ba88-a1b0e1311741","expr":"result.getClass().isArray()","rationale":"The result is always an array of Class<?> objects.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#desc2classArray(ClassLoader,String):Class<?>[]","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.013951170Z"}
{"id":"8deabf7e-1ee6-4991-8a72-e28a07c89f4c","expr":"!methodName.isEmpty()","rationale":"methodName is a String representing the method name, which should not be empty string to identify a method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodSignature(Class<?>,String,String[]):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.015666018Z"}
{"id":"c92f3e93-a0a5-4387-ad77-c3907a6bceda","expr":"parameterTypes == null || parameterTypes.length >= 0","rationale":"If parameterTypes is not null, it must have zero or more elements representing parameter type names.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodSignature(Class<?>,String,String[]):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.015666018Z"}
{"id":"0b2d0ab8-46ab-4f30-952a-40fb22750e79","expr":"clazz.getMethods().length >= 0","rationale":"clazz.getMethods() returns all public methods of clazz, so its length is >= 0.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodSignature(Class<?>,String,String[]):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.015666018Z"}
{"id":"ba4641c0-da46-4d03-a236-da057311ce1f","expr":"clazz != null && methodName != null && !methodName.isEmpty()","rationale":"At the method entry, clazz and methodName should be non-null and methodName is expected to be a non-empty string for a valid method search.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodName(Class<?>,String):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.025505775Z"}
{"id":"90810cf0-a518-472e-bfc0-9e62f75aebeb","expr":"clazz.isInterface() || clazz.isEnum() || clazz.isArray() || !clazz.isPrimitive()","rationale":"The clazz parameter should be a valid class type, commonly not a primitive type when searching for methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodName(Class<?>,String):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.025505775Z"}
{"id":"dd20d750-13bc-46b1-9898-645443af155b","expr":"!methodName.startsWith(\" \") && !methodName.endsWith(\" \")","rationale":"Method names should not have leading or trailing spaces.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodName(Class<?>,String):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.025505775Z"}
{"id":"659c4387-29b6-41f2-a241-cf4fa33d0d15","expr":"clazz.getMethods().length >= 0","rationale":"The clazz.getMethods() will always return a non-null array with length >= 0.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodName(Class<?>,String):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.025505775Z"}
{"id":"6cb8406a-1824-4a08-ad35-8947e7b7a92a","expr":"result != null","rationale":"The method either returns a found Method or throws an exception, so result is non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodSignature(Class<?>,String,String[]):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.028316304Z"}
{"id":"ce401728-68f1-45ee-8235-7fea9064e486","expr":"result.getName().equals(methodName)","rationale":"The returned method's name matches the requested methodName.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodSignature(Class<?>,String,String[]):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.028316304Z"}
{"id":"48e72f16-b6c9-49c3-b83f-a67cf4aba8d7","expr":"clazz.isInterface() == false","rationale":"The class is expected not to be an interface because interfaces do not have constructors.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.028419037Z"}
{"id":"a71a7141-c3b8-46c9-b09e-71d50432fcfd","expr":"paramType.isAssignableFrom(paramType)","rationale":"The paramType is always assignable from itself.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.028419037Z"}
{"id":"70a9774e-9b86-4075-84b7-179bc4e82599","expr":"clazz.getConstructors().length >= 0","rationale":"clazz.getConstructors() returns an array whose length is non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.028419037Z"}
{"id":"63271ff7-8ca4-4e31-8748-c40816273f07","expr":"paramType.isPrimitive() || !paramType.isPrimitive()","rationale":"paramType can only be primitive or non-primitive (trivially true).","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.028419037Z"}
{"id":"980ef870-7d54-46ee-a703-c15223da9d47","expr":"result != null && result.getName().equals(methodName)","rationale":"When the method returns a Method, its name matches the methodName parameter.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodName(Class<?>,String):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.029093477Z"}
{"id":"1da9c97d-9cff-4242-9fa7-04ffc38a945b","expr":"result.getDeclaringClass().isAssignableFrom(clazz)","rationale":"The declaring class of the returned method should be assignable from the input class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodName(Class<?>,String):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.029093477Z"}
{"id":"5a7f3e3f-ed7d-4475-97f5-55f28ffc8970","expr":"!clazz.isInterface() || (result.getDeclaringClass().isInterface() && result.getName().equals(methodName))","rationale":"For an interface clazz, the returned Method is also declared on an interface matching the methodName.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodName(Class<?>,String):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.029093477Z"}
{"id":"99ffe51f-d601-4333-9a3b-4ccdaa38ba2d","expr":"result.getParameterCount() >= 0","rationale":"The method's parameter count is non-negative.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodName(Class<?>,String):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.029093477Z"}
{"id":"7ab316c4-2657-461b-a854-0a77645204b9","expr":"result.getReturnType() != null","rationale":"The result method's return type is non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodName(Class<?>,String):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.029093477Z"}
{"id":"5c9a5bf6-8a96-4baa-ba9d-d6e1a1c9bd58","expr":"result.getDeclaringClass().isAssignableFrom(clazz) || clazz.isAssignableFrom(result.getDeclaringClass())","rationale":"The returned method belongs to clazz or a related class in the hierarchy.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodSignature(Class<?>,String,String[]):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.028316304Z"}
{"id":"405a855e-5d28-4f31-a0e9-41a9f44bb749","expr":"parameterTypes == null || (result.getParameterCount() == parameterTypes.length)","rationale":"When parameterTypes is non-null, the returned method has same number of parameters.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findMethodByMethodSignature(Class<?>,String,String[]):Method","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.028316304Z"}
{"id":"9d39a29e-81bf-4a17-9216-4e85cdd3ee62","expr":"result == null || result.getParameterTypes().length == 1","rationale":"The returned constructor, if not null, must have a single parameter.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.043169476Z"}
{"id":"0e9ed48e-b1fd-4d99-89f0-e1fa31ed630b","expr":"result == null || result.getParameterTypes()[0].isAssignableFrom(paramType)","rationale":"The constructor's single parameter type must be assignable from paramType.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.043169476Z"}
{"id":"b88fe4fb-98b1-46b1-9d8a-3a0587d9d6a6","expr":"result == null || clazz.equals(result.getDeclaringClass())","rationale":"The constructor's declaring class must be clazz.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.043169476Z"}
{"id":"47f725e2-88d6-4492-8cb9-505646a9766b","expr":"(result != null)","rationale":"If not throwing, the method returns a non-null constructor.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#findConstructor(Class<?>,Class<?>):Constructor<?>","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.043169476Z"}
{"id":"2d28ce23-61f4-412e-80f6-4cc58f3d2ce4","expr":"obj != null || interfaceClazzName == null","rationale":"obj can be null or interfaceClazzName can be null, no direct connection but both are inputs.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isInstance(Object,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.046224716Z"}
{"id":"794fad49-bcd3-46b1-a46e-f79c2a05b356","expr":"interfaceClazzName != null","rationale":"Typically the interface class name argument should not be null to make sense.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isInstance(Object,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.046224716Z"}
{"id":"321681b3-890c-4855-bb60-1b0e6d973b33","expr":"obj == null || obj.getClass() != null","rationale":"If obj is not null, then obj.getClass() is valid and non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isInstance(Object,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.046224716Z"}
{"id":"f3f68583-d7ab-4592-a832-2e1b7adf59b7","expr":"interfaceClazzName.length() > 0","rationale":"Interface class name should logically be non-empty string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isInstance(Object,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.046224716Z"}
{"id":"05cb1b2a-1bdf-413e-a467-82a89c67164f","expr":"obj != null && !interfaceClazzName.isEmpty()","rationale":"Typically, obj and interfaceClazzName should be non-null and interfaceClazzName non-empty for the method to work.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isInstance(Object,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.046224716Z"}
{"id":"6cca9395-398a-4779-ac14-7558ca9daa21","expr":"(obj == null || interfaceClazzName == null) ? result == false : true","rationale":"If either input is null, the method would not match any interface, so result should be false.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#isInstance(Object,String):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.050973282Z"}
{"id":"6fc6c789-bd58-4e54-bec7-f235d3ee3002","expr":"result != null || returnType.isPrimitive() || returnType == null","rationale":"The method returns a non-null empty object unless the returnType is primitive or null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.061232429Z"}
{"id":"f350926d-5f91-461b-b334-35eaea6c8260","expr":"returnType == null || returnType.isAssignableFrom(result.getClass())","rationale":"The result is an instance of the returnType if returnType is known.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.061232429Z"}
{"id":"b8432d1f-8fa5-48f3-a113-2e5a52404fab","expr":"result.getClass().isInstance(result)","rationale":"Any result is an instance of its own class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.061232429Z"}
{"id":"a8f7fb9b-ca2d-4ce8-aa19-42a35fbc6829","expr":"result != null || !returnType.isPrimitive()","rationale":"If the returnType is primitive, result cannot be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.061232429Z"}
{"id":"26c33d5e-3870-49ab-baae-51ae928397f5","expr":"returnType != null","rationale":"The class parameter returnType must not be null before method execution.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.062242279Z"}
{"id":"c001ea8c-0367-45c8-9af7-a709caf69012","expr":"returnType.isInterface() == false","rationale":"returnType cannot be an interface at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.062242279Z"}
{"id":"da19c6da-dab8-434e-ac73-f1595769efd3","expr":"returnType.isPrimitive() == false","rationale":"returnType cannot be a primitive type at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.062242279Z"}
{"id":"4e3f68c8-271a-4224-9091-e588fd2d487b","expr":"returnType.isArray() == false","rationale":"returnType cannot be an array type at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.062242279Z"}
{"id":"ddb0ff31-310b-4584-9419-7bf22911ccf6","expr":"level >= 0","rationale":"The level parameter represents recursion depth and should be non-negative at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.064063577Z"}
{"id":"b39c4d7b-ecf0-4e37-8749-a7cef41341c1","expr":"emptyInstances != null","rationale":"The emptyInstances Map should be non-null to store/retrieve cached empty objects.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.064063577Z"}
{"id":"693f811a-4dda-4af3-8e81-24b770ab8475","expr":"returnType == null || level <= 2","rationale":"If returnType is null or level > 2, method returns null early; thus at method entry only these conditions govern early termination.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.064063577Z"}
{"id":"f2934f80-e75c-4a4f-973b-0acbfd9f4687","expr":"returnType != null || emptyInstances.isEmpty()","rationale":"When returnType is null, the method returns null and emptyInstances may be empty or non-empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.064063577Z"}
{"id":"925be7a8-60ee-4c35-97b9-25f81bad05fb","expr":"level <= 2 || returnType == null","rationale":"For the method to proceed past early returns, level must be <= 2 and returnType must be non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.064063577Z"}
{"id":"91ca8d59-d92e-453a-bbd6-5b98ce2bc8c4","expr":"(level > 2) == (result == null)","rationale":"When level is greater than 2, the method returns null, so result must be null in that case.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.064921020Z"}
{"id":"bce63d47-f152-4031-a853-1e112ba644dd","expr":"(returnType == null) == (result == null)","rationale":"If returnType is null, the method returns null, so result must be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.064921020Z"}
{"id":"03310875-0236-4381-9f1c-0e2b6297241e","expr":"(returnType.isArray()) == (result != null && result.getClass().isArray())","rationale":"If returnType is array, result is an array instance, so result.getClass().isArray() is true.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.064921020Z"}
{"id":"18672a02-0ea5-4ba5-9405-6462d3a3a3dc","expr":"m.getReturnType().isPrimitive() == (result != null)","rationale":"result is non-null if and only if the return type is primitive.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Method):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.079465281Z"}
{"id":"9a8a8c72-b515-483f-823d-0a1b7081659f","expr":"(result == null) == !m.getReturnType().isPrimitive()","rationale":"Null is returned exactly when the method return type is not primitive.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Method):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.079465281Z"}
{"id":"534a9568-ff71-4cb4-8e35-df97dd8fd442","expr":"m.getReturnType().isPrimitive() || result == null","rationale":"Result is null when return type is non-primitive; otherwise, not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Method):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.079465281Z"}
{"id":"e6df4ada-c691-4694-9f91-814f54a29f20","expr":"result == null || result.getClass().equals(m.getReturnType())","rationale":"If result is non-null, it is the boxed form of the primitive return type.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#defaultReturn(Method):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-08-31T05:26:50.079465281Z"}
