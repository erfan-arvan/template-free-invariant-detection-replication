{"id":"1496414c-feea-4be2-9b52-52185e0adf1f","expr":"result == null || result.getName().equals(methodName)","rationale":"At method exit, if a Method is returned, its name should match the requested methodName.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.607949177Z"}
{"id":"82e2d159-4262-4066-9f58-50dcf55e46f2","expr":"type != null || methodName == null || methodName.isEmpty() || parameterTypes != null","rationale":"If type is null, methodName cannot be a valid non-empty string to call getDeclaredMethod; parameterTypes may be needed if type is non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.608028537Z"}
{"id":"dcf210e7-b860-4690-95c2-d2c582da9417","expr":"methodName != null && !methodName.isEmpty() || type == null","rationale":"methodName must be non-empty for the method call if type is non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.608028537Z"}
{"id":"16ed4a23-9ecb-4d72-be40-772891e4c31e","expr":"result == null || result.getDeclaringClass().equals(type)","rationale":"The found method, if any, is declared in the input class 'type'.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.607949177Z"}
{"id":"39e96643-a1ca-40bd-937e-eb9eff2c0598","expr":"result == null || !result.isVarArgs()","rationale":"Since parameter types array is empty, the found method is not varargs.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.607949177Z"}
{"id":"d924461a-65ff-456c-bb06-b5f7d8fdc605","expr":"parameterTypes != null","rationale":"parameterTypes should not be null when invoking getDeclaredMethod.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.608028537Z"}
{"id":"d5d43d09-9a9b-4002-afbc-278e3fb5b1db","expr":"type == null || (methodName != null && !methodName.isEmpty())","rationale":"Ensures method invocation conditions are met.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.608028537Z"}
{"id":"97679796-856c-4014-b3de-d3c4ede5879a","expr":"type == null || parameterTypes.length >= 0","rationale":"parameterTypes array length is valid when type is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.608028537Z"}
{"id":"b22d7656-3fa3-4539-b76f-fd7fc66d6ce5","expr":"object != null && methodName != null && !methodName.isEmpty() && methodParameters != null && methodParameters.getClass().isArray()","rationale":"Method expects non-null object and methodName with methodParameters as an array.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.608983203Z"}
{"id":"d22dc833-08d3-499e-b516-887f0f7a3d8b","expr":"object.getClass() != null","rationale":"object.getClass() must not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.608983203Z"}
{"id":"523e44ae-abff-4460-809b-1fd1d2a438c9","expr":"!methodName.trim().isEmpty()","rationale":"methodName is not blank or empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.608983203Z"}
{"id":"20d5fd67-91c2-4358-94c4-544a2ce53688","expr":"result != null || methodName != null && !methodName.isEmpty()","rationale":"The result may be null if the method invoked returns null, but methodName should be a non-empty string as the method is found and invoked.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.613199237Z"}
{"id":"eece100e-abf8-4185-b6e1-55de9c65c267","expr":"(result != null) || (result == null)","rationale":"This expression is a trivial tautology and should not be included, just ensuring completeness.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.613199237Z"}
{"id":"e6c995b1-18b3-4a8e-b055-484872930b24","expr":"overrider != null && overridden != null","rationale":"The method starts with a null check for both parameters, so they must be non-null when proceeding.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.613492078Z"}
{"id":"df252750-5ebb-4946-9869-874f2e95fcf1","expr":"!Objects.equals(overrider, overridden)","rationale":"If the methods are equal, the method returns false, so at the start they are distinct.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.613492078Z"}
{"id":"509d5146-9cbf-4ff6-ab2a-8f76d685e969","expr":"Objects.equals(overrider.getName(), overridden.getName())","rationale":"The method returns false if the method names differ, so at entry they are equal.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.613492078Z"}
{"id":"aaa95be1-68bf-4aa6-8578-9ba980961829","expr":"result == null || result.getName().equals(methodName)","rationale":"If the method is found, result.getName() must equal methodName.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.613621311Z"}
{"id":"f8153431-5aae-4ad4-8878-9476abd2311e","expr":"result == null || result.getDeclaringClass().equals(type)","rationale":"If the method is found, it is declared in the class type.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.613621311Z"}
{"id":"5031b3b4-bcf1-46f0-a117-2bc5efc1a139","expr":"result == null || !methodName.isEmpty()","rationale":"If a method is found, methodName is non-empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.613621311Z"}
{"id":"09e4f1fe-9d2f-4fb6-85bc-1f88762925cd","expr":"(!result || (overrider != null && overridden != null))","rationale":"If the method returns true, both overrider and overridden must be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.616538752Z"}
{"id":"19cd1889-96bc-4bca-bf04-366595d048e2","expr":"(!result || !Objects.equals(overrider, overridden))","rationale":"When method returns true, overrider and overridden cannot be equal methods.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.616538752Z"}
{"id":"688748ad-5930-417b-944a-a8a79f167150","expr":"(!result || (overridden.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())))","rationale":"When result is true, overrider's declaring class must inherit from overridden's.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.616538752Z"}
{"id":"c43fd663-9874-4d60-8f6e-fd479a2e655e","expr":"type != null && methodName != null && !methodName.isEmpty()","rationale":"The parameters 'type' and 'methodName' must be non-null, and 'methodName' must not be empty for the method to function correctly.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.616673185Z"}
{"id":"cb147133-b98f-431b-a265-319ba85d619f","expr":"type.isAssignableFrom(type)","rationale":"This is a basic true fact about the 'type' parameter and may hold as an invariant about the class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.616673185Z"}
{"id":"4386325a-ad8f-4eb9-b132-1e05fa4de770","expr":"methodName.equals(methodName)","rationale":"This trivially holds and relates to 'methodName' string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.616673185Z"}
{"id":"11251d73-62ab-4931-b12c-e593ef53efe7","expr":"type.getName() != null","rationale":"The method likely relies on the class name being a valid string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.616673185Z"}
{"id":"fd4d5954-6e1f-4f32-84f5-9c51d33ba6eb","expr":"methodName.length() > 0","rationale":"For the method to find the method by name, the 'methodName' parameter must have length greater than zero.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.616673185Z"}
{"id":"b50570df-6ea3-402f-9629-a1fb842abf5d","expr":"overrider != null","rationale":"The parameter 'overrider' should be non-null for the method to proceed.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.618327688Z"}
{"id":"957ccdf3-f6c8-4775-96b2-778b54d1d262","expr":"overrider.getDeclaringClass() != null","rationale":"A Method object always has a declaring class (non-null).","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.618327688Z"}
{"id":"c256ab48-1cc3-47ef-9950-77c11c6d1636","expr":"overrider.isAccessible() || !overrider.isAccessible()","rationale":"Method accessibility is boolean, both states possible.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.618327688Z"}
{"id":"97a33690-5146-4488-80b3-e2a615bab33f","expr":"overrider.getParameterCount() >= 0","rationale":"Parameter count of a method cannot be negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.618327688Z"}
{"id":"6030400d-acd4-4b8a-93c6-e2ee32ed9f52","expr":"overrider.getName() != null","rationale":"Method name is always a non-null string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.618327688Z"}
{"id":"6056d1eb-5b6c-4181-9a41-b3f2008e51a7","expr":"result == null || overrider.getName().equals(result.getName())","rationale":"The overridden method found must have the same name as the overrider method.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.618656778Z"}
{"id":"1cd8bbe2-f944-4893-aff5-4aaf811f0f27","expr":"result == null || overrider.getDeclaringClass().isAssignableFrom(result.getDeclaringClass())","rationale":"The overridden method's declaring class must be a superclass or interface of the overrider's declaring class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.618656778Z"}
{"id":"1bd7d807-6f06-4a2a-aa54-40a4283541e5","expr":"result == null || result.getReturnType().equals(overrider.getReturnType())","rationale":"The overridden method and overrider have matching return types.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.618656778Z"}
{"id":"6f678b78-8a82-4095-a5b9-9c3ccb9569b5","expr":"overrider != null && declaringClass != null","rationale":"Both parameters 'overrider' and 'declaringClass' must not be null for the method to function properly.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.619244574Z"}
{"id":"7b2d3c80-82b3-4577-9b1c-a93cdce36b4f","expr":"declaringClass.isAssignableFrom(overrider.getDeclaringClass())","rationale":"The 'declaringClass' is expected to be assignable from the 'overrider's declaring class, reflecting typical override relationship.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.619244574Z"}
{"id":"a151809b-813d-40de-9758-2d33f95c6a55","expr":"overrider.getParameterCount() >= 0","rationale":"The method 'overrider' always has a non-negative number of parameters.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.619244574Z"}
{"id":"bac58b06-20f6-4137-826e-5d27e335254e","expr":"overrider.getDeclaringClass() != null","rationale":"The 'overrider' method always has a declaring class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.619244574Z"}
{"id":"9aa81a30-4880-4997-82d0-dbb144845d7c","expr":"declaringClass != null","rationale":"The 'declaringClass' parameter is expected to be non-null as it is a Class object representing the context where the method is located.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.619244574Z"}
{"id":"5eb58edd-bf8a-494d-afbd-8f9bd20dceab","expr":"result == null || declaringClass.isAssignableFrom(result.getDeclaringClass())","rationale":"The found overridden method's declaring class should be a subclass or the same as declaringClass.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.623091083Z"}
{"id":"02d29532-8413-4b55-b057-ef286c1b36ed","expr":"result == null || result.getName().equals(overrider.getName())","rationale":"Names of the overrider and result methods match.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.623091083Z"}
{"id":"dc6dc5e6-639b-4dc7-b8eb-0125c2e14217","expr":"!declaringClass.isInterface() || result == null || result.getDeclaringClass().isInterface()","rationale":"Relationship between declaringClass and result's declaring class interfaces.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.623091083Z"}
{"id":"a7182d04-2d36-4eec-913d-1389bdd41630","expr":"method != null && method.getName() != null && !method.getName().isEmpty()","rationale":"Methods must have a non-null, non-empty name to perform field name extraction.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.623526081Z"}
{"id":"fed8e1d3-1993-41a6-acff-b4a96f06aebc","expr":"!method.getName().isEmpty()","rationale":"The method name must exist for the extraction logic to be meaningful.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.623526081Z"}
{"id":"0078af84-4275-49cd-b275-e15b13dcce48","expr":"method != null || targetObj == null","rationale":"When method is null, targetObj can be any value as method.invoke won't be called.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.626472636Z"}
{"id":"cd414eac-a6eb-442f-8291-e44d81792ac6","expr":"method == null || method.getParameterCount() == 0","rationale":"Method.invoke is called without arguments, so parameter count must be zero.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.626472636Z"}
{"id":"2de466e9-4733-4b2d-8f2a-39e57e1736bc","expr":"method == null || result != -1L","rationale":"If method is null, result is -1; otherwise, invocation succeeded and result is the method return.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.629066488Z"}
{"id":"c6d3f799-af1c-4f7e-942a-7dcbce7d1212","expr":"result == -1L || method != null","rationale":"If result is not -1, method must not be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.629066488Z"}
{"id":"2d63d07a-9163-4d7d-ba9c-1b8499e8eed4","expr":"(method != null) && (result != -1L || true)","rationale":"When method is non-null, result is either -1 or a valid returned long value.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.629066488Z"}
{"id":"a4bbcb13-80be-4d6e-8e5f-4e39f3e58831","expr":"result == (method == null ? -1L : result)","rationale":"Result is -1 if method is null, else it is returned value from method.invoke casted to long.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.629066488Z"}
{"id":"ad57536d-6d4a-4abd-a81a-31e9a4fd7c23","expr":"method.getDeclaringClass() != null","rationale":"The method's declaring class must not be null to call getName() safely.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.629638144Z"}
{"id":"83d223f3-462a-4d54-9a1f-03a6af69f7c9","expr":"method.getName() != null","rationale":"Method names in Java are always non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.629638144Z"}
{"id":"9fcade28-4863-4ad4-8236-9d62dd4f3a7a","expr":"method.getParameterTypes() != null","rationale":"The parameter types array returned by reflection is non-null, possibly empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.629638144Z"}
{"id":"63b67601-8f5d-45eb-b84b-3c818534c908","expr":"method.getParameterTypes().length >= 0","rationale":"Array lengths are always zero or positive.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.629638144Z"}
{"id":"75beee78-71e7-47ec-ae85-8609f716a07b","expr":"method.getDeclaringClass().getName().length() > 0","rationale":"Declared class names in Java have non-empty names.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.629638144Z"}
