{"id":"edf7a2a6-e20c-4cbe-b435-fd4615d2bc78","expr":"(fileName != null && !fileName.isEmpty()) || result.equals(\"\")","rationale":"If fileName is null or empty, result is empty string, otherwise non-empty might be returned.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ConfigUtils#loadMigrationRule(Set<ClassLoader>,String):String","file":"org/apache/dubbo/common/utils/ConfigUtils.java","createdAt":"2026-08-31T05:26:49.576982712Z"}
