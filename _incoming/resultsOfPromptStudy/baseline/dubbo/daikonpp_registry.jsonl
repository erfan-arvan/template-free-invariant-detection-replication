{"id":"77af4124-01c6-42e7-a0ec-95451287883d","expr":"!className.contains(\" \")","rationale":"Class names generally do not contain spaces.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.198810802Z"}
