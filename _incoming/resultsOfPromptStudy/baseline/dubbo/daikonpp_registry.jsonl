{"id":"8b9f5778-12cb-4eff-b9ce-e91ae982f911","expr":"method != null","rationale":"The parameter method should not be null when entering the isGetter method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#isGetter(Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.578580869Z"}
{"id":"6edb7545-38e9-414f-8f6e-e8ca651a0c46","expr":"method.getParameterTypes().length >= 0","rationale":"Parameter types array length cannot be negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#isGetter(Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.578580869Z"}
