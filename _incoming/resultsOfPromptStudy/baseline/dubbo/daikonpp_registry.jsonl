{"id":"03f6a478-b24d-4084-aefb-519b4a810350","expr":"cls != null && fieldName != null && !fieldName.isEmpty()","rationale":"getAndCacheField requires non-null cls and non-empty fieldName for correct field lookup.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.PojoUtils#getAndCacheField(Class<?>,String):Field","file":"org/apache/dubbo/common/utils/PojoUtils.java","createdAt":"2026-08-31T05:26:51.132768177Z"}
