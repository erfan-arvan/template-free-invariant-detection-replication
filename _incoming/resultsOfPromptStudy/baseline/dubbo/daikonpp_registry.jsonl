{"id":"bef2556c-ae3a-4736-a553-b598fd2badf2","expr":"result == null || (result.getParameterCount() == 1 && result.getParameterTypes()[0] == valueCls)","rationale":"Any found setter method should have exactly one parameter, the valueCls.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.PojoUtils#getSetterMethod(Class<?>,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/PojoUtils.java","createdAt":"2026-08-31T05:26:51.127961241Z"}
