{"id":"7acff1f6-7812-4ee6-a9e6-f3469117927b","expr":"className.equals(className.trim())","rationale":"It is expected that className does not have leading/trailing whitespace.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.198810802Z"}
{"id":"5662ea53-7b82-476a-ba80-9a43e79c33e7","expr":"result != null","rationale":"The returned class object must be non-null because loadClass0 would throw an exception otherwise.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.200320053Z"}
{"id":"66f24b32-d857-47a2-8f18-bc2ccef44899","expr":"result.getName().equals(className)","rationale":"The method returns the class corresponding to the specified className.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.200320053Z"}
{"id":"7d97379f-07cf-4b7a-a032-c45176831867","expr":"className != null && classLoader != null","rationale":"Both classLoader and className are expected to be non-null to successfully load the class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass0(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.201163951Z"}
{"id":"08b1be60-ee6b-41b5-8b34-cebd787e3534","expr":"className.length() > 0","rationale":"The method processes the className string, so it must have at least one character.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass0(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.201163951Z"}
{"id":"6b19b311-1be6-4b89-a952-1a0fa96b28cc","expr":"!className.contains(\" \")","rationale":"A valid Java class name does not contain spaces.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass0(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.201163951Z"}
{"id":"b98b8c01-21ba-4329-bc69-300fc8393068","expr":"className.indexOf('$') >= -1","rationale":"The method processes '$' char to '.' char in className string; hence '$' may appear.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass0(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.201163951Z"}
{"id":"afddd4fd-a889-467c-a966-a187e77c1eff","expr":"result != null","rationale":"The result represents a loaded class object, so it should never be null on successful return.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass0(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.201553474Z"}
{"id":"4b9c0fb6-bb89-4048-ad5d-49b190e04891","expr":"result.getName().equals(className)","rationale":"The returned class's name should equal the input className string.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass0(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.201553474Z"}
{"id":"11b09198-5454-4373-b33a-1be9484c672e","expr":"classLoader != null || classLoader == result.getClassLoader()","rationale":"If classLoader is provided, the returned result's class loader should correspond.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#loadClass0(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.201553474Z"}
{"id":"aaa21247-4df0-4e54-95bc-5482bc4b5170","expr":"result != null","rationale":"Method returns a Class object if successful, so result must be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.202004282Z"}
{"id":"9c43e159-a264-4332-965e-8b2ca7504512","expr":"result.getName().equals(className)","rationale":"The loaded class should have the same name as className parameter.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.202004282Z"}
{"id":"ce341673-36e3-4cf1-8519-33953174b991","expr":"(classLoader == null) || (result.getClassLoader() == classLoader)","rationale":"Resulting class should have been loaded by the specified classLoader if it is not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.202004282Z"}
{"id":"d48c6209-08d1-45ef-9734-e41b6d9b85b4","expr":"className != null && !className.isEmpty()","rationale":"className should not be null or empty to locate the class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.202534460Z"}
{"id":"966805b1-612f-46e2-bef2-682853766caf","expr":"classLoader == null || (classLoader.getClass() != null)","rationale":"Non-null classLoader must have a valid class object.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.202534460Z"}
{"id":"bba4f63d-df5d-4092-a699-4d664308851e","expr":"className != null","rationale":"className should not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#classForName(ClassLoader,String):Class<?>","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.202534460Z"}
{"id":"38547723-12b9-400d-8036-02e44857ede0","expr":"result != null","rationale":"The method returns a bean instance, so result should not be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.DefaultSerializeClassChecker#getInstance():DefaultSerializeClassChecker","file":"org/apache/dubbo/common/utils/DefaultSerializeClassChecker.java","createdAt":"2026-08-31T05:26:51.204903689Z"}
{"id":"0e78b0ec-b2ed-4d1d-92ff-e6f51710500d","expr":"logger != null || msg == null","rationale":"If logger is null, the method returns immediately, so msg is irrelevant; no direct relationship holds otherwise.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205253637Z"}
{"id":"c3d97fc8-210c-4611-ae04-78d4363671ef","expr":"!logger.isTraceEnabled() || (logger.isTraceEnabled() && logger != null)","rationale":"Assuming isTraceEnabled is a method on Logger, calling it requires logger not to be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205253637Z"}
{"id":"424ac875-93b1-41a7-8743-22a0cbbe9a33","expr":"logger.isTraceEnabled() == (logger != null && logger.isTraceEnabled())","rationale":"logger.isTraceEnabled() can be safely called only if logger is non-null","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205253637Z"}
{"id":"39bee05f-0315-4767-a1ff-a0359cb2548b","expr":"logger != null && logger.isTraceEnabled() == (msg != null)","rationale":"trace is called only if logger is not null and trace is enabled; msg is passed directly","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205468451Z"}
{"id":"468ec335-9961-492e-bc6e-3817bb5dd4b5","expr":"logger != null","rationale":"method returns early if logger == null, so at method exit logger != null always holds","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205468451Z"}
{"id":"d7ea3917-4ebd-4fd3-acd7-1a1426dfd5a6","expr":"logger != null && (logger.isTraceEnabled() || msg == null)","rationale":"if trace is not enabled, msg may or may not be null; if enabled trace is called with msg","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205468451Z"}
{"id":"e95df9cc-fd92-4361-aa1f-87211b6fc05d","expr":"logger == null || logger.isTraceEnabled() || !logger.isTraceEnabled()","rationale":"This covers all conditions for logger related to trace enabled or null","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205253637Z"}
{"id":"250f4389-6dd7-45d0-aef1-7e09c1570d93","expr":"msg == null || msg.length() >= 0","rationale":"If msg is not null, its length is at least zero.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205253637Z"}
{"id":"45dc2f5d-d02b-4837-991d-2c37254a681d","expr":"result != null || method.getReturnType().isPrimitive()","rationale":"If the method's return type is primitive, result won't be null; otherwise, it may be null depending on map contents.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.PojoInvocationHandler#invoke(Object,Method,Object[]):Object","file":"org/apache/dubbo/common/utils/PojoUtils.java","createdAt":"2026-08-31T05:26:51.205519467Z"}
{"id":"d99cac43-3d23-48dd-b0ee-9a86cdf9e27a","expr":"logger != null || throwable == null","rationale":"If logger is null method returns early, thus no trace call; throwable may be null or any value but no trace is logged.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205913018Z"}
{"id":"c948f478-24cb-406c-b712-c74478b7f6c2","expr":"logger == null || logger.isTraceEnabled() == false || throwable != null","rationale":"If logger is non-null and trace enabled then throwable is passed to trace; it may be null or non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205913018Z"}
{"id":"7f60de5f-a6e8-48c3-b1b0-34742f9ae879","expr":"logger == null || logger.isTraceEnabled() || !logger.isTraceEnabled()","rationale":"logger.isTraceEnabled returns boolean and logger is non-null or null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205913018Z"}
{"id":"533eb7af-b019-45f1-ba78-1e96c341fd10","expr":"logger == null || logger.getName() != null","rationale":"For a valid Logger object, getName rarely returns null but it is safe to check.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205913018Z"}
{"id":"c4a73a9d-dc07-4c1f-be32-b112dadeb6c3","expr":"logger != null && (!logger.isTraceEnabled() || msg != null || msg == null)","rationale":"msg is passed to trace if isTraceEnabled; if not enabled no tracing","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205468451Z"}
{"id":"1caa0284-6fa4-4802-a224-35d5d2bc625f","expr":"!logger.isTraceEnabled() || logger != null","rationale":"logger cannot be null if isTraceEnabled is checked to avoid NullPointerException.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.205913018Z"}
{"id":"71345f48-154c-4d92-bc3d-357ec7dc2039","expr":"logger != null || throwable == null","rationale":"If logger is null, method returns immediately, so no trace occurs.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.206225005Z"}
{"id":"a2597694-a59b-47bf-a38c-7ff9a663ea64","expr":"!logger.isTraceEnabled() || throwable == null","rationale":"If tracing is enabled, throwable is logged; otherwise, no logging happens.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.206225005Z"}
{"id":"5fcc6252-e464-4aa0-b704-0c18a1fbac70","expr":"logger.isTraceEnabled() == (throwable != null || true)","rationale":"trace is called only if trace is enabled; throwable can be null or non-null and still logged.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.206225005Z"}
{"id":"4f55b367-c6a8-4db5-bca7-fc4f58411cfc","expr":"logger.isTraceEnabled() || throwable == null","rationale":"If trace is disabled, throwable won't be logged; if throwable is null, exception may still be logged as null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.206225005Z"}
{"id":"31382ff3-9fae-4cbc-86e7-e26427f92adf","expr":"logger != null","rationale":"logger is guaranteed non-null just before method exit since method returns early if logger is null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.206225005Z"}
{"id":"0422e5af-c2d4-4346-9379-178a83560227","expr":"logger != null || msg == null || e == null","rationale":"If logger is null, method exits early, so the body that uses msg and e is not executed.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.208335006Z"}
{"id":"6985bc24-d2b0-494c-855e-ef4c420b1071","expr":"logger == null || logger.isTraceEnabled() || !logger.isTraceEnabled()","rationale":"logger must be null or have a determinable trace enabled state which is a boolean.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.208335006Z"}
{"id":"60578d22-1a38-41c3-a5c4-c79fcb518709","expr":"logger == null || (msg != null || msg == null)","rationale":"msg can be any value when logger is null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.208335006Z"}
{"id":"cdde98d6-7eca-4495-bb6f-5e6976506dbf","expr":"logger == null || (e != null || e == null)","rationale":"e can be any value when logger is null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.208335006Z"}
{"id":"749c7520-8343-42d7-91be-51e7f9be446a","expr":"logger != null || (msg != null || msg == null)","rationale":"This reflects that with null logger, msg is unrestricted.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.208335006Z"}
{"id":"d98fe8ed-0f17-4ea1-a911-3172783808bf","expr":"logger != null || true","rationale":"If logger is null, the method returns early.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209365004Z"}
{"id":"c68d6e71-48aa-4dce-9cb6-1aedc4ef63fa","expr":"!logger.isTraceEnabled() || (msg != null || e != null)","rationale":"If the logger is trace enabled, then trace is called with msg and e, so at least one of msg or e is effectively passed.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209365004Z"}
{"id":"19de3fba-d047-45db-97ea-4488e70e7aa2","expr":"!logger.isTraceEnabled() || true","rationale":"No effect when not trace enabled, traces only if enabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#trace(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209365004Z"}
{"id":"062234e0-807b-4380-b417-d4e8db7ed2da","expr":"logger != null || msg == null","rationale":"If logger is null, the method returns early, so at exit either logger is not null or msg can be anything.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209525656Z"}
{"id":"de6573c9-dc73-41b5-a337-facf142c8fa1","expr":"logger != null && logger.isDebugEnabled() || true","rationale":"Since the method returns if logger is null, at exit logger is non-null if code proceeded past first check.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209785325Z"}
{"id":"4a091332-86f3-4e0f-a387-acd1d7220d4e","expr":"logger != null || msg == null","rationale":"No direct dependency between logger nullness and msg; useful to consider cases where logger is null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209519455Z"}
{"id":"b4c2a170-89ef-4328-a73b-287fd02947c5","expr":"!logger.isDebugEnabled() || (logger.isDebugEnabled() && e != null)","rationale":"If debug message was logged, then e is expected to be the Throwable passed.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209785325Z"}
{"id":"dbdd14cd-e2dd-4f97-92da-1346e2657527","expr":"logger != null || e == null","rationale":"Method returns early if logger is null, so meaningful debug only happens if logger is non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209863402Z"}
{"id":"d02e7a22-91ba-4ed2-ad56-8082b6b69495","expr":"!logger.isDebugEnabled() || msg != null","rationale":"If debug logging is enabled, the message passed to logger.debug should logically be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209525656Z"}
{"id":"c5768923-758c-4e9c-8e82-47b77523e40a","expr":"!logger.isDebugEnabled() || true","rationale":"By logic, if debug is enabled, some further conditions might hold, though trivial here.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209525656Z"}
{"id":"97c313c0-da9d-4dd5-b17b-53adc97e1b8d","expr":"logger != null","rationale":"Because method returns early if logger is null, it must be non-null at exit.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209525656Z"}
{"id":"7d85b758-ac8d-42b3-b391-9f43c2ed9ca6","expr":"logger != null && logger.isDebugEnabled() == true || !logger.isDebugEnabled()","rationale":"logger.isDebugEnabled() is a boolean method invoked on non-null logger.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209863402Z"}
{"id":"03dc3b80-17fd-4da8-bb02-377046dade39","expr":"logger != null && logger.isDebugEnabled() == (logger != null && logger.isDebugEnabled())","rationale":"This invariant states the method call consistency on logger; trivially true but captures the state for downstream conditions.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209519455Z"}
{"id":"b3d95fd9-bb22-4562-ac07-73f4de9b1b09","expr":"logger != null","rationale":"Since method returns immediately when logger is null, for meaningful processing logger is expected to be not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209519455Z"}
{"id":"a3de5bd0-fa51-4030-97c5-b58d5dd2c313","expr":"logger != null || !logger.isDebugEnabled()","rationale":"If logger is null, the method returns early; otherwise, the debugEnabled flag may be true or false.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.210679848Z"}
{"id":"fc4b5c9c-70a1-4756-b345-3737723597dc","expr":"!logger.isDebugEnabled() || (msg != null || e != null)","rationale":"When debugging is enabled, a debug call is made with msg and e, so at least one may be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.210679848Z"}
{"id":"bf3d5422-c696-4266-87ad-d256d339a801","expr":"logger != null && (!logger.isDebugEnabled() || (logger.isDebugEnabled() && e != null || e == null))","rationale":"Debug is logged only if debug is enabled on logger.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209863402Z"}
{"id":"3dff69d5-f9dd-4f9e-a483-94df0b8289f6","expr":"logger != null","rationale":"logger must be non-null to reach the debug call.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209863402Z"}
{"id":"02dcb1b3-39af-4502-a493-a41efd432d07","expr":"logger != null || msg == null || e == null","rationale":"Method returns if logger is null, so when logger is null, other parameters are unconstrained.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.210520779Z"}
{"id":"c5cc7b76-86a5-4f6b-ba2d-cda1f3973f62","expr":"logger == null || logger.isDebugEnabled() || true","rationale":"No strict requirement that if logger is non-null then isDebugEnabled() is true before method body executes.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.210520779Z"}
{"id":"19b8f0d6-2fb5-4883-ae7f-9b8ebe14fe56","expr":"logger.isDebugEnabled() == (logger != null && logger.isDebugEnabled())","rationale":"Method guards against null logger, so isDebugEnabled is called only if logger is non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.210679848Z"}
{"id":"35b1e5c0-958d-45ac-8365-ff9b43870aa0","expr":"!(logger != null && logger.isDebugEnabled()) || (msg != null || e != null)","rationale":"debug is only invoked with msg and e if debug is enabled; usually msg or e should not both be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.210679848Z"}
{"id":"f82fe408-ca10-45ef-9951-a61b539adb2c","expr":"logger.isDebugEnabled() == true || logger.isDebugEnabled() == false","rationale":"This represents that isDebugEnabled is a boolean method, a fundamental boolean property.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.209519455Z"}
{"id":"c893d502-da40-43f2-aaf7-6aa98e386954","expr":"(logger != null && logger.isDebugEnabled()) || true","rationale":"logger.isDebugEnabled() may be true or false for non-null logger, no further constraint.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#debug(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.210520779Z"}
{"id":"515d73df-af22-494a-96f5-06bdcc8566c1","expr":"logger != null || msg == null","rationale":"logger can be null at method entry, no direct relation to msg, but msg could be any String or null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.212107385Z"}
{"id":"34905fff-7b15-4c99-91b3-03beab557def","expr":"logger == null || logger.isInfoEnabled() == true || logger.isInfoEnabled() == false","rationale":"logger when not null, isInfoEnabled() returns boolean.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.212107385Z"}
{"id":"950133c3-4e19-4694-885e-0b693c370f0d","expr":"logger == null || msg == null || true","rationale":"No constraints between logger and msg nullness, so trivially true.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.212107385Z"}
{"id":"2605961c-156f-4bee-9d3e-f5af7e3bbf32","expr":"logger == null || msg != null || true","rationale":"No constraints between logger and msg nullness, so trivially true.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.212107385Z"}
{"id":"c3d192e7-6fda-40f5-9daa-62bdc6384961","expr":"logger != null && !logger.isInfoEnabled() || msg == null || !msg.isEmpty()","rationale":"If info logging is enabled, logger.info(msg) was called, which generally implies msg can be null or a non-empty string.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213089824Z"}
{"id":"a5ce4d18-2def-4093-b8eb-5048921ddd9c","expr":"logger != null && (!logger.isInfoEnabled() || msg == null || msg.length() >= 0)","rationale":"msg is either null or a string with non-negative length when info is logged or info is disabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213089824Z"}
{"id":"d3044876-8b40-4df3-9eaa-4dfbcc11ce6f","expr":"logger != null && (!logger.isInfoEnabled() || msg == null || logger.isInfoEnabled())","rationale":"A trivial invariant reflecting logger.isInfoEnabled() status affecting method call.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213089824Z"}
{"id":"73ce463e-5438-477b-887b-22fa81b54bc0","expr":"logger == null || !logger.isInfoEnabled() || true","rationale":"Trivially true at method exit given method flow (info called only if logger and isInfoEnabled).","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213089824Z"}
{"id":"95a11526-f47f-49f6-befc-a33547c3b4ad","expr":"logger != null","rationale":"Because the method returns early if logger is null, at exit logger is not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213089824Z"}
{"id":"d375a545-0c16-4c29-9a17-5b8dbf29a7a8","expr":"logger != null || e != null","rationale":"If logger is null, method returns immediately; e can be null or not.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213345295Z"}
{"id":"f94f41ce-351d-4d63-8325-6e046337bfcf","expr":"logger == null || logger.isInfoEnabled() == false || e == null || true","rationale":"When logger is not null and info is enabled, method logs e, which may be null or non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213345295Z"}
{"id":"214c071f-bb6f-4d9e-acf1-7fdd1099ff0a","expr":"logger == null || logger.isInfoEnabled() || !logger.isInfoEnabled()","rationale":"logger.isInfoEnabled() is either true or false if logger is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213345295Z"}
{"id":"5792f28a-0064-4aa9-9cac-6e774a369d6c","expr":"logger == null || logger.isInfoEnabled() == (logger.isInfoEnabled() == true)","rationale":"logger.isInfoEnabled() is a boolean valued method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213345295Z"}
{"id":"65000809-228a-4018-b668-401a81c2c445","expr":"logger != null && logger.isInfoEnabled() && e != null","rationale":"If the logger is not null and info is enabled, then e was passed to logger.info().","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213939483Z"}
{"id":"4186d1ba-3886-4878-835a-1710fd67cb03","expr":"!logger.isInfoEnabled() || e != null","rationale":"If the logger's info level is enabled, e is passed to logger.info(e), so e is likely non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213939483Z"}
{"id":"56446e85-9049-48a1-8311-f7f75183999f","expr":"logger != null","rationale":"Since the method returns early for null logger, at exit logger is non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213939483Z"}
{"id":"acf564ce-7fbc-438b-ad6b-0233861cdfe4","expr":"logger.isInfoEnabled() || e == null","rationale":"If info is not enabled, e might be null or non-null; if info is enabled, e is logged.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213939483Z"}
{"id":"ab934c20-3f86-43be-947c-42496741479e","expr":"logger.isInfoEnabled() == (logger != null && logger.isInfoEnabled())","rationale":"The isInfoEnabled() check is only valid if logger is not null, which method ensures.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213939483Z"}
{"id":"b124cf27-5b2d-4531-85aa-fb13643aad89","expr":"logger == null || logger.isInfoEnabled() == true || logger.isInfoEnabled() == false","rationale":"The infoEnabled flag can only be true or false when logger is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.213345295Z"}
{"id":"85c0ccff-7612-40b0-aba4-d01811b92dc8","expr":"logger != null","rationale":"The method exits early if logger is null, so logger is expected to be non-null at usage points.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.214650731Z"}
{"id":"12449d7a-9fa9-4c86-8e32-a84600e011f3","expr":"logger.isInfoEnabled() == (logger != null && logger.isInfoEnabled())","rationale":"logger.isInfoEnabled() is invoked only if logger is non-null, so if logger is null this expression is not evaluated.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.214650731Z"}
{"id":"f402ad39-69a9-4b1f-97e1-894f83c4de37","expr":"logger != null && logger.isWarnEnabled() == false || (msg != null || e != null)","rationale":"Since warn is called only if logger.isWarnEnabled() is true, msg or e should not both be null to warn.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.214927863Z"}
{"id":"762b42b7-61e7-4e8c-9628-252a32d81be7","expr":"logger != null","rationale":"The method returns early if logger is null, so at method exit logger is non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.214927863Z"}
{"id":"7f0f300d-6a72-4997-a7a9-51a9954c4d1e","expr":"logger != null && (!logger.isInfoEnabled() || (msg != null || e != null))","rationale":"If logger is non-null and info logging is enabled, the method logs the message and throwable; thus msg or e may be non-null when info is logged.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.215004437Z"}
{"id":"555ab1e6-b252-4de9-8567-6a5b6a96ed9c","expr":"logger != null","rationale":"Method returns early if logger is null, so at exit logger is not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.215004437Z"}
{"id":"45478fca-d5b4-4746-807d-c4ca94758d05","expr":"!logger.isInfoEnabled() || (msg != null || e != null)","rationale":"If info is enabled, the method calls logger.info with msg and e; typically at least one argument should be non-null to make logging meaningful.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.215004437Z"}
{"id":"39ff32c6-b94f-4547-bafb-c4f788aabe54","expr":"!logger.isWarnEnabled() || (msg != null || e != null)","rationale":"warn is called only if isWarnEnabled() is true, so if it is true, msg or e must be non-null to pass to warn.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.214927863Z"}
{"id":"6e41b581-f67d-4769-8d56-4f95626dcd3f","expr":"logger != null || msg == null || true","rationale":"logger might be null, but then method exits; otherwise, logger is non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.215122279Z"}
{"id":"9ac38de5-bacd-46c6-a40c-3236ea8879dd","expr":"logger != null","rationale":"At method entry, logger may be null or non-null; but if null, immediate return.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.215122279Z"}
{"id":"e2a08389-1e63-4cab-b106-9a6466611a17","expr":"logger != null || msg == null","rationale":"logger might be null before the method executes, so msg can be any value.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.215843406Z"}
{"id":"0ede2e17-bfbf-4b2c-acc9-19ea3f1aac67","expr":"logger != null","rationale":"The method immediately returns if logger is null, so logger is not null on actual method body execution.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.215843406Z"}
{"id":"1a3c64e7-9221-413b-918a-94a7f0ef1485","expr":"(logger == null) || (logger.isWarnEnabled() == (logger.isWarnEnabled()))","rationale":"The result of logger.isWarnEnabled() is a boolean property that should be consistent before method execution.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.215843406Z"}
{"id":"37610612-900a-4e36-b152-71f059782086","expr":"logger != null || msg == null","rationale":"Method returns early if logger is null; hence if logger is null, msg can be anything.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.216711810Z"}
{"id":"b817ed15-172c-458b-b68b-3f42991c4b87","expr":"!logger.isWarnEnabled() || msg != null","rationale":"If logger.isWarnEnabled() is true, the warn method is called with msg, so msg is likely non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.216711810Z"}
{"id":"9a6980c9-155b-4e53-a162-29fcbf5a8ef6","expr":"logger.isWarnEnabled() == (msg != null || msg == null)","rationale":"logger.isWarnEnabled() does not depend on msg being null or not.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.216711810Z"}
{"id":"4cee75d5-24a8-4c1f-a6a8-b1014eaceae6","expr":"logger != null && (!logger.isWarnEnabled() || msg != null)","rationale":"If logger is not null and logger.isWarnEnabled() is true, then msg was passed to logger.warn(msg).","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.216711810Z"}
{"id":"bd5db927-62a2-4d2a-8919-4229b9226dbd","expr":"logger != null && logger.isWarnEnabled() == true && e != null","rationale":"At method exit, if logger is non-null and isWarnEnabled() returns true, the exception e is the argument to the warn call and thus probably non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218021034Z"}
{"id":"c068fc89-ba88-439a-9e82-d85dfb4aecd6","expr":"logger == null || logger.isWarnEnabled() == false || e == null","rationale":"Using logical OR to capture cases where no warning is logged or e is null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218021034Z"}
{"id":"29a4be4a-41f3-47c6-bed0-d011d6edabca","expr":"logger != null","rationale":"Logger is either null due to early return or not null at method exit.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218021034Z"}
{"id":"dafbdf9d-90cb-48ef-8f7a-6d332769a2c9","expr":"logger.isWarnEnabled() == true || logger != null","rationale":"At method exit, if logger is not null, then either warn is enabled or not.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218021034Z"}
{"id":"6d86b748-c05a-4f47-8303-4449e59a20b0","expr":"(logger != null && logger.isWarnEnabled()) == (logger != null && e != null)","rationale":"Captures the equivalence of logging condition and presence of exception e at method exit.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218021034Z"}
{"id":"6a572405-c798-46be-a029-21572c8dc22a","expr":"logger != null && logger.isErrorEnabled() == (e != null)","rationale":"Since logger.error(e) is called when isErrorEnabled() is true, the presence of a throwable e often implies logging happens when error is enabled.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218687789Z"}
{"id":"ce380828-b066-4f09-880c-e3ebe3af72d9","expr":"!logger.isErrorEnabled() || logger != null","rationale":"logger.isErrorEnabled cannot be true if logger is null, but logger is guaranteed non-null after initial check.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218687789Z"}
{"id":"20ad28a1-4f41-4a38-8aa8-81711aca16ff","expr":"logger == null || !logger.isErrorEnabled() || e == null","rationale":"Either logger is null or error is not enabled or the throwable e is null at method exit.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218687789Z"}
{"id":"a261d7fd-68a8-48b7-a577-cc3378e062c9","expr":"logger != null","rationale":"Since the method returns if logger==null, at exit logger must be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218687789Z"}
{"id":"95f4b2d5-b726-4c72-8b8d-c9230bce06cc","expr":"logger != null || e == null","rationale":"The method returns if logger is null, so if logger is null, e may be any value, but the expression here expresses the mutual null allowance.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218847309Z"}
{"id":"17a1dc86-06a8-40fd-9a54-0384c0180352","expr":"!logger.isErrorEnabled() || e != null","rationale":"If error logging is enabled, the method will call logger.error with e, so e is expected to be available in that scenario.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218847309Z"}
{"id":"9f1f9aee-c1a9-436c-ae4a-aa82f8336b29","expr":"logger.isErrorEnabled() == (logger != null && logger.isErrorEnabled())","rationale":"If logger is null, the method returns early preventing calls on null; this expression clarifies that isErrorEnabled is checked only when logger is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218847309Z"}
{"id":"4fedcc51-6185-44e3-9169-5b55ea6f2a00","expr":"logger != null","rationale":"Because the method immediately returns if logger is null, relevant assertions about logger imply it is non-null at this point.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218847309Z"}
{"id":"eb33e8c9-30d5-46d5-90e6-8adbfaf5a806","expr":"logger != null || e == null","rationale":"Since method returns early if logger is null, e's state independent here.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219077853Z"}
{"id":"6fbb92b2-7469-40a2-a36e-ee0adda096d5","expr":"logger == null || logger.isWarnEnabled() == true || !logger.isWarnEnabled()","rationale":"Either logger is null or the warn level is enabled or not enabled, so all cases covered. This is a trivial invariant but reflects awareness of state.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219077853Z"}
{"id":"d9bc6e69-a696-4653-9857-90ae92149816","expr":"logger.isErrorEnabled() == (logger != null && e != null)","rationale":"Implication that error logging being enabled implies e is not null, consistent with error call.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.218687789Z"}
{"id":"1ae66f2c-5461-40b5-af8e-501ca02b1e9c","expr":"(logger != null) || (logger == null)","rationale":"Trivial invariant useful for noting logger is of type Logger and must be either null or non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219077853Z"}
{"id":"e5c8b93e-a2f9-41ee-9655-33a3ebe3839d","expr":"logger == null || logger.isWarnEnabled() == logger.isWarnEnabled()","rationale":"Trivial but captures that logger.isWarnEnabled() is consistent at this point.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#warn(Logger,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219077853Z"}
{"id":"86a66af5-6b0f-4d21-bcac-2cc2fd032bed","expr":"logger != null || msg == null","rationale":"If logger is null, the method returns immediately, so msg might be any value including null","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219562375Z"}
{"id":"5479943e-7911-49df-8cfa-8a420c07f0af","expr":"!logger.isErrorEnabled() || msg != null","rationale":"If error level is enabled, msg is used by logger.error, so likely msg is expected to be non-null though not strictly mandated","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219562375Z"}
{"id":"142d65e6-6608-4ea9-bbf3-b9227d3c9b94","expr":"logger != null && !logger.isErrorEnabled() || (logger.isErrorEnabled() && msg != null)","rationale":"If the logger is not null and error is enabled, then error is called with msg; msg is typically non-null in that case.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219375703Z"}
{"id":"e9814894-2681-4385-b290-c1d1482ddabd","expr":"logger != null","rationale":"Since the method returns early if logger is null, at method exit logger must be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219375703Z"}
{"id":"06d09817-b9c3-4791-95cf-86f337875880","expr":"logger.isErrorEnabled() == (logger != null && logger.isErrorEnabled())","rationale":"Method calls to logger must be guarded by logger not being null","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219562375Z"}
{"id":"500cf7b4-e636-4560-b86c-1b10538ca0a8","expr":"msg == null || msg.length() >= 0","rationale":"msg is a string parameter and can be null or any string including empty string","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219562375Z"}
{"id":"ebdf3c47-9dd1-40da-b86c-531f7bccf430","expr":"logger != null","rationale":"Method returns early if logger is null, so at method exit logger != null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.220599126Z"}
{"id":"71da6bba-4db5-42f9-98e4-2fd59882630f","expr":"logger.isErrorEnabled() || e == null && msg == null","rationale":"Either error is enabled, or both e and msg are null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.220599126Z"}
{"id":"010bf3ff-dfc6-4632-a01e-e175af91c399","expr":"logger != null || msg == null || e == null","rationale":"Either logger is not null or other parameters can be any value.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.220198572Z"}
{"id":"d3adeb5a-d7a8-43ae-997f-c18c333607f9","expr":"logger == null || logger.isErrorEnabled() || !logger.isErrorEnabled()","rationale":"logger is either null or its isErrorEnabled method can be true or false.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.220198572Z"}
{"id":"0808ccb2-2837-4a93-be48-973b1648ebf4","expr":"logger != null","rationale":"At some point after method entry if the method executes further, logger must not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.220198572Z"}
{"id":"8622b312-1ea0-4308-aba2-72520ba0baf4","expr":"!(pojoClazz.isPrimitive())","rationale":"In the context of Protobuf classes, pojoClazz is expected to be a reference type, not a primitive.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ProtobufUtils#isProtobufClass(Class<?>):boolean","file":"org/apache/dubbo/common/utils/ProtobufUtils.java","createdAt":"2026-08-31T05:26:51.219875153Z"}
{"id":"fbe77805-084e-432d-9e8a-d685863424f4","expr":"m1 != null && m2 != null","rationale":"Arguments m1 and m2 are Method objects and should not be null at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodComparator#compare(Method,Method):int","file":"org/apache/dubbo/common/utils/MethodComparator.java","createdAt":"2026-08-31T05:26:51.221781491Z"}
{"id":"497cfd48-3a68-48de-83a1-dfb2b7ffef94","expr":"m1.equals(m2) || !m1.equals(m2)","rationale":"m1 and m2 are Method objects and support equals method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodComparator#compare(Method,Method):int","file":"org/apache/dubbo/common/utils/MethodComparator.java","createdAt":"2026-08-31T05:26:51.221781491Z"}
{"id":"092203e2-6cc8-454b-9975-96a252c4a7dd","expr":"m1.getName() != null && m2.getName() != null","rationale":"Method.getName() returns a non-null string at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodComparator#compare(Method,Method):int","file":"org/apache/dubbo/common/utils/MethodComparator.java","createdAt":"2026-08-31T05:26:51.221781491Z"}
{"id":"76db4687-9d51-4377-8a14-002ce8b15bec","expr":"m1 != null && m2 != null && m1.getParameterTypes() != null && m2.getParameterTypes() != null","rationale":"getParameterTypes() returns a non-null Class[] array.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodComparator#compare(Method,Method):int","file":"org/apache/dubbo/common/utils/MethodComparator.java","createdAt":"2026-08-31T05:26:51.221781491Z"}
{"id":"4d6f50b5-0a32-471c-90c3-c32999c75874","expr":"result == 0 || result < 0 || result > 0","rationale":"The result of a compare method is always zero, negative, or positive representing equality or ordering.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodComparator#compare(Method,Method):int","file":"org/apache/dubbo/common/utils/MethodComparator.java","createdAt":"2026-08-31T05:26:51.222726650Z"}
{"id":"b726535e-454b-4554-a2d9-0ab52f51f514","expr":"result == 0 || (m1.getName().compareTo(m2.getName()) == 0 && m1.getParameterTypes().length == m2.getParameterTypes().length && !m1.equals(m2)) || m1.getName().compareTo(m2.getName()) != 0","rationale":"Compare returns 0 only if methods are equal or their names and parameter types are equal, else result depends on name or parameter ordering.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodComparator#compare(Method,Method):int","file":"org/apache/dubbo/common/utils/MethodComparator.java","createdAt":"2026-08-31T05:26:51.222726650Z"}
{"id":"d5a039e9-8254-4240-a0be-8c9e7b142e3c","expr":"!(m1.equals(m2)) || result == 0","rationale":"If two methods are equal, the comparison must return zero as per contract.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodComparator#compare(Method,Method):int","file":"org/apache/dubbo/common/utils/MethodComparator.java","createdAt":"2026-08-31T05:26:51.222726650Z"}
{"id":"51746bc9-8d36-4745-b857-3b4dba3ddbeb","expr":"logger.getName() != null","rationale":"The logger name is typically non-null in loggers, indicating a valid logger instance","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219562375Z"}
{"id":"0d494dc2-e594-46eb-a0fc-e3f0352d5d4f","expr":"(logger.isErrorEnabled() && msg == null) || !logger.isErrorEnabled()","rationale":"If error is enabled, msg is logged, possibly null is allowed; if not enabled, msg is irrelevant.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219375703Z"}
{"id":"e6f07e6d-e443-479f-b1c3-36fe86d6c56e","expr":"msg == null || msg.length() >= 0","rationale":"msg is either null or a String of length >= 0.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.LogHelper#error(Logger,String):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-08-31T05:26:51.219375703Z"}
{"id":"a7d9544b-49f2-4b9b-8a9d-0e47821eb0bd","expr":"result != null","rationale":"The result is guaranteed to be a non-null URL after parsing.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.UrlUtils#parseURL(String,Map<String, String>):URL","file":"org/apache/dubbo/common/utils/UrlUtils.java","createdAt":"2026-08-31T05:26:51.245108911Z"}
