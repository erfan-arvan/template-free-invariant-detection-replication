{"id":"53c43a28-6440-4c74-8a49-39169d98aa0a","expr":"declaredClass.getDeclaredFields().length >= 0","rationale":"The number of declared fields in declaredClass is always zero or more.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.FieldUtils#getDeclaredField(Class<?>,String):Field","file":"org/apache/dubbo/common/utils/FieldUtils.java","createdAt":"2026-08-31T05:26:48.490646831Z"}
