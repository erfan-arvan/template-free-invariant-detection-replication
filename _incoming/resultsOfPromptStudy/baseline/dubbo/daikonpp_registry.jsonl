{"id":"652fb668-ce44-48f6-bbd6-c254ea337f57","expr":"methodsToFilter != null","rationale":"methodsToFilter is expected to be non-null as it represents predicates used to filter methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.598720860Z"}
{"id":"d18e12f0-50b1-4183-89c9-ab82d9310fc0","expr":"methodsToFilter.length >= 0","rationale":"methodsToFilter array length is always zero or more.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-08-31T05:26:49.598720860Z"}
