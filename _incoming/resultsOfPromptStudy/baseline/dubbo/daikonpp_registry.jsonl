{"id":"dc567bdf-ede6-49af-99b7-d77ed910409f","expr":"key.contains(\".\") || !key.contains(\".\")","rationale":"Key is a string and may or may not contain '.'; this invariant indicates key is a valid string for lookup.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameterAndDecoded(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.216912576Z"}
{"id":"245134f5-ea61-47a0-8e17-fa04b4b0f6d7","expr":"defaultValue.length() >= 0","rationale":"Default value is a string and thus has non-negative length.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameterAndDecoded(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.216912576Z"}
{"id":"e106c2de-fc81-492a-9258-c5dd97cb6664","expr":"(method != null && key != null) && (defaultValue != null)","rationale":"All input strings are expected to be non-null at method entry for safe processing.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameterAndDecoded(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.216912576Z"}
{"id":"a4d5d8aa-35c7-4268-8dfc-4864dfc553b5","expr":"method != null && !method.isEmpty() || key != null && !key.isEmpty()","rationale":"At the method entry, typically method or key would be non-null and non-empty to query parameters.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.221233537Z"}
{"id":"0359ad9a-b925-4ed7-b85b-7952a2833842","expr":"key != null && !key.trim().isEmpty()","rationale":"Key parameter is expected to be a non-blank string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.221233537Z"}
{"id":"4cd6858e-8f4c-453a-bddf-394eb8972b1b","expr":"method != null","rationale":"Method string is expected to be non-null since it's a method parameter.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.221233537Z"}
{"id":"a1c39f8a-309b-45f9-8f0c-74c230564116","expr":"key != null","rationale":"Key string is expected to be non-null since it's a method parameter.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.221233537Z"}
{"id":"8668d890-c4a6-4107-bdfd-3ed758a4627d","expr":"(method != null && key != null) == (result != null)","rationale":"If both method and key are non-null, likely the result is non-null, indicating a mapping exists for the method and key.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.226766249Z"}
{"id":"5bea8f22-6934-4395-91f0-83f0cb5b8418","expr":"result == null || result.length() >= 0","rationale":"If result is null or non-null, its length must be zero or more, this is trivially true for any string.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.226766249Z"}
{"id":"32514b65-8f63-41c0-bdc7-b34a46d0f0d8","expr":"result == null || !result.isEmpty()","rationale":"In many cases, the method parameter value returned is expected to be a non-empty string if not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.226766249Z"}
{"id":"8cc71fe8-7349-4aba-87ec-7b7dd2fe7dc6","expr":"(result != null) == (method != null && key != null)","rationale":"Result being non-null implies both method and key are non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.226766249Z"}
{"id":"b76c23ac-df3e-44d7-8c3b-54a863fdac70","expr":"method != null || result == null","rationale":"If method is null, result is expected to be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.226766249Z"}
{"id":"5d8cc281-d211-4086-933d-490345a9ad34","expr":"method != null && key != null","rationale":"The method likely requires non-null method and key strings for parameter lookup.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameterStrict(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.229907300Z"}
{"id":"f08d8153-de74-4ef6-994e-ee3c07d6d192","expr":"!method.isEmpty()","rationale":"It's reasonable to expect that the method string is non-empty for parameter retrieval.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameterStrict(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.229907300Z"}
{"id":"7539f376-65f0-4021-b6be-ec60c82802a6","expr":"!key.isEmpty()","rationale":"The key string should be non-empty to represent a valid parameter name.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameterStrict(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.229907300Z"}
{"id":"e3aaf2af-e624-4b13-9396-6cf47fd3f9e0","expr":"Character.isLowerCase(method.charAt(0)) || Character.isUpperCase(method.charAt(0))","rationale":"The first character in method is likely a letter either lowercase or uppercase.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameterStrict(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.229907300Z"}
{"id":"625732f2-42ac-45f8-a032-04accab6c1b5","expr":"result != null || result == null","rationale":"This invariant is trivially always true as it covers all cases for result's nullness.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameterStrict(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.249869667Z"}
{"id":"049d8171-d974-42e0-a814-db9c8f7bd824","expr":"method != null && !method.isEmpty() && key != null && !key.isEmpty() || result == null","rationale":"If method and key are non-null and non-empty, result may be non-null; else it may be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameterStrict(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.249869667Z"}
{"id":"b0953e07-cb47-4101-9f57-cb4abfc24a8f","expr":"(method == null || method.isEmpty()) || (key == null || key.isEmpty()) || (result != null && !result.isEmpty())","rationale":"If method and key are provided, result should be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameterStrict(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.249869667Z"}
{"id":"ad397c9b-9fbd-4679-8ac5-6123c067dff3","expr":"(result != null && result.length() <= 100) || result == null","rationale":"Assuming parameters map to a reasonable length string or null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameterStrict(String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.249869667Z"}
{"id":"92d7a860-7abf-4adb-87ef-082f87371f95","expr":"method != null && !method.isEmpty() && key != null && !key.isEmpty() && defaultValue != null","rationale":"The method likely is called with non-null and non-empty method and key as parameters to retrieve a parameter value, with defaultValue as fallback.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.250712453Z"}
{"id":"266057d9-f5e6-43f3-8de9-c7f66f7745e5","expr":"key.equals(key.trim())","rationale":"Key might often have no leading or trailing spaces, used as a parameter key.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.250712453Z"}
{"id":"ec5d1194-7634-4906-ac6a-bfc07af60ecb","expr":"defaultValue.equals(defaultValue.trim())","rationale":"Default value strings do not have leading or trailing spaces.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.250712453Z"}
{"id":"6997e087-d1ff-439b-8383-9f2a4c06f9b6","expr":"!defaultValue.isEmpty() || method.isEmpty() || key.isEmpty()","rationale":"If method or key is empty, defaultValue can be empty or non-empty as fallback.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.250712453Z"}
{"id":"f5d48d90-0e70-4bdd-8ddc-9c7661de9f75","expr":"method.length() > 0 && key.length() > 0","rationale":"Method and key are expected non-empty strings to identify parameters.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.250712453Z"}
{"id":"4318ea1e-0ac5-4c34-8ff7-7f4f62c4125c","expr":"method != null && method.length() > 0","rationale":"Assuming the method name is a valid non-empty string when this method is called.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,double):double","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.258261099Z"}
{"id":"a7b088bf-bf62-4358-99f1-f611f2352184","expr":"key != null && key.length() > 0","rationale":"Ensuring the parameter key used to lookup is valid and non-empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,double):double","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.258261099Z"}
{"id":"8519c332-7b30-43a6-9428-eb94e4ded552","expr":"defaultValue >= -Double.MAX_VALUE && defaultValue <= Double.MAX_VALUE","rationale":"Reflects valid double range of defaultValue parameter.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,double):double","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.258261099Z"}
{"id":"8a0d38fa-0536-4911-9417-94a9bd9efe20","expr":"!(method == null || key == null)","rationale":"Ensures that neither method nor key is null simultaneously when method is called.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,double):double","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.258261099Z"}
{"id":"462eaf21-b7cb-42dc-86bd-e2386169d250","expr":"!Double.isNaN(defaultValue)","rationale":"Default value should be a valid number, not NaN.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,double):double","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.258261099Z"}
{"id":"fd21b688-26b2-421f-9a6c-baf6ca0e7615","expr":"result != null && !result.isEmpty() || result.equals(defaultValue)","rationale":"The method returns either the found value if not empty, or defaultValue if the found value is empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.262613700Z"}
{"id":"ebae63f7-f084-49cd-b105-d59460d5b46c","expr":"(!result.equals(defaultValue)) == (result.length() > 0)","rationale":"If the result does not equal the defaultValue, the result must be a non-empty string.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.262613700Z"}
{"id":"369cd6cc-7166-44b1-bbef-267280662b93","expr":"result != null","rationale":"The result of this method cannot be null, as if the internal value is empty or null, defaultValue is returned.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,String):String","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.262613700Z"}
{"id":"4b724b6c-dd7d-41a7-a109-eebfa65c67d5","expr":"method != null && !method.isEmpty() || key != null && !key.isEmpty() || true","rationale":"At method entry, method and key are typically expected to have meaningful values for retrieving parameters.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,float):float","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.270165372Z"}
{"id":"99964459-04e7-414d-87c2-3fe83931c738","expr":"key != null","rationale":"The key string should be non-null to look up the relevant method parameter.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,float):float","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.270165372Z"}
{"id":"1e4fb415-544f-4802-a1e6-4a8b39fae14e","expr":"method != null","rationale":"The method string is expected to be non-null since the parameter is retrieved for a specific method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,float):float","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.270165372Z"}
{"id":"8318c650-0e26-4a83-a25b-1826a84df3b0","expr":"!(\"\".equals(method) && \"\".equals(key))","rationale":"To retrieve meaningful data, at least one of method or key is expected to be non-empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,float):float","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.270165372Z"}
{"id":"f8c66e98-bcee-42d5-99d3-23e09a277e69","expr":"result >= 0.0f || result < 0.0f || result == 0.0f","rationale":"result is always a valid float value.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,float):float","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.277485127Z"}
{"id":"ef496559-6cc8-42ec-9f32-774dd8e325fd","expr":"method != null && !method.isEmpty() || key != null && !key.isEmpty() || defaultValue >= 0","rationale":"The method is used as a key for parameter retrieval and typically should be non-null and non-empty for a meaningful parameter lookup.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,long):long","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.280188074Z"}
{"id":"ad927ae3-6b68-4f38-9fe1-2dd7c9a02a50","expr":"key != null && !key.isEmpty() || method != null && !method.isEmpty() || defaultValue >= 0","rationale":"Either method or key represents valid identifiers for parameter lookup.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,long):long","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.280188074Z"}
{"id":"b836fc95-c3b9-4429-beee-f07b040dd938","expr":"defaultValue >= 0 || method != null && !method.isEmpty()","rationale":"Often defaultValue is non-negative unless overridden by the presence of a proper method string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,long):long","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.280188074Z"}
{"id":"9c27464b-dbb5-442c-929b-9b13a032fd8f","expr":"method != null && !method.isEmpty() && key != null && !key.isEmpty()","rationale":"At method entry, typically method and key are non-null and non-empty strings since parameters represent keys for lookup.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,int):int","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.300763264Z"}
{"id":"be6edb90-91fc-48fe-b9bc-98f92e213f94","expr":"key.length() > 0","rationale":"key being a non-null string parameter is expected to have length > 0.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,int):int","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.300763264Z"}
{"id":"3fab9cfb-c8d5-4890-b73d-2151255ae6df","expr":"method.length() > 0","rationale":"method is expected to be a non-null non-empty string representing the method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,int):int","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.300763264Z"}
{"id":"d78f5f59-7897-4ad3-9de0-acac1f7eab11","expr":"method != null && !method.isEmpty() || method == null || method.isEmpty()","rationale":"Since method is a String parameter, at method entry it can be null or empty; no assumptions about non-nullness are made.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,short):short","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.313421636Z"}
{"id":"92adeacc-467b-49b3-8c9d-5d2bc967d246","expr":"key != null && !key.isEmpty() || key == null || key.isEmpty()","rationale":"key is also a String parameter; no assumptions about its value at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,short):short","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.313421636Z"}
{"id":"785bc16b-e776-4f9d-845b-d1d733778cf5","expr":"defaultValue >= Short.MIN_VALUE && defaultValue <= Short.MAX_VALUE","rationale":"defaultValue is a short primitive parameter; thus it must be in the short range.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,short):short","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.313421636Z"}
{"id":"a17a7a7b-b124-4e17-bde0-ae589fcb928d","expr":"(method == null || key == null) || (method != null && key != null)","rationale":"No assumption about correlation between method and key nullness; both can be null or not independently.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,short):short","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.313421636Z"}
{"id":"170bcb3b-0b8c-44b5-bfde-a1c8eccb9006","expr":"method != null && method.length() > 0","rationale":"Method name should be a non-empty string as it identifies the target method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,byte):byte","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.320953239Z"}
{"id":"d1922434-8e24-4c6a-99cf-1e6d8ad32dcc","expr":"key != null && key.length() > 0","rationale":"Key should be a non-empty string key to lookup a parameter value.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,byte):byte","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.320953239Z"}
{"id":"b65c6239-6c19-4e91-b351-930f3587d610","expr":"defaultValue >= Byte.MIN_VALUE","rationale":"defaultValue must be within valid byte range.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,byte):byte","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.320953239Z"}
{"id":"24177505-75bf-446f-9559-0e3ab38a1830","expr":"defaultValue <= Byte.MAX_VALUE","rationale":"defaultValue must be within valid byte range.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,byte):byte","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.320953239Z"}
{"id":"994624b6-034c-4dd6-a327-51218777bf59","expr":"(method == null || !method.isEmpty()) && (key == null || !key.isEmpty())","rationale":"Combines null and emptiness conditions on method and key to reflect usage assumptions.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,byte):byte","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.320953239Z"}
{"id":"1ac928a6-cf44-4bba-b5f8-0482bfeed849","expr":"result == defaultValue || (method != null && key != null)","rationale":"The method returns defaultValue if the fetched string is empty, otherwise parses it as a byte. So result is either defaultValue or the parsed byte.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,byte):byte","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.329360591Z"}
{"id":"6550fece-24ad-4d7a-9361-f82215631f6f","expr":"(result != defaultValue) || (result == defaultValue)","rationale":"This tautology is omitted to respect the non-tautology rule.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,byte):byte","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-08-31T05:26:45.329360591Z"}
