{"id":"43d9c324-fe27-4ed3-a21a-89d9791f037d","expr":"name != null && !name.isEmpty()","rationale":"Name is expected to be a valid non-empty string identifying the entity visited.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.DuplicatesPredicate#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.664621154Z"}
