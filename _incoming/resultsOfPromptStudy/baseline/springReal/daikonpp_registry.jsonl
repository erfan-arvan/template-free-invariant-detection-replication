{"id":"18e9ef53-3439-44c1-8ca6-e00bd263e9f4","expr":"(superName != null || (superName == null && version < 49))","rationale":"If superName is null, version is likely less than 49 (Java 5 class version).","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.DuplicatesPredicate#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.664550662Z"}
{"id":"4aefe015-8313-4bc6-8353-7d6beee8d176","expr":"!((result != null) && (exceptions.length == 0)) || (exceptions != null)","rationale":"exceptions is non-null if result is non-null, because the method logic depends on input exception array not being null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.DuplicatesPredicate#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.665809211Z"}
{"id":"c6d5c2d0-e757-443a-b267-ffdaac0b70a7","expr":"name != null && desc != null && signature != null && exceptions != null && exceptions.getClass().isArray()","rationale":"Method parameters are typically non-null when this kind of visit method is called, and exceptions is an array of strings.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.DuplicatesPredicate#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.666271722Z"}
{"id":"53c3218b-8b34-4972-a9f8-196b042821a6","expr":"!name.isEmpty()","rationale":"The method name usually represents a valid Java method name, which is typically non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.DuplicatesPredicate#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.666271722Z"}
{"id":"69f727f8-8c87-4c72-88ed-07283cd9082c","expr":"exceptions.length >= 0","rationale":"Java arrays have non-negative length; exceptions is the declared array parameter.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.DuplicatesPredicate#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.666271722Z"}
{"id":"ffcd4f06-ab06-4915-84e2-c9742466bd4e","expr":"(access & (1 << 0)) == 0 || (access & (1 << 0)) != 0","rationale":"Access modifiers use bit flags, access is an int used to describe method access permissions.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.DuplicatesPredicate#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.666271722Z"}
{"id":"e27f459f-316c-454a-ac1c-ef601dd457d5","expr":"m != null && m.getName() != null && !m.getName().isEmpty()","rationale":"The method being added is expected to be non-null and have a valid method name.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#addSuspectMethod(Method):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.668236982Z"}
{"id":"6cd6f471-3dcd-42c8-a80c-e9d32fe3ec90","expr":"m.getParameterTypes().length >= 0","rationale":"The parameter types array length is always non-negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#addSuspectMethod(Method):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.668236982Z"}
{"id":"4637379a-1c51-447a-a211-91b039b83da2","expr":"m.getReturnType() != null","rationale":"Java Method always has a non-null return type.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#addSuspectMethod(Method):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.668236982Z"}
{"id":"39fd5f82-98c0-4bd9-9af1-a79ee755fe3b","expr":"m.isBridge() || !m.isBridge()","rationale":"Method bridge status boolean invariant.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#addSuspectMethod(Method):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.668236982Z"}
{"id":"7f438c43-67a4-4903-9ee2-968dcaa72160","expr":"m.getDeclaringClass().isAssignableFrom(m.getDeclaringClass())","rationale":"The declaring class is assignable from itself, ensuring no null or invalid class.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#addSuspectMethod(Method):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.668236982Z"}
{"id":"e09cb4fe-503d-492e-99aa-2734a1eceabe","expr":"name != null && !name.isEmpty()","rationale":"The visited entity must have a valid non-empty name.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669380926Z"}
{"id":"904c7bed-1db6-4fc9-a390-fddba7ae14fc","expr":"superName == null || !superName.isEmpty()","rationale":"Class might not have a superclass (null) or has a valid non-empty superclass name.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669380926Z"}
{"id":"6ea28ca1-fed8-441a-9bb4-5c5007cc7848","expr":"interfaces != null","rationale":"The interfaces list is initialized and not null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669380926Z"}
{"id":"70e36497-2a5d-4b86-ab2a-e6637c2702f7","expr":"name != null && !name.isEmpty()","rationale":"In typical bytecode visit methods, the method name is expected to be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669485974Z"}
{"id":"aab4f73b-35a3-4a20-b843-331778d03eb4","expr":"signature == null || !signature.isEmpty()","rationale":"Either no generic signature is provided or it's a non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669485974Z"}
{"id":"8d65eeb5-a887-489e-9bfd-3550dd6d6f81","expr":"superName == null || !superName.isEmpty()","rationale":"Either no superclass is specified (for Object), or it's a non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669485974Z"}
{"id":"1503ce33-8fe7-4942-b78a-d87247c06ddf","expr":"interfaces == null || interfaces.length >= 0","rationale":"interfaces array can be null or any length; no negative lengths.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669485974Z"}
{"id":"0cb427a8-baff-477c-8d86-c075b1b8d2cf","expr":"(access & 0xFFFFF) == access","rationale":"Access flags are typically within a certain bitmask range.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669485974Z"}
{"id":"4fd53ffe-6ba2-4613-82e3-bb776e62a8d8","expr":"name != null && desc != null && exceptions != null && signature == null || signature != null","rationale":"name, desc and exceptions are input parameters expected to be non-null; signature might be null or non-null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669726106Z"}
{"id":"2bf3f004-33b9-4428-b3db-96bffe5f7196","expr":"exceptions.length >= 0","rationale":"The length of the exceptions array is always greater than or equal to 0.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669726106Z"}
{"id":"dc225151-df23-48ca-90d8-e9c278446933","expr":"name.length() > 0","rationale":"The method name parameter is expected to be a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669726106Z"}
{"id":"c0c5780f-9ab0-419a-bc21-ab718c84db4c","expr":"desc.length() > 0","rationale":"The method descriptor string is expected to be non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669726106Z"}
{"id":"4f9648ed-b194-4b73-8fe8-af051cce6695","expr":"interfaces.length >= 0","rationale":"Java arrays always have non-negative length.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669380926Z"}
{"id":"033f2216-a78b-4e0d-98c7-e082577fa1ae","expr":"(signature == null) || (signature.length() > 0)","rationale":"Signature may be absent (null) or available and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.UnnecessaryBridgeFinder#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/core/DuplicatesPredicate.java","createdAt":"2026-09-08T06:23:15.669380926Z"}
{"id":"89f9986d-f402-4932-bca9-d5f69ded10ba","expr":"names != null","rationale":"names predicate is used to check string uniqueness; should be non-null at entry.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.SpringNamingPolicy#getClassName(String,String,Object,Predicate):String","file":"org/springframework/cglib/core/SpringNamingPolicy.java","createdAt":"2026-09-08T06:23:15.672186538Z"}
{"id":"6e5fa290-f55e-47df-b02c-030c6b56f925","expr":"key != null || key == null","rationale":"key is an Object parameter with no further constraints; can be null or non-null at method entry.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.SpringNamingPolicy#getClassName(String,String,Object,Predicate):String","file":"org/springframework/cglib/core/SpringNamingPolicy.java","createdAt":"2026-09-08T06:23:15.672186538Z"}
{"id":"1eb654f6-8f46-4255-a19f-eb66806903dc","expr":"!names.evaluate(result)","rationale":"The loop continues as long as attempt names.evaluate returns true. When the method returns, result is set to an attempt that does not exist in names, so names.evaluate(result) must be false.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.SpringNamingPolicy#getClassName(String,String,Object,Predicate):String","file":"org/springframework/cglib/core/SpringNamingPolicy.java","createdAt":"2026-09-08T06:23:15.672337843Z"}
{"id":"fa7ee827-1340-4e2c-b937-38f0058c9599","expr":"result == false","rationale":"The method always returns false, so result is false on exit.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#isStaticHook():boolean","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.692350452Z"}
{"id":"d46e59b5-50e7-4a38-8dc9-67c19b619f6b","expr":"result != null","rationale":"The method returns the field 'state.sig', which should be non-null, ensuring that the result is not null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#getSignature():Signature","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.692601505Z"}
{"id":"0c2947b3-13fe-4660-838a-5eef66644c90","expr":"result.toString() != null","rationale":"The Signature object should produce a non-null string representation via toString().","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#getSignature():Signature","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.692601505Z"}
{"id":"130cb732-dc17-4695-bc7e-b8406669de22","expr":"result != null","rationale":"The getReturnType method should always return a valid Type object representing the method's return type, so the result is non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#getReturnType():Type","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.692720679Z"}
{"id":"c50bebb9-1828-4a0b-9bc7-e77bf15e6df3","expr":"result.toString().length() > 0","rationale":"The Type class often provides a meaningful toString representing the type name, which should be non-empty.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#getReturnType():Type","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.692720679Z"}
{"id":"d5e27ef2-756b-4771-ac8a-88872ebae8bc","expr":"result != null","rationale":"The returned MethodInfo object (result) should never be null as it represents the internal state.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#getMethodInfo():MethodInfo","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.693932100Z"}
{"id":"b343dbe9-ef46-4625-9f1b-28b1601fd962","expr":"result != null","rationale":"The result is expected to be a valid ClassEmitter instance returned from the method.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#getClassEmitter():ClassEmitter","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.714120059Z"}
{"id":"f505ac16-97b6-4f5c-93a9-b89e4198fd99","expr":"result != null","rationale":"The method returns a new Block object, so result is always non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#begin_block():Block","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.714591396Z"}
{"id":"a1467c1a-5225-47fe-9fe7-d29354623a1f","expr":"block != null && exception != null && block.getEnd() != null && block.getStart() != null && exception.getInternalName() != null","rationale":"The catch_exception method throws if block.getEnd() is null, so block.getEnd() is non-null. The calls to visitTryCatchBlock require non-null block.getStart() and exception.getInternalName(). Since block and exception are parameters, they are expected non-null at method entry.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.CodeEmitter#catch_exception(Block,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.715453319Z"}
{"id":"ecf96a72-f6c6-449d-ba98-c2cc9300b197","expr":"block.getEnd() != null","rationale":"The method throws IllegalStateException if block.getEnd() is null, so an invariant before the method executes is that block.getEnd() != null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.CodeEmitter#catch_exception(Block,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.715453319Z"}
{"id":"1ea0ed8d-932e-4d60-b1c0-1a1bae7185d3","expr":"exception.getInternalName() != null","rationale":"exception.getInternalName() is used to configure the try-catch block, so before invocation it should be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.CodeEmitter#catch_exception(Block,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.715453319Z"}
{"id":"821ae5db-1b3e-4e5a-b431-0ecc5e530f5b","expr":"block.getStart() != null","rationale":"block.getStart() must be non-null for visitTryCatchBlock call in catch_exception.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.CodeEmitter#catch_exception(Block,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.715453319Z"}
{"id":"116ef624-9a88-42e2-acdc-94581f72cd42","expr":"block.getEnd() != null","rationale":"Ensures that the block's end marker is set, as required by the method's precondition for visitTryCatchBlock.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#catch_exception(Block,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.715640682Z"}
{"id":"b47e2731-ed5a-4c70-8b74-91602b4f9481","expr":"exception.getInternalName() != null","rationale":"The exception type's internal name must be non-null to correctly register the catch block.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#catch_exception(Block,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.715640682Z"}
{"id":"9da51228-7091-4acb-8ae7-31e8856a94b7","expr":"block.getStart() != null","rationale":"Ensures the block's start marker is set, which is necessary to define the try block range.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#catch_exception(Block,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.715640682Z"}
{"id":"10cc3754-a46f-4d15-9aea-234787dfbcf5","expr":"!block.getEnd().equals(block.getStart())","rationale":"Check that the try-catch block covers a non-empty range.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#catch_exception(Block,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.715640682Z"}
{"id":"43201641-fbac-4351-aa88-c2e55f2ae254","expr":"label != null","rationale":"The method calls visitJumpInsn with label, so label must not be null at method entry.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.CodeEmitter#goTo(Label):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.735616311Z"}
{"id":"9a450eff-0a1e-479f-b1bb-dc8e1ed5d309","expr":"label != null","rationale":"Label is passed to a method that likely requires a valid Label instance, so it is expected not to be null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#ifnull(Label):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.736121342Z"}
{"id":"8edada4c-00d6-41c7-b344-2484fb985ba4","expr":"label != null","rationale":"Since 'label' is used as a jump target, it should not be null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.CodeEmitter#ifnonnull(Label):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.736218344Z"}
{"id":"0d9ed323-8996-4121-b754-da85cb4b1658","expr":"label != null","rationale":"The method call mv.visitJumpInsn requires a non-null label argument.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#goTo(Label):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.736214567Z"}
{"id":"e8d7d022-6d44-44bc-b1ad-0ce19ea12c87","expr":"label.position >= 0","rationale":"Labels typically have non-negative positions representing code indices.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#goTo(Label):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.736214567Z"}
{"id":"38d013f6-b871-4428-acb3-da451a7d76c2","expr":"label.isResolved()","rationale":"Before jumping to a label, it must be resolved to a code position.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#goTo(Label):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.736214567Z"}
{"id":"225b3e15-f2e4-4576-8d83-5045bb09fae3","expr":"label.status == 2","rationale":"Label status 2 indicates resolved state, expected before using in a jump.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#goTo(Label):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:15.736214567Z"}
