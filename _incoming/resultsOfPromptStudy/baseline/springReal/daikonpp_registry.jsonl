{"id":"ab8d3d6f-7fce-4b1c-a30f-97bb958f68ba","expr":"name == null || name.length() >= 0","rationale":"The name parameter is either null or a non-empty string with a non-negative length.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AnnotationVisitorTee#visitArray(String):AnnotationVisitor","file":"org/springframework/cglib/transform/AnnotationVisitorTee.java","createdAt":"2026-09-08T06:23:15.053435273Z"}
