{"id":"e80a3685-49d6-47d0-b410-f3b9325afec9","expr":"owner != null && name != null && desc != null","rationale":"Parameters owner, name, desc are passed directly and expected to be non-null for visiting.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-08T06:23:15.074997700Z"}
