{"id":"a0d624bb-ea99-463d-a56f-bfbd6f33b04c","expr":"outerName == null || !outerName.isEmpty()","rationale":"Outer name, if present, should not be an empty string.","kind":"METHOD_EXIT","element":"org.springframework.asm.ClassVisitor#visitInnerClass(String,String,String,int):void","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.603127682Z"}
{"id":"4924355b-6cc6-410e-a22c-7c402803d3c8","expr":"name != null && !name.isEmpty()","rationale":"The method name is expected to be a valid identifier, not null or empty.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.609956579Z"}
