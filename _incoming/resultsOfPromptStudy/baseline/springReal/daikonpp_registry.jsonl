{"id":"70273601-b8af-402c-b1c0-131f11abc4af","expr":"clazz.getName().length() > 0","rationale":"Class.getName() returns a non-empty string representing the class name.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getPackageName(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.213038411Z"}
