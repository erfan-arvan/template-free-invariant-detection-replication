{"id":"4311a1d8-d0c4-4e66-b8a4-e43cf7f8f5f7","expr":"data.equals(data)","rationale":"No tautologies included.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#charactersInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.205815707Z"}
