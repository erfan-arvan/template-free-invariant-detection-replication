{"id":"04bb576d-3a42-4367-ae4b-111545f90eb9","expr":"name != null && !name.isEmpty()","rationale":"name is method name; typically non-null and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:23:15.100915988Z"}
