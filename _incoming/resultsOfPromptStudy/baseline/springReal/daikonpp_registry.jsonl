{"id":"567f36c9-f84a-42ae-a566-f493da8e89a3","expr":"paramTypes == null || paramTypes.length >= 0","rationale":"If paramTypes is not null, it is an array, and arrays have a non-negative length.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethodIfAvailable(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.321834237Z"}
