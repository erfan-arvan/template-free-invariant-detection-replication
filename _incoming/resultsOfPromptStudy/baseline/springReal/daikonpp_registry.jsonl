{"id":"082eccac-88c0-41b2-adc0-3e365e38a56a","expr":"opcode >= 0 && opcode <= 255","rationale":"opcode value typically represents JVM opcodes which are in the range 0-255.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:23:15.099205748Z"}
