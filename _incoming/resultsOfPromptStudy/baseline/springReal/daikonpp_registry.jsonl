{"id":"5c5443f8-3bc6-48ba-9f74-3c921cc8a922","expr":"ch != null && start >= 0 && length >= 0 && start + length <= ch.length","rationale":"The parameters must be valid indices within the ch array for the String constructor call.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.409761576Z"}
