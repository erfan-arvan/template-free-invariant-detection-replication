{"id":"fff6602c-091b-48f9-8e4e-da5e9b7d49c9","expr":"superName == null || !superName.isEmpty()","rationale":"superName can be null or a valid superclass name which is typically non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-08T06:23:15.074468413Z"}
