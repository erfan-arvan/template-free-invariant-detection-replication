{"id":"d681d2d4-069e-4e5c-95ab-5dd5a1b5b175","expr":"name.equals(innerName) == false","rationale":"Usually innerName differs from name as innerName is a simple name, name is the full name.","kind":"METHOD_EXIT","element":"org.springframework.asm.ClassVisitor#visitInnerClass(String,String,String,int):void","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.603127682Z"}
{"id":"db682b7f-9960-44cd-8cf0-eb16e6e33bfe","expr":"name != null && !name.isEmpty()","rationale":"Class name should be non-null and typically non-empty as per JVM internal naming conventions.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitInnerClass(String,String,String,int):void","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.602774788Z"}
