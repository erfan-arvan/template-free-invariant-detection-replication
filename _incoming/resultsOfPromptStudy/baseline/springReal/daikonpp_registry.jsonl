{"id":"c35a26db-88c0-4e05-aab0-5a1ce86bfc87","expr":"impl != null","rationale":"The method calls impl.getName(), so impl must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.MethodInterceptorGenerator#getMethodProxyField(Signature):String","file":"org/springframework/cglib/proxy/MethodInterceptorGenerator.java","createdAt":"2026-09-08T06:23:16.361121242Z"}
