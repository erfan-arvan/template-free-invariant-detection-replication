{"id":"3e456b46-3d6e-4e7e-898d-e08da8b45221","expr":"ce != null","rationale":"The ClassEmitter must be non-null to generate methods on it, so ce != null holds here.","kind":"METHOD_EXIT","element":"org.springframework.cglib.proxy.MethodInterceptorGenerator#generate(ClassEmitter,Context,List):void","file":"org/springframework/cglib/proxy/MethodInterceptorGenerator.java","createdAt":"2026-09-08T06:23:16.361848912Z"}
