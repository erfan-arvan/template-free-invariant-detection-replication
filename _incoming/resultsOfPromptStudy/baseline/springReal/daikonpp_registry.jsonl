{"id":"da274fdb-e901-4e10-8b5f-d2f368310e66","expr":"resource != null","rationale":"The resource parameter should not be null when method is invoked.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-08T06:23:11.926516280Z"}
