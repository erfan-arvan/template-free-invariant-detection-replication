{"id":"672bfcfb-821c-47a4-944c-05e015b9e7e0","expr":"method.getParameterCount() >= 0","rationale":"Parameter count of a method cannot be negative.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleMethod(Method):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-08T06:23:09.607935717Z"}
