{"id":"bdd6f2b0-6169-4041-9d65-d56e4230e94e","expr":"data != null","rationale":"data is not null as the method writes data to streamWriter without null checks.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#ignorableWhitespaceInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.212286299Z"}
{"id":"6f98c549-55da-474c-8015-351c74e6540a","expr":"name != null && !name.isEmpty()","rationale":"The method writes an entity reference with the given name, which should not be null or empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeEntityRef(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:23:05.212956240Z"}
{"id":"39c74fd9-0a80-415a-b72b-6651aaf03a28","expr":"name.length() <= 32","rationale":"Entity reference names commonly have a length limit, here assumed as 32 characters.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeEntityRef(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:23:05.212956240Z"}
{"id":"3242d536-7a1a-4f8c-a6a2-220401815cf5","expr":"name.equals(name.trim())","rationale":"Whitespace surrounding the entity name would be problematic for XML entity references.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeEntityRef(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:23:05.212956240Z"}
{"id":"5b4322ac-ef16-4401-bdb1-b745acfba677","expr":"!name.contains(\" \")","rationale":"Spaces in entity reference names are invalid in XML.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeEntityRef(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:23:05.212956240Z"}
{"id":"dce8761c-5be4-4f07-8207-7e27a296a157","expr":"target != null && !target.isEmpty()","rationale":"A processing instruction in XML must have a non-empty target.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#processingInstructionInternal(String,String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.215274996Z"}
{"id":"3cddeb0b-d975-4f98-a483-1bfeef9a0d7b","expr":"data == null || !data.contains(\"?>\")","rationale":"To produce valid XML, the data string should not contain the sequence '?>'.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#processingInstructionInternal(String,String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.215274996Z"}
{"id":"b9fbdbee-84e1-4199-83ef-576390f47cc8","expr":"target.trim().length() > 0","rationale":"This ensures target is not only whitespace, which would be invalid.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#processingInstructionInternal(String,String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.215274996Z"}
{"id":"c4232293-02b6-4ec6-9237-aec6eeef87d4","expr":"name != null && name.getLocalPart() != null && !name.getLocalPart().isEmpty()","rationale":"The method is called to end an element, so 'name' should be a valid QName with a meaningful local part.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#endElementInternal(QName,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.201084118Z"}
{"id":"5a1de68f-dcc1-4177-b605-e6706c3e2e3a","expr":"data == null || data.length() >= 0","rationale":"The length of data is never negative and data could be null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#processingInstructionInternal(String,String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.215274996Z"}
{"id":"14559c97-392b-4d66-87be-e469959cc91d","expr":"dtd != null && !dtd.isEmpty()","rationale":"dtd must be a non-null, non-empty valid DTD string since it is passed to writeDTD.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#dtdInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.216050356Z"}
{"id":"a9e0f048-ac0f-42eb-ae4d-def2b23d20f4","expr":"target != null && !target.isEmpty()","rationale":"target is a valid XML processing instruction target, usually non-empty and non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#processingInstructionInternal(String,String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.213306490Z"}
{"id":"a8629d56-a876-45a3-bb3b-97084179512e","expr":"data != null && data.length() >= 0","rationale":"Method writes CDATA which usually expects non-null data string.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#cDataInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.211966337Z"}
{"id":"c396a234-f2ed-4cd6-b961-dc4d32b0d261","expr":"dtd != null","rationale":"Since 'dtd' is passed to 'writeDTD', it should not be null to avoid NullPointerException.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#dtdInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.216705930Z"}
{"id":"e6559586-7f04-4f1d-9597-6b8e858ef0b7","expr":"!dtd.isEmpty()","rationale":"An empty DTD string might be invalid or meaningless, so this invariant captures useful input assumptions.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#dtdInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.216705930Z"}
{"id":"3bda0c49-1eb5-4bf3-a430-f0e1557ac7de","expr":"dtd.length() > 8","rationale":"The DTD string is expected to be longer than minimal DOCTYPE keyword length.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#dtdInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.216705930Z"}
{"id":"ed685f0e-0181-4dfd-b59b-708718ede57e","expr":"!dtd.contains(\"\\0\")","rationale":"This invariant asserts that the DTD string does not contain null characters, which are invalid in XML.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#dtdInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.216705930Z"}
{"id":"1483253d-1f19-4eee-a338-c2c336384b46","expr":"data != null","rationale":"The data parameter must not be null to be safely passed to writeCharacters.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#ignorableWhitespaceInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.210649698Z"}
{"id":"56191d43-5b3b-4584-bba4-732f644ef736","expr":"data.length() >= 0","rationale":"The length of the input string is always zero or more.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#ignorableWhitespaceInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.210649698Z"}
{"id":"ad06f482-07ee-45d5-8175-54ed334a3f31","expr":"data.trim().length() == 0","rationale":"The data string trimmed of whitespace is empty, indicating it is whitespace only.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#ignorableWhitespaceInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.210649698Z"}
{"id":"d8b25162-d826-421a-b8e3-c5dbecbbcad0","expr":"comment != null","rationale":"The comment parameter must be non-null as it is passed to streamWriter.writeComment which likely does not accept null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#commentInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.229799432Z"}
{"id":"8912f63e-223c-429d-9ff2-1bf46debe1ec","expr":"comment.length() >= 0","rationale":"The length of comment string is always zero or positive.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#commentInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.229799432Z"}
