{"id":"ca964bb5-fc0b-4462-b878-965b7a93f3d1","expr":"result != null","rationale":"The method's return is a non-null string literal.","kind":"METHOD_EXIT","element":"org.springframework.core.style.SimpleValueStyler#styleNull():String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-08T06:23:09.609315936Z"}
