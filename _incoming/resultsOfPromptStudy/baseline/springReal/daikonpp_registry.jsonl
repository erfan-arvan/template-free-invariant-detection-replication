{"id":"1b7ac364-dedb-4b2e-a0e7-e55c242067ea","expr":"(className == null) == !result","rationale":"Ensures that null className implies result is false, aligning with the method contract.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isCglibProxyClassName(String):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.144950349Z"}
