{"id":"67a3d752-1daa-4a98-aed0-b1813809e0d1","expr":"version >= 0","rationale":"Class file versions are non-negative integers.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.061071460Z"}
{"id":"2a49a630-9113-4299-b85e-16177c567dd5","expr":"name != null && !name.isEmpty()","rationale":"The class name should be provided and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.061071460Z"}
{"id":"80f650f6-427e-4ce4-873b-faf4e51490a4","expr":"(signature == null) || (!signature.isEmpty())","rationale":"Signature can be null or a valid non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.061071460Z"}
{"id":"4406bd5e-b800-451b-8b71-e9e7b86a98ba","expr":"(superName == null) || (superName.length() > 0)","rationale":"superName is either null or a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.061071460Z"}
{"id":"2fdf318c-a71c-4cf5-a241-0502642a5e20","expr":"interfaces != null","rationale":"Interfaces should be a non-null array, empty is valid.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.061071460Z"}
{"id":"7bff48e4-4cc0-436c-a06f-d4756db2b874","expr":"version > 0","rationale":"version represents the class file version and is usually positive.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.061529703Z"}
{"id":"846e24d9-fbf6-4d63-b25f-f31d7e21f7bf","expr":"access >= 0","rationale":"access is a bitmask of access flags and should be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.061529703Z"}
{"id":"e713a895-e116-422c-8c9e-fed404058062","expr":"name != null && !name.isEmpty()","rationale":"name must represent a valid class name, so it should not be null or empty.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.061529703Z"}
{"id":"b7e1492a-89bf-40fb-a613-1f6cf745d997","expr":"(signature == null) || (!signature.isEmpty())","rationale":"signature may be null or a meaningful string but should not be empty if present.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.061529703Z"}
{"id":"a26c9133-1637-4188-a1ee-0a8c3e1b7174","expr":"(interfaces == null) || (interfaces.length >= 0)","rationale":"interfaces can be null or an array, and length should be non-negative if not null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.061529703Z"}
{"id":"c06196c8-9233-431a-812d-6abbc28c8c0f","expr":"name != null && !name.isEmpty() && (outerName == null || !outerName.isEmpty()) && (innerName == null || !innerName.isEmpty()) && access >= 0","rationale":"name should be a valid non-empty string; outerName and innerName may be null or valid strings; access is a non-negative access flag","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.062583818Z"}
{"id":"b846c5bb-2bdb-466c-9462-b8832837a26d","expr":"(outerName != null) == (innerName != null)","rationale":"outerName is null if and only if innerName is null, indicating consistent class nesting info","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.062583818Z"}
{"id":"5ceb2317-7145-4e66-9c5c-7290501799af","expr":"name.startsWith(outerName == null ? \"\" : outerName) || outerName == null","rationale":"name may start with outerName when outerName is not null","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.062583818Z"}
{"id":"4cf381f4-77a1-4581-b298-1bdda36ec2d7","expr":"innerName == null || name.endsWith(innerName)","rationale":"name often ends with innerName if innerName is not null","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.062583818Z"}
{"id":"9ef3072d-6d08-4ecc-b51d-84d5ec66318c","expr":"name != null && !name.isEmpty()","rationale":"The 'name' parameter often represents the inner class name and should not be null or empty.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.062824210Z"}
{"id":"ff758523-c4d8-408b-aad2-7e709db3c627","expr":"(outerName == null) || (!outerName.isEmpty())","rationale":"The 'outerName' is either null or non-empty string; empty string is unlikely for a valid outer class.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.062824210Z"}
{"id":"a7d5ee83-e993-4b16-ac7c-849702025565","expr":"(access & 0x1000) == 0 || (access & 0x1000) == 0x1000","rationale":"access is a bitmask and specific flags are either set or not set","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.062583818Z"}
{"id":"f5f1dd10-75d5-4484-9872-6224db29be15","expr":"innerName != null || (outerName != null)","rationale":"If innerName is null, outerName must be non-null as an inner class usually has an outer.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.062824210Z"}
{"id":"9baffef0-9775-4ec5-a5bb-58559d53116f","expr":"(access & 0x0001) == 0 || (access & 0x0002) == 0","rationale":"The access flags may not simultaneously indicate public and private for the same inner class.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.062824210Z"}
{"id":"ef72abe6-c25d-4c5c-be09-06612114c107","expr":"name.equals(outerName) == false","rationale":"Inner class name and outer class name should not be equal","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.062824210Z"}
{"id":"9a444137-ec0f-4937-a177-c80bd6059cdc","expr":"name != null && !name.isEmpty()","rationale":"Name should be non-null and non-empty to identify the field.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitField(int,String,String,String,Object):FieldVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.063835294Z"}
