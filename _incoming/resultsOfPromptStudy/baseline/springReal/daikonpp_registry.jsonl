{"id":"217039d3-7d71-41a8-a81c-e9daff0f30eb","expr":"type.getClass().isInstance(type)","rationale":"Reflexive property of instanceof holds for correct type references.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.core.CodeEmitter#throw_exception(Type,String):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-08T06:23:16.240569112Z"}
