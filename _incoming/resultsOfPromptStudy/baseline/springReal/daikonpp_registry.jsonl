{"id":"c683bef8-e914-4614-ae7d-6d1b681a0de0","expr":"result == (paramTypes != null)","rationale":"Result depends on paramTypes being non-null since null paramTypes would cause exception or no constructor match.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#hasConstructor(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.302961615Z"}
{"id":"e829e8fd-0055-4b5c-9424-b27898ed3ab9","expr":"result == (clazz != null) && (clazz.getDeclaredConstructors().length >= 0)","rationale":"Result depends on clazz being non-null and existence of constructors.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#hasConstructor(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.302961615Z"}
{"id":"f030af16-133d-4375-aa5c-3c51dd9b4429","expr":"clazz != null && methodName != null && paramTypes != null","rationale":"Ensures parameters are not null before method lookup.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,String,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.305824014Z"}
{"id":"37f7b9e7-3bdf-49dd-8f30-334ed579f4aa","expr":"clazz.isInterface() || !clazz.isInterface()","rationale":"Class object represents either interface or class type.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,String,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.305824014Z"}
