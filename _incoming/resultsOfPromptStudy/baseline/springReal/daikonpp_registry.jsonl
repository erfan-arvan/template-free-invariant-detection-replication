{"id":"d5916f37-4dfb-4cc7-9785-16c21f6ed2c7","expr":"name != null && desc != null && value != null","rationale":"It is typical that enum name, description, and value are non-null when visited.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AnnotationVisitorTee#visitEnum(String,String,String):void","file":"org/springframework/cglib/transform/AnnotationVisitorTee.java","createdAt":"2026-09-08T06:23:15.052006483Z"}
