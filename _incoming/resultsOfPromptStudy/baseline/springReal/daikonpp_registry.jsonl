{"id":"056e61a7-e425-4382-9526-e2f1f1d5270d","expr":"e != null","rationale":"CodeEmitter 'e' is used to emit bytecode and should be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.MethodInterceptorGenerator#generateStatic(CodeEmitter,Context,List):void","file":"org/springframework/cglib/proxy/MethodInterceptorGenerator.java","createdAt":"2026-09-08T06:23:16.368492109Z"}
{"id":"2efb0059-ae37-416a-8ff8-c5836bf1b978","expr":"context != null","rationale":"The Context 'context' provides signatures and is necessary for generating proxies.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.MethodInterceptorGenerator#generateStatic(CodeEmitter,Context,List):void","file":"org/springframework/cglib/proxy/MethodInterceptorGenerator.java","createdAt":"2026-09-08T06:23:16.368492109Z"}
