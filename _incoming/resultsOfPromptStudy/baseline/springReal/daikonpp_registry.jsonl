{"id":"d48f373d-c721-41b9-a05a-8746d69a7d3e","expr":"m != null && m.getName() != null && m.getParameterTypes() != null && m.getReturnType() != null && m.getExceptionTypes() != null","rationale":"Since the method addDelegate uses these Method methods defensively, their return values are likely non-null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AddDelegateTransformer#addDelegate(Method):void","file":"org/springframework/cglib/transform/impl/AddDelegateTransformer.java","createdAt":"2026-09-08T06:23:15.030927236Z"}
{"id":"65e11aa0-5f00-41b0-9cbd-a796e8e0e6de","expr":"name != null && name.length() > 0","rationale":"Field name should be a valid identifier string (non-null, non-empty)","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeChar(Object,String,char,char):char","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-08T06:23:15.031317901Z"}
