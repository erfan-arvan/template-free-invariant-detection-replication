{"id":"9e1dc7d5-9eac-4f59-abb4-c61b6434b736","expr":"name != null || value == null","rationale":"At method entry, if name is null, value might be null to reflect typical usage.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AnnotationVisitorTee#visit(String,Object):void","file":"org/springframework/cglib/transform/AnnotationVisitorTee.java","createdAt":"2026-09-08T06:23:15.050945586Z"}
