{"id":"0e016504-2894-4b89-9ccc-32157fe78fc3","expr":"obj != null","rationale":"obj must be non-null to call obj.getClass() safely.","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleStart(StringBuilder,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-08T06:23:09.580600602Z"}
{"id":"d54abcb9-491d-4fc3-9383-91f5485eb1e6","expr":"buffer.toString().startsWith(\"[\")","rationale":"The buffer content at return always starts with '['.","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleStart(StringBuilder,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-08T06:23:09.580600602Z"}
{"id":"85dca5cc-db61-4e97-a725-c866dc5e0766","expr":"(obj.getClass().isArray() && buffer.toString().contains(\" \")) || (!obj.getClass().isArray() && !buffer.toString().contains(\" \"))","rationale":"If obj is array, buffer has a space appended after identity hash code; otherwise it does not.","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleStart(StringBuilder,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-08T06:23:09.580600602Z"}
