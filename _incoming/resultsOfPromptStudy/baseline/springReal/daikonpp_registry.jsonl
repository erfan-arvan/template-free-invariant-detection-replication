{"id":"0761e4fc-8501-44d6-aedf-8f0dafc17042","expr":"!methodName.contains(\" \")","rationale":"Method name should not contain whitespace characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,String,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.305824014Z"}
{"id":"ec8c9b27-7b74-4fd8-8792-cf6facb546f5","expr":"(result == false) || (clazz != null)","rationale":"If result is true, clazz cannot be null because getMethodIfAvailable called on it.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,String,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.308247136Z"}
{"id":"cdd6e64f-e298-4a95-af5d-d930aa95fdd9","expr":"(result == false) || (methodName != null)","rationale":"If result is true, methodName cannot be null because getMethodIfAvailable called with it.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#hasMethod(Class<?>,String,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.308247136Z"}
{"id":"0739f39b-85a7-4d18-b1f7-5717356452b0","expr":"(result != null) || (result == null)","rationale":"The method returns either a Constructor or null if no constructor matches.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getConstructorIfAvailable(Class<T>,Class<?>):Constructor<T>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.317674265Z"}
{"id":"49bf1aa6-61eb-4dfe-844c-c666a35a939f","expr":"(result == null) || (result.getDeclaringClass() == clazz)","rationale":"If a constructor is returned, it must belong to the input class clazz.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getConstructorIfAvailable(Class<T>,Class<?>):Constructor<T>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.317674265Z"}
