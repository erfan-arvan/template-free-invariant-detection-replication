{"id":"fa5efeb4-361a-44d7-a963-b14bfdc03860","expr":"name != null && !name.isEmpty()","rationale":"The entity name parameter is expected to be a valid XML entity name, which is usually non-null and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#startEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.234580985Z"}
{"id":"0ec15741-c757-4033-ba75-16299184b4e2","expr":"!name.contains(\" \")","rationale":"XML entity names usually do not include spaces, hence name does not contain whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#startEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.234580985Z"}
{"id":"7dd2f2fe-258b-4aa4-96bf-a91d9ad0b124","expr":"name.equals(name.trim())","rationale":"Entity names are unlikely to have leading or trailing whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#startEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.234580985Z"}
{"id":"d0ad965b-0614-46a1-8be8-bdb4fe878ab8","expr":"comment != null || comment == null","rationale":"comment is either null or not null before the method starts.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#commentInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.226319731Z"}
