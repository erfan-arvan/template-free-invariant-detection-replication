{"id":"fc568f80-c0e1-446f-8f47-b286a317ed18","expr":"result.getName().contains(name)","rationale":"The signature name includes the original name string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#readMethodSig(String,String):Signature","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-08T06:23:15.016788456Z"}
