{"id":"2cfc5f47-7abf-4dcd-a22c-f1847cb152c6","expr":"internalName.length() == 0 || internalName.length() > 0","rationale":"String length is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getObjectType(String):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.643481268Z"}
{"id":"e1674473-09b7-4459-8649-494f55401772","expr":"internalName.startsWith(\"[\") == (internalName.charAt(0) == '[')","rationale":"The string starts with '[' if and only if its first character equals '['.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getObjectType(String):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.643481268Z"}
{"id":"4dab83e3-fa4a-45d0-93e4-a8d2d9d6c632","expr":"result.getInternalName().equals(internalName)","rationale":"The returned Type has the same internal name as the input string.","kind":"METHOD_EXIT","element":"org.springframework.asm.Type#getObjectType(String):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.644026815Z"}
{"id":"3082c90f-c6ed-46b7-99f1-7376c9697b74","expr":"result.getDimensions() == 0","rationale":"The returned Type object has zero dimensions since length is used as second parameter, but dimensions are fixed at 0.","kind":"METHOD_EXIT","element":"org.springframework.asm.Type#getObjectType(String):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.644026815Z"}
{"id":"65f67513-5768-403d-8e41-a3eba678b843","expr":"internalName.length() == result.getLength()","rationale":"The length of internalName matches the length field of the returned Type.","kind":"METHOD_EXIT","element":"org.springframework.asm.Type#getObjectType(String):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.644026815Z"}
{"id":"470c8cee-88fb-4079-8e74-4e415c65f018","expr":"methodDescriptor != null && methodDescriptor.length() > 0","rationale":"The method gets used as a descriptor, so it should be a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getMethodType(String):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.645267721Z"}
{"id":"6652b90f-1eb1-4afa-aa81-e52e869aef66","expr":"methodDescriptor.startsWith(\"(\")","rationale":"methodDescriptor likely represents a method descriptor string which starts with '('.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getMethodType(String):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.645267721Z"}
