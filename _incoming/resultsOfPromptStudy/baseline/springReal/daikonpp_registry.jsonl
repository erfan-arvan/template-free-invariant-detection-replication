{"id":"c5468762-8aab-4788-80d0-fddad16405c1","expr":"methods != null","rationale":"Methods list is iterated and processed, so must not be null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.proxy.MethodInterceptorGenerator#generateStatic(CodeEmitter,Context,List):void","file":"org/springframework/cglib/proxy/MethodInterceptorGenerator.java","createdAt":"2026-09-08T06:23:16.368687888Z"}
