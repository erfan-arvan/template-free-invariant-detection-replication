{"id":"4a0788fe-57df-44c2-a2b5-222375defd31","expr":"!result.hasNext() || !result.next().isEmpty()","rationale":"Namespace prefixes are typically non-empty strings.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.SimpleNamespaceContext#getBoundPrefixes():Iterator<String>","file":"org/springframework/util/xml/SimpleNamespaceContext.java","createdAt":"2026-09-08T06:23:05.356983939Z"}
{"id":"87c7692f-6f70-4b93-8dab-f2755069b50d","expr":"prefix != null && uri != null","rationale":"The method stores prefix and uri into a map, so neither is expected to be null at method exit.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.364149921Z"}
{"id":"ec9d1be7-9375-4072-bf0c-8f2283b0164a","expr":"!prefix.isEmpty()","rationale":"Namespace prefixes are typically non-empty strings.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.364149921Z"}
{"id":"48d2c65d-a433-455c-a1d6-ffd3b9e0f03f","expr":"!uri.contains(\" \")","rationale":"Namespace URIs should not include whitespace characters.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.364149921Z"}
{"id":"6907f1bf-d65e-4b9f-aa28-ff6b66dffed0","expr":"prefix.indexOf(':') == -1","rationale":"Namespace prefixes do not contain colons.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.364149921Z"}
{"id":"05bd8f3f-975e-4afc-9e1d-168210ad59e3","expr":"prefix == null || prefix.length() >= 0","rationale":"prefix is either null or non-null String, so length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endPrefixMapping(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.364701549Z"}
{"id":"2d9acd60-2ab4-4056-a640-49eeda4ebce0","expr":"prefix == null || !prefix.isEmpty() || prefix.isEmpty()","rationale":"prefix is a String, so it is either empty or non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endPrefixMapping(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.364701549Z"}
{"id":"97db415f-9f06-48c3-b298-320edc501211","expr":"prefix != null && uri != null && !prefix.isEmpty() && !uri.isEmpty()","rationale":"Typically, startPrefixMapping is invoked to map a prefix to a URI, both should be non-null and non-empty strings.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.364630776Z"}
{"id":"55b00a4e-1728-4107-89bf-19aa07136615","expr":"uri == null || !uri.isEmpty()","rationale":"URI represents a namespace; usually empty string or null if no namespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.368555315Z"}
{"id":"f6f9291d-a2d4-4fd1-ab6a-24e83ce833d6","expr":"prefix != null || prefix == null","rationale":"No operation performed in method, thus no constraints on prefix","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endPrefixMapping(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.366665667Z"}
{"id":"38c8f01b-74b0-48c9-8cb7-50fefe16d11c","expr":"localName != null && !localName.isEmpty()","rationale":"Local name represents the local part of the qualified name and should not be null or empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.368555315Z"}
{"id":"342a1aab-6dc6-46a1-b279-e90b4ba57b59","expr":"qName != null && !qName.isEmpty()","rationale":"Qualified name (qName) should be non-null and non-empty representing the element name.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.368555315Z"}
{"id":"8c6f2ad8-a04c-4c35-b0a1-560c11b188da","expr":"atts != null","rationale":"Attributes parameter should be non-null since it represents the element's attributes.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.368555315Z"}
{"id":"c59e7c20-329d-49a2-b3bb-f6cc3966e5de","expr":"atts.getLength() >= 0","rationale":"Attributes count (length) must be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.368555315Z"}
{"id":"5f53d13c-3b03-475a-9b8c-8bb97cd49bf6","expr":"qName != null && !qName.isEmpty()","rationale":"The qualified name qName should be a meaningful XML element name, so it is non-null and not empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.374968610Z"}
{"id":"1958c585-03ab-4e85-b6b6-7d3fbd5678d6","expr":"(uri == null || uri.isEmpty()) || qName.startsWith(uri)","rationale":"The qualified name qName often incorporates or relates to URI as a namespace prefix.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.374968610Z"}
{"id":"635958f9-6337-4941-a08f-2e2b3214bfa1","expr":"localName != null && !localName.isEmpty()","rationale":"The localName should be a defined and non-empty string for the XML element.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.374968610Z"}
{"id":"0f5f8339-d128-47f8-aeb3-f21f1b8fc2d3","expr":"qName.contains(localName)","rationale":"The qName should contain the localName string as part of the XML element name.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.374968610Z"}
{"id":"716575fa-18de-417e-99a9-f067c84c29bc","expr":"ch != null && start >= 0 && length >= 0 && start + length <= ch.length","rationale":"The use of new String(ch, start, length) requires these conditions to be valid.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.378212447Z"}
{"id":"3aa52730-3f4b-4b97-9aef-33464fcd1761","expr":"ch != null && start >= 0 && length >= 0 && start + length <= ch.length","rationale":"The substring used to create String data must be within ch bounds.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.378779415Z"}
{"id":"faf66d09-b665-4b0c-a902-727618ca621c","expr":"start + length <= ch.length","rationale":"The substring from start to start+length is strictly within the ch array bounds.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.378779415Z"}
{"id":"ca3acabb-8ace-435d-a811-7f62ae919455","expr":"length >= 0","rationale":"Length param should be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.378779415Z"}
{"id":"7ff5bca3-a6a7-47b0-943b-ef080bbb5636","expr":"start >= 0","rationale":"Start index param should be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.378779415Z"}
{"id":"fee33f25-1d9e-4943-95b8-f03e3374ca8d","expr":"length >= 0","rationale":"Length must be non-negative to form a valid substring from ch.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.384541373Z"}
{"id":"1f4ac146-87b9-4a4a-9ee7-9d3afc300d89","expr":"start >= 0","rationale":"Start index must be valid for the substring constructor.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.384541373Z"}
{"id":"cd8667c1-4b96-4406-949d-a1678f09eea8","expr":"start + length <= ch.length","rationale":"Indices define a substring within the bounds of the character array.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.384541373Z"}
{"id":"6a1c0007-107f-4899-93c0-2b930f3126f9","expr":"ch.length >= 0","rationale":"ch is an array, so length must be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.384541373Z"}
{"id":"260fa69c-7d89-4038-b4e7-931b956d44fd","expr":"uri != null && uri.equals(uri)","rationale":"Since uri is used as a parameter, it is likely not null","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.373310868Z"}
{"id":"2016b68a-f205-4356-bda7-546c1de987c8","expr":"qName != null && !qName.isEmpty()","rationale":"Qualified names for elements are expected to be non-empty strings","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.373310868Z"}
{"id":"4dad8eae-bc20-4121-9228-340a7718e29a","expr":"prefix != null && uri != null && !prefix.equals(uri)","rationale":"The prefix and URI are expected to be different strings representing namespace prefix and namespace URI.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.364630776Z"}
{"id":"1b3330e2-e2bd-48bf-bdf7-85ecced43b9d","expr":"target != null && data != null","rationale":"The method likely expects non-null parameters to process instructions.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.386034263Z"}
{"id":"5ac9f456-3d96-43a9-b656-510ba440153a","expr":"target.length() > 0","rationale":"Processing instruction targets normally are non-empty strings.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.386034263Z"}
{"id":"64fe5486-aa4c-4534-b8b4-73882879e95a","expr":"data.length() >= 0","rationale":"String length cannot be negative, so the data length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.386034263Z"}
{"id":"1533415b-c492-4cff-9511-3d4a92eff074","expr":"!target.contains(\" \")","rationale":"The target of a processing instruction typically does not contain spaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.386034263Z"}
{"id":"bad65788-0166-4ddc-8eb3-4d57962c14d1","expr":"!data.startsWith(\"<\")","rationale":"Data is typically not starting with angle bracket in processing instructions to avoid ambiguity with tags.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.386034263Z"}
{"id":"6678a9a8-548f-4360-9bb1-87d90e62beae","expr":"target != null && !target.isEmpty()","rationale":"The processing instruction's target name is expected to be a non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.387783487Z"}
{"id":"bf34c9a8-1e63-4ebd-b71a-ecc844944efb","expr":"data != null","rationale":"The data parameter should not be null when processing instruction completes.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.387783487Z"}
{"id":"c4dfec21-31bc-41b2-b0a7-17bcbe4d0ca0","expr":"!target.contains(\"<?\")","rationale":"The target string should not contain XML declaration delimiters.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.387783487Z"}
{"id":"9f853616-cecf-4e98-9178-7c7d00ecabff","expr":"!data.contains(\"?>\")","rationale":"The data string should not include the end of PI delimiter '?>'.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.387783487Z"}
{"id":"cce6a46b-9fcd-4599-b1d7-879e835bbb7c","expr":"!(target.isEmpty() && data.isEmpty())","rationale":"Assuming meaningful processing instructions have non-empty target or data.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.387783487Z"}
{"id":"285e774b-a02b-4ad0-acaf-92ffee412690","expr":"ch != null && start >= 0 && length >= 0 && start + length <= ch.length","rationale":"The method creates a new String from ch starting at start with length, so start and length must define a valid substring in ch.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.384565729Z"}
{"id":"a24f74ab-6696-414d-b578-6c9002a24c30","expr":"start <= ch.length","rationale":"The start index is used as the offset in the char array, so it cannot exceed the array length.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.384565729Z"}
{"id":"8f859915-3939-4903-8dea-2cce149e2bb9","expr":"length <= ch.length","rationale":"Although length can be zero, cannot be longer than the array length otherwise substring would be invalid.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.384565729Z"}
{"id":"cce50024-e462-47cd-b2d9-f8fe8204de78","expr":"start + length >= 0","rationale":"For valid substring indices, sum of start and length must be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.384565729Z"}
{"id":"beece2be-9745-4359-9ea4-c9b9004b2be2","expr":"length >= 0","rationale":"Length passed to new String constructor must be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.384565729Z"}
{"id":"4ce0cddc-a600-4c88-8309-051b4029597d","expr":"qName != null && (uri == null || !uri.isEmpty()) && localName != null && !localName.isEmpty()","rationale":"The qName is typically non-null; localName is non-empty if provided; uri may be null or non-empty, reflecting namespace presence.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.389689385Z"}
{"id":"9690fa2f-9fe1-4a86-8592-af2f134ec347","expr":"uri == null || qName.startsWith(uri)","rationale":"qName often has a namespace prefix matching uri.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.389689385Z"}
{"id":"77790a2f-cffb-4609-887e-e7606446c205","expr":"localName.equals(qName) || (qName.contains(\":\"))","rationale":"qName differs from localName when namespace prefix is present.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.389689385Z"}
{"id":"61171be0-f1a0-493f-9eab-e5c5fc6ac325","expr":"(uri == null && !qName.contains(\":\")) || (uri != null && qName.contains(\":\"))","rationale":"Namespace URI presence correlates with prefix in qName.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.389689385Z"}
{"id":"ae6dcc92-a576-4a26-b975-d24b01afc479","expr":"localName.length() > 0","rationale":"localName must not be empty for a valid XML element.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.389689385Z"}
{"id":"557a12f5-63c0-490d-96e2-0da156e8ad03","expr":"name != null && !name.isEmpty()","rationale":"Given the method is for handling skipped XML entities, the name should be a valid, non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.393191729Z"}
{"id":"f7cd01b0-9e97-44dc-9ff2-a54616b801c6","expr":"name.indexOf(' ') == -1","rationale":"XML entity names typically do not contain whitespace characters, so name should not contain spaces.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.393191729Z"}
{"id":"a1619230-0157-4aff-8030-a1bff1e16e09","expr":"name.length() > 0","rationale":"The entity name passed should not be an empty string as that is not a valid entity name.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.393191729Z"}
{"id":"9975dc39-46b4-4653-8cab-bf2b9d4193cb","expr":"name.equals(name.trim())","rationale":"Since the method processes entity names, they should not have leading or trailing spaces.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.393191729Z"}
{"id":"61c62273-ed9c-4b61-b1ee-9e020bc852fd","expr":"name != null && !name.isEmpty()","rationale":"In the method, 'name' is appended directly to the StringBuilder without null check, so name cannot be null or empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.396034271Z"}
{"id":"ef8c54c8-896c-44ac-b771-a4b6527c4c77","expr":"systemId != null && !systemId.isEmpty()","rationale":"systemId is appended without null check, so it must be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.396034271Z"}
{"id":"6b31064d-d1d3-4f90-be52-19fc3e652f9b","expr":"(publicId == null) || (publicId != null && !publicId.isEmpty())","rationale":"The method treats 'publicId' as either null or a non-empty string, no empty or null publicId usage.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.396034271Z"}
{"id":"3da6d176-350d-4a18-ae97-23d23ea5a9d3","expr":"name != null && systemId != null && (publicId == null || publicId != null)","rationale":"name and systemId are appended without null check; publicId is checked before use","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.399206604Z"}
{"id":"295eb276-4481-47d6-a1de-f9cbafe37431","expr":"!(name.isEmpty())","rationale":"name being empty would produce invalid DOCTYPE syntax","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.399206604Z"}
{"id":"f5b13a0f-b09a-4b28-b0bd-499b9d469392","expr":"systemId.length() > 0","rationale":"systemId is appended regardless of publicId's null status, so it must be a valid (non-empty) string","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.399206604Z"}
{"id":"3932efe3-7660-4108-a8a2-fb326d5195aa","expr":"publicId == null || !publicId.isEmpty()","rationale":"publicId if present is appended wrapped in quotes; empty string makes no semantic sense but is allowed; still it's a useful invariant to check","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.399206604Z"}
{"id":"d4a6053f-7708-4138-b79e-b4006f2c774b","expr":"(publicId == null) || (publicId != null && systemId != null)","rationale":"publicId is only appended when non-null; systemId is always appended; Must be non-null when publicId is non-null","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.399206604Z"}
{"id":"7e9d7c8c-31a0-4b00-96fe-805f35ab20ce","expr":"name != null && !name.isEmpty()","rationale":"The parameter 'name' should not be null or empty based on typical usage in XML parsing.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.388330116Z"}
{"id":"129398ac-98ac-4e56-bd40-de0808dec619","expr":"localName != null","rationale":"Local name for XML elements should not be null","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.373310868Z"}
