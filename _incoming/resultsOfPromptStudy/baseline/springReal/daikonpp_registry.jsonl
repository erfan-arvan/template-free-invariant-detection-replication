{"id":"e1a7c106-c643-4869-a03b-c2e6100f9f5d","expr":"result.isEmpty() || resource != null","rationale":"If any properties are loaded into 'result', then 'resource' must have been provided and non-null.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(EncodedResource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-08T06:23:11.924689170Z"}
