{"id":"f7e2b993-78e0-48e9-8cc3-6595e5200ca0","expr":"str.length() >= index","rationale":"the substring call uses index as end index, so index <= str.length()","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#checkStartsWith(String,String,int,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-08T06:23:03.618341526Z"}
{"id":"446d1f11-5bb6-41b7-93fa-aa13c660037f","expr":"pattern.length() >= 0 && str.length() >= 0","rationale":"String lengths cannot be negative","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#checkStartsWith(String,String,int,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-08T06:23:03.618341526Z"}
{"id":"a8685d34-c09d-4235-ae3e-a41ab2d5b9a7","expr":"index >= 0","rationale":"index is used as substring end index, needs to be >= 0","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#checkStartsWith(String,String,int,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-08T06:23:03.618341526Z"}
