{"id":"a6bf1bbf-07c1-489d-b6bf-b940edac27af","expr":"cst != null || cst == null","rationale":"cst can be any Object including null, no constraint to exclude null","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLdcInsn(Object):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:23:15.107228322Z"}
