{"id":"af542f82-188b-4080-a68b-b736d4cc574d","expr":"name != null && attributes != null && namespaceMapping != null","rationale":"The parameters are non-null to safely call methods on them.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#startElementInternal(QName,Attributes,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.210583533Z"}
{"id":"f45659a9-a506-4b32-af4a-6c4e62cb741f","expr":"name.getPrefix() != null","rationale":"Calling writeStartElement with a non-null prefix to avoid null behavior.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#startElementInternal(QName,Attributes,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.210583533Z"}
