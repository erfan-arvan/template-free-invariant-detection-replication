{"id":"549ccba6-d786-41ab-8006-a2686aea0415","expr":"clazz != null && methodName != null && (paramTypes == null || paramTypes.getClass().isArray())","rationale":"clazz and methodName are asserted to be non-null, paramTypes can be null or an array of Class<?>.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethod(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.318550956Z"}
