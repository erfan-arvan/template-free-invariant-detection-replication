{"id":"d37069b0-b464-4f17-929c-5e74e187939b","expr":"method.getModifiers() == method.getModifiers()","rationale":"method.getModifiers() returns a consistent integer value for the modifiers.","kind":"METHOD_EXIT","element":"org.springframework.cglib.proxy.MethodInterceptorGenerator#superHelper(CodeEmitter,MethodInfo,Context):void","file":"org/springframework/cglib/proxy/MethodInterceptorGenerator.java","createdAt":"2026-09-08T06:23:16.367763157Z"}
