{"id":"f9670c21-252f-48ee-b767-2c9cd17e7398","expr":"desc != null && desc.length() >= 1","rationale":"desc string is expected to be a valid field descriptor and thus non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:23:15.099205748Z"}
