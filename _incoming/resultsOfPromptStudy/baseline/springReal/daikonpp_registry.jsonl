{"id":"cf5ae421-b5cf-403b-9968-9d46834a8a69","expr":"name.length() > 0","rationale":"Name represents an identifier and must not be empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-08T06:23:15.074997700Z"}
