{"id":"1a332673-2b23-4bba-aaee-01ed4d4c4f93","expr":"opcode >= 0 && opcode <= 185","rationale":"Java bytecode opcodes have predefined integer values; opcode is expected to be in valid range.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.842634217Z"}
{"id":"7f9e91bb-f095-406c-893a-6c9ad1491e91","expr":"owner != null && !owner.isEmpty()","rationale":"owner string should be non-null and non-empty for valid method invocation.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.842634217Z"}
{"id":"31c10643-ede1-4a5b-bed5-8f7992141f2f","expr":"name != null && !name.isEmpty()","rationale":"Method name cannot be null or empty.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.842634217Z"}
