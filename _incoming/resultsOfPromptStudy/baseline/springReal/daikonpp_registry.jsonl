{"id":"d644634e-2c0b-4a0d-b913-be6d7da72545","expr":"descriptor != null && !descriptor.isEmpty()","rationale":"The descriptor defines method signature and is expected to be non-null and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.609956579Z"}
{"id":"c4aca28e-653f-47ed-87a4-717c10ffdefc","expr":"exceptions == null || (exceptions.length >= 0)","rationale":"Exceptions parameter may be null or an array of exception names, length cannot be negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.609956579Z"}
{"id":"86ec2065-c57d-4805-88a9-a5b247c38314","expr":"(signature == null) || (signature.length() > 0)","rationale":"Signature parameter can be null (absent) or a string with content.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.609956579Z"}
{"id":"92aff5bd-2cc9-4d2c-bebd-1b03c7ec4d8b","expr":"(access & 1) == 0 || (access & 1) == 1","rationale":"Access parameter is an int representing method access flags using bits.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.609956579Z"}
{"id":"e711ee5c-333e-49a3-afac-0af5d6602bdc","expr":"innerName == null || !innerName.isEmpty()","rationale":"Inner name, if present, should not be an empty string.","kind":"METHOD_EXIT","element":"org.springframework.asm.ClassVisitor#visitInnerClass(String,String,String,int):void","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.603127682Z"}
{"id":"2d6113c7-e995-4fa7-872b-b435f65a8b90","expr":"(outerName == null) || (!outerName.isEmpty())","rationale":"Outer class name can be null but if not, it should be non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitInnerClass(String,String,String,int):void","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.602774788Z"}
{"id":"c773d4e1-ce76-484a-be8d-0676b94e21ba","expr":"access >= 0","rationale":"Access flags are non-negative integer bit patterns.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitInnerClass(String,String,String,int):void","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.602774788Z"}
{"id":"91904ae0-7dac-4e36-a8aa-2b6fae87a26b","expr":"name.contains(\"$\") == (innerName != null)","rationale":"If the name contains a '$' character, it usually denotes an inner class, implying innerName is non-null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitInnerClass(String,String,String,int):void","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-08T06:23:17.602774788Z"}
{"id":"82a61b27-8d60-4fbb-a5da-db9538b81485","expr":"clazz != null","rationale":"Method expects a non-null Class<?> parameter.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getType(Class<?>):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.626730290Z"}
