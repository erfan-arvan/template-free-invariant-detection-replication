{"id":"a8142751-a6db-421b-b4aa-571f2b305738","expr":"result == null || result.isInterface() == method.getDeclaringClass().isInterface()","rationale":"Result method is either null or matches the interface status of the method's declaring class","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getInterfaceMethodIfPossible(Method):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.367334122Z"}
