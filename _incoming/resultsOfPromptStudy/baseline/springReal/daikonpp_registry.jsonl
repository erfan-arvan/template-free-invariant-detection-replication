{"id":"07d9a98e-5e0c-4dc3-a272-911e0c04bc16","expr":"constructor != null && constructor.getParameterCount() == constructor.getParameterTypes().length","rationale":"The number of parameters returned by getParameterCount matches the length of the array returned by getParameterTypes.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getConstructorDescriptor(Constructor<?>):String","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.721068445Z"}
