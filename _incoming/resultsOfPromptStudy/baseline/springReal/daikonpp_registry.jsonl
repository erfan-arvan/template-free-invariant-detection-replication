{"id":"9c866187-1ac9-4c53-b9fd-d18be1f93d46","expr":"props.size() > 0 || props.isEmpty()","rationale":"The properties object is either empty or has at least one entry after loading.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-08T06:23:11.931041099Z"}
{"id":"95ce1586-c0f3-400b-9885-c1b4845d85cd","expr":"resource != null","rationale":"The resource parameter must be non-null to be used to load properties.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-08T06:23:11.931041099Z"}
