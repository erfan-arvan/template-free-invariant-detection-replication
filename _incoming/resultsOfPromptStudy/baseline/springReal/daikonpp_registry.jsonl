{"id":"d5fc14b0-b9fa-4e86-8950-bae63d18f31f","expr":"index >= 0","rationale":"Index should be non-negative because it represents an attribute index.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractXMLStreamReader#getAttributeLocalName(int):String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-08T06:23:05.256536952Z"}
