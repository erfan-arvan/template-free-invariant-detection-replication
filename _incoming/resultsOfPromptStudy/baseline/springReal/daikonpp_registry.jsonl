{"id":"ba38f7e2-517d-4ae8-a58e-db9511794e3d","expr":"result == null || result.getName().equals(method.getName())","rationale":"Result method name matches input method name if result is not null","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getInterfaceMethodIfPossible(Method):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.367334122Z"}
