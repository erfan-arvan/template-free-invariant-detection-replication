{"id":"4cac98ba-1fb6-427b-ac7d-c4aabdbddc60","expr":"name != null","rationale":"Field name is generally expected to be non-null for reading fields.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#readObject(Object,String,Object):Object","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-08T06:23:15.046475349Z"}
