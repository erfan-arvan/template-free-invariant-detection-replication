{"id":"e1bfb6ed-2e5e-4064-b227-d2378e0a987f","expr":"superType != null","rationale":"superType should be non-null to represent the direct superclass type.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#begin_class(int,int,String,Type,Type[],String):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-08T06:23:15.004333186Z"}
{"id":"d3191322-1594-4834-9f7f-f5e336e18039","expr":"(superType != null) == true","rationale":"Assert non-null superType explicitly.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#begin_class(int,int,String,Type,Type[],String):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-08T06:23:15.004333186Z"}
{"id":"e2be4bea-9434-4984-80c3-35ae1db9d28e","expr":"version > 0","rationale":"Java class file version numbers are positive integers.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#begin_class(int,int,String,Type,Type[],String):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-08T06:23:15.004397648Z"}
{"id":"c93b935e-c513-4ebd-9c3d-2a43f4b3cb56","expr":"className != null && !className.isEmpty()","rationale":"A class name must be defined and non-empty for a valid class.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#begin_class(int,int,String,Type,Type[],String):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-08T06:23:15.004397648Z"}
{"id":"12370d69-4a15-428b-bdc9-27670c36cb76","expr":"name != null && !name.isEmpty()","rationale":"The name of the field being declared is expected to be a valid non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#declare_field(int,String,Type,Object):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-08T06:23:15.005234533Z"}
