{"id":"aac89a78-249a-4b2f-9f47-579dc59a07c1","expr":"name != null","rationale":"Standard practice is to pass a valid non-null name string.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.412230304Z"}
{"id":"8a436127-4003-4444-9145-cd3f6d3adcc0","expr":"name != null","rationale":"The parameter 'name' should not be null when the method exits, as it represents a valid entity name.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.411291697Z"}
{"id":"db481121-6e32-411d-8965-f0fa539ab8bf","expr":"name != null","rationale":"The parameter 'name' is expected to be non-null when startEntity is called.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.411002523Z"}
{"id":"ca39ea35-f786-47a4-a8bc-2a853844e10f","expr":"name != null && name.trim().length() > 0","rationale":"The 'name' parameter likely represents an entity name that must be meaningful.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.388330116Z"}
{"id":"e2452144-13a1-4b2a-93f7-3e8e0cea15a3","expr":"name.length() > 0","rationale":"The 'name' parameter is expected to be a non-empty string representing an entity name.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.411002523Z"}
{"id":"004fc791-4691-4459-9e2a-1f312bb5f465","expr":"name.length() > 0","rationale":"Entity names typically are non-empty strings.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.411291697Z"}
{"id":"2147cf0a-3f12-42b8-8779-d14b9a3b903c","expr":"name.length() > 0","rationale":"The method is intended to process a named entity; empty names are unlikely valid.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.412230304Z"}
{"id":"2e115ed1-ba5b-4c37-8630-37dfaa749592","expr":"ch.length > 0 || length == 0","rationale":"If length is positive, ch must contain characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.409761576Z"}
{"id":"b756a9ff-bc93-4856-a345-8bb186a1921b","expr":"prefix != null && uri != null","rationale":"Both prefix and uri should be non-null strings when startPrefixMapping is invoked.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.364630776Z"}
{"id":"1959aeca-74b3-4017-8b63-5abf74ab6ad4","expr":"!name.contains(\"/\")","rationale":"Symbolic or path separator characters are typically disallowed in entity names.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.412230304Z"}
{"id":"78d51003-2293-46ea-9fa9-abf9dfd11520","expr":"name.startsWith(\"&\") == false","rationale":"Entity names should not start with the '&' character indicating an entity reference.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.411291697Z"}
{"id":"53473a96-cb1d-4029-8747-b7ca8c9841d1","expr":"name.trim().equals(name)","rationale":"The 'name' parameter should not contain leading or trailing whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.411002523Z"}
{"id":"4a439bb1-e271-4c63-93bb-6e5532d33747","expr":"name == null || name.length() <= 100","rationale":"Entity names are expected to be reasonably short strings.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.388330116Z"}
{"id":"bf64d83f-33f2-49f9-b6ad-27c6e462ecea","expr":"name == null || !name.contains(\" \")","rationale":"The 'name' parameter, if present, likely does not contain whitespace characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.388330116Z"}
{"id":"f6b7f902-9571-479f-92fd-ee42743ef32e","expr":"name == null || Character.isLetterOrDigit(name.charAt(0))","rationale":"The first character of a non-null 'name' is expected to be alphanumeric.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.388330116Z"}
{"id":"65e8b377-fac1-4c9b-a121-bec2a88e182c","expr":"!name.contains(\" \")","rationale":"The 'name' parameter should not contain space characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.411002523Z"}
{"id":"51512a88-a78e-4fdb-a1de-61aae4c50062","expr":"name == null || !name.isEmpty()","rationale":"The parameter 'name' is either null or a non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.414941489Z"}
{"id":"ebda253f-b9c9-43c0-b63b-99c3fd66db06","expr":"ch != null && start >= 0 && length >= 0 && start + length <= ch.length","rationale":"The parameters start and length specify a valid substring within the char array ch.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.420155165Z"}
{"id":"54410421-1540-4b74-a240-d1571a6f2711","expr":"result.getNamespaceURI().equals(namespaceUri)","rationale":"The QName constructed always uses namespaceUri as its namespace URI.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.422524035Z"}
{"id":"cc04324c-18af-42ea-937c-a81727da55c3","expr":"qName != null && qName.getPrefix() != null && qName.getLocalPart() != null","rationale":"The method accesses qName.getPrefix() and qName.getLocalPart(), so qName and these fields should be non-null at entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#isNamespaceDeclaration(QName):boolean","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.424001336Z"}
