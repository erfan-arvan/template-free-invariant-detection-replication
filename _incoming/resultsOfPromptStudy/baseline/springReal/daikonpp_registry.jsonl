{"id":"7ee3c298-15ce-45ff-b31f-60d09e754acb","expr":"result.toString() != null","rationale":"The result's toString method returns a non-null string representation.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AnnotationVisitorTee#visitAnnotation(String,String):AnnotationVisitor","file":"org/springframework/cglib/transform/AnnotationVisitorTee.java","createdAt":"2026-09-08T06:23:15.052259389Z"}
{"id":"57faf685-f705-47e7-9ef1-db96269f215f","expr":"name != null && !name.isEmpty()","rationale":"Class names passed to loadClass should be valid non-empty strings.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassLoader#loadClass(String):Class","file":"org/springframework/cglib/transform/AbstractClassLoader.java","createdAt":"2026-09-08T06:23:15.055761483Z"}
