{"id":"05517fa3-2421-47cc-adc2-669789401fb0","expr":"(qualifiedName.indexOf(':') != -1) == (qualifiedName.contains(\":\"))","rationale":"The presence of ':' in qualifiedName determines the code path taken in this method","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.424414103Z"}
