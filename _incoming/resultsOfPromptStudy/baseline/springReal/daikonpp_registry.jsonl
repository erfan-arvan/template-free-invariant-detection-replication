{"id":"0e95986e-1437-4c30-915a-ee3340d82d07","expr":"dtd.trim().startsWith(\"<!\")","rationale":"The DTD string should start with the DTD declaration syntax.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#dtdInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.216050356Z"}
