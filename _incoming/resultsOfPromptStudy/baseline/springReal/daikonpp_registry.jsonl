{"id":"a65140e2-ca22-4a5b-bf07-8e6fe9dc30f1","expr":"result != null","rationale":"result is the returned AnnotationVisitor and is never null.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLocalVariableAnnotation(int,TypePath,Label[],Label[],int[],String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:23:17.341289545Z"}
