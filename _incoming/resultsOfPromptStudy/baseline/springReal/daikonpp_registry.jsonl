{"id":"30e59992-26fa-434a-972f-76832dd0cd76","expr":"fieldName != null && !fieldName.isEmpty()","rationale":"fieldName is expected to be a meaningful string representing a field.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.ToStringCreator#append(String,byte):ToStringCreator","file":"org/springframework/core/style/ToStringCreator.java","createdAt":"2026-09-08T06:23:09.588622465Z"}
