{"id":"dc74259e-3662-4e11-840e-0e357ccd9874","expr":"(access & 0xFFFF) >= 0","rationale":"access is an int representing access flags, typically non-negative in the valid range.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AddDelegateTransformer#begin_method(int,Signature,Type[]):CodeEmitter","file":"org/springframework/cglib/transform/impl/AddDelegateTransformer.java","createdAt":"2026-09-08T06:23:15.028161589Z"}
{"id":"79380954-a77d-4e06-adce-3de6c112a22e","expr":"exceptions.length >= 0","rationale":"exceptions array length is always zero or more.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AddDelegateTransformer#begin_method(int,Signature,Type[]):CodeEmitter","file":"org/springframework/cglib/transform/impl/AddDelegateTransformer.java","createdAt":"2026-09-08T06:23:15.028161589Z"}
