{"id":"a23c7a4c-aa6a-4b59-acce-51d10f79c845","expr":"(value == null) || (desc != null)","rationale":"Value presence implies desc is defined.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitField(int,String,String,String,Object):FieldVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-08T06:23:15.063835294Z"}
