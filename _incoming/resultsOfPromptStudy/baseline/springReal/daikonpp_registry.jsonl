{"id":"b60453fb-e836-4c60-b834-516ef32c8e7d","expr":"owner != null && !owner.isEmpty()","rationale":"The owner string typically represents an internal class name and should be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.842645188Z"}
{"id":"c6517642-d972-4b62-b437-61b09d9a8147","expr":"name != null && !name.isEmpty()","rationale":"The name string represents a method name and is expected to be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.842645188Z"}
{"id":"506a65c3-3df8-4066-b509-e0c7c263cdad","expr":"descriptor != null && !descriptor.isEmpty()","rationale":"The descriptor string encodes the method signature and is expected to be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.842645188Z"}
{"id":"e1d847c5-d82c-4e07-89d2-a3cbf88be858","expr":"opcode >= 0","rationale":"Opcode is a non-negative integer representing JVM bytecode instruction, so it should be >= 0.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.842645188Z"}
{"id":"3ea144ba-a500-4baf-9e70-642f9a49ef5f","expr":"opcode == (opcode & 0xFF)","rationale":"ASM opcodes are within byte range 0-255, so opcode fits in a byte.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.842645188Z"}
{"id":"0e7b1f25-0647-4d4e-8844-6dfb363b9026","expr":"!isInterface || opcode == 185","rationale":"When the method call is on an interface, the opcode should be INVOKEINTERFACE.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.847318497Z"}
{"id":"da8dec6c-e1f6-4ecf-b0a3-99f3a0d4a07d","expr":"opcode >= 0","rationale":"Opcode values are always non-negative integers.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.847318497Z"}
{"id":"c240b678-16b0-4a4e-92e8-3c91c9e6428e","expr":"owner != null","rationale":"The owner must not be null for a valid method call.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.847318497Z"}
{"id":"5f233d7d-e12c-4851-bcf6-64b1ca0b1569","expr":"name != null && descriptor != null","rationale":"Method name and descriptor must not be null for a valid method call.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.847318497Z"}
{"id":"5e19caef-ef5d-45fe-9411-3ebb7cb518e2","expr":"owner != null","rationale":"The owner argument must be non-null for correct method invocation.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.847797449Z"}
{"id":"345cd896-9e3b-49f6-8498-9ced08be06b8","expr":"name != null","rationale":"The method name string must be non-null for a method instruction.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.847797449Z"}
