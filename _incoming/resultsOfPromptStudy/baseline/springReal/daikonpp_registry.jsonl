{"id":"e23052d0-b194-464d-ab3c-57b368f77b75","expr":"prefix != null && uri != null && prefix.length() <= 100 && uri.length() <= 100","rationale":"The prefix and URI strings are expected to be reasonably sized.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.364630776Z"}
