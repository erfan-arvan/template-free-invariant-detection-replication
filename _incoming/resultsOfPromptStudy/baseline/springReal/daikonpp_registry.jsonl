{"id":"300af08a-a869-44ba-9e40-02f48cfc5461","expr":"access == (access & 0xFFFF)","rationale":"Access flags should be valid within an int bitmask range.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.UndeclaredThrowableTransformer#begin_method(int,Signature,Type[]):CodeEmitter","file":"org/springframework/cglib/transform/impl/UndeclaredThrowableTransformer.java","createdAt":"2026-09-08T06:23:15.049182146Z"}
