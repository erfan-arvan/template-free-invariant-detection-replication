{"id":"f7e4a3d9-ff74-41f1-9167-3c002a8d753e","expr":"clazz == null || clazz.getName() != null","rationale":"Java's Class.getName() is guaranteed to return a non-null string if clazz is not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method,Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.302456073Z"}
