{"id":"f7c6c890-f6d6-4845-8619-052216d6e9cf","expr":"(access & 0x0008) == 0","rationale":"If the field is non-static, addReadMethod or addWriteMethod could have been called.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#declare_field(int,String,Type,Object):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-08T06:23:15.005234533Z"}
{"id":"601c0ef7-17b9-42bd-b201-d38855adff1f","expr":"name != null && !name.isEmpty()","rationale":"The field name should be a valid identifier string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#declare_field(int,String,Type,Object):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-08T06:23:15.004666744Z"}
{"id":"cf28925f-4fef-4e55-a6db-3edd16bf9e95","expr":"type != null","rationale":"The field type must always be non-null to define the field.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#declare_field(int,String,Type,Object):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-08T06:23:15.004666744Z"}
