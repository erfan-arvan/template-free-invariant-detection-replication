{"id":"7d4669ef-db5d-4e8f-b245-a547fac49aa7","expr":"names.length >= 0","rationale":"Array length is always non-negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.FieldProviderTransformer#getByIndex(String[],int[]):void","file":"org/springframework/cglib/transform/impl/FieldProviderTransformer.java","createdAt":"2026-09-08T06:23:14.992486812Z"}
{"id":"fd211a02-8f07-4c5d-a19f-415f57a9a546","expr":"names != null && names.length > 0 && names[0] != null","rationale":"Names array is expected to be non-null and non-empty and individual elements non-null for the string switch to work.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.FieldProviderTransformer#getField(String[]):void","file":"org/springframework/cglib/transform/impl/FieldProviderTransformer.java","createdAt":"2026-09-08T06:23:14.996671591Z"}
