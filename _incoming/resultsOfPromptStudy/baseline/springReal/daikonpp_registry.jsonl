{"id":"e34a4f14-69a9-4bb4-bb55-d4e7855a0bf0","expr":"interfaceName != null || interfaceName == null","rationale":"interfaceName is a String parameter, so it can be either null or non-null.","kind":"METHOD_ENTRY","element":"org.springframework.core.type.filter.AbstractTypeHierarchyTraversingFilter#matchInterface(String):Boolean","file":"org/springframework/core/type/filter/AbstractTypeHierarchyTraversingFilter.java","createdAt":"2026-09-08T06:23:09.517667665Z"}
{"id":"1a17fedc-55b8-45da-ac8d-b721d594d944","expr":"interfaceName == null || interfaceName.length() >= 0","rationale":"A non-null String always has a non-negative length.","kind":"METHOD_ENTRY","element":"org.springframework.core.type.filter.AbstractTypeHierarchyTraversingFilter#matchInterface(String):Boolean","file":"org/springframework/core/type/filter/AbstractTypeHierarchyTraversingFilter.java","createdAt":"2026-09-08T06:23:09.517667665Z"}
{"id":"1db9d8d2-37af-4228-a3ba-b6033b3f0752","expr":"className != null && !className.isEmpty()","rationale":"Since the className is used immediately to get metadata, it is likely expected to be non-null and not empty.","kind":"METHOD_ENTRY","element":"org.springframework.core.type.filter.AbstractTypeHierarchyTraversingFilter#match(String,MetadataReaderFactory):boolean","file":"org/springframework/core/type/filter/AbstractTypeHierarchyTraversingFilter.java","createdAt":"2026-09-08T06:23:09.515592228Z"}
