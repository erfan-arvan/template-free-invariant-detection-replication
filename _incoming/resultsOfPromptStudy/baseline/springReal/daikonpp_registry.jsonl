{"id":"6f343fd4-2b15-4ace-807c-656af69ac678","expr":"attributes != null","rationale":"attributes parameter is non-null, allowing calls to attributes.getLength() and others.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#startElementInternal(QName,Attributes,Map<String, String>):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.200710064Z"}
