{"id":"79d23c4d-775f-422a-897a-935fd35827d9","expr":"startIndex >= 0","rationale":"The search index should be within the bounds of the string length and non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.PatternMatchUtils#indexOf(String,String,int,boolean):int","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-08T06:23:03.618021494Z"}
