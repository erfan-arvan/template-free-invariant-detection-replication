{"id":"57d586d1-cf29-4cbf-acd3-e18c544f1fd5","expr":"name.length() > 0","rationale":"Property names usually are non-empty strings.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractXMLReader#getProperty(String):Object","file":"org/springframework/util/xml/AbstractXMLReader.java","createdAt":"2026-09-08T06:23:05.455383120Z"}
{"id":"f48c6191-80e6-41e3-9135-b7e8b54fbb9b","expr":"!name.isEmpty()","rationale":"Non-empty string for property names.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractXMLReader#getProperty(String):Object","file":"org/springframework/util/xml/AbstractXMLReader.java","createdAt":"2026-09-08T06:23:05.455383120Z"}
