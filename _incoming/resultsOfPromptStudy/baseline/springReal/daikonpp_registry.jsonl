{"id":"b3004d93-b143-41a8-a712-1832d87cb444","expr":"dtd.length() > 10","rationale":"The DTD string length indicates a meaningful DTD content.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#dtdInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.216050356Z"}
{"id":"ab1ea106-cafd-4b28-b1b4-7875a5979053","expr":"dtd.indexOf('>') > 0","rationale":"The DTD string should contain '>' character as part of the markup syntax.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#dtdInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.216050356Z"}
{"id":"1fc2350d-a820-4dc1-abef-b3d7b5de44b4","expr":"name != null","rationale":"The method presumably processes an entity identified by 'name'; thus, 'name' should not be null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#startEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.240441499Z"}
{"id":"3765b9f6-14a6-4633-bea8-ba73a9403d1e","expr":"name.length() > 0","rationale":"Entity names are typically non-empty strings.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#startEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.240441499Z"}
{"id":"28cc47d9-6a57-4bd9-9947-582bbdca1a0b","expr":"!name.contains(\"\\0\")","rationale":"Null characters are invalid in XML entity names.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#startEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.240441499Z"}
{"id":"c3a69481-6200-4966-8f47-42081b6899a9","expr":"name.equals(name.trim())","rationale":"Entity names conventionally do not have surrounding whitespace.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#startEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.240441499Z"}
{"id":"8245a8b8-aaf6-4787-9bae-190cf84e7b9f","expr":"name != null","rationale":"Ensures that the entity name parameter is not null at method exit.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#endEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.241629275Z"}
{"id":"6eea753e-5ae1-4b90-9487-050396b4b510","expr":"!name.isEmpty()","rationale":"The entity name string is expected to be non-empty when the method returns.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#endEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.241629275Z"}
{"id":"014c7976-1d0b-4ed4-9753-3c0b570405f7","expr":"name != null","rationale":"The method parameter 'name' is likely required to be non-null as it represents an entity name to be skipped.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#skippedEntityInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.243844656Z"}
{"id":"02219121-9b20-4c6c-a3e0-8718875ce227","expr":"!name.isEmpty()","rationale":"The skipped entity name is expected to be a meaningful non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#skippedEntityInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.243844656Z"}
{"id":"81df6136-5789-44b1-938a-cb9db4ad87ba","expr":"name.trim().length() > 0","rationale":"The entity name should contain non-whitespace characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#skippedEntityInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.243844656Z"}
{"id":"9adc8a8f-4442-4237-9abb-e0855e0bbf30","expr":"Character.isLetter(name.charAt(0))","rationale":"Entity names conventionally start with a letter character.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#skippedEntityInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.243844656Z"}
{"id":"b01e0fa4-0625-4414-b98f-c32d50d5d4db","expr":"!name.contains(\" \")","rationale":"Entity names typically do not contain spaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#skippedEntityInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.243844656Z"}
{"id":"4513b0cb-99be-4305-acbf-15136722ad81","expr":"name != null","rationale":"The method likely expects a valid entity name, so 'name' should not be null at method exit.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#skippedEntityInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.244803972Z"}
