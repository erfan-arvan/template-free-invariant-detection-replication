{"id":"f002317e-a5a2-4f63-b4cb-94267c95952e","expr":"name != null && !name.isEmpty()","rationale":"The 'name' parameter should be non-null and not empty to represent a valid method name.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.848987740Z"}
{"id":"2e5b07b0-180d-49c8-bda7-7f3dc9117e98","expr":"descriptor != null && !descriptor.isEmpty()","rationale":"The 'descriptor' parameter should be a non-null, non-empty string describing the method signature.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.848987740Z"}
{"id":"19589d90-5ca7-4184-9393-2e03773033c2","expr":"bootstrapMethodHandle != null","rationale":"The bootstrap method handle cannot be null as it is mandatory for invoke dynamic instructions.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.848987740Z"}
{"id":"c85ee684-14a4-4894-b379-65a86f9d6f95","expr":"bootstrapMethodArguments == null || bootstrapMethodArguments.getClass().isArray()","rationale":"The bootstrapMethodArguments parameter is either null or an array of objects, consistent with its varargs nature.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.848987740Z"}
{"id":"f7971b80-3453-4d01-867d-4990f1635449","expr":"name != null && !name.isEmpty()","rationale":"The 'name' parameter for the invokedynamic instruction is typically a non-null, non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.849807934Z"}
{"id":"9ebe844c-f3a8-4067-ac75-98b56c744de9","expr":"descriptor != null && !descriptor.isEmpty()","rationale":"The 'descriptor' parameter is a method descriptor and thus should be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.849807934Z"}
{"id":"1947bb0e-4c09-4c07-9c0c-264a7119937d","expr":"bootstrapMethodHandle != null","rationale":"A non-null bootstrapMethodHandle represents the bootstrap method used for the invokedynamic call.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.849807934Z"}
{"id":"6adcf62f-cbae-48ef-8f60-c7895231aa1c","expr":"bootstrapMethodArguments != null","rationale":"The varargs array bootstrapMethodArguments is never null when passed to the method.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.849807934Z"}
{"id":"2e55b35c-445c-4be8-a3d6-162ba9d2be37","expr":"label != null","rationale":"The label parameter is used in the method call and thus should not be null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitJumpInsn(int,Label):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.850190384Z"}
{"id":"28501540-e07a-474a-a2c6-b89a1772f8ee","expr":"opcode >= 0","rationale":"In ASM, opcode values are typically non-negative integers.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitJumpInsn(int,Label):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-08T06:23:19.850190384Z"}
