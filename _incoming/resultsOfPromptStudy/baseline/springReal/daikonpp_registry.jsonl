{"id":"e4e98f72-a8e8-47bf-834a-361803c9f63b","expr":"data == null || data.length() >= 0","rationale":"Basic property that string length is non-negative if it exists.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeComment(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-08T06:23:05.171550664Z"}
