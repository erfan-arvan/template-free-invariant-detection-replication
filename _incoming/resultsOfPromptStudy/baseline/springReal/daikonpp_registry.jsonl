{"id":"4bd9bcf6-fc73-4dbc-921b-d1983bed7631","expr":"start != null && end != null && handler != null && (type == null || !type.isEmpty())","rationale":"start, end, handler Label references are expected to be non-null; type can be null or non-empty string if given.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:23:17.312062468Z"}
