{"id":"3fc22aa0-fc6e-4139-a71e-179d02913c17","expr":"resource != null && resource.getInputStream() != null","rationale":"Resource.getInputStream() returns an InputStream if resource is readable.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-08T06:23:11.926516280Z"}
{"id":"8ffb4ccb-4aad-45d5-b2c2-3488b9fa82e6","expr":"props != null && !props.isEmpty()","rationale":"After filling properties, props should contain at least some entries assuming resource provides properties.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,EncodedResource):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-08T06:23:11.926884814Z"}
