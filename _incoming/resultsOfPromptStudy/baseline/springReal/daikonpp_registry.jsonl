{"id":"c86af41d-9bbe-4350-a8a4-4df6daa68de2","expr":"descriptor != null","rationale":"Method expects a valid descriptor string.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:23:17.270810631Z"}
{"id":"90ee0d99-3c76-4ec4-81d4-55b47d2cfc21","expr":"descriptor.startsWith(\"[\")","rationale":"MultiANewArray instructions target array types whose descriptor starts with '['.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-08T06:23:17.270810631Z"}
