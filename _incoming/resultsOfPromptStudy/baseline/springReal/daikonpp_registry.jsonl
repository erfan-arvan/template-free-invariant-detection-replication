{"id":"95968e23-5b23-4184-9823-94d33adaea5b","expr":"paramTypes == null || paramTypes.getClass().isArray()","rationale":"paramTypes, if not null, is expected to be an array of Class<?> representing method parameter types.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethodIfAvailable(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.321834237Z"}
{"id":"a7e18552-e7a1-4440-a6ab-927c1112a243","expr":"clazz.isAssignableFrom(clazz)","rationale":"As a Class object, clazz should be assignable from itself.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethodIfAvailable(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.321834237Z"}
