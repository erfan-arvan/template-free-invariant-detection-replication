{"id":"05723d5a-3c07-4f19-95ff-449b2dab3d4d","expr":"!result.contains(\"$\")","rationale":"Nested class separators ('$') are replaced by package separators ('.') in result, so result does not contain '$'.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getShortName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.170576376Z"}
