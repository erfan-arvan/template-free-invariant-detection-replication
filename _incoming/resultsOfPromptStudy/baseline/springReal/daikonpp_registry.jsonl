{"id":"de34ab2f-4186-4ac5-a19e-4df6eb4e15f8","expr":"paramTypes.length >= 0","rationale":"paramTypes array length is always zero or positive as per Java array semantics.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getConstructorIfAvailable(Class<T>,Class<?>):Constructor<T>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.287253460Z"}
