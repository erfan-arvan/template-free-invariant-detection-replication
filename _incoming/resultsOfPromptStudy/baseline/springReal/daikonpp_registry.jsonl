{"id":"c4c7e03f-7c8c-4148-a958-854cbc79c0e1","expr":"!result.isArray()","rationale":"The element type returned must not be an array type.","kind":"METHOD_EXIT","element":"org.springframework.asm.Type#getElementType():Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.642947302Z"}
{"id":"2a521771-3402-4ec9-b3bd-05105f1b0791","expr":"internalName != null && internalName.length() > 0","rationale":"The method calls internalName.charAt(0) which requires internalName to be non-null and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getObjectType(String):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.643481268Z"}
{"id":"e74a56a0-1190-4154-b213-156ed43ff7f4","expr":"internalName.charAt(0) == '[' || internalName.charAt(0) != '['","rationale":"The first character of internalName is significant in determining the Type kind.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getObjectType(String):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.643481268Z"}
