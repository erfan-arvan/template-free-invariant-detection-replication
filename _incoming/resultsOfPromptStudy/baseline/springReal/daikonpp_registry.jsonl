{"id":"dde9065c-82fc-4da0-ad62-8af283bd66f9","expr":"name != null || obj == null","rationale":"name is likely intended to be non-null, but obj being null could allow name to be null safely.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeInt(Object,String,int,int):int","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-08T06:23:15.029326412Z"}
{"id":"bf8dea16-4f1e-441d-8d18-f7f9be660325","expr":"oldValue != newValue || true","rationale":"No direct relation enforced between oldValue and newValue, so they can be equal or different.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeInt(Object,String,int,int):int","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-08T06:23:15.029326412Z"}
{"id":"84a61b44-4b16-468b-8335-46da8f5d86d8","expr":"obj != null || name == null","rationale":"Possible conjunction of nullness states between obj and name.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AbstractInterceptFieldCallback#writeInt(Object,String,int,int):int","file":"org/springframework/cglib/transform/impl/AbstractInterceptFieldCallback.java","createdAt":"2026-09-08T06:23:15.029326412Z"}
{"id":"e8369382-c9c7-47b7-ad6a-51e562939cd4","expr":"name != null && !name.isEmpty()","rationale":"Field name is expected to be a valid non-empty string used for method generation.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.AccessFieldTransformer#declare_field(int,String,Type,Object):void","file":"org/springframework/cglib/transform/impl/AccessFieldTransformer.java","createdAt":"2026-09-08T06:23:15.030280949Z"}
