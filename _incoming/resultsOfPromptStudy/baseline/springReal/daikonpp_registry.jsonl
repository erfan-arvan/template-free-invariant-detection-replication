{"id":"003b2504-f7dd-47b8-8c04-bfaff2978e71","expr":"result.getSize() >= 0","rationale":"The size of the returned annotations collection is at least zero.","kind":"METHOD_EXIT","element":"org.springframework.core.type.StandardAnnotationMetadata#getAnnotations():MergedAnnotations","file":"org/springframework/core/type/StandardAnnotationMetadata.java","createdAt":"2026-09-08T06:23:09.531594927Z"}
{"id":"0ceeb21e-9257-4025-b69c-5838f9166955","expr":"annotationName != null","rationale":"annotationName is the name of the annotation to obtain; typically it must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.core.type.StandardAnnotationMetadata#getAnnotationAttributes(String,boolean):Map<String, @Nullable Object>","file":"org/springframework/core/type/StandardAnnotationMetadata.java","createdAt":"2026-09-08T06:23:09.531974211Z"}
