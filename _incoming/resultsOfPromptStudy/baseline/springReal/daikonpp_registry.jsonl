{"id":"bce7fde4-eb95-4d14-a583-5177ba19f89e","expr":"clazz.isArray() == (clazz.getName().charAt(0) == '[')","rationale":"Descriptor representation for array types corresponds to classes whose names start with '['.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getDescriptor(Class<?>):String","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.708881530Z"}
{"id":"880b7c3d-e276-4cda-8a1f-3689c34110a0","expr":"clazz.isPrimitive() || clazz.isArray() || !clazz.isPrimitive()","rationale":"The clazz variable is a Java Type class instance which can be primitive, array, or reference.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getDescriptor(Class<?>):String","file":"org/springframework/asm/Type.java","createdAt":"2026-09-08T06:23:17.708881530Z"}
