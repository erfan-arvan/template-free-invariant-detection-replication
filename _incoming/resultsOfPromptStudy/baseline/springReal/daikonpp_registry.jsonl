{"id":"397b2b1c-a3af-416f-b5d5-ba006b797885","expr":"result.getDeclaringClass().isAssignableFrom(clazz)","rationale":"The returned Method is declared by the class or its superclass represented by clazz.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getMethod(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.320884379Z"}
{"id":"6803fa14-5f68-49de-99d7-6c973e9e6af8","expr":"clazz.isAssignableFrom(result.getDeclaringClass()) || result.getDeclaringClass().equals(clazz)","rationale":"The Method's declaring class is related to clazz via assignability or equality.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getMethod(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.320884379Z"}
