{"id":"68ab7124-e62c-4643-bf0c-d20b9690547c","expr":"var <= 65535","rationale":"Var index fits into a 16-bit unsigned limit (max 65535).","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitVarInsn(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:23:15.098479490Z"}
{"id":"c52b3805-7da5-408b-b882-ca80a854c7f6","expr":"!desc.contains(\" \")","rationale":"Internal names do not contain spaces, so desc should not contain any space characters.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTypeInsn(int,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:23:15.098834288Z"}
