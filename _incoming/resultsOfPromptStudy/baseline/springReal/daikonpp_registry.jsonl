{"id":"4d2daac2-b248-4a39-a4f7-e2380aa5344c","expr":"keys.length >= 0","rationale":"Keys array length is non-negative, an invariant for any arrays.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:23:15.112745089Z"}
{"id":"1f3d0a05-2ef4-4994-be35-581916a7a2d1","expr":"labels.length >= 0","rationale":"Labels array length is non-negative, an invariant for any arrays.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:23:15.112745089Z"}
