{"id":"fe589723-4e9a-4f6e-95f0-e35bc401b14d","expr":"!name.isEmpty()","rationale":"The property name string must be non-empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractXMLReader#setProperty(String,Object):void","file":"org/springframework/util/xml/AbstractXMLReader.java","createdAt":"2026-09-08T06:23:05.463861793Z"}
