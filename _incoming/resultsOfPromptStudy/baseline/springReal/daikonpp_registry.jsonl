{"id":"3815d619-452b-4f4c-8258-f0422fbb6179","expr":"comment == null || comment.length() >= 0","rationale":"If comment is not null, its length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#commentInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.226319731Z"}
{"id":"0774e54a-b9dd-4052-aefd-bab4a54d4c68","expr":"comment == null || !comment.contains(\"--\")","rationale":"If comment is not null, it does not contain invalid XML comment delimiter '--'.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#commentInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.226319731Z"}
{"id":"705130e4-965e-4630-8626-d2c9a1b16f48","expr":"comment == null || !comment.endsWith(\"-\")","rationale":"If comment is not null, it does not end with a single hyphen character.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#commentInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.226319731Z"}
{"id":"ec4794f1-21b1-4ab0-b635-d2e36d6b082e","expr":"comment == null || comment.trim().length() == comment.length()","rationale":"If comment is not null, it has no leading or trailing whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#commentInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.226319731Z"}
{"id":"e56213b6-993a-47d1-bd46-fc1c52a9646c","expr":"name.length() <= 255","rationale":"Entity names are generally restricted in length, often to 255 characters or fewer.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#startEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-08T06:23:05.234580985Z"}
{"id":"edd318e8-a312-4585-a433-cd175d11f5b6","expr":"result != null","rationale":"The returned string from StringBuilder.toString() is never null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractXMLStreamReader#getElementText():String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-08T06:23:05.250420467Z"}
{"id":"988a95b0-e928-421f-aead-2d1d431bf3a1","expr":"result.length() >= 0","rationale":"String length is always non-negative.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractXMLStreamReader#getElementText():String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-08T06:23:05.250420467Z"}
