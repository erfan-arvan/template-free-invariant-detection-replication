{"id":"de20898b-4b40-4fcc-9d92-16a5945daba3","expr":"!name.contains(\" \")","rationale":"Entity names usually do not contain spaces.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.411291697Z"}
{"id":"5904ed27-68c4-4ef3-ae1f-edd886a77da1","expr":"name.equals(name.trim())","rationale":"Trimming whitespace is standard to ensure valid entity names.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-08T06:23:05.412230304Z"}
