{"id":"f24579c9-b569-42f9-b73d-972b4a44b917","expr":"!methodName.isEmpty()","rationale":"methodName is expected to be a valid method identifier.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethod(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.318550956Z"}
{"id":"87fb1c32-ae44-43ed-bdad-c546e4a03330","expr":"paramTypes == null || (paramTypes.length >= 0)","rationale":"If paramTypes is not null, it is an array with non-negative length.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getMethod(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.318550956Z"}
{"id":"e366d844-f967-44e2-83a3-78fae0e4427a","expr":"result != null","rationale":"The method is guaranteed to return a Method object if it successfully returns; otherwise, it throws an exception.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getMethod(Class<?>,String,Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-08T06:23:08.320884379Z"}
