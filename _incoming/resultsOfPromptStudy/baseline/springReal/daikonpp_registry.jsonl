{"id":"900da8a7-b3ec-4811-9103-a35c0a1cfcca","expr":"names != null && indexes != null && names.length == indexes.length","rationale":"Common pattern when using paired arrays to map names to indexes is equal length","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.impl.FieldProviderTransformer#setByIndex(String[],int[]):void","file":"org/springframework/cglib/transform/impl/FieldProviderTransformer.java","createdAt":"2026-09-08T06:23:14.981883268Z"}
