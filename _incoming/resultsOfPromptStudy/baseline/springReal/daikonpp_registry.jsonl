{"id":"7d6874cb-2d64-49a5-8545-8c62365ef547","expr":"desc.startsWith(\"[\")","rationale":"desc is a valid array descriptor string which starts with '['.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-08T06:23:15.112777179Z"}
