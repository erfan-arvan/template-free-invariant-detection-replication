{"id":"1beac875-6ff0-4adb-b5c7-0bed89dcb67d","expr":"result != null","rationale":"Method returns a byte array even in edge cases (e.g. empty input).","kind":"METHOD_EXIT","element":"io.netty.util.internal.StringUtil#decodeHexDump(CharSequence,int,int):byte[]","file":"io/netty/util/internal/StringUtil.java","createdAt":"2026-08-31T05:08:39.953719938Z"}
