{"id":"a91608ee-94e7-445c-855e-11a17d33d349","expr":"(bootstrapMethodArguments == null) || (bootstrapMethodArguments.length >= 0)","rationale":"If bootstrapMethodArguments is provided, its length must be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:32.138092088Z"}
{"id":"1e9b283c-aaee-4184-b3fe-9474d7229855","expr":"owner != null && !owner.isEmpty()","rationale":"The method owner string should represent the internal class name, which cannot be null or empty.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:32.415351799Z"}
{"id":"a86130d6-37c8-4098-acf5-141d85b83c78","expr":"name != null && !name.isEmpty()","rationale":"A method instruction requires a non-null, non-empty method name.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:32.415351799Z"}
{"id":"2b1c778f-941b-46d2-bc53-27edba1fde08","expr":"descriptor != null && descriptor.startsWith(\"(\") && descriptor.endsWith(\")\") == false","rationale":"A valid method descriptor starts with '(' and describes argument and return types.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:32.415351799Z"}
{"id":"71f5aa08-b438-4180-a73a-a469afb4b3fc","expr":"owner != null && name != null && descriptor != null","rationale":"Method invocation instructions should have non-null owner, method name and descriptor.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:32.526333707Z"}
