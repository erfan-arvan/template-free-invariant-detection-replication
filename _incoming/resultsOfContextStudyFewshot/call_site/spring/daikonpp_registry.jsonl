{"id":"52005d6b-15c7-42c0-a79d-22f772d25921","expr":"!type.isArray() || (type.getComponentType() != null)","rationale":"Ensures array types have valid component types.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#writeCallbackSig(Type):Signature","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-10T16:25:48.641431735Z"}
{"id":"4a58bdb5-7261-4c7b-987a-7ab284e160e4","expr":"type.isPrimitive() || (!type.isPrimitive())","rationale":"Type instance is either primitive or not; representing mutually exclusive states.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#writeCallbackSig(Type):Signature","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-10T16:25:48.641431735Z"}
{"id":"ff92d1a8-4fd3-44a3-9d01-cc59f35ab514","expr":"type.getDescriptor() != null","rationale":"Type descriptor is necessary for the writeMethodSig call at call-site.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#writeCallbackSig(Type):Signature","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-10T16:25:48.641431735Z"}
