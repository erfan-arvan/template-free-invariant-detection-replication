{"id":"16fd13a3-f8dc-464a-b768-ca79e44654e2","expr":"ex.getMessage() != null","rationale":"The exception should have a message describing the error.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.SimpleTransformErrorListener#fatalError(TransformerException):void","file":"org/springframework/util/xml/SimpleTransformErrorListener.java","createdAt":"2026-09-10T16:13:03.541061565Z"}
