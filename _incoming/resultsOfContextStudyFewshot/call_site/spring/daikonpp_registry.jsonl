{"id":"6b3ea3ba-e7ff-4ad8-a96a-1669afca7dee","expr":"labels.length == max - min + 1","rationale":"The labels array should have one label for each possible key value between min and max inclusive.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T16:26:03.089217036Z"}
{"id":"2e878f00-60bc-470d-b6d7-ab2a5d30b2c1","expr":"dflt != null","rationale":"The default label for the switch instruction is expected to be non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T16:26:03.089217036Z"}
{"id":"5c6fe96a-9ce9-425b-89c3-dd2a3a3f71e5","expr":"max >= min","rationale":"The switch range must have max greater or equal to min for valid table switch","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T16:26:03.089237795Z"}
{"id":"aabe950b-2e47-4e7b-97e2-322cdc706fcd","expr":"labels != null","rationale":"The labels array parameter should not be null to properly dispatch switch cases","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T16:26:03.089237795Z"}
{"id":"6218e380-66da-43a3-9df3-46837e6742d3","expr":"labels.length == max - min + 1","rationale":"The number of labels must be exactly max-min+1 to cover all switch keys in the range","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T16:26:03.089237795Z"}
{"id":"a3783a26-cdc0-486f-964b-409c73aa0e39","expr":"dflt != null","rationale":"A default label must always be provided","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTableSwitchInsn(int,int,Label,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T16:26:03.089237795Z"}
{"id":"9221cc9d-a44b-4e9a-9093-ae188a668021","expr":"keys != null && labels != null && keys.length == labels.length","rationale":"The arrays keys and labels must be non-null and have equal length to represent the switch cases properly.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T16:26:03.095896987Z"}
