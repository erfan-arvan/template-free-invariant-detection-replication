{"id":"6a933186-ef58-4b24-b3ef-952ec59cb7c9","expr":"!((opcode < 46) && (opcode != 0 && opcode != 1 && opcode != 2 && opcode != 3 && opcode != 4 && opcode != 5))","rationale":"If opcode is less than 46, it must be one of the defined constant instructions (like NOP or ICONST_0).","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitInsn(int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:17.918875670Z"}
{"id":"6f10063b-52b3-491e-8610-b079773a1752","expr":"opcode >= 0 && operand >= Short.MIN_VALUE && operand <= Short.MAX_VALUE","rationale":"Opcode is a valid non-negative integer and operand fits within short range at call time.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitIntInsn(int,int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:20.428464334Z"}
{"id":"807e9798-ba4d-415e-8783-80dcc9b7f950","expr":"parameterCount >= 0","rationale":"The count of parameters that can have annotations must be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitAnnotableParameterCount(int,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:21.991748131Z"}
