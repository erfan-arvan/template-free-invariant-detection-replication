{"id":"9f5315e1-5e81-462c-ba36-983e38a17c7f","expr":"end.bytecodeOffset > start.bytecodeOffset","rationale":"The local variable's scope should have a positive length; end offset must come after start offset.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T16:32:57.883205268Z"}
{"id":"d46d8663-d859-414b-8010-66d12a66a943","expr":"descriptor.length() > 0","rationale":"The type descriptor of the local variable should be a valid non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T16:32:57.883205268Z"}
