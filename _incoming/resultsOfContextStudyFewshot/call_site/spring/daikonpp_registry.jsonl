{"id":"94934df0-c3d6-435a-ae90-2d9456e3da7d","expr":"fieldName != null","rationale":"fieldName is expected to identify the field; null would be meaningless or cause errors.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.ToStringCreator#append(String,long):ToStringCreator","file":"org/springframework/core/style/ToStringCreator.java","createdAt":"2026-09-10T16:16:41.378621936Z"}
