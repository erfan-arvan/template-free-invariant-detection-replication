{"id":"7adec9cf-5302-4aec-9651-0ed44cc544b8","expr":"operand >= Byte.MIN_VALUE && operand <= Short.MAX_VALUE","rationale":"The operand is always within the range of byte to short inclusive as per call sites.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitIntInsn(int,int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:22.769815918Z"}
{"id":"b1085b3a-4399-47d7-b2b3-2f8bfdf0f22c","expr":"opcode >= 0","rationale":"opcode is an unsigned byte value in range 0 to 255, so it is >= 0","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitVarInsn(int,int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:23.470697797Z"}
{"id":"00e5ccad-88a9-42f9-b93f-5b4f8ca9c8df","expr":"0 <= varIndex","rationale":"varIndex is the index of local variable and must be non-negative","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitVarInsn(int,int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:23.470697797Z"}
{"id":"17248cad-45d2-4b70-b0dd-b570e064dd59","expr":"varIndex <= 65535","rationale":"varIndex is usually within unsigned short range due to JVM bytecode constraints","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitVarInsn(int,int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:23.470697797Z"}
{"id":"65548271-f773-4658-b48f-608a9fef3694","expr":"opcode != -1","rationale":"opcode at method entry cannot be the sentinel invalid value -1","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitVarInsn(int,int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:23.470697797Z"}
