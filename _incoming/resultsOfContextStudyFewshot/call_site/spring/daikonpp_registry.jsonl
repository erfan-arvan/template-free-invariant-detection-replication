{"id":"e0d518ec-010e-4f66-a940-7e74ca5b9d48","expr":"method != null","rationale":"The method parameter must not be null for the method to execute properly, consistent with Assert.notNull","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isUserLevelMethod(Method):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T16:15:20.753132196Z"}
