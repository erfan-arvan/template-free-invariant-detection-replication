{"id":"850b0265-c076-4d46-9ee4-ceaef8b09fea","expr":"!result.equals(null)","rationale":"Result should never be equal to null.","kind":"METHOD_EXIT","element":"org.springframework.core.style.ToStringCreator#append(String,boolean):ToStringCreator","file":"org/springframework/core/style/ToStringCreator.java","createdAt":"2026-09-10T16:16:41.409604760Z"}
{"id":"e4d04c95-1d59-4a52-88ab-a0ee8d358b1d","expr":"fieldName == null || fieldName.length() > 0","rationale":"If the field name is not null, it should be a non-empty string, because empty field names would be unusual in describing object fields.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.ToStringCreator#append(String,Object):ToStringCreator","file":"org/springframework/core/style/ToStringCreator.java","createdAt":"2026-09-10T16:16:41.413656954Z"}
