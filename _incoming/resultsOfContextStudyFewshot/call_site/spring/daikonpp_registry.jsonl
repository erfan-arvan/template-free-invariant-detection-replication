{"id":"d638af5e-c449-4ada-98aa-fafa0e7d57bd","expr":"result || !(sourceType.getElementTypeDescriptor() != null && targetType.getElementTypeDescriptor() != null)","rationale":"If either element type descriptor is missing, the method returns false.","kind":"METHOD_EXIT","element":"org.springframework.core.convert.support.CollectionToCollectionConverter#matches(TypeDescriptor,TypeDescriptor):boolean","file":"org/springframework/core/convert/support/CollectionToCollectionConverter.java","createdAt":"2026-09-10T16:22:25.233987354Z"}
