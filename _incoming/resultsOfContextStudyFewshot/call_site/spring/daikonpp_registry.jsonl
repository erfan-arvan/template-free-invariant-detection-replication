{"id":"53ce7b39-9d7f-4d63-820d-c3ad5d7caefc","expr":"name != null","rationale":"The name parameter is required and used for generating getter/setter method names.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.AccessFieldTransformer#declare_field(int,String,Type,Object):void","file":"org/springframework/cglib/transform/impl/AccessFieldTransformer.java","createdAt":"2026-09-10T16:25:51.611973736Z"}
