{"id":"c3024924-2531-4fc0-a1b7-fe5b049eee51","expr":"result == null || (result.length >= 0)","rationale":"Array length must be non-negative if the array is non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.proxy.MixinEmitter#getInterfaces(Class[]):Class[]","file":"org/springframework/cglib/proxy/MixinEmitter.java","createdAt":"2026-09-10T16:30:18.739909834Z"}
