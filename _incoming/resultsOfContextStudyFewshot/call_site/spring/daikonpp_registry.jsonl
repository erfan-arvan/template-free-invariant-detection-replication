{"id":"c3e756d2-9e37-42cb-8161-c6c3ef209096","expr":"typePath == null || typePath.getLength() >= 0","rationale":"If typePath is not null, its length must be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitLocalVariableAnnotation(int,TypePath,Label[],Label[],int[],String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T16:32:57.006730778Z"}
