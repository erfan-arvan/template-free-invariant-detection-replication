{"id":"73b59c76-3704-410d-8aa2-5cc81090c66e","expr":"line >= 0","rationale":"The 'line' parameter represents a source code line number, which should be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitLineNumber(int,Label):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T16:33:01.215341381Z"}
