{"id":"ff24e3a7-bc84-4ca8-9240-be5e84f0de22","expr":"namespaceUri != \"\"","rationale":"Empty string is generally not considered a valid namespace URI.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.SimpleNamespaceContext#getPrefixesSet(String):Set<String>","file":"org/springframework/util/xml/SimpleNamespaceContext.java","createdAt":"2026-09-10T16:13:02.885468548Z"}
