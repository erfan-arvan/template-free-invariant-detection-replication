{"id":"6403db0c-1b6a-4ea9-b13d-c0e7fcc4dd03","expr":"returnType != null","rationale":"The returnType parameter must not be null to generate a valid method descriptor.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getMethodType(Type,Type):Type","file":"org/springframework/asm/Type.java","createdAt":"2026-09-10T16:34:00.122783712Z"}
