{"id":"70a570f5-e14d-4dd2-8ae0-1a7c5f0e6c7f","expr":"name != null && !name.isEmpty()","rationale":"The field name must be provided and cannot be empty in a putstatic call.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#putstatic(Type,String,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-10T16:28:18.432700658Z"}
{"id":"c1d5b9f7-b431-4948-94e3-c14947c404fd","expr":"type != null","rationale":"The field type parameter must be non-null indicating the type of the field for putstatic.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#putstatic(Type,String,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-10T16:28:18.432700658Z"}
{"id":"8039794e-58e2-4113-b48c-2d804eab2241","expr":"owner.getSort() != 0","rationale":"Owner type must represent a valid JVM type. getSort() returns type sort; 0 often means invalid or VOID.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#putstatic(Type,String,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-10T16:28:18.432700658Z"}
{"id":"e97cb4bc-ea12-422c-96c4-dad10044c70e","expr":"type.getSort() != 0","rationale":"Type parameter must represent a valid JVM type rather than void or invalid.","kind":"METHOD_EXIT","element":"org.springframework.cglib.core.CodeEmitter#putstatic(Type,String,Type):void","file":"org/springframework/cglib/core/CodeEmitter.java","createdAt":"2026-09-10T16:28:18.432700658Z"}
