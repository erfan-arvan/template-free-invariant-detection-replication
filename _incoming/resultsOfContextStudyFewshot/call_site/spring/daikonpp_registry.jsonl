{"id":"30382261-74e0-4267-8cdd-218e7a24a081","expr":"fieldName != null && !fieldName.isEmpty() || fieldName == null || fieldName.isEmpty()","rationale":"fieldName may be any String, possibly null or empty; reflecting its state.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.ToStringCreator#append(String,double):ToStringCreator","file":"org/springframework/core/style/ToStringCreator.java","createdAt":"2026-09-10T16:16:41.396972311Z"}
