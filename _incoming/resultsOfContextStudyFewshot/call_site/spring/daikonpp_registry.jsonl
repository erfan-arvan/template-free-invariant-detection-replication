{"id":"789d306e-c870-4c72-8cc2-5787322fa385","expr":"(interfaces.length >= 0)","rationale":"Interfaces array length is always zero or more.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#begin_class(int,int,String,Type,Type[],String):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-10T16:25:36.284768911Z"}
