{"id":"d764c1d5-3d8e-4485-8b0d-33fef1329ade","expr":"increment != 0 || increment == 0","rationale":"Increment can be any int, no constraints.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitIincInsn(int,int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T16:40:42.247088756Z"}
