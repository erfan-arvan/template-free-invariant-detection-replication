{"id":"47b4ddd0-8f93-4ac8-a182-27671bc642be","expr":"desc != null","rationale":"desc is passed to two method calls and therefore should not be null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T16:26:03.099966122Z"}
