{"id":"08e523d4-fecf-41ad-bb56-8f6f0c650bca","expr":"labels != null","rationale":"labels array must be non-null to represent switch target labels","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T16:26:03.096306920Z"}
{"id":"ab2c9c62-6421-412b-aa41-bcebdee7f4b0","expr":"keys.length == labels.length","rationale":"Each key corresponds to a label in lookup switch","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLookupSwitchInsn(Label,int[],Label[]):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T16:26:03.096306920Z"}
