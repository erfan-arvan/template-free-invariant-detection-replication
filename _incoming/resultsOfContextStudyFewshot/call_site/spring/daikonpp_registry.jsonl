{"id":"fae2b172-1ffe-4a91-93d6-179cdd699cd0","expr":"name != null","rationale":"The name parameter is non-null to be used to generate method signatures and access field.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#addReadMethod(String,Type):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-10T16:25:39.887555739Z"}
