{"id":"447c0e9a-031a-4b10-9ead-09f231d06278","expr":"nestMember != null && !nestMember.isEmpty() || nestMember == null || nestMember.isEmpty() == false","rationale":"nestMember should be a valid internal name and likely non-null and non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitNestMember(String):void","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-10T16:33:45.709867131Z"}
