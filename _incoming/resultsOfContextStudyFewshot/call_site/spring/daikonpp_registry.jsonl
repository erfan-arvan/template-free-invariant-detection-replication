{"id":"6c217d99-6c14-4024-9d77-f26f4d008fec","expr":"type != null","rationale":"The parameter is assumed to be non-null for safe evaluation.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#callbackName(Type):String","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-10T16:25:50.993281002Z"}
