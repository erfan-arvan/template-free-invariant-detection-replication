{"id":"c1985c39-a07b-4462-882a-a5b9a7598199","expr":"result == null || !returnType.isArray() || (result.getClass().isArray() && returnType.getComponentType().isAssignableFrom(result.getClass().getComponentType()))","rationale":"The method should return an empty array or null for array types.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-15T12:14:16.467165300Z"}
{"id":"a15994a7-4131-420d-8085-d5b54b98f2cf","expr":"returnType != null","rationale":"The method returns early if returnType is null, so it's generally non-null at entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-15T12:14:16.610940701Z"}
