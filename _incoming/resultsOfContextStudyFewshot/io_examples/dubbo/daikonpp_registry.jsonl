{"id":"d02318ac-b0e1-4df5-9033-275bc6068eac","expr":"name == null || name.length() >= 0","rationale":"Name is a string used to identify extension; may be null or empty but not negative length.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.extension.ExtensionLoader#loadClass(ClassLoader,Map<String, Class<?>>,java.net.URL,Class<?>,String,boolean):void","file":"org/apache/dubbo/common/extension/ExtensionLoader.java","createdAt":"2026-09-15T12:15:56.961236522Z"}
{"id":"3db87490-f927-4dab-9ce8-cf1f814d609e","expr":"clazz != null","rationale":"clazz must be non-null because the method immediately calls clazz.getAnnotation().","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.extension.ExtensionLoader#loadClassIfActive(ClassLoader,Class<?>):boolean","file":"org/apache/dubbo/common/extension/ExtensionLoader.java","createdAt":"2026-09-15T12:15:56.985170734Z"}
{"id":"359ec238-28bb-454d-8fd3-61ce38faf981","expr":"(classLoader != null) || (classLoader == null)","rationale":"classLoader may be null or non-null; no constraints restrict it.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.extension.ExtensionLoader#loadClassIfActive(ClassLoader,Class<?>):boolean","file":"org/apache/dubbo/common/extension/ExtensionLoader.java","createdAt":"2026-09-15T12:15:56.985170734Z"}
{"id":"00ea8fcd-9ac6-4b86-a3e0-bf7bcecff992","expr":"clazz != null","rationale":"The map cachedNames is accessed with clazz as a key, so clazz should not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.extension.ExtensionLoader#cacheName(Class<?>,String):void","file":"org/apache/dubbo/common/extension/ExtensionLoader.java","createdAt":"2026-09-15T12:15:57.007053291Z"}
{"id":"bfd65330-9b3e-48cc-91bc-cb3e04e0f3a9","expr":"name != null","rationale":"The name being cached should be non-null for meaningful caching.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.extension.ExtensionLoader#cacheName(Class<?>,String):void","file":"org/apache/dubbo/common/extension/ExtensionLoader.java","createdAt":"2026-09-15T12:15:57.007053291Z"}
{"id":"7b6d2392-0697-41a8-b1c4-dcc9436061ab","expr":"name.length() > 0","rationale":"A valid name should have positive length.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.extension.ExtensionLoader#cacheName(Class<?>,String):void","file":"org/apache/dubbo/common/extension/ExtensionLoader.java","createdAt":"2026-09-15T12:15:57.007053291Z"}
