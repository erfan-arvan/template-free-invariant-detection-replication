{"id":"102cdaec-4666-4946-8566-1b770c65f626","expr":"!result || (method.getParameterTypes().length == 0)","rationale":"If result is true, the method must have zero parameters.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#isBeanPropertyReadMethod(Method):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-15T12:14:20.323426697Z"}
{"id":"0f38be80-4d80-4fb3-b2e8-7238de9b03a2","expr":"method != null","rationale":"The method should not be null to call the inspected method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isBeanPropertyWriteMethod(Method):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-15T12:14:20.954239095Z"}
{"id":"91b9231f-e040-4f4e-ab73-1221ac0849b0","expr":"method.getParameterTypes().length == 1","rationale":"Setters have a single parameter for the property.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#isBeanPropertyWriteMethod(Method):boolean","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-15T12:14:20.954239095Z"}
