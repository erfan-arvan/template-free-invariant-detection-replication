{"id":"10d9db0b-9dc0-46af-ba36-c95d113f4e19","expr":"(returnType.isArray()) == (result != null && result.getClass().isArray())","rationale":"If returnType is an array, the result should be a non-null array instance.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ReflectUtils#getEmptyObject(Class<?>,Map<Class<?>, Object>,int):Object","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-15T12:14:17.386965716Z"}
{"id":"4cd51a48-62b4-4bf2-8214-2a067f14a767","expr":"method != null","rationale":"Method object must be non-null to derive a property name","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getPropertyNameFromBeanReadMethod(Method):String","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-15T12:14:19.729856969Z"}
