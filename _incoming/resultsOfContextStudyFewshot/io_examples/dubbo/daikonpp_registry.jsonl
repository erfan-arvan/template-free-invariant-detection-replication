{"id":"cfe55ead-9a7d-4744-8ace-5e0958870d2c","expr":"clazz.isInterface() || !clazz.isInterface()","rationale":"Trivially true inclusion as an inference point regarding interface status.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.extension.ExtensionLoader#cacheWrapperClass(Class<?>):void","file":"org/apache/dubbo/common/extension/ExtensionLoader.java","createdAt":"2026-09-15T12:15:57.122689359Z"}
