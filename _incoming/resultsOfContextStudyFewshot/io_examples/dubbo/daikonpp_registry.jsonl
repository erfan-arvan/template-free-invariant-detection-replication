{"id":"8e3170c8-f8e4-4e7d-8e78-6228e778e339","expr":"parameters == null || parameters.isEmpty() && result.isEmpty()","rationale":"If parameters is null or empty, result is an empty HashMap.","kind":"METHOD_EXIT","element":"org.apache.dubbo.config.AbstractConfig#convert(Map<String, String>,String):Map<String, String>","file":"org/apache/dubbo/config/AbstractConfig.java","createdAt":"2026-09-15T12:08:32.304170306Z"}
