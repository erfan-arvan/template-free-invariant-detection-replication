{"id":"2a60c7ce-fe6f-4a74-b9c1-e864212b3cea","expr":"str != null || start == 0 && end == 0","rationale":"Likely when str is null, start and end are expected to be zero or unused.","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.CharArray#append(String,int,int):CharArray","file":"com/badlogic/gdx/utils/CharArray.java","createdAt":"2026-09-10T12:15:29.715405587Z"}
{"id":"b9720a28-f3b4-420c-940d-03acfb8e52a3","expr":"start >= 0","rationale":"Indexes must not be negative if string is non-null.","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.CharArray#append(String,int,int):CharArray","file":"com/badlogic/gdx/utils/CharArray.java","createdAt":"2026-09-10T12:15:29.715405587Z"}
{"id":"bc5beb23-3e6e-446f-a846-aeac5daa418c","expr":"end <= (str != null ? str.length() : 0)","rationale":"The end index cannot exceed the string's length.","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.CharArray#append(String,int,int):CharArray","file":"com/badlogic/gdx/utils/CharArray.java","createdAt":"2026-09-10T12:15:29.715405587Z"}
{"id":"b0c86b15-f1bd-471f-a4c1-e46039d5444b","expr":"str == null || str.length() >= 0","rationale":"str length is non-negative when str is not null","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.CharArray#append(StringBuffer):CharArray","file":"com/badlogic/gdx/utils/CharArray.java","createdAt":"2026-09-10T12:15:29.916812805Z"}
{"id":"915bf5e3-e697-4a59-bb62-106f66f8dce6","expr":"str == null || str.length() == str.length()","rationale":"self-comparison avoided, so excluded from output","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.CharArray#append(StringBuffer):CharArray","file":"com/badlogic/gdx/utils/CharArray.java","createdAt":"2026-09-10T12:15:29.916812805Z"}
{"id":"cb310e6e-cc91-4d0d-82f4-2f0b880f436f","expr":"str == null || result.size >= (end - start)","rationale":"When 'str' is not null and substring length > 0, 'size' increases. This invariant conservatively bounds 'result.size'.","kind":"METHOD_EXIT","element":"com.badlogic.gdx.utils.CharArray#append(String,int,int):CharArray","file":"com/badlogic/gdx/utils/CharArray.java","createdAt":"2026-09-10T12:15:30.428819104Z"}
{"id":"2fadb9d4-bb28-464d-8a8f-c801ad31ef7c","expr":"result.items != null","rationale":"CharArray always requires a non-null internal 'items' array.","kind":"METHOD_EXIT","element":"com.badlogic.gdx.utils.CharArray#append(String,int,int):CharArray","file":"com/badlogic/gdx/utils/CharArray.java","createdAt":"2026-09-10T12:15:30.428819104Z"}
