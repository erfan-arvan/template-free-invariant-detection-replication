{"id":"bb3bb6a7-b79a-43b4-85ab-008807ca14a9","expr":"file != null","rationale":"toJson writes JSON to the provided file handle, so file should not be null.","kind":"METHOD_EXIT","element":"com.badlogic.gdx.utils.Json#toJson(Object,FileHandle):void","file":"com/badlogic/gdx/utils/Json.java","createdAt":"2026-09-10T12:43:37.389643087Z"}
