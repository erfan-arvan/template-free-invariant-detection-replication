{"id":"a8be9121-0392-4244-9a8a-6e9e9364d9d7","expr":"typeRef >= 0","rationale":"typeRef denotes a reference and is expected to be non-negative","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTryCatchAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T11:29:07.333692896Z"}
{"id":"c5b55c45-f08e-427a-873f-e203497d60c3","expr":"typeRef <= 0xFFFFF","rationale":"typeRef is typically limited by JVM spec to 20 bits","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTryCatchAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T11:29:07.333692896Z"}
