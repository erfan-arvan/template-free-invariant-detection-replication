{"id":"7c392171-3be3-4f50-8366-b43853a2cdb1","expr":"opcode >= 178 && opcode <= 181","rationale":"The opcode parameter must correspond to one of the valid field instruction opcodes.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitFieldInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T11:37:09.198136903Z"}
