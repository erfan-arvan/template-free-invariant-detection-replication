{"id":"084ce6be-988a-4467-a34d-5d8d16ed50e4","expr":"Character.isLetter(name.charAt(0))","rationale":"XML entity names usually start with a letter as per naming conventions.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.StaxStreamHandler#endEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-10T10:33:27.875444668Z"}
