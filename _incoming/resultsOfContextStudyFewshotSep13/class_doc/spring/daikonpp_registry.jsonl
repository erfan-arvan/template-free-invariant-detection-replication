{"id":"b00da647-47b3-456f-aa33-f4d413816c22","expr":"exceptions == null || exceptions.length >= 0","rationale":"Exceptions can be null or an array of exception types thrown by the method.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodFilterTransformer#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/transform/MethodFilterTransformer.java","createdAt":"2026-09-10T11:20:03.356579487Z"}
