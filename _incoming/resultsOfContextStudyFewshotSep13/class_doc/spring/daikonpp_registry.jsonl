{"id":"9efec167-22f7-4965-a1d1-514f9877120b","expr":"prefix == null || prefix != null","rationale":"Trivially true, no meaningful invariant","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractXMLStreamReader#getNamespaceURI(String):String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-10T10:33:36.224499758Z"}
{"id":"aea736c6-6b7a-49f9-862f-8b0624ae8387","expr":"prefix != null || result == null","rationale":"The namespace URI for a null prefix is usually undefined, so the result is often null in that case.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractXMLStreamReader#getNamespaceURI(String):String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-10T10:33:36.914126239Z"}
