{"id":"ff35d47f-69a3-41b1-a1d9-2a2f6735f9ca","expr":"ifc != null","rationale":"The input interface class should not be null to check if it belongs to the set of Java language interfaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isJavaLanguageInterface(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:43:13.131854893Z"}
{"id":"b1a6c9fe-7761-4185-a8fc-4db1d5e4856e","expr":"ifc.isInterface()","rationale":"Java language interfaces are indeed interfaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isJavaLanguageInterface(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:43:13.131854893Z"}
{"id":"788dc087-f431-48d6-b0d5-8a2f8a940b22","expr":"!ifc.isAnnotation()","rationale":"Java language interfaces typically exclude annotations, focusing on primary user-level interfaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isJavaLanguageInterface(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:43:13.131854893Z"}
