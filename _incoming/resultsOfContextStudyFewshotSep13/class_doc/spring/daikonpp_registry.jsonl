{"id":"d2d856c3-f44e-48f6-9b66-b2c3d60bfc79","expr":"name.equals(name.trim())","rationale":"Entity names should not have leading or trailing whitespace.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:30.855318224Z"}
{"id":"3ed4bf26-8048-44cd-b27a-cfc54ad557dc","expr":"qualifiedName != null","rationale":"qualifiedName is used immediately with indexOf which would throw NullPointerException if qualifiedName were null","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:31.827331758Z"}
