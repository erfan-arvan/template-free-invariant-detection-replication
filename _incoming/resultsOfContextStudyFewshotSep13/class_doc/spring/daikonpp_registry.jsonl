{"id":"bf43d84b-a687-4bbf-9848-15ad6caeedfc","expr":"name != null && !name.isEmpty()","rationale":"Method name should typically be a valid non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T11:37:14.775701905Z"}
{"id":"95b220cb-c43e-4e8b-916e-427bad982743","expr":"descriptor != null && descriptor.startsWith(\"(\") && descriptor.contains(\")\")","rationale":"The descriptor is expected to be a valid JVM method descriptor string.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T11:37:14.775701905Z"}
