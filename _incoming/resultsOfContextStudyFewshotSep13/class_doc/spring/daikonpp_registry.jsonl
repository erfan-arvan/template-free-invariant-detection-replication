{"id":"baf334c9-ffb2-4058-99ff-18c9550f02d4","expr":"resource.getEncoding() == null || !resource.getEncoding().isEmpty()","rationale":"The encoding string is either null or a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(EncodedResource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:35.261183394Z"}
{"id":"058ea9e2-085a-4884-abcb-816078526866","expr":"resource.getResource().isReadable()","rationale":"The underlying Resource should be readable to be loaded without errors.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(EncodedResource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:35.261183394Z"}
{"id":"3351354a-3a9e-442b-8fe3-88697d407893","expr":"!ignoreResourceNotFound == false","rationale":"Equivalent to ignoreResourceNotFound being a boolean.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderSupport#setIgnoreResourceNotFound(boolean):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T11:01:35.838926867Z"}
{"id":"db4845da-d78b-4a52-bac2-8b56fba4bc3e","expr":"props != null","rationale":"Ensures the properties object to load into is not null before loading.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderSupport#loadProperties(Properties):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T11:01:36.362872412Z"}
{"id":"f1891968-95f6-4230-9c18-2ce33919345c","expr":"props.size() >= 0","rationale":"Properties collection size is never negative.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderSupport#loadProperties(Properties):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T11:01:36.362872412Z"}
{"id":"d9b95e47-d36b-4b92-88e5-0d68d24b608f","expr":"result != null","rationale":"The method returns a new Properties instance, so result is non-null.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(EncodedResource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:37.144790131Z"}
