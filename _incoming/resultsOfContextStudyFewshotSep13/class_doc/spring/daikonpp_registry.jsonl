{"id":"e1b5d1c3-499d-4eeb-9025-d76382768f0c","expr":"clazz.isAssignableFrom(result.getClass())","rationale":"Resulting instance's runtime class is assignable from clazz, ensuring type compatibility.","kind":"METHOD_EXIT","element":"org.springframework.objenesis.SpringObjenesis#newInstance(Class<T>):T","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-10T11:38:40.472685132Z"}
