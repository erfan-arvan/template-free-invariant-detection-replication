{"id":"32318f1b-d6bb-4636-972d-7de73baf665e","expr":"ignoreUnresolvablePlaceholders == result.isIgnoreUnresolvablePlaceholders()","rationale":"The helper's ignoreUnresolvablePlaceholders setting corresponds to the parameter passed.","kind":"METHOD_EXIT","element":"org.springframework.core.env.AbstractPropertyResolver#createPlaceholderHelper(boolean):PropertyPlaceholderHelper","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:53.688418057Z"}
