{"id":"c0e1fb32-c13e-4a28-9125-a0d992223b3a","expr":"!result || clazz != null","rationale":"The method returns false if clazz is null, so result true implies clazz is not null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isCglibProxyClass(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:43:27.759512459Z"}
