{"id":"c780cd7d-2913-4013-af06-fe1f5b99f660","expr":"method.getParameterCount() >= 0","rationale":"Parameter count is always zero or positive.","kind":"METHOD_ENTRY","element":"org.springframework.aot.hint.predicate.ReflectionHintsPredicates#onMethod(Method):MethodHintPredicate","file":"org/springframework/aot/hint/predicate/ReflectionHintsPredicates.java","createdAt":"2026-09-10T11:14:35.249801186Z"}
