{"id":"f4b8a031-6b26-4d3c-9344-b823437850ed","expr":"props != null && resource != null && persister != null","rationale":"Parameters must be non-null to safely load properties.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,EncodedResource,PropertiesPersister):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:40.112389948Z"}
