{"id":"0f406bad-efb8-485e-9e31-d6567507d6bb","expr":"(qName.isEmpty() == false) || (localName.isEmpty() == false)","rationale":"At least one of qName or localName is non-empty string","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:13.701834133Z"}
{"id":"a30f8deb-be39-484b-add0-70e44ea47750","expr":"prefix != null","rationale":"Method parameter 'prefix' is typically non-null when registering a namespace prefix.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:15.707754751Z"}
{"id":"549a639e-b19d-4b93-b871-037daa167173","expr":"uri != null","rationale":"Namespace URIs should be non-null to correctly map prefixes.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:15.707754751Z"}
{"id":"cf10231a-e089-4973-95e1-d5d765668379","expr":"!prefix.isEmpty()","rationale":"Prefixes are usually non-empty strings specifying a namespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:15.707754751Z"}
{"id":"890843db-cc65-4e08-ab2f-ea46c86efc30","expr":"prefix.indexOf(':') == -1","rationale":"Namespace prefixes do not contain colon ':' characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startPrefixMapping(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:15.707754751Z"}
{"id":"1af851a1-8224-427a-92c1-a809e25b04af","expr":"prefix != null","rationale":"prefix represents the namespace prefix being ended, typically non-null when ending a mapping.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endPrefixMapping(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.502424032Z"}
{"id":"f164115b-c6a9-4834-818e-deb7aa70b7e6","expr":"!prefix.isEmpty()","rationale":"Namespace prefix is generally a non-empty string representing a prefix.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endPrefixMapping(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.502424032Z"}
{"id":"6fec324e-6f2b-49ea-820f-2db280d6d38c","expr":"prefix.indexOf(':') == -1","rationale":"Namespace prefixes do not contain colon characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endPrefixMapping(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.502424032Z"}
{"id":"86cfa21c-c37d-42d5-9bee-943196e2a27e","expr":"prefix.length() <= 10","rationale":"Namespace prefixes are typically short strings (heuristic guess).","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endPrefixMapping(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.502424032Z"}
{"id":"4823e171-d27f-40c1-9fc2-d888ca8f966d","expr":"prefix == null || prefix.length() >= 0","rationale":"Since the method accepts a String parameter named prefix, it is possible that prefix can be null or non-null, and if non-null, has a non-negative length","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endPrefixMapping(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.627208169Z"}
{"id":"a1bb8ab7-ae15-4372-bcb1-500a62ee6db3","expr":"prefix == null || !prefix.contains(\":\")","rationale":"XML namespace prefixes generally do not contain colons, so if prefix is not null, it likely does not contain ':'","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endPrefixMapping(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.627208169Z"}
{"id":"8c1d1f7f-be06-41d2-8721-768a1ff139ce","expr":"uri != null && qName != null","rationale":"startElementInternal is called with toQName(uri, qName), so uri and qName should be non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.838523721Z"}
{"id":"4b43f7c4-f5f0-4d66-b261-467922ce4947","expr":"atts != null","rationale":"startElementInternal is called with atts, so it is expected not to be null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.838523721Z"}
{"id":"4ed9b9ea-729a-4ab0-b574-c62072d7197c","expr":"localName != null","rationale":"SAX parser always provides a localName string for this method.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.838523721Z"}
{"id":"ddbd9380-ad69-4f8b-97cb-9db16d8f9d3d","expr":"qName.length() >= localName.length()","rationale":"By the contract qName is the qualified name, which can be 'prefix:localName' or just 'localName', so length qName is at least length localName if both non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.838523721Z"}
{"id":"fbd305b8-dc1a-4ba0-9df2-b24ac7cb63b8","expr":"atts.getLength() >= 0","rationale":"Attributes.getLength() must be non-negative as per SAX API.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startElement(String,String,String,Attributes):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:16.838523721Z"}
{"id":"a09f96e6-6c29-4343-84fc-2175003113d9","expr":"uri != null","rationale":"The URI parameter is typically expected to be non-null in SAX handler methods to represent the namespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.495621824Z"}
{"id":"24bfe17b-75fa-4a2d-ae72-44b9f464c9c7","expr":"localName != null","rationale":"The localName parameter represents the local part of the element name and should not be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.495621824Z"}
{"id":"acd22d6e-b038-46f0-ab51-daff9bdae940","expr":"qName != null","rationale":"The qName parameter is usually expected to be non-null as the qualified element name.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.495621824Z"}
{"id":"5d6bd2e2-cd73-4540-a4fd-c8a43f264367","expr":"(qName.indexOf(':') >= 0) == (localName.length() < qName.length())","rationale":"If the qualified name qName contains a prefix, it will have a colon, and localName will be shorter than qName.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.495621824Z"}
{"id":"bebc86ab-6f9b-4474-9f66-18b1e89004b4","expr":"(!uri.isEmpty()) == (qName.indexOf(':') >= 0)","rationale":"If uri is not empty, qName is expected to have a prefix indicated by a colon in qName.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.495621824Z"}
{"id":"f8931a52-4cd0-4e70-8191-fffb1af885b6","expr":"ch != null","rationale":"The character array to process must be non-null to create a String from it.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.635770478Z"}
{"id":"64208c2c-bc24-45f0-b610-c53412508f53","expr":"start >= 0","rationale":"The start index for substring extraction must be zero or positive.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.635770478Z"}
{"id":"9a73bbe6-ab8e-4af0-b443-c35cc24dcea4","expr":"length >= 0","rationale":"The length of the substring must be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.635770478Z"}
{"id":"1be0c639-3bc0-4a5a-849d-f512b2fa7fe7","expr":"start + length <= ch.length","rationale":"The substring must fit within the bounds of the character array.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.635770478Z"}
{"id":"9e70e284-75d0-4851-b91a-71a018f77dc7","expr":"ch.length >= 0","rationale":"Array length is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.635770478Z"}
{"id":"b19256be-9e34-4aa3-b2fd-ec6f5591fee4","expr":"uri != null","rationale":"The method converts 'uri' and 'qName' to a QName, so 'uri' is expected to be non-null at this point.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.979636645Z"}
{"id":"c6f8a659-bb09-4d61-ac05-532e6a7e1095","expr":"qName != null","rationale":"Since the qName is passed to the toQName method for conversion, it should be non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.979636645Z"}
{"id":"5b4bd7df-ac9d-421b-a246-c2d2426c7730","expr":"localName != null","rationale":"While 'localName' is not directly used in the implementation code snippet, it is part of the method signature and usually non-null in XML parsing.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.979636645Z"}
{"id":"b4294b0b-9e65-467d-8c36-74257246e1d9","expr":"qName.contains(localName) || localName.isEmpty()","rationale":"Typically, the qualified name includes the local name as its suffix or entirety, especially in SAX/XML handling, so qName contains localName or localName is empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.979636645Z"}
{"id":"a0978f1b-43bf-4215-93ed-46b8ea2366ca","expr":"uri.isEmpty() || qName.startsWith(uri) || qName.contains(\":\")","rationale":"The QName may include a namespace prefix from the uri or be composed in a way where the uri is related to qName (prefix:localName). If uri is empty, qName may be just localName.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endElement(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:18.979636645Z"}
{"id":"0ef9c7ae-6355-41c2-be50-800eb0c4204b","expr":"ch != null","rationale":"A new String is constructed from ch, start, and length; so ch must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:19.036853543Z"}
{"id":"41361265-cb40-4a6d-abc3-ae6c80df47d9","expr":"start >= 0","rationale":"The start index must be within valid bounds for the char array.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:19.036853543Z"}
{"id":"0dfe2f5f-1199-488e-9d7d-971b6b61b3c0","expr":"length >= 0","rationale":"The length parameter for the substring constructor must be non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:19.036853543Z"}
{"id":"65c2645a-7cc8-464e-9788-2693542650ac","expr":"start + length <= ch.length","rationale":"The substring constructor enforces that start + length does not exceed ch.length.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:19.036853543Z"}
{"id":"050db150-fc06-4e10-ac31-d7c241d46dd0","expr":"ch != null","rationale":"The char array ch must be non-null otherwise new String(ch, start, length) would throw NullPointerException.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:20.772434703Z"}
{"id":"e1fee028-f5f9-4a30-bcb6-2704458dc0e0","expr":"start >= 0","rationale":"start index must be non-negative to be a valid array slice start.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:20.772434703Z"}
{"id":"0c391f86-7cf5-4bbf-85ef-8cbbd4b3757e","expr":"length >= 0","rationale":"length must be non-negative to be a valid string length.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:20.772434703Z"}
{"id":"cf55b094-5245-461d-b371-0dc28011d63c","expr":"start + length <= ch.length","rationale":"The substring indices must be within the bounds of ch array to avoid String constructor exceptions.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#ignorableWhitespace(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:20.772434703Z"}
{"id":"0b84fc7b-7bfc-49c5-bba7-221a0e74e5c5","expr":"ch != null","rationale":"The characters(char[], int, int) method uses ch to create a new String, so ch must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.213883646Z"}
{"id":"e114ac78-9e82-4bf2-a807-b3423d6fde68","expr":"start >= 0 && start <= ch.length","rationale":"The substring created from ch using start and length is valid only if start is within the ch bounds.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.213883646Z"}
{"id":"c551f55e-10e6-4a9f-9147-d3af4f246f54","expr":"length >= 0 && start + length <= ch.length","rationale":"Ensures that the substring from ch starting at start of length length is valid.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.213883646Z"}
{"id":"436b3b01-e1bb-4772-bab2-8ea087c0bf23","expr":"length == 0 || (start < ch.length && ch[start] != '\\0')","rationale":"If non-empty substring is processed, starting character should not be null char.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#characters(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.213883646Z"}
{"id":"9a07a2a7-20c4-4e34-b515-a46b5ac7bffd","expr":"target != null","rationale":"A processing instruction must have a target, so target is typically non-null","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.409236202Z"}
{"id":"a28adcc2-f058-46ee-b4f4-094ad2c5f03e","expr":"data != null || data == null","rationale":"The data parameter can be null or contain processing instruction data","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.409236202Z"}
{"id":"5bb7811c-b458-4302-935b-fb5012c8f202","expr":"target.length() > 0","rationale":"Processing instruction target is expected to be a non-empty string","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.409236202Z"}
{"id":"8e8d9e3c-edeb-4ac8-908f-2b475a2253c1","expr":"!target.contains(\":\" )","rationale":"Processing instruction target is typically a QName without colon characters","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.409236202Z"}
{"id":"c6e26bba-5e0c-47d6-a375-f029d3330578","expr":"data != null && data.length() >= 0","rationale":"Data length is always >= 0 if data is not null","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.409236202Z"}
{"id":"4a3fb921-1a18-48b6-a1fe-d4ff1db3dbeb","expr":"target != null","rationale":"The method delegates to processingInstructionInternal which likely requires a non-null target.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.697195040Z"}
{"id":"d9c319b3-494e-4fea-9a5b-7788b85d7c5d","expr":"data != null","rationale":"The method delegates to processingInstructionInternal with data which possibly expected to be non-null or at least valid for use.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.697195040Z"}
{"id":"29a287ea-88cd-496d-94df-8de048a2a98b","expr":"target.length() > 0","rationale":"Processing instruction targets are usually non-empty strings.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.697195040Z"}
{"id":"6d4fe12d-3e0d-4728-9027-13694d953e00","expr":"data.length() >= 0","rationale":"Data is a string possibly empty, length is always >= 0.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.697195040Z"}
{"id":"cacaf24e-9945-444b-8b6b-9d070eda16f6","expr":"!target.contains(\" \")","rationale":"XML processing instruction targets typically cannot contain whitespace.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#processingInstruction(String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.697195040Z"}
{"id":"83e30937-778d-4e95-a745-c6f3d7b8c374","expr":"name != null && !name.isEmpty()","rationale":"The parameter 'name' represents the skipped entity name which is usually a non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.916571053Z"}
{"id":"88e99163-7203-43c2-8296-ed522f21cc79","expr":"name.indexOf(' ') == -1","rationale":"Entity names in XML normally do not contain spaces.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.916571053Z"}
{"id":"381cb01e-3d82-4f58-8625-bac066879509","expr":"name.startsWith(\"&\") == false","rationale":"The skipped entity name is expected to be the name part rather than a reference with the '&' prefix.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.916571053Z"}
{"id":"5834d14b-27d5-42c4-967d-33723d6d2ef2","expr":"name.equals(name.trim())","rationale":"Entity names should not have leading or trailing whitespace.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:21.916571053Z"}
{"id":"b91e63f2-7a55-4d3f-953f-af48001a054f","expr":"name != null && !name.isEmpty() && Character.isJavaIdentifierStart(name.charAt(0)) || name.length() == 0 || name == null","rationale":"At method entry, 'name' is expected to be a valid (non-null) XML entity identifier or possibly null/empty in some cases.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:22.678795334Z"}
{"id":"398e5aa9-60cd-4a42-b349-44edd08c89d4","expr":"name == null || name.length() > 0","rationale":"Non-null name should be non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#skippedEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:22.678795334Z"}
