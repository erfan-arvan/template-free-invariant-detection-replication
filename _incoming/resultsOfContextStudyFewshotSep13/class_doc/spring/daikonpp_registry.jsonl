{"id":"db67bc20-3a51-4c06-bc1d-bd93486a470c","expr":"name.indexOf(' ') < 0","rationale":"Feature names presumably follow a URI-style format without whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractXMLReader#getFeature(String):boolean","file":"org/springframework/util/xml/AbstractXMLReader.java","createdAt":"2026-09-10T10:34:47.476352797Z"}
