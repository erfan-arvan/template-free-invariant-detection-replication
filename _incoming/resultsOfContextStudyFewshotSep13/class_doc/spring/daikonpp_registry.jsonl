{"id":"702718e9-ee4f-4543-8e97-b2d571246f24","expr":"result != null","rationale":"getLocalPart() of QName is non-null, so returned String result is never null.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractXMLStreamReader#getAttributeLocalName(int):String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-10T10:33:32.420106209Z"}
{"id":"81a9fbb1-6621-41b5-8f95-abf3de4bf07c","expr":"result.length() > 0","rationale":"The local part of an attribute name should generally be a non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractXMLStreamReader#getAttributeLocalName(int):String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-10T10:33:32.420106209Z"}
{"id":"8f16b901-6334-41f1-9227-b808dbe76ded","expr":"index >= 0","rationale":"Attribute indices are usually zero or positive.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractXMLStreamReader#getAttributePrefix(int):String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-10T10:33:32.776284898Z"}
{"id":"4398f5d5-0c74-49ed-b4cf-dc7f9ee26a8a","expr":"index >= 0","rationale":"Indices for attributes are usually zero or positive.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractXMLStreamReader#getAttributeNamespace(int):String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-10T10:33:33.241163915Z"}
