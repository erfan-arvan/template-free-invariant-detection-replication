{"id":"5e008400-4cfe-41fc-977b-266b780d3689","expr":"name.indexOf(' ') == -1","rationale":"Entity names typically do not contain spaces.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.823672460Z"}
{"id":"6c1b7a70-2349-4a19-82d9-937c162f37c6","expr":"name.equals(name.trim())","rationale":"This reiterates that there is no leading or trailing whitespace.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.823672460Z"}
{"id":"8ecdc985-b316-4d0e-b801-e40531d08789","expr":"name.length() > 0","rationale":"The entity name should be a non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:30.855318224Z"}
