{"id":"7366900b-acad-4faf-a375-a26b2a30fac2","expr":"desc != null","rationale":"The descriptor specifies the method type and is expected to be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-10T11:21:57.253387097Z"}
{"id":"26af6398-1811-43c8-b842-dc82781fee5b","expr":"name.length() > 0","rationale":"It is expected that the method name is a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-10T11:21:57.253387097Z"}
