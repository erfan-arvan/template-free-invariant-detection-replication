{"id":"bad6c64d-71e9-472d-8668-7b11a706dc2a","expr":"result != null","rationale":"The returned string after placeholder resolution should be non-null.","kind":"METHOD_EXIT","element":"org.springframework.core.env.AbstractPropertyResolver#resolvePlaceholders(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:50.442945245Z"}
