{"id":"a41b7c74-4c2e-426e-94cd-f54860e0f491","expr":"resource != null && resource.exists()","rationale":"The resource parameter should represent an existing resource to load properties from.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:40.281695760Z"}
{"id":"7c18d174-81df-485c-8b3d-309e91bd791a","expr":"resource.getFilename() != null && resource.getFilename().endsWith(\".properties\")","rationale":"Typically properties are loaded from files ending with .properties extension.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:40.281695760Z"}
{"id":"3d1d2830-4199-4ee2-a9fa-dafd321dfd76","expr":"resource.isReadable()","rationale":"The resource must be readable to allow properties to be loaded from it.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:40.281695760Z"}
{"id":"e8e4d80c-0875-4bff-bc32-1fbe32ef0b00","expr":"!resource.getDescription().isEmpty()","rationale":"A meaningful description of the resource is available for diagnostics or logging.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:40.281695760Z"}
{"id":"8746da29-1672-452c-a962-b7fc027f5da9","expr":"resource.getURL() != null","rationale":"Most resource implementations provide a URL representing its location.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:40.281695760Z"}
{"id":"a79b2118-12f8-4123-8d0f-0af59112d121","expr":"props != null","rationale":"Properties are loaded into the 'props' object, so it must be non-null after method execution.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,EncodedResource,PropertiesPersister):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:42.284575243Z"}
{"id":"464d420d-218f-4e49-a2cf-a69933a68edc","expr":"resource != null","rationale":"'resource' is dereferenced in the method implementation, so it cannot be null.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,EncodedResource,PropertiesPersister):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:42.284575243Z"}
{"id":"e575fc9a-14be-4fd1-9bef-81f699eb1e1f","expr":"persister != null","rationale":"'persister' is invoked to load the properties, indicating it is non-null at this point.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,EncodedResource,PropertiesPersister):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:42.284575243Z"}
{"id":"59ab1319-5d5e-44f1-868f-70a97d53c33c","expr":"(resource.getResource().getFilename() == null || !resource.getResource().getFilename().endsWith(\".xml\")) || props.size() > 0","rationale":"If the resource filename ends with \".xml\", properties are loaded from XML, so 'props' should contain entries.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,EncodedResource,PropertiesPersister):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:42.284575243Z"}
{"id":"4e29dd6b-1891-433e-81a1-90341f3ae78d","expr":"(resource.getResource().getFilename() != null && resource.getResource().getFilename().endsWith(\".xml\")) || props.size() > 0","rationale":"'props' should be populated unless resource filename is null or ends with '.xml', in which case properties are loaded differently.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,EncodedResource,PropertiesPersister):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:42.284575243Z"}
{"id":"8852ccdd-83e2-40ba-b2b4-f3aa28474cac","expr":"result != null","rationale":"Since a new Properties instance is created and returned, result cannot be null.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:43.209213817Z"}
{"id":"1a9f6829-f3bc-4ddc-b861-46abb6286315","expr":"result.isEmpty() || result.size() > 0","rationale":"The Properties object must either be empty or contain one or more entries, always true since Properties inherits from Hashtable.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:43.209213817Z"}
{"id":"e15591b2-9364-475b-96d5-6db4f4ffb1ce","expr":"!result.isEmpty() || resource.exists()","rationale":"If properties are loaded empty, it may be because the resource does not exist.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:43.209213817Z"}
{"id":"fb6d4be0-bb24-489f-8ac3-aac8d140e27d","expr":"result.propertyNames() != null","rationale":"The method propertyNames() on Properties returns an Enumeration that should not be null.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(Resource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:43.209213817Z"}
{"id":"eafb880d-28d9-4e9e-ad78-6c0321315a5e","expr":"props != null","rationale":"The method requires a Properties instance to fill, so props must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:43.579520707Z"}
{"id":"a30fd580-f3c2-4187-9bc8-901ac05b33fe","expr":"resource != null","rationale":"The resource parameter must be non-null to extract InputStream and filename.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:43.579520707Z"}
{"id":"a07336c7-b93b-4c87-84b0-15efcf2d73d8","expr":"resource.getInputStream() != null","rationale":"The resource must provide a non-null InputStream for loading properties.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:43.579520707Z"}
{"id":"cb472b17-7814-4e61-883b-542389e4c946","expr":"resource.getFilename() == null || resource.getFilename().endsWith(\".xml\") || !resource.getFilename().endsWith(\".xml\")","rationale":"Filename being null or ending with .xml determines loading method but both cases are possible.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:43.579520707Z"}
{"id":"1733161e-76cb-4567-9371-8ab1c3b80777","expr":"props.isEmpty() || !props.isEmpty()","rationale":"Properties props may initially be empty or populated before loading.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:43.579520707Z"}
{"id":"cbc816c6-6fcf-4b9e-a261-2c2f38c65068","expr":"resourceName != null","rationale":"Resource name must be non-null to load properties.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadAllProperties(String):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:44.977336111Z"}
