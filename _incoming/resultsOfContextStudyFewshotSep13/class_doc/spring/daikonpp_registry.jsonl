{"id":"2e85c552-a584-41a7-867e-df51ea325cb1","expr":"qualifiedName.indexOf(':') >= -1 && qualifiedName.indexOf(':') < qualifiedName.length()","rationale":"indexOf should always return -1 if not found or an index within range.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#toQName(String,String):QName","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:31.827331758Z"}
