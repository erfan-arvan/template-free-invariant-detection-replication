{"id":"4216606d-9b58-4d5d-a782-612a42f4b2bf","expr":"valueSeparator == null || valueSeparator.equals(\":\" ) || !valueSeparator.equals(\":\" )","rationale":"The string is either the default separator or something else; this tautology captures that it has a defined set behavior, i.e. it is stable.","kind":"METHOD_EXIT","element":"org.springframework.core.env.AbstractPropertyResolver#setValueSeparator(String):void","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:41.058090687Z"}
{"id":"cb33ff0c-ddb1-470f-9c41-bd91fd4cfaa6","expr":"(valueSeparator == null) || (valueSeparator != null)","rationale":"Trivially true but harmless invariant to state the variable is stable at method exit.","kind":"METHOD_EXIT","element":"org.springframework.core.env.AbstractPropertyResolver#setValueSeparator(String):void","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:41.058090687Z"}
{"id":"96157df2-9529-4904-abdb-72599379d8c6","expr":"key != null && key.length() > 0","rationale":"The key must be non-null and non-empty to look up a property.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#containsProperty(String):boolean","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:41.392700263Z"}
{"id":"9979271b-5d1f-4956-8406-9e9f052918a5","expr":"key.trim().length() == key.length()","rationale":"The property key has no leading or trailing whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#containsProperty(String):boolean","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:41.392700263Z"}
{"id":"bd4ff3b9-dae8-437a-a772-62d667d88313","expr":"key.length() <= 256","rationale":"Property keys have a practical maximum length.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#containsProperty(String):boolean","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:41.392700263Z"}
{"id":"b1fcaad3-b916-4356-9927-dff5e4af07e2","expr":"key != null","rationale":"The key parameter should be non-null to query the property map meaningfully.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:44.637942259Z"}
{"id":"154221d6-f190-40c9-9d37-e9c87440680d","expr":"key.length() > 0","rationale":"Property keys are usually non-empty to represent valid property names.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:44.637942259Z"}
{"id":"d48c46b1-f9b7-440b-bae9-f7677c2b9ffb","expr":"key.trim().length() == key.length()","rationale":"Leading or trailing whitespace in property keys is typically invalid or meaningless.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:44.637942259Z"}
{"id":"09a7721d-891e-4f68-8f21-98f08c885580","expr":"key.indexOf(' ') < 0","rationale":"Property keys usually do not contain white space characters such as spaces.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:44.637942259Z"}
{"id":"d6332377-1dbb-40ec-87d0-be2c7493bbeb","expr":"key.equals(key.trim())","rationale":"Ensuring the key contains no leading or trailing whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:44.637942259Z"}
{"id":"2c7cf824-688d-4f02-b1cc-33950e57b04f","expr":"result == null || result.length() > 0","rationale":"When a property is found, it returns a non-empty string; otherwise, null.","kind":"METHOD_EXIT","element":"org.springframework.core.env.AbstractPropertyResolver#getProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:45.096245856Z"}
