{"id":"f69d8877-b117-46c5-8426-6de0c0760110","expr":"ch != null","rationale":"The input char array ch must not be null because it is used to create a new String.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.373799700Z"}
{"id":"6ddc952d-5f48-4670-9197-4fcc3c0015ac","expr":"start >= 0","rationale":"The start index must be non-negative because it indexes into the char array.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.373799700Z"}
{"id":"444514f9-15e1-49c2-94b4-20c5f71515e7","expr":"length >= 0","rationale":"The length of the comment substring must be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.373799700Z"}
{"id":"9e3936d6-de59-4df2-9e5f-d2a1f6bd57e9","expr":"start + length <= ch.length","rationale":"The substring defined by start and length must lie within the char array bounds.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#comment(char[],int,int):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.373799700Z"}
{"id":"802ae1ec-9f16-40e8-a98b-89d247ff219f","expr":"name != null","rationale":"The entity name should not be null when ending an entity.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.646532652Z"}
{"id":"7115c5c2-a345-4a65-a069-39b8e8a62f4b","expr":"name.length() > 0","rationale":"Entity names are typically non-empty strings.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.646532652Z"}
{"id":"64c50e0b-8e6b-4c1c-9e05-a18f6700105a","expr":"!name.contains(\" \")","rationale":"Entity names typically do not contain spaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.646532652Z"}
{"id":"53eb3c7c-75b3-426b-b57e-581bfefce09f","expr":"name.equals(name.trim())","rationale":"Entity names likely do not have leading or trailing whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.646532652Z"}
{"id":"c1fb55df-e107-4495-9d7c-5770cfbe1a98","expr":"Character.isLetter(name.charAt(0))","rationale":"XML entity names typically start with a letter.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#endEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.646532652Z"}
{"id":"f90362df-5fa2-4d67-9962-f249568e0c0e","expr":"name != null && !name.isEmpty()","rationale":"Since startEntity is called with a valid entity name, it is expected that 'name' is non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.AbstractStaxHandler#startEntity(String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:28.823672460Z"}
