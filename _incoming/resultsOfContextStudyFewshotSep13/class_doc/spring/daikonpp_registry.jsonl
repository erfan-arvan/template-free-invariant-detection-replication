{"id":"9d8bfdf3-6c4d-43cd-9ad1-ea119c60143f","expr":"classes == null || result.contains(\".\") || classes.isEmpty()","rationale":"If classes is non-null and not empty, result string will include fully qualified class names which contain '.'","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classNamesToString(Collection<Class<?>>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:45.787077254Z"}
