{"id":"458259a5-f62a-4a17-9fad-f72b571a1827","expr":"text != null","rationale":"text parameter should be non-null for meaningful placeholder resolution.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#resolvePlaceholders(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:49.215289496Z"}
{"id":"56697aee-55ce-43ba-995c-80d8f01e0a83","expr":"text.isEmpty() || text.length() > 0","rationale":"text is a String and its length is >= 0; this reflects no tautology is returned.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#resolvePlaceholders(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:49.215289496Z"}
