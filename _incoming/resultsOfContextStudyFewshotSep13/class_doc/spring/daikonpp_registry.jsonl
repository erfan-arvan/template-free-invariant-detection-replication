{"id":"f88068dd-349f-482b-a44c-17f0e7f5c318","expr":"clazz.isMemberClass() == (clazz.isMemberClass())","rationale":"Reflects knowledge that clazz may be a member class, relevant to static class determination.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isStaticClass(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:43:18.224397213Z"}
