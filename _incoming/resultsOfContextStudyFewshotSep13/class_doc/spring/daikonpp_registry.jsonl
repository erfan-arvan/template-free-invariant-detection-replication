{"id":"f134a378-3fa0-4b05-934c-490f753d0fb4","expr":"text.length() >= 0","rationale":"String length is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#doResolvePlaceholders(String,PropertyPlaceholderHelper):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:53.398481792Z"}
{"id":"7fef8052-dff8-4f7f-a7f7-5917b2b7a9c9","expr":"helper.getPlaceholderPrefix() != null","rationale":"The helper typically has a defined placeholder prefix, necessary for placeholder resolution.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#doResolvePlaceholders(String,PropertyPlaceholderHelper):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:53.398481792Z"}
{"id":"824b68a7-68aa-4814-afff-515b0af0fc3f","expr":"helper.getPlaceholderSuffix() != null","rationale":"The helper typically has a defined placeholder suffix, necessary for placeholder resolution.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#doResolvePlaceholders(String,PropertyPlaceholderHelper):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:53.398481792Z"}
{"id":"63b63352-0635-4822-88b0-1b29ec0c499a","expr":"ignoreUnresolvablePlaceholders == true || ignoreUnresolvablePlaceholders == false","rationale":"The parameter ignoreUnresolvablePlaceholders is a primitive boolean, thus it can only be true or false.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#createPlaceholderHelper(boolean):PropertyPlaceholderHelper","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:53.644920083Z"}
