{"id":"75c71e44-d923-48f5-bfef-c821c69d7fbb","expr":"clazz.getClassLoader() == null || clazz.getClassLoader() == classLoader || classLoader == null","rationale":"Although not guaranteed, often clazz is loaded by the classLoader passed in or the system class loader if classLoader is null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:49.621496359Z"}
{"id":"f7ea1511-65a4-4a20-bc78-108a29a5645d","expr":"clazz.getName().length() > 0","rationale":"Class.getName() returns a non-empty String representing the class name.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:49.621496359Z"}
{"id":"868cf182-dab4-4730-a527-ff9fe5b10d16","expr":"!result || classLoader == null || clazz.getClassLoader() != null","rationale":"The method returns true if clazz.getClassLoader() == classLoader or clazz.getClassLoader() == null. So if result is true and classLoader is not null, then clazz.getClassLoader() can't be null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isCacheSafe(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:50.032770935Z"}
{"id":"40ce40a9-c3c2-4fe4-bb17-f404d2f85a8f","expr":"result || classLoader != null","rationale":"The method returns false if target != classLoader and target != null but classLoader == null causes false as well. Thus if result is false, classLoader cannot be null according to flow.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isCacheSafe(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:50.032770935Z"}
{"id":"a5de8957-30e0-47fa-b593-785ed3f301c2","expr":"(!result) || (clazz.equals(classLoader.loadClass(clazz.getName())))","rationale":"If the result is true, then clazz must be exactly the class returned by classLoader.loadClass for clazz's name.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:54.264717102Z"}
{"id":"2f1012b6-7fc7-474c-b211-764b170c2aad","expr":"(!result) || (classLoader != null)","rationale":"If the result is true, classLoader cannot be null as loadClass would fail or yield different behavior.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:54.264717102Z"}
{"id":"cdedf188-5d0f-4520-b49f-f7bafb8c1361","expr":"result == (clazz != null && classLoader != null && clazz.equals(classLoader.loadClass(clazz.getName())))","rationale":"This invariant expresses the direct meaning of the method: true iff loadClass finds the same class as clazz.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:54.264717102Z"}
{"id":"7d5b9768-ff49-4c8a-a5a1-77a5286646a2","expr":"(!result) || (clazz.getName() != null && !clazz.getName().isEmpty())","rationale":"If result is true, loading the class by name succeeded, so the name must be valid and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isLoadable(Class<?>,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:54.264717102Z"}
{"id":"2207ee5d-4fbd-45a1-ae7b-b34dc6f1829c","expr":"name == null || name.length() <= 7","rationale":"The method returns null if name is null, otherwise proceeds only if name length is at most 7.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:54.459066535Z"}
{"id":"420703a8-861e-4fd4-8fea-26a6b4a23054","expr":"name == null || !name.isEmpty()","rationale":"An empty name string is unlikely to correspond to a primitive type name.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:54.459066535Z"}
{"id":"341f4239-4d8b-465b-8d7d-e375d615963e","expr":"name != null || true","rationale":"Name can be null (method parameter is annotated @Nullable).","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:54.459066535Z"}
{"id":"a4660d8f-1f5c-4e7b-b6ad-125a55db1146","expr":"name == null || !name.contains(\".\")","rationale":"Primitive type names do not contain package separators.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:54.459066535Z"}
{"id":"65948fd8-ec59-424d-9b90-a81ae9cf20fa","expr":"result == null || result.isPrimitive()","rationale":"If a matching primitive class name is provided, result is the primitive Class object; otherwise null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:54.955683171Z"}
{"id":"f77a2c36-b06e-4fbd-9658-bc743bc222e8","expr":"result == null || name != null","rationale":"primitiveTypeNameMap is accessed only if name is not null, thus non-null result implies non-null name.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:54.955683171Z"}
{"id":"20cd47ad-efa4-4a0d-98db-7c25f762b1a3","expr":"clazz != null","rationale":"The method asserts that clazz is not null, so it must be non-null here.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:57.596307877Z"}
{"id":"3bf816e1-9aaa-4399-b64f-ee700a43b0ef","expr":"clazz.isPrimitive() == false","rationale":"The class cannot be a primitive itself if it's a wrapper.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:57.596307877Z"}
{"id":"9d33659a-57c4-431f-8945-5f8c13adc024","expr":"clazz.isInterface() == false","rationale":"Primitive wrappers are classes, not interfaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:57.596307877Z"}
{"id":"76e2935e-430b-4b0b-b302-b1b226eb9353","expr":"clazz != null","rationale":"The method starts by asserting that clazz must not be null","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveOrWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:58.229086589Z"}
{"id":"138395b8-4d3f-47cb-bbf0-f54680039666","expr":"!result || clazz.isPrimitive() == false","rationale":"If result is true (clazz is a primitive wrapper), then clazz.isPrimitive() must be false, because primitive wrappers are not primitive classes.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPrimitiveWrapper(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:41:59.355937618Z"}
{"id":"d8de7af6-59de-459d-9b4f-2ac10bfe876b","expr":"clazz != null","rationale":"The method requires clazz to be non-null as enforced by Assert.notNull.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:04.087013109Z"}
{"id":"94fa35c1-e4ea-43ab-beb6-3115ed4d8c72","expr":"clazz.isArray() == (clazz.getComponentType() != null)","rationale":"A Class object is an array type if and only if its componentType is non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:04.087013109Z"}
{"id":"58a64fe3-9038-4d0d-8646-c488d609771f","expr":"clazz.isArray() || !clazz.isPrimitive()","rationale":"If the class is primitive, it cannot be an array; if it is an array, it is not primitive.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:04.087013109Z"}
{"id":"1cb856a4-12bf-49c0-a9c4-4fe797e04003","expr":"!clazz.isArray() || clazz.getComponentType() != null","rationale":"If clazz is array, the componentType is non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:04.087013109Z"}
{"id":"36452f03-a9d7-4be4-9d57-6c06901f998b","expr":"clazz.getComponentType() == null || clazz.getComponentType().isPrimitive() || !clazz.isArray()","rationale":"If componentType is primitive, clazz must be an array, or componentType can be null otherwise.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:04.087013109Z"}
{"id":"e70c6dce-c6f4-4648-ab0d-57afd9c235c0","expr":"!result || clazz.isArray()","rationale":"If result is true (clazz is a primitive array), then clazz must be an array.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:04.772732835Z"}
{"id":"55f4bc3c-3620-4b34-b6a2-7b61a67eaff8","expr":"!result || clazz.componentType().isPrimitive()","rationale":"If result is true, the component type of clazz must be primitive.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:04.772732835Z"}
{"id":"47828ef4-72da-4393-b29c-2dc2ae6eaee2","expr":"result == (clazz.isArray() && clazz.componentType().isPrimitive())","rationale":"This matches the method's true return value logic.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPrimitiveArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:04.772732835Z"}
{"id":"6f0ad49f-e0f3-4930-b34a-dc160a1d2658","expr":"clazz != null","rationale":"The method asserts that clazz is not null, so it cannot be null at this point.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapperArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:06.136767636Z"}
{"id":"6a28fb96-31c9-4efe-9038-17b8234f6d12","expr":"clazz.isArray() == (clazz.getComponentType() != null)","rationale":"Java arrays have a non-null componentType, so isArray() is true iff componentType() is not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapperArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:06.136767636Z"}
{"id":"e5fcd3f5-62eb-45ee-a048-93efcf7c5007","expr":"!clazz.isArray() || clazz.getComponentType() != null","rationale":"If clazz is not an array, componentType could be null, but this invariant ensures safe usage.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapperArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:06.136767636Z"}
{"id":"0f5b1bd2-54ce-4426-8dca-768592831058","expr":"clazz.isArray() == (clazz.getName().startsWith(\"[\") )","rationale":"Array classes in Java have class names that start with the '[' character.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapperArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:06.136767636Z"}
{"id":"58373f2a-8c6d-4219-b2b6-534720c5c26e","expr":"clazz.isArray() && clazz.getComponentType() != null","rationale":"If this method intends to call isPrimitiveWrapper on componentType, clazz must be an array and componentType must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isPrimitiveWrapperArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:06.136767636Z"}
{"id":"d4a282ea-0111-4dc5-bab7-a4c568408db4","expr":"clazz != null","rationale":"The parameter 'clazz' must not be null as asserted by the method precondition.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:07.961557332Z"}
{"id":"0fc13f38-96a2-408e-b944-50c1c55389a7","expr":"clazz.getName() != null","rationale":"Class names are always non-null so this invariant ensures clazz has a valid name.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:07.961557332Z"}
{"id":"9e513ab2-198c-4fdf-a27e-c1de24c55db4","expr":"clazz.isArray() == result || !clazz.isArray()","rationale":"The method returns true only if clazz is an array, so if result is true clazz.isArray() must be true.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPrimitiveWrapperArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:09.357131343Z"}
{"id":"0740b367-b615-4705-b6d4-824ed330dbfe","expr":"!result || clazz.isArray()","rationale":"If the result is true, clazz must be an array because the logic depends on clazz.isArray().","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPrimitiveWrapperArray(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:09.357131343Z"}
{"id":"4c2818bf-ce45-4e46-953b-787f8c209473","expr":"type != null || true","rationale":"type is nullable as indicated by the @Nullable annotation.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isVoidType(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:11.234743300Z"}
{"id":"6c1d9144-c188-4057-a79b-c5852185ae69","expr":"!result || type != null","rationale":"The method returns false if type is null, so result implies type != null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isVoidType(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:14.473821484Z"}
{"id":"d3e7b54b-d28c-4495-95a3-345ae357ee43","expr":"type != null","rationale":"The method expects a non-null Class type to evaluate.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isSimpleValueType(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:15.225019126Z"}
{"id":"d2d14ae3-77a5-47f5-8644-1daa35e085b8","expr":"result != null","rationale":"Because primitiveTypeToWrapperMap should contain all primitive keys except void, and clazz is non-null, result is never null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:16.704290836Z"}
{"id":"6f818067-07ec-4fa5-9edf-6286297f27aa","expr":"result.isPrimitive() == false || result == clazz","rationale":"If result differs from clazz, then clazz was primitive; result is wrapper, so result.isPrimitive() == false. If result equals clazz, result.isPrimitive() may be true.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:16.704290836Z"}
{"id":"ac90960e-e40b-4987-9944-57826b0c0726","expr":"lhsType != null && rhsType != null","rationale":"Both lhsType and rhsType are required non-null as per Assert.notNull before any logic.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignable(Class<?>,Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:20.787841240Z"}
{"id":"58b237dc-c781-4083-a11e-f431b54aa8a4","expr":"type != null","rationale":"Method assertion 'Assert.notNull(type, \"Type must not be null\")' guarantees 'type' is non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:25.048354784Z"}
{"id":"e876b904-ce8a-4577-bfd3-325d6b3aa705","expr":"(value == null) || (value.getClass() != null)","rationale":"Java API guarantees Object.getClass() returns non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:25.048354784Z"}
{"id":"714b9540-1ac2-46ee-a04a-8636d29031b4","expr":"(value != null) || (!type.isPrimitive())","rationale":"Method returns 'true' only if either value is non-null or type is not primitive.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:25.048354784Z"}
{"id":"c2e6b8fe-474f-4bf0-b990-d5dc0b58e3b0","expr":"value != null || type != null","rationale":"'type' is not null, so this expression is true if value is null; no contradiction.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:25.048354784Z"}
{"id":"8559bdf7-5399-42cd-a698-632f6c87b316","expr":"!type.isPrimitive() || value != null","rationale":"If type is primitive, then value must be non-null for the method to return true.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:25.048354784Z"}
{"id":"9e88ba37-3446-44ef-b7e0-137ac9c3ef8f","expr":"(value != null) == result || (value == null && result == !type.isPrimitive())","rationale":"This condition matches the method's returned boolean logic.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:26.220002208Z"}
{"id":"2990ce34-6d0f-4f7d-93f5-2ae1a6b06efc","expr":"!result || (value == null && !type.isPrimitive())","rationale":"If result is true with null value, type cannot be primitive.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isAssignableValue(Class<?>,Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:26.220002208Z"}
{"id":"cb536b79-cdb0-47e6-b686-47002de01ff2","expr":"resourcePath != null","rationale":"The method asserts that resourcePath is not null at entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:27.299726273Z"}
{"id":"f5325280-2ee3-43ad-ac0a-c5105a1b74cb","expr":"resourcePath.indexOf('/') >= -1","rationale":"The resourcePath string may or may not contain path separators.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:27.299726273Z"}
{"id":"d50f1e40-e516-4009-a039-f3dd696ab087","expr":"resourcePath.indexOf('.') >= -1","rationale":"The resourcePath string may or may not contain package separators.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:27.299726273Z"}
{"id":"12607d38-9f6d-46ac-ab25-7e88adf311e7","expr":"resourcePath.length() >= 0","rationale":"Length of string resourcePath is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:27.299726273Z"}
{"id":"2df5033d-f24e-4b46-97fd-195d7c0d63bb","expr":"className != null","rationale":"The method asserts className is not null, so it must be non-null at method entry.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertClassNameToResourcePath(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:29.927535696Z"}
{"id":"1ebcd3be-f16f-4d10-a136-e8f084938c76","expr":"!className.isEmpty()","rationale":"A fully qualified class name is expected to be non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertClassNameToResourcePath(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:29.927535696Z"}
{"id":"ee7eee47-3149-4577-a0d2-06fb5f5e3ef9","expr":"className.indexOf('.') >= 0 || className.indexOf('.') == -1","rationale":"Class name may or may not contain dots; no constraint forbids either.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertClassNameToResourcePath(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:29.927535696Z"}
{"id":"e42984b1-978b-4dbf-826a-c2ec2312c001","expr":"result.equals(resourcePath.replace('/', '.'))","rationale":"The method returns resourcePath.replace(PATH_SEPARATOR, PACKAGE_SEPARATOR), which from context are '/' and '.', so this must hold.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:32.065575480Z"}
{"id":"edd5da97-19e6-482e-85f8-a8104c0a43b8","expr":"!result.contains(\"/\")","rationale":"The result converts slashes to dots, so result can't contain slashes.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:32.065575480Z"}
{"id":"8d391eef-f690-42da-9ba9-014d40a0a110","expr":"result.length() == resourcePath.length()","rationale":"Replacing one character with another preserves string length.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:32.065575480Z"}
{"id":"455a5c34-9ba9-4bfd-9b09-e1850029ffd8","expr":"result.equals(className.replace('.', '/'))","rationale":"Result string should equal the className with '.' replaced by '/'.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertClassNameToResourcePath(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:32.223419644Z"}
