{"id":"edddad3d-86dc-45f8-8e10-df4df106971f","expr":"args.length <= 1000","rationale":"Assuming a practical limit on the number of arguments passed to the proxied method for system sanity.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.MethodProxy#invoke(Object,Object[]):Object","file":"org/springframework/cglib/proxy/MethodProxy.java","createdAt":"2026-09-10T11:26:34.352018334Z"}
