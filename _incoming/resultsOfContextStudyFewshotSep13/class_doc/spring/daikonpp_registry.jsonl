{"id":"ceecb40a-fa37-4f14-9a73-6707e79d41ab","expr":"!key.isEmpty()","rationale":"Key is not empty, as empty keys are not likely valid.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getRequiredProperty(String,Class<T>):T","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:49.576052038Z"}
