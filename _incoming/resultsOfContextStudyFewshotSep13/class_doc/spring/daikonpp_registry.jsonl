{"id":"3581af99-8e75-4894-9ac2-baa5c11c7f6b","expr":"type == null || type.getSimpleName() != null","rationale":"If type is non-null, getSimpleName() should return a non-null string.","kind":"METHOD_ENTRY","element":"org.springframework.aot.hint.SimpleTypeReference#buildName(TypeReference,StringBuilder):void","file":"org/springframework/aot/hint/SimpleTypeReference.java","createdAt":"2026-09-10T11:16:14.313423193Z"}
{"id":"2b4f0e98-b71a-42ae-bf89-c69e5f49e49a","expr":"type == null || type.getEnclosingType() == null || !type.getEnclosingType().equals(type)","rationale":"EnclosingType, if present, should not be the type itself to avoid direct cycles.","kind":"METHOD_ENTRY","element":"org.springframework.aot.hint.SimpleTypeReference#buildName(TypeReference,StringBuilder):void","file":"org/springframework/aot/hint/SimpleTypeReference.java","createdAt":"2026-09-10T11:16:14.313423193Z"}
{"id":"ada2e190-5324-4bf0-bd72-0b570c308ea0","expr":"type == null || type.getSimpleName().length() > 0","rationale":"The simple name should be a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.aot.hint.SimpleTypeReference#buildName(TypeReference,StringBuilder):void","file":"org/springframework/aot/hint/SimpleTypeReference.java","createdAt":"2026-09-10T11:16:14.313423193Z"}
{"id":"85a7c560-15cb-4676-9d30-29dd06f70a2e","expr":"name != null && !name.isEmpty() || name == null || name.isEmpty()","rationale":"name can be null or empty; if not, it must be some string potentially checked by startsWith.","kind":"METHOD_ENTRY","element":"org.springframework.aot.hint.SimpleTypeReference#isPrimitive(String):boolean","file":"org/springframework/aot/hint/SimpleTypeReference.java","createdAt":"2026-09-10T11:16:14.333215979Z"}
