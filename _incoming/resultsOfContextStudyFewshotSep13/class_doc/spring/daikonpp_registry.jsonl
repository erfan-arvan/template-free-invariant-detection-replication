{"id":"6c90e9b5-72be-4596-b481-34b777ddc38a","expr":"attr != null && attr.isCodeAttribute() == false","rationale":"At method entry, attr is expected not to be a code attribute since visitAttribute is for non-code attributes.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-10T11:21:57.088468184Z"}
{"id":"c18dcd4c-1bad-44fc-8605-c0e717417b4c","expr":"attr != null && attr.getName() != null && attr.getName().length() <= 255","rationale":"To ensure attribute names are reasonably sized for processing.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-10T11:21:57.088468184Z"}
{"id":"26166b21-0db8-43bc-9cd7-58bc0f22da95","expr":"attr != null && !attr.isUnknown()","rationale":"Attr passed to visitAttribute should be a known attribute type.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-10T11:21:57.088468184Z"}
{"id":"f328f59f-19ed-49b9-8fb8-edd3c573f08c","expr":"attr != null","rationale":"Method expects attr argument to be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-10T11:21:57.088468184Z"}
{"id":"f8f65345-d381-404a-8181-63b4e29d06c0","expr":"owner != null","rationale":"The owner typically represents the internal name of the class and should not be null when visiting an outer class.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-10T11:21:57.253387097Z"}
