{"id":"999e392c-069c-4a3a-a1f0-11fc67421783","expr":"genericMethod.getGenericParameterTypes().length == genericMethod.getParameterTypes().length","rationale":"Generic parameter types length matches the raw parameter types length in a method.","kind":"METHOD_ENTRY","element":"org.springframework.core.BridgeMethodResolver#isResolvedTypeMatch(Method,Method,Class<?>):boolean","file":"org/springframework/core/BridgeMethodResolver.java","createdAt":"2026-09-10T10:50:20.020912145Z"}
