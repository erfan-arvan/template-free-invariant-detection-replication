{"id":"0bae3989-37e5-4ba4-a565-93eafeea0276","expr":"signature == null || !signature.isEmpty()","rationale":"Signature, if present, should be a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-10T11:21:36.874216293Z"}
{"id":"0e6cf1bb-fb36-41d2-8aee-7c58376f34eb","expr":"superName == null || !superName.isEmpty()","rationale":"superName is null if class has no superclass, otherwise non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-10T11:21:36.874216293Z"}
{"id":"e798008a-d7f0-4588-ad50-591937211473","expr":"version >= 0","rationale":"Typically, version should be non-negative as class file versions are unsigned.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-10T11:21:38.169717416Z"}
{"id":"afb15872-3336-4423-8d78-376da0ecdb01","expr":"name != null","rationale":"The class name should not be null in visit.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-10T11:21:38.169717416Z"}
