{"id":"8fb4061a-a078-41c3-b1d7-c5cfdf7402ad","expr":"logger.isDebugEnabled() || !logger.isTraceEnabled()","rationale":"This captures the condition that trace level logging is only meaningful if debug level logging is also enabled.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-10T10:52:39.900520710Z"}
