{"id":"dfeba7a6-73a5-406c-843f-0f7ecbcc1792","expr":"dtd != null && !dtd.isEmpty() && dtd.indexOf('<') >= 0 && dtd.indexOf('>') > dtd.indexOf('<')","rationale":"The dtd string, being passed to streamWriter.writeDTD, should represent a valid DTD fragment which usually includes markup within angle brackets.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#dtdInternal(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-10T10:33:26.019126838Z"}
