{"id":"3e07929b-9f87-4d6d-ad8d-2c5f164c2cfd","expr":"result != null","rationale":"The method guarantees to return a non-null instance.","kind":"METHOD_EXIT","element":"org.springframework.objenesis.SpringObjenesis#newInstance(Class<T>):T","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-10T11:38:40.472685132Z"}
{"id":"30919810-1b83-4364-94d7-ab79f900f88b","expr":"clazz.isInstance(result)","rationale":"The returned result is guaranteed to be an instance of the clazz parameter.","kind":"METHOD_EXIT","element":"org.springframework.objenesis.SpringObjenesis#newInstance(Class<T>):T","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-10T11:38:40.472685132Z"}
