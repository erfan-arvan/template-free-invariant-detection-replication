{"id":"69e6e5df-1ece-4090-9473-b0e6436982d1","expr":"defaultValue != null || key != null","rationale":"Either defaultValue is provided or key is not null to attempt property lookup.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getProperty(String,Class<T>,T):T","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:45.393845682Z"}
{"id":"954c2c90-5519-4fd8-a4b4-1f5c9fd006ed","expr":"(key != null && key.length() > 0) || defaultValue != null","rationale":"Either a valid key string is supplied or a default value is supplied for fallback.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getProperty(String,Class<T>,T):T","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:45.393845682Z"}
{"id":"07372801-7ac3-40b8-b06a-42ab3ffd2350","expr":"key != null && !key.isEmpty() && key.trim().length() > 0","rationale":"The key should be a meaningful string to retrieve a property.","kind":"METHOD_ENTRY","element":"org.springframework.core.env.AbstractPropertyResolver#getRequiredProperty(String):String","file":"org/springframework/core/env/AbstractPropertyResolver.java","createdAt":"2026-09-10T11:08:45.686802072Z"}
