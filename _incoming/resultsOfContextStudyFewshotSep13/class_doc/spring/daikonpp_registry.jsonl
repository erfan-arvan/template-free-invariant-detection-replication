{"id":"204d8a41-25bd-45a5-8785-81cfce4e81df","expr":"publicId == null || publicId.length() > 0","rationale":"If 'publicId' is non-null, it is included as a PUBLIC identifier, so it is probably not empty","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:24.465607443Z"}
{"id":"29362221-a1ee-47b0-9bbf-fa49a5474b36","expr":"name.length() > 0","rationale":"The DOCTYPE name should be non-empty for a well-formed DTD declaration","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:24.465607443Z"}
{"id":"b83b0b5b-0cd9-4d20-a289-816ad2146b72","expr":"systemId.length() > 0","rationale":"The systemId string must be non-empty for a valid DOCTYPE system identifier","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractStaxHandler#startDTD(String,String,String):void","file":"org/springframework/util/xml/AbstractStaxHandler.java","createdAt":"2026-09-10T10:34:24.465607443Z"}
