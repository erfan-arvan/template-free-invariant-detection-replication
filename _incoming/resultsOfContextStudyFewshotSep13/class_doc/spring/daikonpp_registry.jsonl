{"id":"7e99aeaa-ae62-4cf1-b8a2-99cd7dea1d88","expr":"result != null","rationale":"The StringJoiner always produces a non-null string, so result must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classNamesToString(Collection<Class<?>>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:45.787077254Z"}
