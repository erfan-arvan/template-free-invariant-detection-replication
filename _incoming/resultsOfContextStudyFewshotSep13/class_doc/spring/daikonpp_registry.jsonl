{"id":"55b37764-f4fa-4b0c-b49d-340c528b1b55","expr":"object != null","rationale":"The method calls object.getClass(), so object must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isCglibProxy(Object):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:43:24.212121344Z"}
