{"id":"8157f532-b7ce-420d-b45c-dc0e8e97845a","expr":"owner != null","rationale":"owner is expected to be the internal name of the method's owner class and thus non-null","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T11:37:15.057617525Z"}
{"id":"1d939ddc-2f7e-41bc-894d-20a73886418b","expr":"name != null","rationale":"name is the method's name and should not be null for a valid method instruction","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T11:37:15.057617525Z"}
{"id":"d656f19b-19cc-4e0e-b18e-8b5d1a491a48","expr":"descriptor != null","rationale":"descriptor is the method descriptor string and is required for valid method definition","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String,boolean):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T11:37:15.057617525Z"}
