{"id":"02a94d47-819b-4e34-ab52-6415acb25561","expr":"props.size() >= 0","rationale":"Properties size cannot be negative.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderUtils#fillProperties(Properties,EncodedResource):void","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T11:01:39.143615285Z"}
