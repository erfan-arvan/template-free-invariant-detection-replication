{"id":"e757f394-5a7b-42f7-bc0f-ec1d698ded3a","expr":"name.equals(name.trim())","rationale":"The entity name should have no leading or trailing whitespace.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.StaxStreamHandler#endEntity(String):void","file":"org/springframework/util/xml/StaxStreamHandler.java","createdAt":"2026-09-10T10:33:29.044250855Z"}
{"id":"32b61386-491f-40f3-b4a2-e54ce1327740","expr":"index >= 0","rationale":"Attribute indices are typically zero-based and non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.AbstractXMLStreamReader#getAttributeLocalName(int):String","file":"org/springframework/util/xml/AbstractXMLStreamReader.java","createdAt":"2026-09-10T10:33:29.298507728Z"}
