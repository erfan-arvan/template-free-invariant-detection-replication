{"id":"d1013b77-8557-4fbf-b818-1af2408b176f","expr":"result != null","rationale":"The method always returns a MethodVisitor, either from pass.visitMethod(...) or direct.visitMethod(...), both presumably non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodFilterTransformer#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/transform/MethodFilterTransformer.java","createdAt":"2026-09-10T11:20:03.617013523Z"}
