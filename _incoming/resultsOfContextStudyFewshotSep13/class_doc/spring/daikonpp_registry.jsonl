{"id":"f4f47542-5189-40dd-9390-7d1079020928","expr":"descriptor != null","rationale":"descriptor is typically a non-null string representing the annotation descriptor.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInsnAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T11:29:03.523524821Z"}
