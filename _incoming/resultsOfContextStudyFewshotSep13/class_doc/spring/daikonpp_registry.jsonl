{"id":"f977256b-8290-4243-bbab-69522e0e3e9f","expr":"!result.isBridge() || !bridgeMethod.isBridge()","rationale":"At least one of result or bridgeMethod is not a bridge method (the resolved method is typically not a bridge method).","kind":"METHOD_EXIT","element":"org.springframework.core.BridgeMethodResolver#getMostSpecificMethod(Method,Class<?>):Method","file":"org/springframework/core/BridgeMethodResolver.java","createdAt":"2026-09-10T10:50:08.676749523Z"}
