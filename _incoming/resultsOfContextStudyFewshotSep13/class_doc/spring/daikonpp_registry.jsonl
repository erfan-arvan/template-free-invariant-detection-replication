{"id":"e0b8f7a6-94fe-411c-b3d9-68a67e85ca24","expr":"clazz == null || clazz.getName().contains(\".\") == (result.length() > 0)","rationale":"If clazz is null, the method returns empty string. If clazz name contains package separator '.', result is non-empty string as package path","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:41.023832106Z"}
{"id":"dec6fd7a-6527-4516-93ae-3e425b831cbd","expr":"clazz == null || result.equals(clazz.getPackageName().replace('.', '/'))","rationale":"The method returns the package name of clazz replacing '.' with '/'","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:41.023832106Z"}
{"id":"56d44364-777a-48fe-8b6c-7519336d77be","expr":"clazz == null || !result.contains(\".\")","rationale":"Package separator '.' are replaced by '/' so result cannot contain '.'","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:41.023832106Z"}
{"id":"fd34fbb9-364e-46d3-a472-d12cb0316c3f","expr":"result != null && (result.equals(\"\") || result.indexOf('.') == -1)","rationale":"Result represents resource path with only slashes, no dots","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:41.023832106Z"}
{"id":"53c05e1e-00d1-4897-8969-b6a289e4ffc4","expr":"result.equals(\"\") || result.indexOf('/') >= 0","rationale":"If package exists, result contains slashes for package path; or it's empty for default package","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classPackageAsResourcePath(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:41.023832106Z"}
{"id":"47b27a42-1610-4d79-a72d-62681e64bfe4","expr":"result != null","rationale":"The method returns a String, so result is expected to be non-null for any valid return.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classNamesToString(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:42.092045052Z"}
{"id":"ebc9cc2a-23f8-4ad2-8a65-8c8f73ac5296","expr":"result.startsWith(\"[\") && result.endsWith(\"]\")","rationale":"The String result is expected to mimic a collection representation enclosing with brackets.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classNamesToString(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:42.092045052Z"}
{"id":"3cee4a59-0a1b-466c-af04-95eb91d19e1f","expr":"classes == null || result.length() >= 2","rationale":"If the input is null or empty, the result is an empty brackets string of length >= 2.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#classNamesToString(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:42.092045052Z"}
{"id":"45f39ff0-ca49-4a45-948e-d91f5ce1c417","expr":"classes == null || !classes.isEmpty()","rationale":"The method returns \"[]\" if the classes Collection is empty or null, so this indicates that at method entry, classes is either null or non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#classNamesToString(Collection<Class<?>>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:42:44.938904265Z"}
