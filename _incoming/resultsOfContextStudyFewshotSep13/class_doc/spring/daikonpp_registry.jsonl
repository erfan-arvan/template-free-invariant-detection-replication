{"id":"ca2df177-14e8-4d67-be18-61e528d7dd90","expr":"clazz != null","rationale":"The method immediately calls clazz.getModifiers(), so clazz must be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isStaticClass(Class<?>):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T10:43:18.224397213Z"}
