{"id":"1131c2a0-0c29-4df0-b978-2e3d589f6574","expr":"text != null && !text.isEmpty() || text == null || text.isEmpty()","rationale":"This invariant states that text can be null or empty or non-empty string, expressing no restriction on nullness or emptiness.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeCharacters(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-10T10:32:52.402877465Z"}
