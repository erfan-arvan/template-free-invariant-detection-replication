{"id":"d7bdb2f9-c027-4989-969c-da2d3236bdf9","expr":"clazz.isPrimitive() == false || clazz.isArray() == false","rationale":"The clazz may not be a primitive type or array type.","kind":"METHOD_ENTRY","element":"org.springframework.objenesis.SpringObjenesis#getInstantiatorOf(Class<T>):ObjectInstantiator<T>","file":"org/springframework/objenesis/SpringObjenesis.java","createdAt":"2026-09-10T11:38:40.445179144Z"}
