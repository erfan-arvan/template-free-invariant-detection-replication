{"id":"df63c8c6-8781-4287-a5f8-6a13ff0b88a4","expr":"(opcode == 188) == (operand == 4 || operand == 5 || operand == 6 || operand == 7 || operand == 8 || operand == 9 || operand == 10 || operand == 11)","rationale":"NEWARRAY opcode operand must be one of the allowed array type codes.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitIntInsn(int,int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-10T11:36:59.990025445Z"}
