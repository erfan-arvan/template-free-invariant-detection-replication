{"id":"5fbfcf69-80b5-4f2f-9035-e3031504335a","expr":"parameterTypes != null","rationale":"Parameter types array must be non-null to retrieve a method.","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.reflect.ClassReflection#getDeclaredMethod(Class,String,Class):Method","file":"com/badlogic/gdx/utils/reflect/ClassReflection.java","createdAt":"2026-09-10T17:05:35.295043651Z"}
