{"id":"99e54938-5252-49f7-ba43-d6a8526d6782","expr":"value == null || value.length() <= 2147483647","rationale":"Length must fit within the int type range.","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.DataOutput#writeString(String):void","file":"com/badlogic/gdx/utils/DataOutput.java","createdAt":"2026-09-10T17:16:18.588065147Z"}
{"id":"15ad57d0-4a73-4d16-a0d7-c89d4d3984d2","expr":"value == null || value.length() >= 0 && (value.length() == 0 || value.charAt(value.length() - 1) >= 0)","rationale":"Characters in a String have codepoints between 0 and 65535.","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.DataOutput#writeString(String):void","file":"com/badlogic/gdx/utils/DataOutput.java","createdAt":"2026-09-10T17:16:18.588065147Z"}
{"id":"4743f19a-be6f-4237-af94-bcb7c7e91e27","expr":"value == null || value.length() > 0","rationale":"The method returns early for null or empty strings, so at this exit point, if value is not null it must be non-empty.","kind":"METHOD_EXIT","element":"com.badlogic.gdx.utils.DataOutput#writeString(String):void","file":"com/badlogic/gdx/utils/DataOutput.java","createdAt":"2026-09-10T17:16:18.591844318Z"}
