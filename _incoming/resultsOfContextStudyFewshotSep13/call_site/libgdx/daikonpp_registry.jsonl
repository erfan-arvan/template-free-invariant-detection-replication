{"id":"c94df77e-5686-42f8-ac07-56bfe3d75316","expr":"c.getDeclaredMethods().length >= 0","rationale":"Array length is always zero or positive","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.reflect.ClassReflection#getDeclaredMethods(Class):Method[]","file":"com/badlogic/gdx/utils/reflect/ClassReflection.java","createdAt":"2026-09-10T17:05:35.262557309Z"}
{"id":"492c1291-28e7-4b33-add2-0d0dc58ab498","expr":"c.getDeclaredMethods().length == c.getDeclaredMethods().length","rationale":"This is trivial, should be avoided but included for template.","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.reflect.ClassReflection#getDeclaredMethods(Class):Method[]","file":"com/badlogic/gdx/utils/reflect/ClassReflection.java","createdAt":"2026-09-10T17:05:35.262557309Z"}
{"id":"65ecaa54-0190-4f2c-8002-f6dc899e730c","expr":"(c.getDeclaredMethods() == null) == false","rationale":"Equivalent to c.getDeclaredMethods() != null, included to demonstrate logical equivalence.","kind":"METHOD_ENTRY","element":"com.badlogic.gdx.utils.reflect.ClassReflection#getDeclaredMethods(Class):Method[]","file":"com/badlogic/gdx/utils/reflect/ClassReflection.java","createdAt":"2026-09-10T17:05:35.262557309Z"}
