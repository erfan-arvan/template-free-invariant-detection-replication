{"id":"bdc995de-5675-41a7-b125-861b59086065","expr":"props != null","rationale":"The method modifies the given Properties instance, so it must not be null.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderSupport#loadProperties(Properties):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T04:54:23.778792095Z"}
{"id":"0f741b3f-0fb2-4033-9973-801059c4668d","expr":"props.size() >= 0","rationale":"Properties size cannot be negative.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderSupport#loadProperties(Properties):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T04:54:23.778792095Z"}
