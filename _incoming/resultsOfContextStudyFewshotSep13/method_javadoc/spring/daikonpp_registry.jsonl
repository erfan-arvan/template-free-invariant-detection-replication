{"id":"0499fb5d-f806-494b-a637-efef336e94e2","expr":"buffer.length() > 0 && buffer.charAt(0) == '['","rationale":"The method always appends '[' as the first character to buffer.","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleStart(StringBuilder,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-10T04:48:06.469625800Z"}
{"id":"0f03de19-d7d9-44e8-8daa-8e5f27229c6e","expr":"obj != null","rationale":"Method calls obj.getClass(), so obj cannot be null here.","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleStart(StringBuilder,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-10T04:48:06.469625800Z"}
{"id":"f3f2283b-8ad7-44a4-a081-b2cd34a6681f","expr":"buffer.toString().startsWith(\"[\")","rationale":"Regardless of obj type, the first appended character is '['.","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleStart(StringBuilder,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-10T04:48:06.469625800Z"}
{"id":"f65f7b6d-c13d-4ec7-abb3-88c456870445","expr":"buffer != null","rationale":"buffer is used for appending text, so it should not be null","kind":"METHOD_ENTRY","element":"org.springframework.core.style.DefaultToStringStyler#styleIdentityHashCode(StringBuilder,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-10T04:48:06.476556928Z"}
