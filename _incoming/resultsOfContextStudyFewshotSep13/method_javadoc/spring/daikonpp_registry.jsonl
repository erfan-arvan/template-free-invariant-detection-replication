{"id":"d1779771-6188-4ddf-86ab-14e361aab5f0","expr":"location != null","rationale":"Since location is used in a method call, it should not be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ResourceUtils#toURI(String):URI","file":"org/springframework/util/ResourceUtils.java","createdAt":"2026-09-10T04:38:13.793806991Z"}
