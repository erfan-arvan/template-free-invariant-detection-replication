{"id":"fe32ea8b-3936-4e24-b3a7-2df796d2b1dc","expr":"desc != null","rationale":"The 'desc' parameter is a descriptor string likely required and non-null for type annotations.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTypeAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T05:05:07.055536202Z"}
