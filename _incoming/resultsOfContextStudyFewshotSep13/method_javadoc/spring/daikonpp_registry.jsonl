{"id":"31a9ac2f-9064-4fa7-8733-6ccad64809e0","expr":"result != null","rationale":"The Java Class#getTypeName() method returns a non-null String.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#getQualifiedName(Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T04:44:40.276827624Z"}
