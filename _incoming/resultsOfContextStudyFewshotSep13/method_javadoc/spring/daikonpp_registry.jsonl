{"id":"a2f224fa-c91c-4c8b-917a-727231628dc2","expr":"method.getName() != null","rationale":"Method.getName() always returns a non-null name string.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getQualifiedMethodName(Method,Class<?>):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T04:44:42.480794912Z"}
