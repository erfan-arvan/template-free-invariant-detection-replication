{"id":"ddd0c863-4244-4dac-a348-dab7adf332ed","expr":"bsm != null","rationale":"The bootstrap method handle (bsm) must be non-null for a valid invoke dynamic instruction.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitInvokeDynamicInsn(String,String,Handle,Object):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T05:05:07.061957821Z"}
