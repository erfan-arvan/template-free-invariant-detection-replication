{"id":"6fcef45f-be6b-42de-80cc-aa85ae68d3d6","expr":"callbackTypes != null","rationale":"The method uses callbackTypes.length and callbackTypes[i], so callbackTypes must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.CallbackInfo#determineTypes(Class[],boolean):Type[]","file":"org/springframework/cglib/proxy/CallbackInfo.java","createdAt":"2026-09-10T05:05:44.388576668Z"}
