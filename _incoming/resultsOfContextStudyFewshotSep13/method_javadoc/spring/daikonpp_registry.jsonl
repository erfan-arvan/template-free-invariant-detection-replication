{"id":"b9705a98-69b3-4398-9e2c-d10f561d7534","expr":"name != null && !name.isEmpty()","rationale":"name should be a valid field name string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T05:05:06.922780487Z"}
