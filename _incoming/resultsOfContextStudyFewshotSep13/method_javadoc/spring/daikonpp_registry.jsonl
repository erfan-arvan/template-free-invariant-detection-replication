{"id":"3283365e-5242-4ae0-aaa0-d1efa8277a9c","expr":"start != null","rationale":"start label must be non-null as it is passed to Handler constructor","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T05:06:06.414753457Z"}
{"id":"9c94092c-5f86-4741-9d57-7f8018ab0f77","expr":"end != null","rationale":"end label must be non-null as it is passed to Handler constructor","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T05:06:06.414753457Z"}
{"id":"834f902e-7a5d-403d-b824-b56d47234b7e","expr":"handler != null","rationale":"handler label must be non-null as it is passed to Handler constructor","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T05:06:06.414753457Z"}
{"id":"9424a38a-ee9f-469a-bc20-78ee36cb3dec","expr":"descriptor != null","rationale":"The descriptor string representing the annotation type should not be null for creating an annotation.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTryCatchAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-10T05:06:06.426155553Z"}
