{"id":"1b001f93-01d2-42f1-bea8-071ea69d6013","expr":"propertiesArray != null || propertiesArray == null","rationale":"The input propertiesArray parameter may be null or not based on usage.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderSupport#setPropertiesArray(Properties):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T04:54:07.129910959Z"}
{"id":"51d5316f-3d6e-435d-a2de-6a2d94c88454","expr":"locations != null","rationale":"The method expects an array of Resource locations to set for loading properties files.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderSupport#setLocations(Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T04:54:09.334990608Z"}
{"id":"664162a2-a7fc-4dbf-82c7-0891526aa325","expr":"locations.length >= 0","rationale":"Java arrays have non-negative length; this is a trivial invariant.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderSupport#setLocations(Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T04:54:09.334990608Z"}
{"id":"f616ffb8-a3e5-4183-bd62-3b74cbe7da4f","expr":"localOverride == true || localOverride == false","rationale":"Boolean variables by nature can only be true or false.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderSupport#setLocalOverride(boolean):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T04:54:10.430374932Z"}
