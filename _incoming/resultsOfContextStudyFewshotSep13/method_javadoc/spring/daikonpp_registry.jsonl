{"id":"204e8805-ee6c-4c86-9ad4-84f2e1b3354b","expr":"result.indexOf('/') >= 0 || clazz.getName().indexOf('.') == -1","rationale":"If the original class name has dots, they become '/', so result contains at least one slash; else no slash is present.","kind":"METHOD_EXIT","element":"org.springframework.asm.Type#getInternalName(Class<?>):String","file":"org/springframework/asm/Type.java","createdAt":"2026-09-10T05:07:54.320641527Z"}
