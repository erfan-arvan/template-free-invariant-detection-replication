{"id":"d1a8bbf5-87cc-4d87-919d-a6faf2a0104b","expr":"name != null","rationale":"Similarly, 'name' should not be null because it is used as a parameter in the invoked methods.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-10T05:05:06.791893416Z"}
