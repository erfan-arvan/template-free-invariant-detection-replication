{"id":"b7aff9e2-2346-49b0-8bed-1938a8c23122","expr":"declaringClass.isAssignableFrom(declaringClass)","rationale":"This expresses a tautological property confirming class identity.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#findPubliclyAccessibleMethodIfPossible(String,Class<?>[],Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T04:45:06.449624831Z"}
