{"id":"e833a0a8-a2ab-43e5-9b22-3c9bd68db645","expr":"maxLocals >= 0","rationale":"Local variables count cannot be negative","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMaxs(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T05:05:07.038318749Z"}
