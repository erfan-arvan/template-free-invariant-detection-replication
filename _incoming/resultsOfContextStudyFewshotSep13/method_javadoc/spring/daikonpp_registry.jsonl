{"id":"dd566c9e-765a-4b88-b34d-20bad546cbff","expr":"name != null","rationale":"The parameter 'name' representing the variable's identifier is expected to be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T05:05:07.025825172Z"}
{"id":"8e4c45ac-b576-4e46-b605-c493396d4ecf","expr":"desc != null","rationale":"Local variable descriptor should be non-null for proper bytecode generation.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T05:05:07.025825172Z"}
{"id":"42c4eb7d-cccb-4916-844f-e326039e7fc6","expr":"start != null","rationale":"Non-null 'start' label is expected to mark the scope of the local variable.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T05:05:07.025825172Z"}
{"id":"874f82bb-37a6-43c8-8fc7-74866911978c","expr":"end != null","rationale":"Non-null 'end' label is required to mark the scope end of the local variable.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T05:05:07.025825172Z"}
{"id":"df490ea1-d2c5-4dde-99db-8f3677005a1e","expr":"index >= 0","rationale":"The 'index' parameter identifies the slot position and must be zero or positive.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLocalVariable(String,String,String,Label,Label,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T05:05:07.025825172Z"}
{"id":"e1edb5ca-1b21-431d-a00a-01c58b9b187f","expr":"line >= 0","rationale":"Line numbers in source code or bytecode generally start from 0 or 1 and should not be negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLineNumber(int,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-10T05:05:07.026329783Z"}
