{"id":"be775c6e-35ce-4488-865e-0d891b5c38cf","expr":"resource.getEncoding() == null || !resource.getEncoding().isEmpty()","rationale":"Encoding is either unspecified (null) or a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(EncodedResource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T04:54:22.064650460Z"}
{"id":"8dcc29fc-76e8-4024-8bcd-06f789975a59","expr":"resource.getResource().exists()","rationale":"The underlying resource should exist to load properties.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderUtils#loadProperties(EncodedResource):Properties","file":"org/springframework/core/io/support/PropertiesLoaderUtils.java","createdAt":"2026-09-10T04:54:22.064650460Z"}
