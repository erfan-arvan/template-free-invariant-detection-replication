{"id":"26969ba3-4ff8-448b-9f2f-4e3b23dcbceb","expr":"locations.length == 0 || locations[0] != null","rationale":"The locations array typically does not contain null elements when non-empty.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderSupport#setLocations(Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T04:54:10.683181350Z"}
{"id":"344eab79-cf99-4d31-a6cd-f0d6b6058ed4","expr":"localOverride || !localOverride","rationale":"localOverride is a boolean, so it must be true or false.","kind":"METHOD_EXIT","element":"org.springframework.core.io.support.PropertiesLoaderSupport#setLocalOverride(boolean):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-10T04:54:11.582092173Z"}
