{"id":"8b9a5c83-082f-4982-a9dd-849bc120dcdb","expr":"(method.isBridge() || (!method.isSynthetic() && true))","rationale":"Reflects partial user-level method criteria excluding the GroovyObject method check.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#isUserLevelMethod(Method):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-10T04:45:12.170022766Z"}
