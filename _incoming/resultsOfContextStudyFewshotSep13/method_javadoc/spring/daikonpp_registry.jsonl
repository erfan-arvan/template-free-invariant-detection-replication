{"id":"e1cfeb68-02b9-4006-9102-db8537e7fa7f","expr":"attr != null","rationale":"The attribute parameter is directly passed to other visitAttribute calls, thus it should be non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.FieldVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/FieldVisitorTee.java","createdAt":"2026-09-10T05:05:06.805598567Z"}
{"id":"88adb8b4-20a0-4f6e-9924-d20b9cc31aa7","expr":"attr.getName() != null","rationale":"Attributes typically have a non-null name; useful for further processing.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.FieldVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/FieldVisitorTee.java","createdAt":"2026-09-10T05:05:06.805598567Z"}
