{"id":"19668455-d207-4ca9-af31-db1ec509dcc2","expr":"type.isInterface() == false","rationale":"You generally cannot instantiate an interface","kind":"METHOD_ENTRY","element":"org.springframework.cglib.beans.BeanCopier#firstInstance(Class):Object","file":"org/springframework/cglib/beans/BeanCopier.java","createdAt":"2026-09-10T05:06:04.108657160Z"}
