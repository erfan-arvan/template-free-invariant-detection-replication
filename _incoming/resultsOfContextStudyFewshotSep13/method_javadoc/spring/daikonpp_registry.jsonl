{"id":"e10e9b21-4572-4a44-960b-481e1bbfe6c1","expr":"result.contains(\")\")","rationale":"The JVM method descriptor has argument types enclosed within parentheses, so ')' must be present.","kind":"METHOD_EXIT","element":"org.springframework.asm.Type#getMethodDescriptor(Type,Type):String","file":"org/springframework/asm/Type.java","createdAt":"2026-09-10T05:08:02.769204125Z"}
{"id":"968d2502-7296-46dd-954e-6adb660d9cfb","expr":"result.endsWith(returnType.getDescriptor())","rationale":"The method descriptor is composed of '(' + argument descriptors + ')' + return type descriptor.","kind":"METHOD_EXIT","element":"org.springframework.asm.Type#getMethodDescriptor(Type,Type):String","file":"org/springframework/asm/Type.java","createdAt":"2026-09-10T05:08:02.769204125Z"}
{"id":"dee700b7-e81b-4009-b643-669a31313968","expr":"method != null && method.getParameterTypes() != null && method.getReturnType() != null","rationale":"The method's parameter types array and return type must be non-null to construct the descriptor.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getMethodDescriptor(Method):String","file":"org/springframework/asm/Type.java","createdAt":"2026-09-10T05:08:04.071641982Z"}
