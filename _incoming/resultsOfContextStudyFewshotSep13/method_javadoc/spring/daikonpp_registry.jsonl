{"id":"4d7cb666-81fd-4d00-b3a5-f2b9e248319e","expr":"method.getDeclaringClass() != null","rationale":"The method's declaring class is not null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Type#getMethodDescriptor(Method):String","file":"org/springframework/asm/Type.java","createdAt":"2026-09-10T05:08:04.071641982Z"}
