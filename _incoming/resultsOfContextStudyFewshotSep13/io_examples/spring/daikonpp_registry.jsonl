{"id":"98fa2682-cfed-4714-8ab3-f81ce6195cb7","expr":"opcode >= 153 && opcode <= 166 || opcode == 198 || opcode == 199","rationale":"Opcode is within the range or set of known jump instruction codes.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitJumpInsn(int,Label):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-11T14:17:47.829539434Z"}
