{"id":"1e4772b1-68e9-4ad1-87a7-ead7ccb975dd","expr":"opcode >= 0","rationale":"Opcode should be non-negative as it represents a valid bytecode instruction.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T14:17:39.413341754Z"}
