{"id":"d7ab5aa5-a6f9-41e9-affb-fe985d5cf3fe","expr":"name != null","rationale":"name is required to create a Signature object without NullPointerException","kind":"METHOD_ENTRY","element":"org.springframework.cglib.proxy.BridgeMethodResolver#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/proxy/BridgeMethodResolver.java","createdAt":"2026-09-11T14:17:42.818622967Z"}
