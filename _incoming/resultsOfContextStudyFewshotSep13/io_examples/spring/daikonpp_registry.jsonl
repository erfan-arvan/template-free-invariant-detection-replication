{"id":"eb3ecbae-7726-49eb-b54e-36b1dca20fa7","expr":"line.trim().startsWith(\"<!--\") || !line.trim().startsWith(\"<!--\")","rationale":"Line either starts with comment start token or it does not; this is a trivial but potentially useful condition.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XmlValidationModeDetector#endComment(String):int","file":"org/springframework/util/xml/XmlValidationModeDetector.java","createdAt":"2026-09-11T14:11:35.911487830Z"}
