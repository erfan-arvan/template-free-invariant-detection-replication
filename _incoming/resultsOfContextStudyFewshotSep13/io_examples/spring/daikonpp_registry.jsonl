{"id":"a8a5e324-2a45-49ef-92f4-9377a4e8524f","expr":"opcode >= 0 && opcode <= 255","rationale":"opcode is typically a bytecode value and hence expected to be within 0 to 255.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitIntInsn(int,int):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-11T14:17:47.810243115Z"}
