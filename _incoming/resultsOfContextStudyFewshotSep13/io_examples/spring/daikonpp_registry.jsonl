{"id":"bdd2530a-11bd-41a0-bc03-e25d17042477","expr":"name != null","rationale":"Name representing field name should be non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T14:17:39.400385808Z"}
