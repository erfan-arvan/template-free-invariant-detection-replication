{"id":"960e7606-cc5b-4d26-a996-48d7866d84f0","expr":"attributePrototypes.isEmpty() == false || attributePrototypes.isEmpty() == true","rationale":"Trivially true but shows method calls are available. This is a placeholder sample.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#collectAttributePrototypes(Attribute.Set):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-11T14:17:44.756391421Z"}
