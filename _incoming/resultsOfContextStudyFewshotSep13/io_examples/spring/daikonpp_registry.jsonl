{"id":"8477b6b3-5c41-4c9b-94ee-cb4bfb3dfb35","expr":"buffer.toString().endsWith(\"]\") || buffer.toString().endsWith(\",\") || buffer.toString().endsWith(\" \") || buffer.toString().endsWith(\"\")","rationale":"In typical toString styling, the buffer may end with delimiters like ']' or ',' or whitespace or empty if untouched.","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleFieldEnd(StringBuilder,String):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.643715217Z"}
{"id":"47a6394a-c3d4-490e-a347-b52ca8a04b40","expr":"!(fieldName != null && fieldName.isEmpty())","rationale":"Typically, a field name string should not be empty if non-null.","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleFieldEnd(StringBuilder,String):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.643715217Z"}
