{"id":"56e598f1-3a5c-4a6f-a29a-b157a04c393a","expr":"result == true || result == false","rationale":"Result is boolean so it can only be true or false. (This may be trivial but satisfies consistent type.)","kind":"METHOD_EXIT","element":"org.springframework.util.PatternMatchUtils#simpleMatch(String,String,boolean):boolean","file":"org/springframework/util/PatternMatchUtils.java","createdAt":"2026-09-11T14:11:33.882862263Z"}
