{"id":"14e5e30d-8151-4918-a55e-fcbd8f78386a","expr":"result != null && result.startPc != null && result.endPc != null","rationale":"Returned Handler objects have valid start and end labels set.","kind":"METHOD_EXIT","element":"org.springframework.asm.Handler#removeRange(Handler,Label,Label):Handler","file":"org/springframework/asm/Handler.java","createdAt":"2026-09-11T14:17:47.658884006Z"}
