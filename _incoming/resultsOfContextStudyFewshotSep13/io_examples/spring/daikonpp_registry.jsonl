{"id":"0f2b6693-f726-45fe-b3b4-e7f676a9e035","expr":"namespaceURI == null || !namespaceURI.isEmpty()","rationale":"Namespace URI, if not null, is typically a non-empty string in XML contexts.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.249253657Z"}
{"id":"34cc0aea-de2d-44f8-82c4-088e7a0878df","expr":"namespaceURI == null || namespaceURI.trim().length() > 0","rationale":"The namespaceURI parameter can be null or contain meaningful XML namespace URIs which are not whitespace only.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.249253657Z"}
{"id":"8193ef73-9179-472e-9577-fa3cfd516bd0","expr":"namespaceURI == null || !namespaceURI.contains(\"␀\")","rationale":"XML namespace URIs do not include null characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.249253657Z"}
{"id":"7f8e0144-ca9d-4fc6-9f9b-2dbada49732b","expr":"namespaceURI == null || !namespaceURI.contains(\" \")","rationale":"XML namespace URIs conventionally do not contain spaces.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.249253657Z"}
{"id":"38eb985c-d541-48b4-96d9-6a119541a6d5","expr":"namespaceURI == null || namespaceURI.equals(namespaceURI.trim())","rationale":"Namespace URIs usually do not have leading or trailing whitespace.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.249253657Z"}
{"id":"88967bda-1cf6-4ef7-b260-ea44f2bb8708","expr":"namespaceURI != null && namespaceURI.length() > 0 || namespaceURI == null || namespaceURI.length() == 0","rationale":"The method is expected to write a default namespace with the given URI; namespaceURI can be null or non-empty string","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.256488117Z"}
{"id":"a92dcd86-8b53-4168-8055-be99a49f07eb","expr":"namespaceURI == null || namespaceURI.indexOf(':') == -1","rationale":"Namespace URIs are usually URIs without embedded ':' except in some cases; this captures that they typically don't contain colon","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.256488117Z"}
{"id":"9ba52c14-88c4-400f-9d21-f66160d184b7","expr":"namespaceURI == null || !namespaceURI.trim().isEmpty()","rationale":"If namespaceURI is not null, it is generally a non-blank string to write namespace","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.256488117Z"}
{"id":"e8511362-10cf-4fbe-9608-dab852861bb4","expr":"namespaceURI == null || namespaceURI.equals(namespaceURI.trim())","rationale":"Namespace URI strings generally do not have leading or trailing whitespace","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeDefaultNamespace(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.256488117Z"}
{"id":"44237002-bb24-4792-aef5-3b06991065a5","expr":"namespace != null && namespace.getPrefix() != null && namespace.getNamespaceURI() != null && !namespace.getPrefix().isEmpty() && !namespace.getNamespaceURI().isEmpty()","rationale":"Namespace object is expected to provide a valid prefix and URI.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#doWriteNamespace(Namespace):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.257846585Z"}
