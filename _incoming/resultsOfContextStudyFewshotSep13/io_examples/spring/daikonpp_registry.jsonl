{"id":"add83d96-814b-4ad6-877a-3a1b6309d03a","expr":"parameterTypes != null","rationale":"Parameter types array is used to identify the method signature and is expected non-null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#findPubliclyAccessibleMethodIfPossible(String,Class<?>[],Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:43.940592271Z"}
{"id":"f66bcb9e-8a17-4e18-b71b-86d1ce35df2a","expr":"parameterTypes.length >= 0","rationale":"Array length is naturally non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#findPubliclyAccessibleMethodIfPossible(String,Class<?>[],Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:43.940592271Z"}
{"id":"ed253602-4298-4496-9529-57c9d2cdc4ca","expr":"declaringClass.isAssignableFrom(declaringClass)","rationale":"This expresses a tautological property confirming class identity.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#findPubliclyAccessibleMethodIfPossible(String,Class<?>[],Class<?>):Method","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:43.940592271Z"}
