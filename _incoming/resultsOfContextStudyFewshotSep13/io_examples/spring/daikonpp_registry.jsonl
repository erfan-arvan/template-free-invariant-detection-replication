{"id":"84ecb4f2-ebaf-4154-9267-7651c1ce3833","expr":"limitLength == (limitLength ? true : false)","rationale":"limitLength remains consistent when used in ternary expressions.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:51.997365647Z"}
{"id":"1cf840ca-378a-40da-9c4a-c81f0665dbfb","expr":"result != null","rationale":"The method returns a formatted string representation so result should never be null.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:51.999645087Z"}
{"id":"f33d0884-c7cf-4b0a-9142-d999c0d7102b","expr":"!limitLength || result.length() <= 100","rationale":"If limitLength is true, the result string length should be limited to 100 characters.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:51.999645087Z"}
{"id":"95d6b5c1-7e6b-4525-9760-eb7247654ca5","expr":"limitLength || result.length() > 0","rationale":"When limitLength is false, result length might be unrestricted but typically positive or nonempty if value is non-null.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:51.999645087Z"}
{"id":"a446ad6f-24de-40e4-984d-b4eb80f8d8a1","expr":"(value == null) == result.equals(\"null\")","rationale":"If the input value is null, the result is typically the string \"null\".","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:51.999645087Z"}
{"id":"ae8860c2-0200-437f-aa61-af608c5ab10d","expr":"(maxLength >= -1)","rationale":"maxLength is used for truncation with -1 indicating no truncation.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,int,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.000361807Z"}
{"id":"0e8156b1-e1fc-43dc-b007-4b07eaf49869","expr":"(replaceNewlinesAndControlCharacters == true || replaceNewlinesAndControlCharacters == false)","rationale":"Standard boolean variable invariant, always true.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,int,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.000361807Z"}
{"id":"96923cfd-b991-4560-af3f-f35ce6f847e2","expr":"(value == null || maxLength != -1 || maxLength == -1)","rationale":"maxLength applies irrespective of value being null; included for completeness.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,int,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.000361807Z"}
{"id":"7e2988b2-39e0-4a50-9461-65d9364e0515","expr":"(value == null || (replaceNewlinesAndControlCharacters == false || replaceNewlinesAndControlCharacters == true))","rationale":"Boolean flag can be true or false when value is non-null.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,int,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.000361807Z"}
{"id":"65891751-11bf-459f-b3a0-f6a6a091d9f2","expr":"value == null || result != null","rationale":"If value is null the method returns empty string, else result should be a non-null string representing the value.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,int,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.003204167Z"}
{"id":"b9edd9d2-2aee-4663-84e8-3fb54701990b","expr":"maxLength == -1 || result.length() <= maxLength","rationale":"When maxLength is set, result length is truncated accordingly.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,int,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.003204167Z"}
{"id":"ada4ffec-667e-4a98-bd31-53a4e8726455","expr":"value == null || !result.isEmpty()","rationale":"For non-null value, result string is not empty because it is at least the string conversion of the value.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#formatValue(Object,int,boolean):String","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.003204167Z"}
{"id":"9ff2271c-0bce-4f84-8010-a565de6f648c","expr":"logger != null","rationale":"logger must not be null to invoke isDebugEnabled and other methods","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.003909034Z"}
{"id":"975fe0e8-a982-4591-aee0-7fef0e7924a7","expr":"messageFactory != null","rationale":"messageFactory must not be null to invoke apply method","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.003909034Z"}
{"id":"973bd5b5-fc4b-4330-a13f-3dab4728f593","expr":"(!logger.isDebugEnabled()) || (messageFactory.apply(true) != null)","rationale":"When debug is enabled, applying messageFactory with trace enabled true produces a log message string","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.003909034Z"}
{"id":"7a2647d3-8279-4d7c-8021-29c2667cf534","expr":"(!logger.isDebugEnabled()) || (messageFactory.apply(false) != null)","rationale":"When debug is enabled, applying messageFactory with trace enabled false produces a log message string","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.003909034Z"}
{"id":"8b14cf4e-aece-4144-a5e7-3e14b66e6d74","expr":"(!logger.isDebugEnabled()) || (logger.isTraceEnabled() || !logger.isTraceEnabled())","rationale":"traceEnabled boolean value covers both cases when debug is enabled","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.003909034Z"}
{"id":"1cf8807b-2865-4fc0-a305-00e0d8248e0d","expr":"primaryLogger != null","rationale":"primaryLogger is expected to be non-null because it is added to the list in getCompositeLog.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogDelegateFactory#getCompositeLog(Log,Log,Log):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.006219053Z"}
{"id":"127c5600-08c2-41f0-8968-e228046595a1","expr":"secondaryLogger != null","rationale":"secondaryLogger is expected to be non-null because it is added to the list in getCompositeLog.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogDelegateFactory#getCompositeLog(Log,Log,Log):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.006219053Z"}
{"id":"297cbbfa-d24f-4dfb-a121-4d4f8f63ee9b","expr":"tertiaryLoggers != null","rationale":"The tertiaryLoggers array is used in Collections.addAll so it should be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogDelegateFactory#getCompositeLog(Log,Log,Log):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.006219053Z"}
{"id":"a5c8d8c5-4ae2-4ae6-b2af-a124008e2b6b","expr":"tertiaryLoggers.length >= 0","rationale":"The length of the tertiaryLoggers array is naturally non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogDelegateFactory#getCompositeLog(Log,Log,Log):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.006219053Z"}
{"id":"ccbd21ce-17f8-4e4c-9d92-3319ec07901a","expr":"!logger.isDebugEnabled() || messageFactory.apply(logger.isTraceEnabled()) != null","rationale":"If debug logging is enabled, the messageFactory is applied with the traceEnabled state; the result is used in logging.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.006753079Z"}
{"id":"a086681d-f835-498e-a03f-502c81a78804","expr":"!logger.isDebugEnabled() || (logger.isTraceEnabled() || !logger.isTraceEnabled())","rationale":"traceEnabled is assigned as logger.isTraceEnabled(), thus it matches the value exactly.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.006753079Z"}
{"id":"168a309e-4c7c-4766-9758-279b9d75717d","expr":"!logger.isDebugEnabled() || (logger.isTraceEnabled() == logger.isTraceEnabled())","rationale":"traceEnabled is a local variable assigned from logger.isTraceEnabled(), the expression confirms traceEnabled value.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.006753079Z"}
{"id":"a54ecf47-bc6a-48eb-8729-2d22ef02f821","expr":"!logger.isDebugEnabled() || (logger.isTraceEnabled() ? logger.isTraceEnabled() : !logger.isTraceEnabled())","rationale":"The method logs trace or debug messages based on traceEnabled when debug is enabled.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.006753079Z"}
{"id":"7fd1fd76-f9f9-49ec-b5fe-4d2a26670136","expr":"!logger.isDebugEnabled() || (true)","rationale":"This invariant is trivial and always true when debug is enabled; should be disregarded.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogFormatUtils#traceDebug(Log,Function<Boolean, String>):void","file":"org/springframework/core/log/LogFormatUtils.java","createdAt":"2026-09-11T14:12:52.006753079Z"}
{"id":"7242a0f3-78ea-4d35-95f4-6b26d52e1dc2","expr":"result != null","rationale":"The method always returns a new CompositeLog constructed from the input loggers, so result is never null.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogDelegateFactory#getCompositeLog(Log,Log,Log):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.008434854Z"}
{"id":"34a4c713-a4d5-4df8-b824-140b1cb1effb","expr":"primaryLogger == null || secondaryLogger == null || result != primaryLogger","rationale":"If primaryLogger and secondaryLogger are non-null, result is a CompositeLog wrapping them, so result should not equal either original logger.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogDelegateFactory#getCompositeLog(Log,Log,Log):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.008434854Z"}
{"id":"6615d909-7971-4c7e-a1cd-b72b0d5f71e7","expr":"clazz != null","rationale":"To call getName() safely, clazz must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(Class<?>):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.009182422Z"}
{"id":"b774d920-cc81-4cbb-a0d4-f7f8c2b57251","expr":"result != secondaryLogger || primaryLogger == null || secondaryLogger == null","rationale":"Ensures that if both primary and secondary loggers exist, result is a new composite and distinct from secondaryLogger.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogDelegateFactory#getCompositeLog(Log,Log,Log):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.008434854Z"}
{"id":"5de9359a-7d59-4d4a-8ec1-722db56840ad","expr":"clazz.getName() != null","rationale":"Java Class.getName() returns a non-null String representing class name.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(Class<?>):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.009182422Z"}
{"id":"f4767311-628c-4b8b-a561-a217b0d0439a","expr":"tertiaryLoggers.length == 0 || result != tertiaryLoggers[0]","rationale":"If there are tertiary loggers passed in, result is a CompositeLog wrapping them, distinct from any single tertiary logger.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogDelegateFactory#getCompositeLog(Log,Log,Log):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.008434854Z"}
{"id":"052af71d-b552-4407-8ca5-35a66a81858e","expr":"clazz.getName().length() > 0","rationale":"Class names are non-empty strings.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(Class<?>):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.009182422Z"}
{"id":"da15d5c9-2cdf-404a-9298-86792cc93491","expr":"result != null","rationale":"Generally, the method should return some non-null Log instance for valid inputs.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(Class<?>):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.012496210Z"}
{"id":"7f737a62-ad4e-40f4-97f9-35176f0ba7b8","expr":"result.toString().contains(clazz.getName())","rationale":"The returned Log is expected to be associated with the class name passed in, so its string representation might contain the class name.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(Class<?>):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.012496210Z"}
{"id":"e9e55019-fc6b-486c-9ab6-fc4597d3e4e1","expr":"category != null","rationale":"Since the method uses category to build a string for LogFactory.getLog, category must not be null to avoid NullPointerException.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(String):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.012522459Z"}
{"id":"6598a3cb-d8ae-4c95-a9d2-d75cc98def3b","expr":"result.getName() != null && result.getName().equals(clazz.getName())","rationale":"If Log has a getName() method, it is plausible it returns the name used for the hidden log which should match clazz.getName().","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(Class<?>):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.012496210Z"}
{"id":"61345786-c5c2-46f2-836b-8698ca21a836","expr":"category.length() >= 0","rationale":"A String's length is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(String):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.012522459Z"}
{"id":"30ab4b72-db3f-46f6-afeb-c0852c3906df","expr":"!category.isEmpty()","rationale":"Empty category strings are less meaningful for logging categories, so possibly category is expected to be a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(String):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.012522459Z"}
{"id":"1c300629-e1fa-44cc-992e-251cbdff5c78","expr":"result != null","rationale":"The LogFactory.getLog method typically returns a non-null Log instance for any input string, so the result is expected to be non-null.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(String):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.014770882Z"}
{"id":"6d068679-29bc-4f44-935a-59ef255ad741","expr":"result.toString().contains(category)","rationale":"The Log instance returned corresponds to a category string including the input; thus its string representation is likely to contain the category.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogDelegateFactory#getHiddenLog(String):Log","file":"org/springframework/core/log/LogDelegateFactory.java","createdAt":"2026-09-11T14:12:52.014770882Z"}
{"id":"21e60f2f-64de-42ec-adec-b9d737a6d281","expr":"result != null","rationale":"Since the method returns this.log which is presumably initialized, result should not be null.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogAccessor#getLog():Log","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.019864661Z"}
{"id":"ac84e045-a235-4b17-a302-ece63817ecce","expr":"result.isInfoEnabled() == result.isInfoEnabled()","rationale":"This expression is simply showing method validity; can be omitted if tautologies are disallowed.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogAccessor#getLog():Log","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.019864661Z"}
{"id":"3408aa66-87b4-465c-be4e-ee76985fe4f6","expr":"result.isDebugEnabled() || !result.isDebugEnabled()","rationale":"Reflexive method call usage; tautological and can be omitted.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogAccessor#getLog():Log","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.019864661Z"}
{"id":"b78145ac-b0b9-43fc-a59d-f8e3abf02695","expr":"result.isTraceEnabled() || !result.isTraceEnabled()","rationale":"Same as above for trace.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogAccessor#getLog():Log","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.019864661Z"}
{"id":"3727459f-04bb-4ced-97df-d3602804ff30","expr":"result.isWarnEnabled() == result.isWarnEnabled()","rationale":"Same as above for warn.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogAccessor#getLog():Log","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.019864661Z"}
{"id":"b2ffeab7-7cf9-464d-8458-c616da5f19f9","expr":"result == true || result == false","rationale":"As a boolean return type, the result is always either true or false.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogAccessor#isWarnEnabled():boolean","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.034713094Z"}
{"id":"894da9fe-36c2-4b11-b3a6-1fd78168fa08","expr":"result == true || result == false","rationale":"Result is boolean, thus it is either true or false.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogAccessor#isDebugEnabled():boolean","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.045812629Z"}
{"id":"b57fd9d0-a3b4-4bae-b901-ef3b78c34d52","expr":"message != null","rationale":"Method fatal is called with a non-null message to log.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogAccessor#fatal(CharSequence):void","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.051486219Z"}
{"id":"e3f2c5f7-5d66-4507-982c-874de0b7be8b","expr":"message.length() > 0","rationale":"Log messages are usually non-empty strings or character sequences.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogAccessor#fatal(CharSequence):void","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.051486219Z"}
{"id":"abfa482c-8f23-426f-97c1-88b159f3ba08","expr":"message != null","rationale":"The message passed to the log.fatal method is typically non-null to provide meaningful log information.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogAccessor#fatal(Throwable,CharSequence):void","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.056912955Z"}
{"id":"4cb4da51-dd9a-495e-9ff0-73a3a45076a0","expr":"message.length() >= 0","rationale":"By definition, CharSequence length is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogAccessor#fatal(Throwable,CharSequence):void","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.056912955Z"}
{"id":"a48c85b8-53da-4c72-98cf-dbb2d895a6d6","expr":"cause == null || cause.getMessage() != null","rationale":"Typically, when a Throwable is passed, it usually has a non-null message, but cause itself can be null.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogAccessor#fatal(Throwable,CharSequence):void","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.056912955Z"}
{"id":"10aa079b-4824-421e-b1e5-3b3084313084","expr":"message != null && message.length() >= 0","rationale":"message should not be null to safely log its length.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogAccessor#error(CharSequence):void","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.061763797Z"}
{"id":"d5847dea-51c1-43bb-9d20-18690a0951de","expr":"message.length() <= 32767","rationale":"Logs usually have a practical maximum message length.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogAccessor#error(CharSequence):void","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.061763797Z"}
{"id":"f41ae096-4973-4923-a4d2-5fb5452cd467","expr":"message.length() >= 0","rationale":"Length of CharSequence is non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.core.log.LogAccessor#error(CharSequence):void","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.061763797Z"}
{"id":"77c62dc4-e4e2-4a0a-ba97-27b2f41e809f","expr":"message == null || message.length() >= 0","rationale":"If message is non-null, its length must be zero or greater.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogAccessor#fatal(Throwable,CharSequence):void","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.062530730Z"}
{"id":"025c3ac4-880d-40bf-86e9-dbcfb00b858a","expr":"message == null || message.toString().contains(\"\")","rationale":"message is a CharSequence and calling toString() on it returns a non-null String.","kind":"METHOD_EXIT","element":"org.springframework.core.log.LogAccessor#fatal(Throwable,CharSequence):void","file":"org/springframework/core/log/LogAccessor.java","createdAt":"2026-09-11T14:12:52.062530730Z"}
