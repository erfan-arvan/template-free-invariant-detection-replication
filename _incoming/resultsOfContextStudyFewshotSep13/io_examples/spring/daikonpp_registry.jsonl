{"id":"dfcfe4a0-dbc3-4c21-907d-0f8466f43f64","expr":"resourcePath.indexOf('.') >= -1","rationale":"resourcePath can contain '.' but not mandatory.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:19.944623345Z"}
{"id":"1717f9f3-6e60-448d-a558-f40255497fde","expr":"result.equals(resourcePath.replace(\"/\", \".\"))","rationale":"The returned string replaces path separators '/' with package separators '.' in the resource path string.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:19.980096193Z"}
{"id":"a80e5f05-3bf9-49d3-8c4a-4668a7a9d1a9","expr":"!result.contains(\"/\")","rationale":"Since all '/' are replaced, the result string should not contain any '/' characters.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:19.980096193Z"}
{"id":"cb7d6913-9f3b-4a78-a924-191307d0b161","expr":"!resourcePath.contains(\".\") || result.contains(\".\")","rationale":"If the original resource path contains dots, then the result must also contain dots, since dots are not removed.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:19.980096193Z"}
{"id":"8e27cc99-5b89-48f4-86de-ad8b6e5a2257","expr":"result.length() == resourcePath.length()","rationale":"Replacing '/' with '.' is a character substitution that doesn't change string length.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:19.980096193Z"}
{"id":"47a56f83-fad1-458e-ad65-8f78aac58683","expr":"name == null || name.length() <= 7","rationale":"If name is not null and length is greater than 7, the method returns null immediately.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.264320970Z"}
{"id":"c40253e9-f82a-4322-81d0-fb47cd04b93e","expr":"name == null || name.length() > 0","rationale":"Primitive type names are non-empty strings; null is allowed as input.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.264320970Z"}
{"id":"1fc7b6ca-a013-4b5a-a978-d3567c6198c3","expr":"name == null || Character.isJavaIdentifierStart(name.charAt(0))","rationale":"Primitive type names or identifiers start with a valid Java identifier character, if not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.264320970Z"}
{"id":"2dc6a227-475b-4472-bfa4-b2eb2841097f","expr":"name == null || !name.contains(\".\")","rationale":"Primitive type names do not contain dot characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.264320970Z"}
{"id":"cfba9b73-c0fd-47a6-911b-fa760ad46e65","expr":"name == null || !name.contains(\"$\")","rationale":"Primitive type names do not have '$' characters.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.264320970Z"}
{"id":"b7bbcaf2-0391-4001-8eeb-c7c1defad789","expr":"!result || (className.length() > 0)","rationale":"A valid class name must be a non-empty string if the class is present (result == true).","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPresent(String,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.605044796Z"}
{"id":"647f4865-8e30-4666-8667-cf1132200989","expr":"!result || (classLoader == null || classLoader.getClass().getName() != null)","rationale":"If a class is present, any provided classLoader should have a valid class name.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPresent(String,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.605044796Z"}
{"id":"c11b4c1c-688c-44b4-864a-1020bc02030c","expr":"result == (className != null && (classLoader == null || classLoader.getClass() != null))","rationale":"The result being true is consistent with className being non-null and classLoader either null or having a valid 'getClass' method.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#isPresent(String,ClassLoader):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.605044796Z"}
{"id":"406f77cf-1c59-4551-8cad-f09f81a95316","expr":"resourceName != null","rationale":"The method asserts that resourceName must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#addResourcePathToPackagePath(Class<?>,String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.643925180Z"}
{"id":"f62eb718-24ea-4413-a13d-f1ee1e524427","expr":"(!resourceName.startsWith(\"/\")) || resourceName.startsWith(\"/\")","rationale":"The string resourceName either starts with '/' or it does not.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#addResourcePathToPackagePath(Class<?>,String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.643925180Z"}
{"id":"5b638358-30cb-4d32-95cb-f932c9427756","expr":"clazz != null","rationale":"clazz is used in classPackageAsResourcePath(clazz), so it is presumably not null.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#addResourcePathToPackagePath(Class<?>,String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.643925180Z"}
{"id":"2980d85c-705f-4de5-acb8-31609652acad","expr":"resourceName.length() > 0","rationale":"resourceName is a non-null string representing a resource path, so it is likely not empty.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#addResourcePathToPackagePath(Class<?>,String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.643925180Z"}
{"id":"69e710f9-278e-4874-9c21-2f0a281cbced","expr":"result.contains(resourceName)","rationale":"Result appends resourceName to the package path, so it must contain resourceName substring.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#addResourcePathToPackagePath(Class<?>,String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:20.679878452Z"}
{"id":"64945767-c7bf-427c-b682-0a574bf04540","expr":"result == null || result.isPrimitive()","rationale":"If the result is not null, it corresponds to a primitive class type for the given name.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:21.104117647Z"}
{"id":"c4a4e454-f9ae-416e-8ca6-95169d9e382d","expr":"result == null || name.equals(result.getName())","rationale":"Result corresponds to the primitive class with the given name, so their names should match.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#resolvePrimitiveClassName(String):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:21.104117647Z"}
{"id":"a3120b3d-946c-48db-a182-f82905123370","expr":"clazz != null","rationale":"The method uses Assert.notNull(clazz), so clazz must not be null at this point.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:24.684887623Z"}
{"id":"af117b2a-97f1-4be9-a8f0-79ea4d4e691f","expr":"clazz.isPrimitive() || !clazz.isPrimitive()","rationale":"This is tautological but confirms the method logic depends on primitive status.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#resolvePrimitiveIfNecessary(Class<?>):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:24.684887623Z"}
