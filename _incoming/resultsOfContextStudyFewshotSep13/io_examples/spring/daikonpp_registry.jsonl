{"id":"1c7735b2-ec71-48b8-bae4-fda0d349fb77","expr":"!(opcode == 187 && (desc == null || desc.length() == 0))","rationale":"If opcode is 187 (NEW), then desc must be non-null and non-empty.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitTypeInsn(int,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T14:17:39.465575570Z"}
{"id":"2679ab13-32db-4dec-95cf-e6b5f1a1c335","expr":"line >= 0","rationale":"Line numbers in source code or bytecode generally start from 0 or 1 and should not be negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitLineNumber(int,Label):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T14:17:39.467027539Z"}
