{"id":"7e9af998-255e-438f-89fb-9b809a2af60f","expr":"str != null","rationale":"The method uses str directly with string concatenation; thus, str must not be null at method entry.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.SimpleValueStyler#styleString(String):String","file":"org/springframework/core/style/SimpleValueStyler.java","createdAt":"2026-09-11T14:12:48.669505618Z"}
