{"id":"e621940c-3356-4e14-ac01-1e6c0ea6f8cd","expr":"fieldName != null","rationale":"To safely call StringBuilder.append(fieldName) and produce meaningful output, fieldName is expected to be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.DefaultToStringStyler#styleFieldStart(StringBuilder,String):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.641892726Z"}
{"id":"d41756c7-51cb-42c9-ad7d-8f630e067944","expr":"buffer.charAt(buffer.length() - fieldName.length() - 3) == ' '","rationale":"The character before the fieldName in buffer is a space character.","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleFieldStart(StringBuilder,String):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.641880223Z"}
{"id":"ccb1e7bd-c7ca-4be3-8184-fc918d2aaeac","expr":"fieldName.length() > 0","rationale":"For styleFieldStart to append a meaningful field name, fieldName should be non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.DefaultToStringStyler#styleFieldStart(StringBuilder,String):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.641892726Z"}
{"id":"b6c48969-4562-4f2a-b357-f12604e8b1e2","expr":"buffer.length() >= 0","rationale":"StringBuilder length is always >= 0; useful as a basic invariant.","kind":"METHOD_ENTRY","element":"org.springframework.core.style.DefaultToStringStyler#styleFieldStart(StringBuilder,String):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.641892726Z"}
{"id":"6b3f6ca2-dcf2-4010-bea5-d82b45100163","expr":"buffer != null || fieldName != null","rationale":"Buffer or fieldName might be null but at least one is expected to be not null","kind":"METHOD_ENTRY","element":"org.springframework.core.style.DefaultToStringStyler#styleFieldEnd(StringBuilder,String):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.642942933Z"}
{"id":"deace021-03e0-4f4f-8d17-eb3640622747","expr":"buffer == null || buffer.length() >= 0","rationale":"The length of the buffer, if it exists, cannot be negative","kind":"METHOD_ENTRY","element":"org.springframework.core.style.DefaultToStringStyler#styleFieldEnd(StringBuilder,String):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.642942933Z"}
{"id":"983be510-108c-4e47-baf8-ce3493db9cc6","expr":"fieldName == null || fieldName.length() >= 0","rationale":"The length of the fieldName, if it exists, cannot be negative","kind":"METHOD_ENTRY","element":"org.springframework.core.style.DefaultToStringStyler#styleFieldEnd(StringBuilder,String):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.642942933Z"}
{"id":"87f74014-5515-498b-a923-6df2910256d2","expr":"fieldName == null || !fieldName.isEmpty()","rationale":"The fieldName parameter is not an empty string if provided","kind":"METHOD_ENTRY","element":"org.springframework.core.style.DefaultToStringStyler#styleFieldEnd(StringBuilder,String):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.642942933Z"}
