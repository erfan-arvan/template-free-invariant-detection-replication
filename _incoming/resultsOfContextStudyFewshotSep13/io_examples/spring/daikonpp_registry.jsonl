{"id":"eb6b1639-a35a-4e3c-bb7a-7738a3a46095","expr":"locale == null || (locale.getLanguage() != null && locale.getCountry() != null && locale.getVariant() != null)","rationale":"Safe to call getLanguage, getCountry, and getVariant only if locale is not null, and these methods do not return null.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.LocalizedResourceHelper#findLocalizedResource(String,String,Locale):Resource","file":"org/springframework/core/io/support/LocalizedResourceHelper.java","createdAt":"2026-09-11T14:14:23.649674531Z"}
