{"id":"143f68ca-7b8c-4fff-916d-249a5a8555a5","expr":"firstHandler != null","rationale":"To safely evaluate getExceptionTableLength(firstHandler), firstHandler must not be null.","kind":"METHOD_ENTRY","element":"org.springframework.asm.Handler#getExceptionTableSize(Handler):int","file":"org/springframework/asm/Handler.java","createdAt":"2026-09-11T14:17:47.661787622Z"}
