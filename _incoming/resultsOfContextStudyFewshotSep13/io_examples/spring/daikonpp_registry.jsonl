{"id":"7a4e0699-ceb3-4fee-a378-5c6e351c43b9","expr":"superName == null || !superName.equals(name)","rationale":"Avoids the class being its own superclass.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.275505111Z"}
{"id":"84059be9-bc3b-47a8-84dd-45691b4945b0","expr":"interfaces != null","rationale":"Interfaces array should be non-null in visit calls, even if empty.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.275505111Z"}
{"id":"408d9ac8-1a74-4398-a5c3-e681253ec2e0","expr":"version >= 0","rationale":"Class file version numbers are expected to be non-negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.275505111Z"}
{"id":"cce70d8d-82a2-48f8-864b-33e2a3697549","expr":"access >= 0","rationale":"Access flags are non-negative integers.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visit(int,int,String,String,String,String[]):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.275505111Z"}
{"id":"e0b46845-bd67-44e4-9c44-1cf9eef9a033","expr":"name != null","rationale":"name is the inner class name and should not be null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.279154326Z"}
{"id":"28ec05ff-1cfb-42f9-9303-1b72930a5d13","expr":"access >= 0","rationale":"access is an integer representing access flags, non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.279154326Z"}
{"id":"8976807c-4f09-4cbf-9ac1-438eaf14612f","expr":"(innerName == null) || innerName.equals(name)","rationale":"innerName if present usually corresponds to name or can be null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.279154326Z"}
{"id":"36289fb5-3c70-48dc-b433-63b8f8831259","expr":"(outerName == null) || (!outerName.isEmpty())","rationale":"outerName is often either null or a non-empty string representing enclosing class name.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.279154326Z"}
{"id":"523b07eb-f468-4f7b-943b-a40221f7e842","expr":"name.length() > 0","rationale":"The inner class name name must be a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.279154326Z"}
{"id":"67fc13b1-67eb-4c0b-b4cf-e6fffaa1a309","expr":"name != null","rationale":"The field name is expected to be a valid identifier, so it should not be null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitField(int,String,String,String,Object):FieldVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.279861510Z"}
{"id":"675bfcdf-8ea3-4ffc-bc43-fbe37180f90a","expr":"desc != null","rationale":"The descriptor describes the field type, it should be non-null for valid operation.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitField(int,String,String,String,Object):FieldVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.279861510Z"}
{"id":"a2866268-da47-4cd9-a217-703f2b7b674c","expr":"(value == null) || true","rationale":"The value parameter is an Object and can be null or any object instance.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitField(int,String,String,String,Object):FieldVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.279861510Z"}
{"id":"65e28c2c-a8b7-4265-8aad-8fd9f589b70f","expr":"(access & 0xFFFF) == access","rationale":"Access flags are usually contained within lower bits.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitField(int,String,String,String,Object):FieldVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.279861510Z"}
{"id":"c4da5fd9-b710-469a-84e4-988efaeabf01","expr":"name != null && outerName != null && innerName != null","rationale":"Ensures that all name parameters refer to valid strings describing class names.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.280776136Z"}
{"id":"f50d8cbf-1641-43c8-bf6b-05b9ae3312ac","expr":"innerName.length() <= name.length()","rationale":"Reflects typical naming conventions for inner classes where innerName is a substring or suffix.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.280776136Z"}
{"id":"fd7db2d0-5328-49b4-8436-974277965231","expr":"outerName != null && name.startsWith(outerName)","rationale":"Indicates relationship between inner and outer classes by string prefix.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.280776136Z"}
{"id":"42dca7d9-0bda-49f1-9ed9-f7e2b1eeafa9","expr":"(access & 0x0001) == 0 || (access & 0x0002) == 0 || (access & 0x0004) == 0","rationale":"The access flags may follow standard Java modifiers that are mutually exclusive or independently set.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.280776136Z"}
{"id":"602d06fa-85db-44f8-81c3-e45dc4fe16a7","expr":"name.equals(innerName) || innerName.contains(\"$\")","rationale":"Captures common characteristic signatures of inner class names.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.280776136Z"}
{"id":"dcf93d28-481a-4011-9120-d68262292b61","expr":"result != null","rationale":"According to the code, if both fv1 and fv2 are non-null, a new FieldVisitorTee is returned, which is non-null; if one is null, the other (non-null) is returned; so result is never null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitField(int,String,String,String,Object):FieldVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.283131450Z"}
{"id":"940bdeae-defd-4741-b780-dfd6f2b03fec","expr":"name != null","rationale":"The method name is expected to be a valid string representing the method identifier.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.283827103Z"}
{"id":"a0afd6f6-1e94-4d87-8024-66e2a32d02b3","expr":"desc != null","rationale":"The descriptor encodes the method's parameters and return type and is expected to be valid.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.283827103Z"}
{"id":"e9249559-8feb-460d-909b-c83736831cf8","expr":"signature == null || signature.length() > 0","rationale":"Signature is optional and may be null, but if present, it is non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.283827103Z"}
{"id":"019c55fc-ff80-4dd0-9b03-541787fa9e58","expr":"exceptions == null || exceptions.length >= 0","rationale":"Exceptions parameter may be null or an array representing exceptions thrown by the method.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.283827103Z"}
{"id":"9a29b7d8-be68-46b5-b445-32bda8ef39ec","expr":"result != null","rationale":"When either mv1 or mv2 is non-null, result cannot be null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.285356739Z"}
{"id":"29f01bfd-4583-4ccc-be72-e6fc75a8624d","expr":"source == null || source.length() >= 0","rationale":"If source is not null, it has a non-negative length","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitSource(String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.286430996Z"}
{"id":"dbff0d37-b486-4078-be61-eace4ea13702","expr":"debug == null || debug.length() >= 0","rationale":"If debug is not null, it has a non-negative length","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitSource(String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.286430996Z"}
{"id":"98b80748-7478-442c-92ca-96558edee1a6","expr":"source != null || debug == null","rationale":"There is no direct dependence between source and debug's nullness","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitSource(String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.286430996Z"}
{"id":"cbc4fce7-521e-4958-8fb7-d802b9c78f52","expr":"source == null || debug == null || debug.length() >= 0","rationale":"The debug string can be null or non-null. If non-null, its length is non-negative.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitSource(String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.287673771Z"}
{"id":"2a2f39b0-2901-4f3d-b880-5c1baedc3516","expr":"source == null || source.length() >= 0","rationale":"The source string length is non-negative when source is non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitSource(String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.287673771Z"}
{"id":"a613438c-ab2c-4fee-b9c2-2a779c171599","expr":"(source == null) || (debug == null) || true","rationale":"No strong logical relation between source and debug can be derived here, but both can be null or non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitSource(String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.287673771Z"}
{"id":"2503247d-387c-416e-bf47-db082f52cc15","expr":"owner != null","rationale":"Since owner identifies a class, it is expected to be non-null when visiting outer class.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.289495869Z"}
{"id":"3062c4c2-1049-40b9-bce1-f314a25d9c93","expr":"(name == null) || (name.length() > 0)","rationale":"Outer class method name may be null, or if present, should be non-empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.289495869Z"}
{"id":"c917f9f6-7c0f-445f-98e2-0777b108e0ea","expr":"(desc == null) || (desc.length() > 0)","rationale":"Descriptor may be null or a valid non-empty string describing method signature.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.289495869Z"}
{"id":"978f5e08-2345-4d1c-9bf2-519297f9f133","expr":"(name != null) || (desc == null)","rationale":"name and desc represent method name and signature; if descriptor is present, method name should be too.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.289495869Z"}
{"id":"6a89e449-f3a7-4304-a0d1-f4bb1c8b33b7","expr":"owner.length() > 0","rationale":"owner identifies a class name and should be a non-empty string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.289495869Z"}
{"id":"8995dd9e-6639-4ca8-ae3a-08cc0fb03d4f","expr":"owner != null","rationale":"The 'owner' parameter must not be null as it is directly used in method calls cv1.visitOuterClass and cv2.visitOuterClass.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.290047109Z"}
{"id":"5003ce47-6941-46dc-a8e2-8512b04cc623","expr":"name != null","rationale":"Similarly, 'name' should not be null because it is used as a parameter in the invoked methods.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.290047109Z"}
{"id":"d9517008-6834-4bf5-9a9e-4d8b8cc70091","expr":"desc != null","rationale":"The 'desc' string parameter is also used without null checks, implying it should not be null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.290047109Z"}
{"id":"bf34e8a8-3cb3-4232-a42b-8d15908f0f85","expr":"owner.length() > 0","rationale":"Typically, the 'owner' string in ASM or similar bytecode libraries represents a class name and is expected to be non-empty.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.290047109Z"}
{"id":"2a68ca5b-7a30-42a7-bc1f-b2da34978556","expr":"(!name.isEmpty() && !desc.isEmpty()) || (name == null && desc == null)","rationale":"In ASM, usually name and desc are either both provided with meaningful content or both null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitOuterClass(String,String,String):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.290047109Z"}
{"id":"c8657136-dae6-4c4d-816a-13918b10056a","expr":"desc != null","rationale":"desc is expected to be a valid type descriptor or annotation description string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.291374043Z"}
{"id":"66fdd747-17f1-4703-aaaf-252c98f1344b","expr":"desc.length() > 0","rationale":"Annotation descriptors are non-empty strings indicating annotation type.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.291374043Z"}
{"id":"54208875-0989-4cac-a083-8df2c0f9cbf0","expr":"visible == true || visible == false","rationale":"visible is a method parameter of type boolean, so it is always boolean.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.291374043Z"}
{"id":"4297dd10-2cb1-410b-8cbc-b97830270df4","expr":"result != null","rationale":"The method returns the result of AnnotationVisitorTee.getInstance(...) which likely never returns null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.293939263Z"}
{"id":"26bca195-4203-4a5e-b71f-63a34eada215","expr":"!(result == null && desc != null)","rationale":"If desc is not null, then result should not be null since the annotations are being visited.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.293939263Z"}
{"id":"2b8d0dc1-3212-4529-abad-82b790619abf","expr":"!visible || result != null","rationale":"If the annotation is visible, the returned AnnotationVisitor should not be null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.293939263Z"}
{"id":"026bfadd-e70f-455e-a668-5db9211cb626","expr":"attrs != null","rationale":"The method visitAttribute is called with attrs, so attrs is expected not to be null to avoid NullPointerException.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.294075420Z"}
{"id":"81a23914-1c14-44a4-915e-e5aed3181b6f","expr":"!attrs.isEmpty()","rationale":"If Attribute provides an isEmpty() method, the attribute being visited is typically non-empty, but this depends on available methods which are not guaranteed.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.294075420Z"}
{"id":"8b7e1774-42a6-4b42-946b-63fc5f87925a","expr":"attrs.toString() != null","rationale":"Typically, toString() returns a non-null string, indicating the attribute can be represented as text.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.294075420Z"}
{"id":"2f6ef53b-e884-4d1a-be79-f4a420e06c33","expr":"attrs.hashCode() >= 0","rationale":"Hash codes should be consistent and mostly non-negative depending on implementation, giving an invariant to consider.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.294075420Z"}
{"id":"f4dc8200-1322-4956-982a-9422c963eeed","expr":"attrs != null","rationale":"The parameter attrs is passed to both cv1 and cv2 visitAttribute calls, so it must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.295195262Z"}
{"id":"eb41c2a5-f32d-4401-ba87-0dafd513713c","expr":"attrs.equals(attrs)","rationale":"Trivial but ensures attrs is a valid object reference.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.ClassVisitorTee#visitAttribute(Attribute):void","file":"org/springframework/cglib/transform/ClassVisitorTee.java","createdAt":"2026-09-11T14:17:39.295195262Z"}
{"id":"1062ee1b-82f6-4ee7-994d-0aeea73b1a1f","expr":"desc != null","rationale":"The 'desc' parameter is used as a method argument immediately, so it should be non-null.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.FieldVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/FieldVisitorTee.java","createdAt":"2026-09-11T14:17:39.297162294Z"}
{"id":"6ab89458-f39a-416f-a1ac-f2156bb6696c","expr":"desc.length() > 0","rationale":"Annotation descriptor strings are usually non-empty for valid annotations.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.FieldVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/FieldVisitorTee.java","createdAt":"2026-09-11T14:17:39.297162294Z"}
{"id":"9ab4be8a-8501-41c1-83ac-1e2e7810ce82","expr":"visible == true || visible == false","rationale":"The visible parameter must be a boolean value.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.FieldVisitorTee#visitAnnotation(String,boolean):AnnotationVisitor","file":"org/springframework/cglib/transform/FieldVisitorTee.java","createdAt":"2026-09-11T14:17:39.297162294Z"}
