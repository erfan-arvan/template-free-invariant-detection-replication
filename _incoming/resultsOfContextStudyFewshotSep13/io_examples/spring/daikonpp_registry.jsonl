{"id":"9b20d60d-02df-4aa6-93ab-81a9d3d5d9f6","expr":"descriptor != null","rationale":"A method's descriptor is necessary to identify parameter and return types.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-11T14:17:47.819627934Z"}
{"id":"14d1ff7c-bcd8-4baa-882c-18feabb9249a","expr":"opcode >= 0","rationale":"Opcodes must be in a valid non-negative range.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodVisitor#visitMethodInsn(int,String,String,String):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-11T14:17:47.819627934Z"}
