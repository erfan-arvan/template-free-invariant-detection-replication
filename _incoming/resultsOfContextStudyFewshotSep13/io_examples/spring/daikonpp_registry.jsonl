{"id":"91b52c24-105f-4381-9879-da7562a51714","expr":"owner.indexOf('/') >= 0","rationale":"The internal name for a class typically uses '/' as package separators.","kind":"METHOD_ENTRY","element":"org.springframework.asm.ClassVisitor#visitOuterClass(String,String,String):void","file":"org/springframework/asm/ClassVisitor.java","createdAt":"2026-09-11T14:17:44.754577386Z"}
