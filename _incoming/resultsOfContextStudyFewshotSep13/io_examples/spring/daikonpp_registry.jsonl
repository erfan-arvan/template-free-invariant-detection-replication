{"id":"4e23eb8c-36b9-401a-b000-6db1fdb887aa","expr":"locations != null","rationale":"The parameter 'locations' is expected to be a non-null array of Resource instances.","kind":"METHOD_ENTRY","element":"org.springframework.core.io.support.PropertiesLoaderSupport#setLocations(Resource):void","file":"org/springframework/core/io/support/PropertiesLoaderSupport.java","createdAt":"2026-09-11T14:14:24.496754812Z"}
