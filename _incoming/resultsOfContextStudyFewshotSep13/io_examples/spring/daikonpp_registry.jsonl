{"id":"5989ab7e-7412-4bb2-a049-2dcd703246ae","expr":"buffer.length() >= 0","rationale":"buffer length is always non-negative before appending","kind":"METHOD_ENTRY","element":"org.springframework.core.style.DefaultToStringStyler#styleIdentityHashCode(StringBuilder,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.636592609Z"}
{"id":"b64e6fa8-c2d1-4165-8c47-d51899467539","expr":"buffer.toString().indexOf('@') == -1","rationale":"Method appends '@'; prior to call this character should not already exist in buffer","kind":"METHOD_ENTRY","element":"org.springframework.core.style.DefaultToStringStyler#styleIdentityHashCode(StringBuilder,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.636592609Z"}
{"id":"d9ae7f0f-3847-4abb-a4b1-21101d4162fd","expr":"buffer.length() > 0","rationale":"After appending '@' and the identity hex string, the buffer must have increased in length.","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleIdentityHashCode(StringBuilder,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.636892052Z"}
