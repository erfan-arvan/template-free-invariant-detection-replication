{"id":"8794c60d-c1da-4e35-ab74-40106145cd36","expr":"end != null","rationale":"end label must be non-null as it is passed to Handler constructor","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-11T14:17:44.274674165Z"}
{"id":"9a6a14f1-9528-482a-a05d-48e52eae4941","expr":"handler != null","rationale":"handler label must be non-null as it is passed to Handler constructor","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitTryCatchBlock(Label,Label,Label,String):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-11T14:17:44.274674165Z"}
{"id":"e93c7b81-a719-4515-8342-0c3985a89c85","expr":"descriptor != null","rationale":"The descriptor string representing the annotation type should not be null for creating an annotation.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitTryCatchAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-11T14:17:44.274776949Z"}
