{"id":"6c8a1e87-3de3-438f-8e7f-1d3b930fe28c","expr":"result == (typeName != null && (typeName.equals(clazz.getTypeName()) || typeName.equals(clazz.getSimpleName())))","rationale":"Result reflects the exact return expression in the method.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#matchesTypeName(Class<?>,String):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:36.852976675Z"}
{"id":"f1ceb707-55dd-4498-8852-e151c482b98e","expr":"!result || (clazz.getTypeName() != null && clazz.getSimpleName() != null)","rationale":"If the method returns true, then clazz.getTypeName() and clazz.getSimpleName() must be non-null.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#matchesTypeName(Class<?>,String):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:36.852976675Z"}
{"id":"72a32673-d13e-4362-a81d-92e4aaf52e41","expr":"instance != null","rationale":"The method asserts that instance is not null before proceeding.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getUserClass(Object):Class<?>","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:39.094697312Z"}
