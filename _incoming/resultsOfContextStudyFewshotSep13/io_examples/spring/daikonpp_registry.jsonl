{"id":"09585785-43a9-4c86-ae2a-f9991a630361","expr":"(signature == null) || (signature.length() > 0)","rationale":"Signature is optional; if given, it is not empty.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.ClassTransformerChain#visitMethod(int,String,String,String,String[]):MethodVisitor","file":"org/springframework/cglib/transform/ClassTransformerChain.java","createdAt":"2026-09-11T14:17:39.343053793Z"}
