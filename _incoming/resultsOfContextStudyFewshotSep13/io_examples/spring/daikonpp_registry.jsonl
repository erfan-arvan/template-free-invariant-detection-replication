{"id":"c6dd19ff-0704-43b7-9943-ac5c4a519494","expr":"start + len <= text.length","rationale":"To avoid IndexOutOfBoundsException when creating the String.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeCharacters(char[],int,int):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.276416185Z"}
{"id":"067608d4-6460-4b54-9201-6fae48a6570d","expr":"data != null","rationale":"The method likely expects non-null input data to create a CDATA event.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeCData(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.290293711Z"}
{"id":"26801ec7-1d8c-48df-9cff-3600eaf67248","expr":"data.length() >= 0","rationale":"Data is a valid string and thus its length is always non-negative.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeCData(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.290293711Z"}
{"id":"49962b8b-0cb0-4c09-bb81-cb4c1a27c19d","expr":"!data.contains(\"]]>\" )","rationale":"The data for CDATA should not contain the CDATA termination sequence to be well-formed.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeCData(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.290293711Z"}
{"id":"4fb3efac-b234-44ac-abc0-5a04a3dcec63","expr":"data.indexOf(\"<\") == -1 || data.indexOf(\">\") == -1 || data.indexOf(\"<\") < data.indexOf(\">\")","rationale":"Ensures that if there are < and > characters, their order is valid or one is missing.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeCData(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.290293711Z"}
{"id":"0bffc312-41dc-4082-9d7c-4d3c1ee01a2a","expr":"!data.trim().isEmpty()","rationale":"Data is expected to be meaningful text and not just whitespace.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeCData(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.290293711Z"}
{"id":"80c9b5d6-3992-4f10-ab53-be4aeab22060","expr":"data != null","rationale":"The data parameter should not be null to create a valid XML comment.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeComment(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.292361224Z"}
{"id":"b414d77a-4600-412b-9ab0-19af2800497a","expr":"!data.contains(\"--\")","rationale":"XML comments cannot contain the sequence \"--\".","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeComment(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.292361224Z"}
{"id":"56b5019e-796d-4be5-92dc-7a6ea4c571f2","expr":"data.indexOf('>') == -1 || data.indexOf('<') == -1","rationale":"Comment data usually should not include angle brackets, avoiding malformed XML.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeComment(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.292361224Z"}
{"id":"caa57bb9-673c-4e53-805f-bec963180cf3","expr":"data.length() >= 0","rationale":"String length is always non-negative.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeComment(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.292361224Z"}
{"id":"5828c453-e3fc-4746-a0d1-d822fe6398e4","expr":"!data.startsWith(\"-\")","rationale":"XML comments should not start with a hyphen.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeComment(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.292361224Z"}
