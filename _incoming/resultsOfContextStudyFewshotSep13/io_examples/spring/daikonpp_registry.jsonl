{"id":"035fb179-cedb-4589-a414-96620d24769b","expr":"resourcePath.indexOf('/') >= -1","rationale":"resourcePath may or may not contain path separators.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#convertResourcePathToClassName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:19.944623345Z"}
