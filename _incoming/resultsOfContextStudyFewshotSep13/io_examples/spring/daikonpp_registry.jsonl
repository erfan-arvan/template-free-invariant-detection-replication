{"id":"4d00c5b1-2cf4-42c5-a1f6-e4ea6da76239","expr":"debug == null || debug.length() >= 0","rationale":"Debug can be null or a non-empty or empty string at method entry.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitSource(String,String):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T14:17:39.309824285Z"}
