{"id":"2b46a7e8-6d10-4f82-b8c6-ef53c09bb7f9","expr":"text != null","rationale":"The method creates a String using 'text', so it must be non-null to avoid NullPointerException.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XMLEventStreamWriter#writeCharacters(char[],int,int):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.266540051Z"}
