{"id":"6463b8fe-4312-4708-8999-54b8255063de","expr":"line.trim().startsWith(\"<!--\") || !line.trim().startsWith(\"<!--\")","rationale":"This is logically trivial but indicates the line either starts a comment or not.","kind":"METHOD_ENTRY","element":"org.springframework.util.xml.XmlValidationModeDetector#startComment(String):int","file":"org/springframework/util/xml/XmlValidationModeDetector.java","createdAt":"2026-09-11T14:11:35.907147549Z"}
