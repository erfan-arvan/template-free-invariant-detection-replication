{"id":"13d9cda3-0260-44e8-9d4b-2c9bb834b27b","expr":"maxStack >= 0","rationale":"Operand stack size cannot be negative","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMaxs(int,int):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T14:17:39.473154379Z"}
