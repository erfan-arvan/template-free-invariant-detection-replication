{"id":"4cb7150b-65c2-4fa0-b3b6-d850f725818b","expr":"(access & 0x0001) == 0 || (access & 0x0002) == 0 || (access & 0x0004) == 0","rationale":"Access flags commonly include visibility modifiers corresponding to 0x0001, 0x0002, or 0x0004 bits set.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.AbstractClassFilterTransformer#visitInnerClass(String,String,String,int):void","file":"org/springframework/cglib/transform/AbstractClassFilterTransformer.java","createdAt":"2026-09-11T14:17:39.333696157Z"}
