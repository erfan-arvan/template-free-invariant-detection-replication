{"id":"816638d3-c328-4741-ab2c-891f15c0f6fc","expr":"numLocal >= 0 && numLocal <= (local == null ? 0 : local.length)","rationale":"numLocal cannot be negative and must not exceed local array length.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodVisitor#visitFrame(int,int,Object[],int,Object[]):void","file":"org/springframework/asm/MethodVisitor.java","createdAt":"2026-09-11T14:17:47.802278399Z"}
