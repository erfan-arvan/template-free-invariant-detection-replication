{"id":"97ff1a0a-9603-4c39-81ba-eae9f5d4f395","expr":"name != null && !name.isEmpty()","rationale":"name should be a valid field name string.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T14:17:39.406778580Z"}
{"id":"d3260347-02bb-4f76-bf03-2cd12df83152","expr":"desc != null && !desc.isEmpty()","rationale":"desc should be a valid descriptor string of the field type.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.MethodVisitorTee#visitFieldInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T14:17:39.406778580Z"}
{"id":"7a959d9b-d892-4a1a-b61d-ae864db4d31b","expr":"result != null","rationale":"The method returns a new DefaultMethodReference object, so result should never be null.","kind":"METHOD_EXIT","element":"org.springframework.aot.generate.GeneratedMethod#toMethodReference():MethodReference","file":"org/springframework/aot/generate/GeneratedMethod.java","createdAt":"2026-09-11T14:17:39.410147737Z"}
{"id":"e949682e-d82d-4c06-9c89-2737e93e9adf","expr":"owner != null","rationale":"Method owner string should be non-null to represent the class/method owner.","kind":"METHOD_EXIT","element":"org.springframework.cglib.transform.MethodVisitorTee#visitMethodInsn(int,String,String,String):void","file":"org/springframework/cglib/transform/MethodVisitorTee.java","createdAt":"2026-09-11T14:17:39.413341754Z"}
