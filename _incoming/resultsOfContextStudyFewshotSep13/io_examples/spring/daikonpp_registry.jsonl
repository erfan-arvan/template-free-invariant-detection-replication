{"id":"241ea18c-4e35-4b87-bcac-962c1ebc1f92","expr":"(namespaceURI == null || !namespaceURI.isEmpty())","rationale":"Either namespaceURI is null or it should be a non-empty string.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeAttribute(String,String,String,String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.237880566Z"}
