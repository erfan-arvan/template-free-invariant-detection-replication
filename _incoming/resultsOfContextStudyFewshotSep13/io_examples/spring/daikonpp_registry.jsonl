{"id":"717a1382-1209-47c0-9571-2c57b0e4d4df","expr":"(interfaces.length >= 0)","rationale":"Interfaces array length is always zero or more.","kind":"METHOD_ENTRY","element":"org.springframework.cglib.transform.impl.InterceptFieldTransformer#begin_class(int,int,String,Type,Type[],String):void","file":"org/springframework/cglib/transform/impl/InterceptFieldTransformer.java","createdAt":"2026-09-11T14:17:39.133890259Z"}
