{"id":"b46411dc-b311-414f-800a-830e815fa0da","expr":"!text.contains(\"<\") && !text.contains(\">\")","rationale":"Text content written to XML characters likely does not contain angle brackets to avoid breaking XML structure.","kind":"METHOD_EXIT","element":"org.springframework.util.xml.XMLEventStreamWriter#writeCharacters(String):void","file":"org/springframework/util/xml/XMLEventStreamWriter.java","createdAt":"2026-09-11T14:11:36.265524139Z"}
