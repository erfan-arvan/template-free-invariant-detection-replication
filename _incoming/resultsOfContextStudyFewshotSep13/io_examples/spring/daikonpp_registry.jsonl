{"id":"ff6803c1-c0d7-4c14-b6ef-8ccb37858095","expr":"className.indexOf(\"$$\") == -1 || className.indexOf(\"$$\") <= className.length()","rationale":"The indexOf CGLIB class separator is -1 or within the string bounds.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getShortName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:43.670714724Z"}
{"id":"6b9c8420-02ad-48b2-b9e6-eba076377b07","expr":"className.indexOf(\"$$\") == -1 || className.indexOf(\"$$\") > className.lastIndexOf('.')","rationale":"If '$$' exists, it appears after the last dot to ensure substring is correct.","kind":"METHOD_ENTRY","element":"org.springframework.util.ClassUtils#getShortName(String):String","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:43.670714724Z"}
{"id":"6947f0c8-0705-452d-8586-f3d6b9da7386","expr":"!result || clazz.getDeclaredMethods().length > 0 || clazz.getInterfaces().length > 0 || clazz.getSuperclass() != null","rationale":"If result is true, clazz must have declared methods or non-empty interfaces or a superclass that might declare the method.","kind":"METHOD_EXIT","element":"org.springframework.util.ClassUtils#hasAtLeastOneMethodWithName(Class<?>,String):boolean","file":"org/springframework/util/ClassUtils.java","createdAt":"2026-09-11T14:12:43.692072780Z"}
