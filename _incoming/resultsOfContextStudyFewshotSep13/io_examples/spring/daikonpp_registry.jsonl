{"id":"f83ccc37-e9c0-4581-a78c-2f504a463f1f","expr":"descriptor.startsWith(\"[[\") || !descriptor.contains(\"[\")","rationale":"The descriptor should start with at least one or two '[' characters indicating array dimensions for a multi-dimensional array.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-11T14:17:44.222843853Z"}
{"id":"b11adeb3-e0f4-4210-9357-41effe494b91","expr":"numDimensions <= 255","rationale":"numDimensions is stored as a byte, so it must be within 0 and 255 inclusive.","kind":"METHOD_EXIT","element":"org.springframework.asm.MethodWriter#visitMultiANewArrayInsn(String,int):void","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-11T14:17:44.222843853Z"}
{"id":"48ffef8a-77c7-4766-ba94-81b7761b7c3e","expr":"descriptor != null && !descriptor.isEmpty()","rationale":"Annotations have a valid non-empty descriptor string.","kind":"METHOD_ENTRY","element":"org.springframework.asm.MethodWriter#visitInsnAnnotation(int,TypePath,String,boolean):AnnotationVisitor","file":"org/springframework/asm/MethodWriter.java","createdAt":"2026-09-11T14:17:44.259185655Z"}
