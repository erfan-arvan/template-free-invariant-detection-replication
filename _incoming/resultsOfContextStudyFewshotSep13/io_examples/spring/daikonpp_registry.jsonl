{"id":"aea06261-442f-424d-a2aa-b5f506a2d91a","expr":"buffer.length() > 0","rationale":"buffer should have content after styling field name and value","kind":"METHOD_EXIT","element":"org.springframework.core.style.DefaultToStringStyler#styleField(StringBuilder,String,Object):void","file":"org/springframework/core/style/DefaultToStringStyler.java","createdAt":"2026-09-11T14:12:48.640241057Z"}
