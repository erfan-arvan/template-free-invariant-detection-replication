{"id":"0dcf6a35-6cc7-454b-bdf8-676d5e31ac47","expr":"methodName != null","rationale":"The methodName must be non-null to find the method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.210939341Z"}
{"id":"9d35fdc8-4ab5-472f-bcd4-3a5676d16fc6","expr":"methodName.length() > 0","rationale":"Method name typically should not be empty for a valid method search.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.210939341Z"}
{"id":"d2a8eae2-ad97-4aaf-b73f-45dea984c5dc","expr":"type.isInterface() || !type.isPrimitive()","rationale":"Primarily methods are searched in classes or interfaces, not primitives.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.210939341Z"}
{"id":"382ece64-ba50-4cb0-bd18-48bbc4adb95a","expr":"type.getDeclaredMethods() != null","rationale":"The class's declared methods array is initialized and accessible.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.210939341Z"}
{"id":"43a5ee6e-2f2a-406b-9a2d-c8530f8fd1e7","expr":"(result == null) || (result.getName().equals(methodName))","rationale":"The method returns either null if not found or a Method whose name matches methodName.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.236513409Z"}
{"id":"55348d55-f515-49c0-910d-e9b4867da20d","expr":"(result == null) || (result.getDeclaringClass().equals(type))","rationale":"findMethod returns a Method declared by the given class type.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.236513409Z"}
{"id":"54eca0f1-a5d0-4d7d-87e8-ab443ebc18cb","expr":"type != null","rationale":"The method attempts to call type.getDeclaredMethod only if type is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.260695257Z"}
{"id":"0bc53d63-efe0-4dc7-9a33-4e7356684a25","expr":"methodName != null && !methodName.isEmpty()","rationale":"The method checks if methodName is not empty before calling getDeclaredMethod.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.260695257Z"}
{"id":"57adfdf7-61f8-48cd-8358-e8a4c84f099f","expr":"parameterTypes != null","rationale":"parameterTypes is the varargs argument for parameter types, usually not null at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.260695257Z"}
{"id":"0d502ae9-81a9-414a-8b3d-3fd6b5b9dec8","expr":"!methodName.isEmpty()","rationale":"Only proceed if methodName is not empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.260695257Z"}
{"id":"5cd4be20-314d-43f5-b5bb-9abfd3c6bb71","expr":"type != null && (methodName == null || methodName.isEmpty()) || parameterTypes != null","rationale":"Allows reasoning about parameter relationships and method execution path.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.260695257Z"}
{"id":"92d0a703-5f72-4277-a553-07a73dd0b2e1","expr":"result == null || result.getName().equals(methodName)","rationale":"The method returns either null or a Method with the exact requested methodName","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.284974116Z"}
{"id":"ee891625-8640-454f-9e6b-12e0aea4c381","expr":"result == null || result.getDeclaringClass() == type","rationale":"If a method is found, it must be declared by the given type","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.284974116Z"}
{"id":"b676d076-d580-4f7e-a499-51484f7e6ca3","expr":"object != null","rationale":"The method calls object.getClass(), so object must not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.308825651Z"}
{"id":"07ad64cc-edd8-4c81-8cdf-9545a609b749","expr":"methodName != null","rationale":"To find a method by name, methodName should not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.308825651Z"}
{"id":"c656e64c-9dc8-4995-932e-842fbb716a85","expr":"methodParameters == null || methodParameters.getClass().isArray()","rationale":"methodParameters is declared as Object..., so either null or an array of Objects.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.308825651Z"}
{"id":"4e5c806c-de97-4973-9cc8-86d3ddb6bbfd","expr":"object.getClass() != null","rationale":"The Class object for the runtime type of object is never null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.308825651Z"}
{"id":"537898e6-e3dd-430d-97df-2344cb890544","expr":"(methodParameters == null) || (methodParameters.length >= 0)","rationale":"methodParameters is either null or a (possibly empty) array.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.308825651Z"}
{"id":"b926a9db-0627-4602-a30e-14d752b07737","expr":"object != null && methodName != null && methodParameters != null && result != null","rationale":"Since the method invokes a method reflectively, if it returns normally, result should not be null (assuming underlying method does not return null).","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.330298898Z"}
