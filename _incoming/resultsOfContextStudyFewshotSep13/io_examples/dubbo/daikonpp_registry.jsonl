{"id":"6898c62d-bca6-402e-9e0b-7781d6e1c42c","expr":"bean != null && methodName != null && bean.getClass().getDeclaredMethods() != null","rationale":"bean is expected to be non-null to call getClass(); methodName is expected non-null for comparison with method names.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ReflectUtils#getProperty(Object,String):T","file":"org/apache/dubbo/common/utils/ReflectUtils.java","createdAt":"2026-09-11T10:20:39.423243548Z"}
