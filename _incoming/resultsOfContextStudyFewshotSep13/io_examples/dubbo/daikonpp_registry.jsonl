{"id":"96574222-53f3-46f4-9cbb-7f8426e207b3","expr":"methodsToFilter.getClass().isArray()","rationale":"methodsToFilter is a varargs parameter of Predicate<Method>, so it is always an array.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:50.461337650Z"}
{"id":"c4476547-593a-4b49-be9b-bed160d7a2b1","expr":"true == (includeInheritedTypes || !includeInheritedTypes)","rationale":"includeInheritedTypes is a boolean, so either true or false.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:50.461337650Z"}
{"id":"01241737-61be-4c22-afc1-df79b24607b9","expr":"true == (publicOnly || !publicOnly)","rationale":"publicOnly is a boolean, so either true or false.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:50.461337650Z"}
{"id":"37c37fea-4822-48c7-954e-d6b82ebb13d7","expr":"result != null","rationale":"Since the method returns an unmodifiableList, result should never be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:50.636096229Z"}
{"id":"1fa57dc1-d208-408d-9aa6-4e30868161e4","expr":"!result.isEmpty() || declaringClass == null || declaringClass.isPrimitive()","rationale":"An empty result implies either input was invalid or filters excluded all methods.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:50.636096229Z"}
{"id":"ee5a2730-e1a5-4190-ba7b-27b0e52ef667","expr":"declaringClass != null && !declaringClass.isPrimitive() || result.isEmpty()","rationale":"Method returns empty list if declaringClass is null or primitive.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:50.636096229Z"}
{"id":"ad0eab3b-986d-4f03-8a32-fbc87032e1f9","expr":"declaringClass != null","rationale":"The method appears to require a non-null Class parameter for correctness.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:51.546551173Z"}
{"id":"e7b2b4ab-d219-4411-ae80-a65ef3610e90","expr":"methodsToFilter != null","rationale":"The filter predicates array must be non-null to perform filtering.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:51.546551173Z"}
{"id":"fbbf82c0-05cf-4660-99af-4342508bcf14","expr":"methodsToFilter.getClass().isArray()","rationale":"methodsToFilter is a varargs array of Predicate<Method>.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:51.546551173Z"}
{"id":"c9d4787f-0ab4-4f98-8e96-cd52b810890e","expr":"declaringClass.getDeclaredMethods().length >= 0","rationale":"The number of declared methods on a Class is always non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:51.546551173Z"}
{"id":"b04d825b-eebd-4360-97fc-c9c20a9da4a3","expr":"result != null","rationale":"The method's contract returns a List of methods, never null (usually an empty list if no methods found).","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.186735462Z"}
