{"id":"6629c4d9-810f-419b-b6ea-2bdfc0cb97ae","expr":"overridden.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"The overrider's declaring class is assignable to the overridden's declaring class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.346724078Z"}
{"id":"04c2a871-20da-41f3-83a5-4bf2d28a6e53","expr":"Objects.equals(overrider.getName(), overridden.getName()) && overrider.getParameterCount() == overridden.getParameterCount()","rationale":"Method names and parameter counts are equal.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.346724078Z"}
{"id":"872588c5-b454-4848-8ab4-934d7463afa2","expr":"result || (overrider != null && overridden != null)","rationale":"The method returns false immediately if overrider or overridden is null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.362339674Z"}
{"id":"3938e6c3-3eca-4c84-9ed9-dbc944e0207b","expr":"result || !Objects.equals(overrider, overridden)","rationale":"If the method returns true, the two Method objects are not equal.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.362339674Z"}
{"id":"2e6bf4ee-debf-4f73-99c5-3299694ac93f","expr":"result || overridden.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"The declaring class of overrider is a subclass or the same as overridden's when result is true.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.362339674Z"}
{"id":"6adc0be6-a589-44a1-800f-d018b77540d1","expr":"overrider != null","rationale":"The method operates on the 'overrider' parameter, invoking instance methods on it. Thus 'overrider' must be non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.378405808Z"}
{"id":"dac365fb-d944-4bae-85da-27cc902052e8","expr":"overrider.getDeclaringClass() != null","rationale":"According to the Java Reflection API contracts, Method#getDeclaringClass always returns a non-null Class<?> object.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.378405808Z"}
{"id":"2ce3eb65-a9fa-49cd-8d0e-0ec9e4e3868a","expr":"!overrider.isSynthetic()","rationale":"Synthetic methods do not participate in typical override semantics, so generally the overridden finder considers non-synthetic methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.378405808Z"}
{"id":"aa94b39f-5b0e-4a79-b273-e49d5cba1948","expr":"overrider.getParameterCount() >= 0","rationale":"Ensures the parameter count of the overrider method is a valid number (non-negative).","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.378405808Z"}
{"id":"5cc477df-552b-484a-a44d-d3a663b98b8a","expr":"overrider.getReturnType() != null","rationale":"Method#getReturnType returns a non-null Class<?> instance reflecting the method's return type.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.378405808Z"}
{"id":"a3510336-3315-43d5-943b-17280677a973","expr":"result == null || (result != overrider && result.getName().equals(overrider.getName()))","rationale":"The method returns either null or an overridden method of overrider with the same name.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.393917909Z"}
{"id":"50383887-7d62-4c4a-9300-167efaa05707","expr":"result == null || result.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"Overridden methods must be declared in a superclass or superinterface.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.393917909Z"}
{"id":"323ba873-2618-47b0-a43b-b0b2296bf752","expr":"result == null || result.getParameterCount() == overrider.getParameterCount()","rationale":"Overriding methods have the same signature parameter count.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.393917909Z"}
{"id":"d547ee50-811b-4385-820e-7564574357a0","expr":"result == null || !result.equals(overrider)","rationale":"The result, if non-null, is different from the overrider method itself.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.393917909Z"}
{"id":"b1fdb143-4203-4d9c-b467-2e795005e2e7","expr":"overrider != null","rationale":"The method findOverriddenMethod assumes overrider is valid and non-null to perform logic on it.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.408474140Z"}
{"id":"028c84e1-d40b-4804-8860-4bf39ed2799c","expr":"declaringClass != null","rationale":"A null declaringClass would prevent performing reflective lookups.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.408474140Z"}
{"id":"0125045d-b3b6-4e17-a103-3dec6400f816","expr":"declaringClass.isAssignableFrom(overrider.getDeclaringClass())","rationale":"Overrides occur when the overrider is declared in a subclass of or the same class as declaringClass.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.408474140Z"}
{"id":"16b88a0c-7fbe-4402-bdc5-81a07005ad0d","expr":"overrider.getParameterCount() >= 0","rationale":"Java methods cannot have negative parameter counts.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.408474140Z"}
{"id":"208407a5-5315-4151-9f38-ddeaffbb82fa","expr":"overrider.getName() != null","rationale":"All Java Method instances have non-null names.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.408474140Z"}
{"id":"12ee2e35-131e-4a07-be5f-59b4e6dd2467","expr":"result == null || declaringClass.isAssignableFrom(result.getDeclaringClass())","rationale":"Since the found overridden method must be declared in a class assignable from declaringClass, this captures proper overriding hierarchy.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.422960630Z"}
{"id":"9a222dc2-b33f-4ac4-95b3-234a7540b238","expr":"result == null || result.getDeclaringClass() != null","rationale":"Java Method instances always have a non-null declaring class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.422960630Z"}
{"id":"62581238-27f2-493c-a73c-95e5f817ef2b","expr":"result == null || result.getName().equals(overrider.getName())","rationale":"Overriding implies methods share name.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.422960630Z"}
{"id":"0c166357-2671-4638-b843-7971c0f0bdd5","expr":"result == null || result.getParameterCount() == overrider.getParameterCount()","rationale":"Overridden methods must have the same signature, including parameter count.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.422960630Z"}
{"id":"1579f3b2-c9c7-43d1-b5ca-6161372f15da","expr":"result != null","rationale":"The method is expected to return a non-null list even if no methods match.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:55.785620297Z"}
{"id":"4e0c0826-3ead-4aaa-bee9-72ddc183ce0f","expr":"declaringClass != null","rationale":"The method getAllDeclaredMethods operates on the declaringClass parameter, which cannot be null for method retrieval.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.050704309Z"}
{"id":"e438f6e7-ca24-4df7-81a3-95c93dccadca","expr":"methodsToFilter != null","rationale":"The method expects an array of Predicate filters which may be empty but not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.050704309Z"}
{"id":"0ff74e07-0095-4bd9-9d3b-c8eb86044c92","expr":"methodsToFilter.getClass().isArray()","rationale":"methodsToFilter is declared as vararg Predicate parameter, which is treated as an array and must have an array type.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.050704309Z"}
{"id":"0d3daf05-6824-450c-b3c8-ad4a0248ae94","expr":"(!declaringClass.isPrimitive())","rationale":"Methods are not declared on primitive classes; thus, the class is usually non-primitive.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.050704309Z"}
{"id":"f546c5bf-f22d-40cf-9149-4af94d6a906b","expr":"declaringClass.getName() != null","rationale":"A Class object always has a non-null name string.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.050704309Z"}
{"id":"b3b30722-b8f2-41bd-a1db-ff763ec4a9c6","expr":"method != null","rationale":"The method parameter should be non-null to properly invoke the method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.080498495Z"}
{"id":"744870f8-fb41-4121-8150-b2f183aa7ea0","expr":"targetObj == null || method.getDeclaringClass().isInstance(targetObj)","rationale":"Either the target object is null (for static methods) or is an instance of the declaring class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.080498495Z"}
{"id":"259376ff-d038-41a2-ae0a-7ca0249cde73","expr":"method.getParameterCount() == 0","rationale":"The method is invoked with no arguments (as seen in the code).","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.080498495Z"}
{"id":"eb946081-3934-4ef6-a0e9-a92f414498d4","expr":"(! (method == null))","rationale":"Redundant null check that triggers alternate behavior in the method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.080498495Z"}
{"id":"689a3580-c5f3-4da1-b1d4-202c50c6ca77","expr":"declaringClass != null","rationale":"The declaringClass must be provided for method retrieval.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.102875413Z"}
{"id":"28583a04-f9ac-4911-8b5c-de128056e318","expr":"methodsToFilter != null","rationale":"Since methodsToFilter is varargs, it is at least an empty array, not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.102875413Z"}
{"id":"754d48ef-e1c7-4b23-9674-725ef6d37f16","expr":"methodsToFilter.getClass().isArray()","rationale":"The methodsToFilter parameter is a vararg, representing an array of Predicate<Method>.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.102875413Z"}
{"id":"e8171c6d-11c8-4917-97bc-78bf6397e999","expr":"declaringClass.isInterface() || !declaringClass.isPrimitive()","rationale":"The declaringClass should represent a reference type, either interface or class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.102875413Z"}
{"id":"a183c429-0781-4cd5-a4d8-120d854ea423","expr":"methodsToFilter.length >= 0","rationale":"The length of the array cannot be negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.102875413Z"}
{"id":"d3352de1-93ba-4597-9fd0-1136b00d3a09","expr":"method == null || !Double.isNaN(result)","rationale":"When method is null, the method returns Double.NaN explicitly, otherwise it returns the invoked value cast to double.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.105498753Z"}
{"id":"f5888147-f6a0-44ef-a16e-0c73779d2257","expr":"Double.isNaN(result) || method != null","rationale":"Result is NaN only if method is null or invocation failed.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.105498753Z"}
{"id":"d155ef0e-5947-48f0-b682-a67e493070fe","expr":"result == Double.NaN || (method != null && !Double.isNaN(result))","rationale":"Result is NaN exactly when invocation failed or method is null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.105498753Z"}
{"id":"627a8f7c-7856-46dc-8332-5e115f6a3de7","expr":"!Double.isNaN(result) || method == null","rationale":"Result is NaN only if method is null or invocation failed.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.105498753Z"}
{"id":"88dc6e45-73c1-426c-bce1-3ab89f0e4630","expr":"method != null || targetObj == null","rationale":"Since method.invoke(targetObj) is called only if method is not null, if method is null, targetObj's state does not affect execution.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.130999473Z"}
{"id":"d51d8c95-4e48-49c9-b215-8d0dc02d179e","expr":"method == null || method.getParameterCount() == 0","rationale":"The provided invoke call does not pass arguments, so method's parameter count should be zero when method is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.130999473Z"}
{"id":"10687cd5-86bb-4fb0-bf97-21071a60475d","expr":"targetObj != null || method == null","rationale":"If method is static, targetObj can be null; otherwise, it shouldn't be null when method is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.130999473Z"}
{"id":"b62f1262-63d8-4c58-ba7b-0f7e07d8333c","expr":"(method == null) == (result == -1L)","rationale":"The method returns -1 if the method parameter is null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.131712276Z"}
{"id":"83657ceb-c609-4c31-842c-77ac2170073f","expr":"(method != null) || (result == -1L)","rationale":"The method lengthens that if method is null, result must be -1.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.131712276Z"}
{"id":"998837da-c523-4ddb-a2c2-77a065ccfcf9","expr":"(result == -1L) || (method != null)","rationale":"If result is not -1, it means method.invoke was called, so method is not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.131712276Z"}
{"id":"a5553235-d973-4f67-b257-58db47800abe","expr":"result == -1L || (result != -1L)","rationale":"This is tautological but harmless; consider dropping if preferred.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.131712276Z"}
{"id":"0b00eb1e-2772-40d3-b2b5-4e710eef03f3","expr":"method == null || !method.isVarArgs()","rationale":"Because invoke is called with exactly one argument (targetObj) and no varargs, method should either be null or not a varargs method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.130999473Z"}
{"id":"d8e25e4e-4820-40ac-884b-752105c22fa0","expr":"method != null","rationale":"The method object must be non-null to call instance methods safely.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.147702367Z"}
{"id":"1ad7e002-7d93-48e4-8750-82eb26844d83","expr":"method.getDeclaringClass() != null","rationale":"Every method must belong to a declaring class, so this is required.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.147702367Z"}
{"id":"97f4e2ad-2269-45bb-b8a3-b0004611cd6c","expr":"method.getName() != null","rationale":"A Java Method object should always have a non-null name.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.147702367Z"}
{"id":"d71e17f0-1c68-40bc-8b92-134764d2a5e7","expr":"method.getParameterTypes() != null","rationale":"Parameter types array returned by Method is always non-null, possibly empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.147702367Z"}
{"id":"bdcb9d67-3d9c-4367-9c71-b3307d82da1f","expr":"method.getParameterTypes().length >= 0","rationale":"Array length properties are always non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.147702367Z"}
{"id":"2ad4863f-9c89-4145-aea8-b06dd884b768","expr":"result != null","rationale":"toShortString builds a string regardless of method details, so result should never be null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.154117457Z"}
{"id":"e58068ef-2b33-4a19-a355-50435fc72422","expr":"result.startsWith(method.getDeclaringClass().getName() + \".\" )","rationale":"The string is constructed starting with the declaring class name and a dot.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.154117457Z"}
{"id":"62786796-ff10-4a20-887b-709663d22f5c","expr":"result.endsWith(\")\")","rationale":"The method appends a closing parenthesis at the end of the string.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.154117457Z"}
{"id":"59402d64-7e6a-4aa1-a906-702c237f6a98","expr":"result.contains(method.getName())","rationale":"toShortString appends the method's name within the string.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.154117457Z"}
{"id":"4713fe16-b7db-4c25-bcbe-3fb4ba4eaa8a","expr":"!result.contains(\"(\") || result.indexOf('(') > (method.getDeclaringClass().getName().length() + 1)","rationale":"String is constructed as 'ClassName.methodName(' so '(' must be after className + dot length.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.154117457Z"}
{"id":"cf2def3f-788b-418d-9375-bda7a490de60","expr":"md != null","rationale":"The method expects a valid MethodDescriptor object; otherwise, it cannot proceed.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(MethodDescriptor):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.162087525Z"}
{"id":"2ade2fc4-fa91-41be-a962-7f5a94866f54","expr":"md.getParameterClasses() != null","rationale":"The method appends parameter type names, which requires a non-null array.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(MethodDescriptor):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.162087525Z"}
{"id":"1c69a431-4ca3-4e20-aaa2-7797e0158f1a","expr":"md.getParameterClasses().length >= 0","rationale":"Array lengths in Java are always non-negative, but explicitly stating for clarity.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(MethodDescriptor):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.162087525Z"}
{"id":"732552c1-dd3e-4865-9155-f6ad7b4b5afd","expr":"md.getMethodName() != null","rationale":"The toShortString uses md.getMethodName() when the method is null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(MethodDescriptor):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-11T10:18:56.162087525Z"}
