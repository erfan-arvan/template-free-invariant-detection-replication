{"id":"c1095cbb-8e70-4599-9cb7-c5d1371ad3f4","expr":"method.getName().length() >= 0","rationale":"Method name length is always non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.config.AbstractConfig#isPropertySetter(Method):boolean","file":"org/apache/dubbo/config/AbstractConfig.java","createdAt":"2026-09-10T13:27:13.970757286Z"}
{"id":"f4b760bb-6157-4c7c-b569-cb995c77dac6","expr":"method.getParameterCount() >= 0","rationale":"Parameter count cannot be negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.config.AbstractConfig#isPropertySetter(Method):boolean","file":"org/apache/dubbo/config/AbstractConfig.java","createdAt":"2026-09-10T13:27:13.970757286Z"}
{"id":"a2142e83-fff5-4127-9313-e55f04bdc7b2","expr":"! (result != null && !result.isEmpty()) || c != null","rationale":"Because invocation of getParameters depends on a valid class object.","kind":"METHOD_EXIT","element":"org.apache.dubbo.config.AbstractConfig#invokeGetParameters(Class,Object):Map<String, String>","file":"org/apache/dubbo/config/AbstractConfig.java","createdAt":"2026-09-10T13:27:13.985666531Z"}
{"id":"90fcba6e-3d9c-4d3d-abdd-ace90f1bbfdf","expr":"result == null || o != null","rationale":"Because method.invoke(o) requires o to be non-null for successful invocation.","kind":"METHOD_EXIT","element":"org.apache.dubbo.config.AbstractConfig#invokeGetParameters(Class,Object):Map<String, String>","file":"org/apache/dubbo/config/AbstractConfig.java","createdAt":"2026-09-10T13:27:13.985666531Z"}
