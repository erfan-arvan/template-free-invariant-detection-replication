{"id":"ef2b8b69-336a-4f84-adf1-a29d669df585","expr":"e == null || e != null","rationale":"e is passed through to logger.info as is, may be null or not","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.LogHelper#info(Logger,String,Throwable):void","file":"org/apache/dubbo/common/utils/LogHelper.java","createdAt":"2026-09-10T13:27:31.836973273Z"}
