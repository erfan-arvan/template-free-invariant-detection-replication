{"id":"b94b068e-e6b6-4aba-9b2e-3c6a06700cc1","expr":"method.getName() != null","rationale":"Method name must be non-null to check if it startsWith 'set' and compare for 'set'.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.config.AbstractConfig#isNestedSetter(Object,Method):boolean","file":"org/apache/dubbo/config/AbstractConfig.java","createdAt":"2026-09-10T13:27:14.086620149Z"}
