{"id":"fa88a823-7651-4a51-8b3f-7e0917063664","expr":"Character.isDefined(defaultValue)","rationale":"defaultValue is a character parameter, and it should be valid.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodParameter(String,String,char):char","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-09-10T13:27:20.490741065Z"}
