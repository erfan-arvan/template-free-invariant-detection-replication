{"id":"d4073512-8eb3-4aa6-a06c-78ff7339f9c0","expr":"result.test(null) == !Objects.equals(declaredClass, null)","rationale":"Applying the Predicate to a null method yields the negation of Objects.equals(declaredClass, null).","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#excludedDeclaredClass(Class<?>):Predicate<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.919648062Z"}
{"id":"38a2388e-188e-4084-8d1f-19602b21d244","expr":"result != null","rationale":"The returned list of methods should never be null; it may be empty but not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.928446109Z"}
{"id":"ed2edeb3-f617-4f84-8250-8c1dc0097add","expr":"declaringClass != null","rationale":"Method implementation checks for null and returns early, so the parameter should be non-null for actual processing.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.929009882Z"}
{"id":"368ee43a-2f1f-46ae-a80b-d00ea9724583","expr":"!declaringClass.isPrimitive()","rationale":"Method returns immediately if declaringClass is primitive; thus for the method body executing, declaringClass must not be primitive.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.929009882Z"}
{"id":"814e8728-86df-4aab-b32d-ba9692f2a203","expr":"methodsToFilter != null","rationale":"The methodsToFilter predicate is expected to be used to filter methods, so typically it is passed non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.929009882Z"}
{"id":"f26bae88-a144-46e8-a249-b4ec687e12b0","expr":"publicOnly || !publicOnly","rationale":"publicOnly is a boolean flag; this invariant is trivially true but included for completeness.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.929009882Z"}
{"id":"be5cb271-408c-4e2c-b387-fd5b3b56a197","expr":"includeInheritedTypes || !includeInheritedTypes","rationale":"includeInheritedTypes is a boolean flag; trivial invariant indicating presence of boolean.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.929009882Z"}
{"id":"d9f05b3e-04ef-411e-b213-9b649d21ba38","expr":"result != null","rationale":"The method always returns an unmodifiable list, never null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,boolean,boolean,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.929172960Z"}
{"id":"7def3432-8136-4a72-be40-7ec2f275cf26","expr":"declaringClass != null","rationale":"The method operates on the declaringClass to get methods; a null declaringClass would be improper.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.930161254Z"}
{"id":"b1a0b36e-8a28-424b-93e4-23044e7d0f71","expr":"methodsToFilter != null","rationale":"The predicate to filter methods should be defined, even if it might be an empty filter.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.930161254Z"}
{"id":"a607dde8-7835-44a4-aef1-a80b2ced406c","expr":"!declaringClass.isPrimitive()","rationale":"Primitive types don't have declared methods, so commonly the class passed is non-primitive.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.930161254Z"}
{"id":"7b26e815-19d1-4541-8006-e0b67e3b62f5","expr":"declaringClass.getDeclaredMethods().length >= 0","rationale":"The array length returned by getDeclaredMethods() is always non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.930161254Z"}
{"id":"143b6d36-a70f-449a-ab60-9e869814fed4","expr":"declaringClass != null","rationale":"The method requires a non-null declaringClass to retrieve methods from.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.936237607Z"}
{"id":"ea352c03-0443-4de8-bb85-2e3aefa480d9","expr":"methodsToFilter != null","rationale":"The methodsToFilter predicate array is expected to be non-null even if empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.936237607Z"}
{"id":"e669bfa7-4d62-41b6-b4ad-fac1715e422d","expr":"methodsToFilter.length >= 0","rationale":"Array length is always non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.936237607Z"}
{"id":"efb5289b-d3c7-4ddb-b0df-ab39f3b48fb7","expr":"(!declaringClass.isPrimitive())","rationale":"Expected the class to be non-primitive for method retrieval.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.936237607Z"}
{"id":"90a0b43c-4786-43e7-ace4-eaff6dfa5214","expr":"declaringClass.getMethods().length > 0 || declaringClass.getDeclaredMethods().length >= 0","rationale":"DeclaringClass has either public or declared methods or none.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.936237607Z"}
{"id":"2557b333-20d2-46fd-8a8b-df8a0b877468","expr":"result != null","rationale":"The method always returns a List instance, even if empty.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.936664362Z"}
{"id":"a58609db-f0d1-45fd-b150-ac836cf9f9d3","expr":"!(methodsToFilter != null && methodsToFilter.test(null)) || !result.contains(null)","rationale":"The list contains only non-null Method objects passing the filter; if filter doesn't accept null, then no null is in the list.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.936664362Z"}
{"id":"dd3c46aa-2891-45fa-9360-ced72b0c6dc9","expr":"result.size() >= 0","rationale":"The result is a java.util.List, which cannot have negative size.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.936664362Z"}
{"id":"d160215f-b09f-4759-9dd6-26c5f921a8e8","expr":"declaringClass != null","rationale":"The declaringClass parameter must be non-null to retrieve its methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.946321399Z"}
{"id":"14b3b84f-d57d-40f0-8dac-0b8fdfb7879d","expr":"methodsToFilter != null","rationale":"The methodsToFilter predicate is expected to be non-null for filtering methods","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.946321399Z"}
{"id":"50aac8dc-c92b-46f7-8f99-e92600281faf","expr":"declaringClass.getDeclaredMethods().length >= 0","rationale":"The class's declared methods array length is non-negative","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.946321399Z"}
{"id":"8e132879-68e3-442e-9196-0e97777d5750","expr":"methodsToFilter.test(declaringClass.getDeclaredMethods()[0]) || declaringClass.getDeclaredMethods().length == 0","rationale":"If there are declared methods, the filter predicate applies to at least one of them; otherwise, no methods exist","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.946321399Z"}
{"id":"49db04e9-aa8c-46d7-8219-d9ed7e651a6c","expr":"declaringClass.isInterface() || !declaringClass.isPrimitive()","rationale":"The class is either an interface or not a primitive type since methods only exist in such classes","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.946321399Z"}
{"id":"6cdaa4a4-cf78-469a-b8b2-c16e76592e19","expr":"result != null","rationale":"The method returns a list so result is expected to be non-null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllDeclaredMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.958508048Z"}
{"id":"9966b6dc-6d79-44e9-a1c7-6c1a19c8493a","expr":"(result == null) || (result.getName().equals(methodName))","rationale":"The method returns either null if not found or a Method whose name matches methodName.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.958567990Z"}
{"id":"6d92f137-2562-4602-8f42-1894f8f2fbfe","expr":"(result == null) || (result.getDeclaringClass().equals(type))","rationale":"findMethod returns a Method declared by the given class type.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.958567990Z"}
{"id":"ae77c6a4-5874-4631-8b93-ea9a099f7f1d","expr":"type != null","rationale":"The Class parameter 'type' must be non-null to find a method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.959509116Z"}
{"id":"a9a3957d-77c9-4c0d-a066-ecfbf9882059","expr":"methodName != null","rationale":"The methodName must be non-null to find the method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.959509116Z"}
{"id":"0f294f9e-0a9e-473e-b6ab-e1ff53537d5d","expr":"methodName.length() > 0","rationale":"Method name typically should not be empty for a valid method search.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.959509116Z"}
{"id":"a81084b9-839a-465c-8105-25ede9eddf98","expr":"type.isInterface() || !type.isPrimitive()","rationale":"Primarily methods are searched in classes or interfaces, not primitives.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.959509116Z"}
{"id":"2f829280-f425-46f6-91dd-7d0dc9fe2467","expr":"type.getDeclaredMethods() != null","rationale":"The class's declared methods array is initialized and accessible.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.959509116Z"}
{"id":"32dae664-c6ea-4f93-bde8-31cf6d264d6f","expr":"declaringClass != null","rationale":"To get all methods, the declaringClass cannot be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.980982253Z"}
{"id":"2a59ac6d-88c6-4e27-9bce-cf45c1a8bdec","expr":"result != null","rationale":"The result is expected to be a non-null List of methods including inherited ones.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.981063396Z"}
{"id":"35549ebf-e166-48d8-8a71-40144e3cd9bb","expr":"type != null","rationale":"The method attempts to call type.getDeclaredMethod only if type is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.981433203Z"}
{"id":"67f4d65f-6308-4dac-b080-26d1c6b0631f","expr":"methodsToFilter != null","rationale":"The methodsToFilter parameter is expected to be a Predicate array and should not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.980982253Z"}
{"id":"bc3c9dcb-18db-4b3f-b57e-41fd3d0f657b","expr":"methodsToFilter.length >= 0","rationale":"Ensures valid length of the filter predicates array.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.980982253Z"}
{"id":"7a25cd34-cec1-4c7f-9d8d-1ec834f77ac7","expr":"declaringClass.getDeclaredMethods().length >= 0","rationale":"Declared methods array length is always non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#getAllMethods(Class<?>,Predicate<Method>):List<Method>","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.980982253Z"}
{"id":"4ebbc88c-31ca-49b0-b715-d630cc3996dc","expr":"result == null || result.getName().equals(methodName)","rationale":"The method returns either null or a Method with the exact requested methodName","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.982669976Z"}
{"id":"7c858af6-6fc0-4e1f-b974-fd4f81944007","expr":"overrider != null && overridden != null && !Objects.equals(overrider, overridden)","rationale":"Both methods must be non-null and unequal for override to be possible.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.982834677Z"}
{"id":"28188c7d-a35c-4a73-bab7-0536060d98ea","expr":"methodName != null && !methodName.isEmpty()","rationale":"The method checks if methodName is not empty before calling getDeclaredMethod.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.981433203Z"}
{"id":"dc64a062-4c3f-417b-9481-3ecfd8b959e7","expr":"parameterTypes != null","rationale":"parameterTypes is the varargs argument for parameter types, usually not null at method entry.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.981433203Z"}
{"id":"d026bc6d-0f4a-4df8-84d2-c55cb6d520b1","expr":"!methodName.isEmpty()","rationale":"Only proceed if methodName is not empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.981433203Z"}
{"id":"3e0f0f7c-f319-4430-af33-8bf66aa554aa","expr":"overridden.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"The overrider's declaring class is assignable to the overridden's declaring class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.982834677Z"}
{"id":"cfe776a9-dab3-4a3f-8c4e-ad85bca5d1cf","expr":"object != null && methodName != null && methodParameters != null && result != null","rationale":"Since the method invokes a method reflectively, if it returns normally, result should not be null (assuming underlying method does not return null).","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.982874963Z"}
{"id":"1914165b-9e78-49f9-a839-201a924b8298","expr":"result == null || result.getDeclaringClass() == type","rationale":"If a method is found, it must be declared by the given type","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.982669976Z"}
{"id":"e0a5cb5d-b452-4068-86c5-f66060c3d5e5","expr":"object != null","rationale":"The method calls object.getClass(), so object must not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.984526759Z"}
{"id":"22ed99f9-1b86-4110-86a3-1d0d3905ffbd","expr":"methodName != null","rationale":"To find a method by name, methodName should not be null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.984526759Z"}
{"id":"ceb7f0e5-7ee4-448a-8911-87939876f589","expr":"methodParameters == null || methodParameters.getClass().isArray()","rationale":"methodParameters is declared as Object..., so either null or an array of Objects.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.984526759Z"}
{"id":"6f195d88-40aa-4943-b6d8-c6c31b93b548","expr":"object.getClass() != null","rationale":"The Class object for the runtime type of object is never null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.984526759Z"}
{"id":"15489d4d-5495-4bc7-9726-ff2586749b07","expr":"(methodParameters == null) || (methodParameters.length >= 0)","rationale":"methodParameters is either null or a (possibly empty) array.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeMethod(Object,String,Object):T","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.984526759Z"}
{"id":"c54eefa7-bd7f-43e4-8078-df73b6ac3e40","expr":"result || (overrider != null && overridden != null)","rationale":"The method returns false immediately if overrider or overridden is null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.982692579Z"}
{"id":"0d831790-2d96-4646-91f9-7a45501479a3","expr":"result || !Objects.equals(overrider, overridden)","rationale":"If the method returns true, the two Method objects are not equal.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.982692579Z"}
{"id":"ba88e825-7234-4a4a-a079-b1691cc823d7","expr":"result || overridden.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"The declaring class of overrider is a subclass or the same as overridden's when result is true.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.982692579Z"}
{"id":"8c00b324-c56e-4137-bbf6-11fcf2b133d7","expr":"Objects.equals(overrider.getName(), overridden.getName()) && overrider.getParameterCount() == overridden.getParameterCount()","rationale":"Method names and parameter counts are equal.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#overrides(Method,Method):boolean","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.982834677Z"}
{"id":"e7e04276-3f6d-4bcd-abce-00ed29e69148","expr":"type != null && (methodName == null || methodName.isEmpty()) || parameterTypes != null","rationale":"Allows reasoning about parameter relationships and method execution path.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findMethod(Class,String,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:28.981433203Z"}
