{"id":"35fc2259-a37f-4e1b-9c6c-beaff4905559","expr":"defaultValue > 0","rationale":"Method throws IllegalArgumentException if defaultValue <= 0, so defaultValue must be positive.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.URL#getMethodPositiveParameter(String,String,short):short","file":"org/apache/dubbo/common/URL.java","createdAt":"2026-09-10T13:27:20.414158159Z"}
