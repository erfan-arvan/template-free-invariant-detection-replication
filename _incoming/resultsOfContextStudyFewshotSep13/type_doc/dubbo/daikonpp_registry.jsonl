{"id":"0f5e6c7d-b67e-4be4-ba12-367b5a1fb242","expr":"result == null || result.getDeclaringClass().isAssignableFrom(overrider.getDeclaringClass())","rationale":"Overridden methods must be declared in a superclass or superinterface.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.000557780Z"}
{"id":"42756afb-274d-4a48-8eda-f3e9c1523a44","expr":"result == null || result.getParameterCount() == overrider.getParameterCount()","rationale":"Overriding methods have the same signature parameter count.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.000557780Z"}
{"id":"783109dd-b33d-4499-8b0b-baadd0394100","expr":"result == null || !result.equals(overrider)","rationale":"The result, if non-null, is different from the overrider method itself.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.000557780Z"}
{"id":"cffd799a-10b2-45de-841a-a8e8a6b0eb3a","expr":"method != null","rationale":"The method parameter must be non-null for method invocation, as the method uses method.getName() unconditionally.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.020734260Z"}
{"id":"6572fca1-65f9-4092-9cf1-f8298aae5508","expr":"overrider != null","rationale":"The method findOverriddenMethod assumes overrider is valid and non-null to perform logic on it.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.020903129Z"}
{"id":"23905988-91f0-426e-ab25-fa87249b3a34","expr":"declaringClass != null","rationale":"A null declaringClass would prevent performing reflective lookups.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.020903129Z"}
{"id":"63d5bc59-74bc-4551-acc3-e91ca9eeb3cf","expr":"declaringClass.isAssignableFrom(overrider.getDeclaringClass())","rationale":"Overrides occur when the overrider is declared in a subclass of or the same class as declaringClass.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.020903129Z"}
{"id":"884d261c-1372-448b-be5a-71d5fb964fab","expr":"overrider.getParameterCount() >= 0","rationale":"Java methods cannot have negative parameter counts.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.020903129Z"}
{"id":"3c86157c-b4ae-40b5-8f12-7ba44e7dd8c3","expr":"overrider.getName() != null","rationale":"All Java Method instances have non-null names.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.020903129Z"}
{"id":"33c89f46-07bd-450a-bed8-220c7d3a1afd","expr":"overrider != null","rationale":"The method operates on the 'overrider' parameter, invoking instance methods on it. Thus 'overrider' must be non-null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021035198Z"}
{"id":"a76e995a-8a7d-4a7e-8bd9-168c5e643658","expr":"overrider.getDeclaringClass() != null","rationale":"According to the Java Reflection API contracts, Method#getDeclaringClass always returns a non-null Class<?> object.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021035198Z"}
{"id":"8a1f3e5e-b289-4e4e-b899-0bd6e2398b2e","expr":"method.getName() != null","rationale":"Method names are never null; getName() returns a non-null string representing the method name.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.020734260Z"}
{"id":"9afed79e-a6cd-4e8e-a3c5-8400ac8bd3c8","expr":"!method.getName().isEmpty()","rationale":"Method names are typically non-empty strings.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.020734260Z"}
{"id":"4df54dc8-f176-4b9c-a926-c155f79a4b36","expr":"method.getName().length() >= 2","rationale":"Method names checked for prefixes ('is', 'get', 'set') are at least length 2.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.020734260Z"}
{"id":"2ff05c78-a305-4dfb-8a22-0ce350d42451","expr":"result != null","rationale":"The method always returns a non-null string, either empty or a processed field name.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021884240Z"}
{"id":"4063a409-4466-4ce7-b3b2-02032127bf36","expr":"!overrider.isSynthetic()","rationale":"Synthetic methods do not participate in typical override semantics, so generally the overridden finder considers non-synthetic methods.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021035198Z"}
{"id":"8490c9de-901a-4925-9ce3-4e5f33939607","expr":"overrider.getParameterCount() >= 0","rationale":"Ensures the parameter count of the overrider method is a valid number (non-negative).","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021035198Z"}
{"id":"667c429a-fd1a-4e3d-8b46-ae89cd088540","expr":"overrider.getReturnType() != null","rationale":"Method#getReturnType returns a non-null Class<?> instance reflecting the method's return type.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#findNearestOverriddenMethod(Method):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021035198Z"}
{"id":"7a7f22a7-2f45-40ec-93bd-32f5d06a6f20","expr":"method != null","rationale":"The method parameter should be non-null to properly invoke the method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021525002Z"}
{"id":"b32357b3-5acd-42b3-91d3-bdf7c972cc6f","expr":"targetObj == null || method.getDeclaringClass().isInstance(targetObj)","rationale":"Either the target object is null (for static methods) or is an instance of the declaring class.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021525002Z"}
{"id":"0197bbdb-11a5-4a08-9b23-bcc2f96b2c80","expr":"method.getParameterCount() == 0","rationale":"The method is invoked with no arguments (as seen in the code).","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021525002Z"}
{"id":"56fce2ca-dd14-4587-8962-4d6fdcc7c357","expr":"(! (method == null))","rationale":"Redundant null check that triggers alternate behavior in the method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021525002Z"}
{"id":"6d090d30-6a68-4279-8f19-f1850d832366","expr":"result.isEmpty() || Character.isLowerCase(result.charAt(0))","rationale":"When non-empty, the result has its first letter lowercased as per the code logic.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#extractFieldName(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.021884240Z"}
{"id":"e6deecde-0898-4d19-b8c6-6e95f3a8c30c","expr":"method == null || !Double.isNaN(result)","rationale":"When method is null, the method returns Double.NaN explicitly, otherwise it returns the invoked value cast to double.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.023310490Z"}
{"id":"254b1771-ab1b-4476-b2fc-78116cf663be","expr":"Double.isNaN(result) || method != null","rationale":"Result is NaN only if method is null or invocation failed.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.023310490Z"}
{"id":"77090b49-a85a-4c37-a764-931a3d492a6f","expr":"result == Double.NaN || (method != null && !Double.isNaN(result))","rationale":"Result is NaN exactly when invocation failed or method is null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.023310490Z"}
{"id":"1774b5d1-9048-478c-b94a-4138029ede43","expr":"!Double.isNaN(result) || method == null","rationale":"Result is NaN only if method is null or invocation failed.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnDouble(Method,Object):double","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.023310490Z"}
{"id":"b3948cd1-afcd-482d-a97b-2fe6bdd6e099","expr":"method != null || targetObj == null","rationale":"Since method.invoke(targetObj) is called only if method is not null, if method is null, targetObj's state does not affect execution.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.026796556Z"}
{"id":"b77b2ede-b08b-4f1f-a239-5b93975d2ef2","expr":"method == null || method.getParameterCount() == 0","rationale":"The provided invoke call does not pass arguments, so method's parameter count should be zero when method is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.026796556Z"}
{"id":"e5727c24-8753-42ac-ab1b-fc35ababe730","expr":"targetObj != null || method == null","rationale":"If method is static, targetObj can be null; otherwise, it shouldn't be null when method is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.026796556Z"}
{"id":"e82b79ab-4d19-46fd-b65d-1292736e22fc","expr":"method == null || !method.isVarArgs()","rationale":"Because invoke is called with exactly one argument (targetObj) and no varargs, method should either be null or not a varargs method.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.026796556Z"}
{"id":"d5ab6c1a-65a1-41fd-92d4-a99ab8bca65b","expr":"result == (array == null || array.length == 0)","rationale":"The method returns true if the array is null or its length is zero.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.ArrayUtils#isEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-10T13:27:29.038472833Z"}
{"id":"b911a8f3-105a-43a6-81e0-222ba82e6000","expr":"result == null || declaringClass.isAssignableFrom(result.getDeclaringClass())","rationale":"Since the found overridden method must be declared in a class assignable from declaringClass, this captures proper overriding hierarchy.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.039564452Z"}
{"id":"6d922632-8ab8-41e2-9fa2-777139f27652","expr":"result == null || result.getDeclaringClass() != null","rationale":"Java Method instances always have a non-null declaring class.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.039564452Z"}
{"id":"820c9049-7ca5-4d04-be0a-82efe809b71d","expr":"result == null || result.getName().equals(overrider.getName())","rationale":"Overriding implies methods share name.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.039564452Z"}
{"id":"e11ac4b1-0488-4798-af8a-1dff5e6d54bf","expr":"result == null || result.getParameterCount() == overrider.getParameterCount()","rationale":"Overridden methods must have the same signature, including parameter count.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#findOverriddenMethod(Method,Class<?>):Method","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.039564452Z"}
{"id":"540ca754-becb-45e3-a174-fd87ed0e7bb6","expr":"array == null || array.length >= 0","rationale":"The method checks if array is null or has zero length, so it's valid that if not null, length is non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-10T13:27:29.040466944Z"}
{"id":"54022757-8c30-49ba-8862-1e4cd3d63818","expr":"array == null || array.length == 0 || array.length > 0","rationale":"Length of an array is always zero or positive if array is not null.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-10T13:27:29.040466944Z"}
{"id":"812c2e5e-f82b-463b-b313-fcfe813b19cc","expr":"!(array != null && array.length == 0) || array.length == 0","rationale":"Trivial, but safe invariant involving array nullness and length 0 condition","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-10T13:27:29.040466944Z"}
{"id":"68dfe467-6c10-49d0-aef0-1101b131f40e","expr":"array == null || array.length <= array.length","rationale":"a trivial but correct invariant. Strictly we avoid tautologies, but length <= length is tautology and not required","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-10T13:27:29.040466944Z"}
{"id":"6940fa22-f13b-4fe7-8e32-387558ef87e4","expr":"array == null || array.length != -1","rationale":"Array length is never negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.ArrayUtils#isEmpty(Object[]):boolean","file":"org/apache/dubbo/common/utils/ArrayUtils.java","createdAt":"2026-09-10T13:27:29.040466944Z"}
{"id":"6fab8d4f-9966-40ea-8820-d2fe5a75506f","expr":"method != null","rationale":"The method object must be non-null to call instance methods safely.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.042173463Z"}
{"id":"c195d515-089e-4861-9bc0-95bc7a7405e6","expr":"method.getDeclaringClass() != null","rationale":"Every method must belong to a declaring class, so this is required.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.042173463Z"}
{"id":"b27ab032-8992-4cac-b060-33dec72af431","expr":"method.getName() != null","rationale":"A Java Method object should always have a non-null name.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.042173463Z"}
{"id":"b21aea8f-d756-4abf-8275-6c72a51f845c","expr":"method.getParameterTypes() != null","rationale":"Parameter types array returned by Method is always non-null, possibly empty.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.042173463Z"}
{"id":"a6af712b-b0b5-4559-a908-4e555e49edf5","expr":"(method == null) == (result == -1L)","rationale":"The method returns -1 if the method parameter is null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.042504979Z"}
{"id":"71b363e4-70a5-4acf-9b30-cb777379d171","expr":"(method != null) || (result == -1L)","rationale":"The method lengthens that if method is null, result must be -1.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.042504979Z"}
{"id":"b4aab9b9-0120-4cb2-b858-d47c7eb31b26","expr":"method.getParameterTypes().length >= 0","rationale":"Array length properties are always non-negative.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(Method):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.042173463Z"}
{"id":"d67e597b-6c19-4999-9d3e-d7ca64056c12","expr":"(result == -1L) || (method != null)","rationale":"If result is not -1, it means method.invoke was called, so method is not null.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.042504979Z"}
{"id":"b6fc9853-f659-454d-9572-c6bd66abd01a","expr":"result == -1L || (result != -1L)","rationale":"This is tautological but harmless; consider dropping if preferred.","kind":"METHOD_EXIT","element":"org.apache.dubbo.common.utils.MethodUtils#invokeAndReturnLong(Method,Object):long","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.042504979Z"}
{"id":"4eeb62a9-6b6f-46e3-a163-c3086f775b08","expr":"md != null","rationale":"The method expects a valid MethodDescriptor object; otherwise, it cannot proceed.","kind":"METHOD_ENTRY","element":"org.apache.dubbo.common.utils.MethodUtils#toShortString(MethodDescriptor):String","file":"org/apache/dubbo/common/utils/MethodUtils.java","createdAt":"2026-09-10T13:27:29.044430832Z"}
